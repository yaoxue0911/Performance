              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Per-report dynamic data" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters" />
                <stringProp name="filename" />
                <boolProp name="cacheKey">true</boolProp>
                <stringProp name="script">import java.util.concurrent.ThreadLocalRandom
def r=ThreadLocalRandom.current(); vars.put('iteration_failed','false')
vars.put('firstName','TEST'+r.nextInt(1000,10000)); vars.put('lastName','TEST'+r.nextInt(1000,10000))
vars.put('ssn',String.format('%03d-%02d-%04d',r.nextInt(100,1000),r.nextInt(10,100),r.nextInt(1000,10000)))
vars.put('plateNo','P'+r.nextInt(100000,1000000)); vars.put('narrative',"TEST REPORT ${ctx.getThreadNum()+1}-${System.currentTimeMillis()}-${r.nextInt(1000,10000)}")
def rnd={ '0.'+r.nextInt(100000000,1000000000) }
vars.put('contact_name_mn_rnd',rnd()); vars.put('contact_ssn_mn_rnd',rnd()); vars.put('vehicle_mn_rnd',rnd()); vars.put('victim_popup_rnd',rnd()); vars.put('vehicle_popup_rnd',rnd()); vars.put('njs_popup_rnd',rnd())</stringProp>
              </JSR223PreProcessor>
