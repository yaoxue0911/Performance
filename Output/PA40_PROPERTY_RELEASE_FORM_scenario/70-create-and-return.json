            "type": "jsr223_preprocessor",
            "name": "Build CreateIntake object payload",
            "language": "groovy",
            "cache_key": true,
            "script": "import java.nio.charset.StandardCharsets\nimport java.util.Base64\n\ndef required = { String name ->\n    def value = vars.get(name)\n    if (value == null || value == '' || value == 'NOT_FOUND') {\n        throw new IllegalStateException('Missing required variable: ' + name)\n    }\n    value\n}\ndef idFrom = { String value, String key ->\n    def matcher = (value =~ java.util.regex.Pattern.quote(key) + '#(\\\\d+)#')\n    if (!matcher.find()) {\n        throw new IllegalStateException('Cannot extract ' + key + ' from ' + value)\n    }\n    matcher.group(1)\n}\n\ndef contact = required('contact_master_object')\ndef vehicle = required('vehicle_master_object')\ndef property = required('property_master_object')\ndef disposition = required('disposition_master_object')\ndef caseObject = required('case_master_object')\n\ndef personId = idFrom(contact, 'person_id')\ndef vehicleId = idFrom(vehicle, 'vehicle_id')\ndef propertyId = idFrom(property, 'property_id')\ndef dispositionId = idFrom(disposition, 'property_dispose_id')\ndef caseId = idFrom(caseObject, 'case_id')\n\ndef etx = '\\u0003'\ndef stx = '\\u0002'\ndef objectParameter = [\n    'ALLCONTACT:CONTACT:' + contact,\n    'VEHICLE::' + vehicle,\n    'PROPERTY::' + property,\n    'PROPERTY_DISPOSITION::' + disposition,\n    'CASE:CASE:' + caseObject\n].join(etx)\ndef objectDataIndex = [\n    'ALLCONTACT:CONTACT:person_id:' + personId + ':' + contact,\n    'VEHICLE::vehicle_id:' + vehicleId + ':' + vehicle,\n    'PROPERTY::property_id:' + propertyId + ':' + property,\n    'PROPERTY_DISPOSITION::property_dispose_id:' + dispositionId + ':' + disposition,\n    'CASE:CASE:case_id:' + caseId + ':' + caseObject\n].join(stx)\n\nvars.put('objects_parameter_b64', Base64.encoder.encodeToString(objectParameter.getBytes(StandardCharsets.UTF_8)))\nvars.put('objects_data_index_b64', Base64.encoder.encodeToString(objectDataIndex.getBytes(StandardCharsets.UTF_8)))"
          },
          {
            "type": "json_extractor",
            "name": "Extract report_id",
            "refname": "report_id",
            "json_path": "$.report_id",
            "match_number": "1",
            "default_value": "NOT_FOUND"
          },
