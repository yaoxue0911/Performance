{
  "test_plan": {
    "name": "PA40 Property Release Form",
    "comments": "Generated from approved Stage 1 plan for PA40_PROPERTY RELEASE FORM.saz"
  },
  "thread_groups": [
    {
      "name": "PA40 Property Release Form Stable Load",
      "threads": "${__P(concurrency,1)}",
      "rampup": "${__P(rampup,1)}",
      "duration": "${__P(duration,600)}",
      "loops": "-1",
      "on_sample_error": "continue",
      "children": [
        {
          "type": "http_defaults",
          "host": "${__P(target_host,parms42test.csitech.com)}",
          "port": "${__P(target_port,443)}",
          "protocol": "${__P(protocol,https)}",
          "encoding": "${__P(content_encoding,UTF-8)}",
          "path": "${__P(base_path,)}"
        },
        {
          "type": "cookie_manager",
          "clear_each_iteration": false
        },
        {
          "type": "cache_manager",
          "clear_each_iteration": false,
          "use_expires": true
        },
        {
          "type": "csv_data_set",
          "name": "PA40 Property Release users",
          "filename": "${__P(users_csv,pa40_property_release_users.csv)}",
          "variable_names": "login_id,login_password_encoded",
          "delimiter": ",",
          "ignore_first_line": true,
          "recycle": true,
          "stop_thread": false,
          "share_mode": "shareMode.all"
        },
        {
          "$include": "10-auth.json"
        },
        {
          "type": "loop_controller",
          "name": "Property Release Form business flow",
          "loops": "-1",
          "children": [
            {
              "type": "user_parameters",
              "name": "Per-loop dynamic values",
              "per_iteration": true,
              "parameters": [
                {
                  "name": "firstName",
                  "values": [
                    "TEST${__Random(1000,9999,)}"
                  ]
                },
                {
                  "name": "lastName",
                  "values": [
                    "TEST${__Random(1000,9999,)}"
                  ]
                },
                {
                  "name": "plateNo",
                  "values": [
                    "P${__Random(100000,999999,)}"
                  ]
                },
                {
                  "name": "vinNo",
                  "values": [
                    "W${__RandomString(15,0123456789,)}"
                  ]
                },
                {
                  "name": "releaseDate",
                  "values": [
                    "${__time(MM/dd/yyyy,)}"
                  ]
                },
                {
                  "name": "contact_popup_rnd",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                },
                {
                  "name": "contact_mn_rnd",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                },
                {
                  "name": "vehicle_popup_rnd",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                },
                {
                  "name": "vehicle_mn_rnd_1",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                },
                {
                  "name": "vehicle_mn_rnd_2",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                },
                {
                  "name": "property_popup_rnd",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                },
                {
                  "name": "disposition_popup_rnd",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                },
                {
                  "name": "intake_page_rnd",
                  "values": [
                    "0.${__Random(100000000,999999999,)}"
                  ]
                }
              ]
            },
            {
              "type": "uniform_timer",
              "name": "Business think time 500-1500 ms",
              "delay_ms": "500",
              "range_ms": "1000"
            },
            {
              "$include": "20-select-and-start.json"
            },
            {
              "$include": "30-contact.json"
            },
            {
              "$include": "40-vehicle.json"
            },
            {
              "$include": "50-property.json"
            },
            {
              "$include": "60-disposition.json"
            },
            {
              "$include": "70-create-and-return.json"
            }
          ]
        },
        {
          "type": "view_results_tree",
          "name": "View Results Tree (Debug)",
          "filename": "${__P(debug_result_file,PA40_PROPERTY_RELEASE_FORM_debug.jtl)}"
        },
        {
          "type": "simple_data_writer",
          "name": "Simple Data Writer (Load)",
          "filename": "${__P(load_result_file,PA40_PROPERTY_RELEASE_FORM_load.jtl)}"
        }
      ]
    }
  ]
}
