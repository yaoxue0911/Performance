{
  "type": "transaction_controller",
  "name": "Add property disposition",
  "children": [
    {
      "type": "http_sampler",
      "name": "GET /RMS/Aspsoft/PopUpDispatcher Open disposition form",
      "method": "GET",
      "path": "/RMS/Aspsoft/PopUpDispatcher?nextPID=addPropertyDispose_Intake&case_id=${case_id}&PartialRefresh=listIntakeFormMaster_PropertyDispose&template_id=2409&report_id=0&rnd=${disposition_popup_rnd}",
      "follow_redirects": true,
      "children": [
        {
          "type": "css_extractor",
          "name": "Extract disposition_csrf",
          "refname": "disposition_csrf",
          "expression": "meta[name='csrf-token']",
          "attribute": "content",
          "match_number": "1",
          "default_value": "NOT_FOUND",
          "scope": "parent"
        },
        {
          "type": "css_extractor",
          "name": "Extract disposition_timestamp",
          "refname": "disposition_timestamp",
          "expression": "input[name='doubleEntryTimeStamp']",
          "attribute": "value",
          "match_number": "1",
          "default_value": "NOT_FOUND",
          "scope": "parent"
        }
      ]
    },
    {
      "type": "http_sampler",
      "name": "POST /RMS/Aspsoft/PopUpDispatcher Save disposition",
      "method": "POST",
      "path": "/RMS/Aspsoft/PopUpDispatcher?nextPID=addPropertyDispose_Intake&case_id=${case_id}&PartialRefresh=listIntakeFormMaster_PropertyDispose&template_id=2409&report_id=0&rnd=${disposition_popup_rnd}",
      "follow_redirects": true,
      "params": [
        {
          "name": "ReleasedDate~|intake_property_report_disposition_add~|A",
          "value": "${releaseDate}",
          "always_encode": true
        },
        {
          "name": "ReleasedDate~|intake_property_report_disposition_add~|A_txtDate",
          "value": "${releaseDate}",
          "always_encode": true
        },
        {
          "name": "ReleasedDate~|intake_property_report_disposition_add~|A_txtTime",
          "value": "",
          "always_encode": true
        },
        {
          "name": "ProofOfOwnership~|intake_property_report_disposition_add~|A",
          "value": "",
          "always_encode": true
        },
        {
          "name": "SignatureOfOfficerAuthor~|intake_property_report_disposition_add~|A",
          "value": "",
          "always_encode": true
        },
        {
          "name": "ReleasedToOwner~|intake_property_report_disposition_add~|A",
          "value": "",
          "always_encode": true
        },
        {
          "name": "AddressOfOwner~|intake_property_report_disposition_add~|A",
          "value": "",
          "always_encode": true
        },
        {
          "name": "SignatureOfOwner~|intake_property_report_disposition_add~|A",
          "value": "",
          "always_encode": true
        },
        {
          "name": "SignatureOfOfficerRelease~|intake_property_report_disposition_add~|A",
          "value": "",
          "always_encode": true
        },
        {
          "name": "DispositionStatus~|intake_property_report_disposition_add~|A",
          "value": "Complete",
          "always_encode": true
        },
        {
          "name": "submit_button",
          "value": "Save",
          "always_encode": true
        },
        {
          "name": "case_id~|intake_property_report_disposition_add~|A",
          "value": "${case_id}",
          "always_encode": true
        },
        {
          "name": "PID",
          "value": "addPropertyDispose_Intake",
          "always_encode": true
        },
        {
          "name": "doubleEntryTimeStamp",
          "value": "${disposition_timestamp}",
          "always_encode": true
        },
        {
          "name": "__RequestVerificationToken",
          "value": "${disposition_csrf}",
          "always_encode": true
        }
      ],
      "children": [
        {
          "type": "header_manager",
          "name": "Headers - POST /RMS/Aspsoft/PopUpDispatcher Save disposition",
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            },
            {
              "name": "Origin",
              "value": "${__P(protocol,https)}://${__P(target_host,parms42test.csitech.com)}:${__P(target_port,443)}"
            }
          ]
        }
      ]
    },
    {
      "type": "http_sampler",
      "name": "GET /RMS/Aspsoft/IntakeForm/middlepage Refresh dispositions",
      "method": "GET",
      "path": "/RMS/Aspsoft/IntakeForm/middlepage?nextPID=intakeFormMiddelPage&template_id=2409&report_id=0&case_id=${case_id}&PID=listPoliceReport&FormGUID=${FormGUID}&PartialRefresh_Ajax=listIntakeFormMaster_PropertyDispose&handler=partialrefresh&rnd=0.${__Random(100000000,999999999,)}",
      "follow_redirects": true,
      "children": [
        {
          "type": "header_manager",
          "name": "Headers - GET /RMS/Aspsoft/IntakeForm/middlepage Refresh dispositions",
          "headers": [
            {
              "name": "X-Requested-With",
              "value": "XMLHttpRequest"
            },
            {
              "name": "RequestVerificationToken",
              "value": "${middle_csrf}"
            }
          ]
        },
        {
          "type": "css_extractor",
          "name": "Extract disposition_master_object",
          "refname": "disposition_master_object",
          "expression": "input[name='master_id_list~|list~|D']",
          "attribute": "value",
          "match_number": "1",
          "default_value": "NOT_FOUND",
          "scope": "parent"
        }
      ]
    }
  ]
}
