{
  "type": "once_only_controller",
  "name": "Authentication and initialization",
  "children": [
    {
      "type": "transaction_controller",
      "name": "Login and disclaimer",
      "children": [
        {
          "type": "http_sampler",
          "name": "GET /RMS/Login Load login page",
          "method": "GET",
          "path": "/RMS/Login",
          "follow_redirects": true,
          "children": [
            {
              "type": "css_extractor",
              "name": "Extract login_csrf",
              "refname": "login_csrf",
              "expression": "input[name='__RequestVerificationToken']",
              "attribute": "value",
              "match_number": "1",
              "default_value": "NOT_FOUND",
              "scope": "parent"
            }
          ]
        },
        {
          "type": "http_sampler",
          "name": "POST /RMS/Login Authenticate user",
          "method": "POST",
          "path": "/RMS/Login",
          "follow_redirects": true,
          "params": [
            {
              "name": "LoginId",
              "value": "${login_id}",
              "always_encode": true
            },
            {
              "name": "Password",
              "value": "${login_password_encoded}",
              "always_encode": true
            },
            {
              "name": "usbKeyValue",
              "value": "",
              "always_encode": true
            },
            {
              "name": "computerNameValue",
              "value": "",
              "always_encode": true
            },
            {
              "name": "__RequestVerificationToken",
              "value": "${login_csrf}",
              "always_encode": true
            }
          ],
          "children": [
            {
              "type": "header_manager",
              "name": "Headers - POST /RMS/Login Authenticate user",
              "headers": [
                {
                  "name": "Content-Type",
                  "value": "application/x-www-form-urlencoded"
                },
                {
                  "name": "Origin",
                  "value": "${__P(protocol,https)}://${__P(target_host,parms42test.csitech.com)}:${__P(target_port,443)}"
                }
              ]
            },
            {
              "type": "css_extractor",
              "name": "Extract disclaimer_csrf",
              "refname": "disclaimer_csrf",
              "expression": "input[name='__RequestVerificationToken']",
              "attribute": "value",
              "match_number": "1",
              "default_value": "NOT_FOUND",
              "scope": "all"
            }
          ]
        },
        {
          "type": "http_sampler",
          "name": "POST /RMS/DisclaimerRedirect Accept disclaimer",
          "method": "POST",
          "path": "/RMS/DisclaimerRedirect?handler=Jump",
          "follow_redirects": true,
          "params": [
            {
              "name": "__RequestVerificationToken",
              "value": "${disclaimer_csrf}",
              "always_encode": true
            }
          ],
          "children": [
            {
              "type": "header_manager",
              "name": "Headers - POST /RMS/DisclaimerRedirect Accept disclaimer",
              "headers": [
                {
                  "name": "Content-Type",
                  "value": "application/x-www-form-urlencoded"
                },
                {
                  "name": "Origin",
                  "value": "${__P(protocol,https)}://${__P(target_host,parms42test.csitech.com)}:${__P(target_port,443)}"
                }
              ]
            }
          ]
        },
        {
          "type": "http_sampler",
          "name": "GET /RMS/Home Initialize authenticated home",
          "method": "GET",
          "path": "/RMS/Home?division_id=3",
          "follow_redirects": true,
          "children": [
            {
              "type": "regex_extractor",
              "name": "Extract staff_id",
              "refname": "staff_id",
              "regex": "inbox_staff_id=(\\d+)",
              "template": "$1$",
              "match_number": "1",
              "default_value": "NOT_FOUND"
            },
            {
              "type": "regex_extractor",
              "name": "Extract region_id",
              "refname": "region_id",
              "regex": "region_id=(\\d+)",
              "template": "$1$",
              "match_number": "1",
              "default_value": "NOT_FOUND"
            }
          ]
        }
      ]
    }
  ]
}
