                <stringProp name="filename" />
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.nio.charset.StandardCharsets
import java.util.Base64

def required = { String name -&gt;
    def value = vars.get(name)
    if (value == null || value == '' || value == 'NOT_FOUND') {
        throw new IllegalStateException('Missing required variable: ' + name)
    }
    value
}
def idFrom = { String value, String key -&gt;
    def matcher = (value =~ java.util.regex.Pattern.quote(key) + '#(\\d+)#')
    if (!matcher.find()) {
        throw new IllegalStateException('Cannot extract ' + key + ' from ' + value)
    }
    matcher.group(1)
}

def contact = required('contact_master_object')
def vehicle = required('vehicle_master_object')
def property = required('property_master_object')
def disposition = required('disposition_master_object')
def caseObject = required('case_master_object')

def personId = idFrom(contact, 'person_id')
def vehicleId = idFrom(vehicle, 'vehicle_id')
def propertyId = idFrom(property, 'property_id')
def dispositionId = idFrom(disposition, 'property_dispose_id')
def caseId = idFrom(caseObject, 'case_id')

def etx = '\u0003'
def stx = '\u0002'
def objectParameter = [
    'ALLCONTACT:CONTACT:' + contact,
    'VEHICLE::' + vehicle,
    'PROPERTY::' + property,
    'PROPERTY_DISPOSITION::' + disposition,
    'CASE:CASE:' + caseObject
].join(etx)
def objectDataIndex = [
    'ALLCONTACT:CONTACT:person_id:' + personId + ':' + contact,
    'VEHICLE::vehicle_id:' + vehicleId + ':' + vehicle,
    'PROPERTY::property_id:' + propertyId + ':' + property,
    'PROPERTY_DISPOSITION::property_dispose_id:' + dispositionId + ':' + disposition,
    'CASE:CASE:case_id:' + caseId + ':' + caseObject
].join(stx)

vars.put('objects_parameter_b64', Base64.encoder.encodeToString(objectParameter.getBytes(StandardCharsets.UTF_8)))
vars.put('objects_data_index_b64', Base64.encoder.encodeToString(objectDataIndex.getBytes(StandardCharsets.UTF_8)))</stringProp>
