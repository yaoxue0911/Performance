{
  "type": "loop_controller",
  "name": "Case permission and report loop",
  "loops": "-1",
  "children": [
    {
      "type": "csv_data_set",
      "name": "Case IDs",
      "filename": "case id.csv",
      "variable_names": "case_id",
      "delimiter": ",",
      "ignore_first_line": true,
      "recycle": true,
      "stop_thread": false,
      "share_mode": "shareMode.all"
    },
    {
      "type": "user_parameters",
      "name": "Per-case request values",
      "per_iteration": true,
      "parameters": [
        {"name": "njs_popup_rnd", "values": ["0.${__Random(100000000,999999999,)}"]},
        {"name": "intake_page_rnd", "values": ["0.${__Random(100000000,999999999,)}"]},
        {"name": "workflow_rnd_1", "values": ["0.${__Random(100000000,999999999,)}"]},
        {"name": "workflow_rnd_2", "values": ["0.${__Random(100000000,999999999,)}"]}
      ]
    },
    {
      "type": "http_sampler",
      "name": "Open case incident summary",
      "method": "GET",
      "path": "/RMS/AspSoft/Dispatcher.aspx?nextPID=inquireIncidentSummary&case_id=${case_id}",
      "follow_redirects": true,
      "children": [
        {
          "type": "header_manager",
          "name": "Open case headers",
          "headers": [
            {
              "name": "Referer",
              "value": "${__P(protocol,https)}://${__P(target_host,hcrms.csitech.com)}:${__P(target_port,443)}/RMS/AspSoft/inbox/inboxTaskList.aspx?nextPID=listInbox_ActiveCase_NO&inbox_staff_id=1&inbox_sub_id=10030811&UseDefault=1&is_temp_page_size=1&page_size=100"
            }
          ]
        }
      ]
    },
    {"$include": "30-permission.json"},
    {"$include": "40-report.json"}
  ]
}
