[
  {
    "type": "http_defaults",
    "host": "${__P(target_host,hcrms.csitech.com)}",
    "port": "${__P(target_port,443)}",
    "protocol": "${__P(protocol,https)}",
    "encoding": "${__P(content_encoding,UTF-8)}",
    "path": "${__P(base_path,/)}"
  },
  {"type": "cookie_manager", "clear_each_iteration": false},
  {"type": "cache_manager", "clear_each_iteration": false, "use_expires": true},
  {
    "type": "once_only_controller",
    "name": "Login once",
    "children": [
      {
        "type": "http_sampler",
        "name": "GET /RMS/Login.aspx",
        "method": "GET",
        "path": "/RMS/Login.aspx",
        "follow_redirects": true,
        "children": [
          {"type": "css_extractor", "name": "Login VIEWSTATE", "refname": "login_viewstate", "expression": "input[name='__VIEWSTATE']", "attribute": "value", "match_number": "1", "default_value": "NOT_FOUND", "scope": "parent"},
          {"type": "css_extractor", "name": "Login VIEWSTATEGENERATOR", "refname": "login_viewstate_generator", "expression": "input[name='__VIEWSTATEGENERATOR']", "attribute": "value", "match_number": "1", "default_value": "NOT_FOUND", "scope": "parent"}
        ]
      },
      {
        "type": "http_sampler",
        "name": "POST /RMS/Login.aspx",
        "method": "POST",
        "path": "/RMS/Login.aspx",
        "follow_redirects": true,
        "params": [
          {"name": "__VIEWSTATE", "value": "${login_viewstate}", "always_encode": true},
          {"name": "__VIEWSTATEGENERATOR", "value": "${login_viewstate_generator}", "always_encode": true},
          {"name": "txtUserName", "value": "sa01", "always_encode": true},
          {"name": "txtPassword", "value": "QyQhMTk5MCFuZjAkaGFyMzIwMjY=", "always_encode": true},
          {"name": "btnLogin", "value": "Login", "always_encode": true},
          {"name": "hdnDebugConn", "value": "", "always_encode": true},
          {"name": "hdnDeviceInfo", "value": "", "always_encode": true},
          {"name": "usbKeyValue", "value": "", "always_encode": true},
          {"name": "computerNameValue", "value": "", "always_encode": true}
        ],
        "children": [
          {"type": "header_manager", "name": "Login headers", "headers": [{"name": "Content-Type", "value": "application/x-www-form-urlencoded"}, {"name": "Origin", "value": "${__P(protocol,https)}://${__P(target_host,hcrms.csitech.com)}:${__P(target_port,443)}"}, {"name": "Referer", "value": "${__P(protocol,https)}://${__P(target_host,hcrms.csitech.com)}:${__P(target_port,443)}/RMS/Login.aspx"}]},
          {"type": "css_extractor", "name": "Disclaimer VIEWSTATE", "refname": "disclaimer_viewstate", "expression": "input[name='__VIEWSTATE']", "attribute": "value", "match_number": "1", "default_value": "NOT_FOUND", "scope": "all"},
          {"type": "css_extractor", "name": "Disclaimer VIEWSTATEGENERATOR", "refname": "disclaimer_viewstate_generator", "expression": "input[name='__VIEWSTATEGENERATOR']", "attribute": "value", "match_number": "1", "default_value": "NOT_FOUND", "scope": "all"},
          {"type": "css_extractor", "name": "Disclaimer EVENTVALIDATION", "refname": "disclaimer_eventvalidation", "expression": "input[name='__EVENTVALIDATION']", "attribute": "value", "match_number": "1", "default_value": "NOT_FOUND", "scope": "all"}
        ]
      },
      {
        "type": "http_sampler",
        "name": "POST /RMS/DisclaimerRedirect.aspx",
        "method": "POST",
        "path": "/RMS/DisclaimerRedirect.aspx?division_id=3",
        "follow_redirects": true,
        "params": [
          {"name": "__VIEWSTATE", "value": "${disclaimer_viewstate}", "always_encode": true},
          {"name": "__VIEWSTATEGENERATOR", "value": "${disclaimer_viewstate_generator}", "always_encode": true},
          {"name": "__EVENTVALIDATION", "value": "${disclaimer_eventvalidation}", "always_encode": true},
          {"name": "btnJump", "value": "", "always_encode": true}
        ],
        "children": [
          {"type": "header_manager", "name": "Disclaimer headers", "headers": [{"name": "Content-Type", "value": "application/x-www-form-urlencoded"}, {"name": "Origin", "value": "${__P(protocol,https)}://${__P(target_host,hcrms.csitech.com)}:${__P(target_port,443)}"}, {"name": "Referer", "value": "${__P(protocol,https)}://${__P(target_host,hcrms.csitech.com)}:${__P(target_port,443)}/RMS/Index.aspx"}]}
        ]
      },
      {
        "type": "http_sampler",
        "name": "GET /RMS/Home.aspx",
        "method": "GET",
        "path": "/RMS/Home.aspx?division_id=3",
        "follow_redirects": true
      }
    ]
  }
]
