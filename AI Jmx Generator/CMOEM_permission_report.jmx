              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build captured create-report payload" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def caseId = vars.get(&apos;case_id&apos;)
def cfsId = vars.get(&apos;cfs_id&apos;)
def locationId = vars.get(&apos;location_id&apos;)
def njsId = vars.get(&apos;inv_njs_id&apos;)
def encoder = java.util.Base64.encoder
def p = &quot;NJS::inv_njs_id#${njsId}#\u0003CASE:CASE:case_id#${caseId}#|cfs_id#${cfsId}#|location_id#${locationId}#CASE|org_id#100000#ORG&quot;
def p2 = &quot;NJS::inv_njs_id:${njsId}:inv_njs_id#${njsId}#\u0002CASE:CASE:case_id:${caseId}:case_id#${caseId}#|cfs_id#${cfsId}#|location_id#${locationId}#CASE|org_id#100000#ORG&quot;
vars.put(&apos;create_report_p&apos;, encoder.encodeToString(p.getBytes(java.nio.charset.StandardCharsets.UTF_8)))
vars.put(&apos;create_report_p2&apos;, encoder.encodeToString(p2.getBytes(java.nio.charset.StandardCharsets.UTF_8)))</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
