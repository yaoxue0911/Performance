e_1\">\r\n\t\t\t\t\t\t\t\t<label id=\"ilReportWorkflowSection\" class=\"d-block  fs-6\" class=\"text-label text-secondary\">REPORT APPROVAL SECTION</label>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div id=\"collapse_1\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#div_1\">\r\n\t\t\t\t\t\t<div class=\"accordion-body  engine-legend-body\">\r\n\t\t\t\t\t\t\t<div class=\"engine-legend-form\">\r\n\t\t\t\t\t\t\t\t<div class=\"vc-engine-form\">\r\n\t\t\t\t\t\t\t\t\t<div class=\"form-row \">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item col-3\" style=\"\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"col-3\">\r\n\t\t\t\t\t\t\t\t\t\t\t<label ID=\"ilReportStatus\" class=\"form-label d-block fw-bold fs-6\" class=\"text-label text-secondary\">Report Status</label>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item\" style=\"\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"\">\r\n\t\t\t\t\t\t\t\t\t\t\t<span id=\"lReportStatus\">PENDING SUBMISSION</span>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"form-row \">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item col-3\" style=\"\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"col-3\">\r\n\t\t\t\t\t\t\t\t\t\t\t<label ID=\"ilReportNextStep\" class=\"form-label d-block fw-bold fs-6\" class=\"text-label text-secondary\">Next Step<font color=\"#F15A29\"> (Req.)</font></label>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item\" style=\"\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t<select isreq=\"Y\" onchange=\"ReportNextStepSelectedChanged(this)\" id=\"ReportNextStep\" name=\"ReportNextStep\"><option selected=\"selected\" value=\"\"></option>\r\n<option value=\"ROUTE1\">SENT FOR APPROVAL</option>\r\n</select>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"form-row \">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item col-3\" style=\"display:none\" id=\"tdRouteTypeCaption\" style=\"\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"col-3\">\r\n\t\t\t\t\t\t\t\t\t\t\t<label ID=\"ilRouteType\" class=\"form-label d-block fw-bold fs-6\" class=\"text-label text-secondary\">Route Type<font color=\"#F15A29\"> (Req.)</font></label>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item\" id=\"tdRouteType\" style=\"display:none\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item col-3\" id=\"tdRouteCaption\" style=\"display:none\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"col-3\">\r\n\t\t\t\t\t\t\t\t\t\t\t<label ID=\"ilRouteForReview\" class=\"form-label d-block fw-bold fs-6\" class=\"text-label text-secondary\">Route Type<font color=\"#F15A29\"> (Req.)</font></label>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item\" style=\"display:none\" id=\"tdRoute\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div class=\"form-row \">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"col row-item\" style=\"\" data-colspan=\"1\" data-width=\"\" data-original-classes=\"\">\r\n\t\t\t\t\t\t\t\t\t\t\t<label ID=\"ilNote\" class=\"form-label d-block fw-bold fs-6\" class=\"text-label text-secondary\">Note</label>\r\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"notebox\" id=\"nbReviewNote\" check_spelling=\"1\" style=\"position: relative;\"><textarea check_spelling=\"1\" class=\"notebox notebox\" cols=\"80\" id=\"nbReviewNote\" maxlength=\"2000\" name=\"nbReviewNote\" rows=\"6\" style=\"width:98% !important;width:300px;height:120px\"></textarea><br/><span counterTip=\"counterTip\" style=\"padding:0px 3px;font-size:110%;display:inline-block !important;\"></span><span style=\"display:inline-block !important;\">characters left</span></div>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"CurrentWorkflowLookupId\" name=\"CurrentWorkflowLookupId\" value=\"INTAKE_1LEVELGROUP\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"CurrentReportStatus\" name=\"CurrentReportStatus\" value=\"PENDING SUBMISSION\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"OriginalReportStatus\" name=\"OriginalReportStatus\" value=\"PENDING\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"ParentManagerId\" name=\"ParentManagerId\" value=\"\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"reportIds\" name=\"ReportIds\" value=\"4191\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"currentReportId\" name=\"CurrentReportId\" value=\"4191\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"reportStatus\" name=\"ReportStatus\" value=\"PENDING\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"reportStatusDesc\" name=\"ReportStatusDesc\" value=\"PENDING SUBMISSION\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"hldRouteType\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"hldDSKey\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"hldDSAuto\" />\r\n\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" id=\"hldRouteGroupType\" />\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"engine-form-page-default-container\">\r\n\t\t\t\t<div class=\"vc-engine-form\">\r\n\t\t\t\t\t<div class=\"form-row no-border\">\r\n\t\t\t\t\t\t<div class=\"col row-item no-border col\" style=\"text-align:center; \" data-colspan=\"1\" data-width=\"\" data-original-classes=\"\">\r\n\t\t\t\t\t\t\t\t<input name=\"btnSave\" class=\"btn btn-success\" objectname=\"submit_button\" type=\"button\" value=\"Save\" onclick=\"SaveWorkFlow()\">\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"engine-form-page-default-container\">\r\n\t\t\t\t<table class=\"gridview_table\" cellspacing=\"0\" border=\"0\" id=\"ctl00_ContentPlaceHolder1_igvReportWorkflow\" style=\"width:100%;\">\r\n\t\t\t\t\t<tbody>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t<th class=\"titleColumnHeader\" scope=\"col\">Posted Date</th>\r\n\t\t\t\t\t\t\t<th class=\"titleColumnHeader\" scope=\"col\">Report Status</th>\r\n\t\t\t\t\t\t\t<th class=\"titleColumnHeader\" scope=\"col\">Route From</th>\r\n\t\t\t\t\t\t\t<th class=\"titleColumnHeader\" scope=\"col\">Route To</th>\r\n\t\t\t\t\t\t\t<th class=\"titleColumnHeader\" scope=\"col\">Review note</th>\r\n\t\t\t\t\t\t\t<th class=\"titleColumnHeader\" scope=\"col\">Posted By</th>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t\t\t\t<tr class=gridodd>\r\n\t\t\t\t\t\t\t\t\t\t<td>07/29/2026</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<span id=\"tdlReportStatus\">PENDING SUBMISSION</span>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<span id=\"lRouteFrom\"></span>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"hidRouteType\" value=\"\" id=\"hidRouteType\">\r\n\t\t\t\t\t\t\t\t\t\t\t<span id=\"lRouteTo\"></span>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"hidReviewNote\" id=\"hidReviewNote\" value=\"\">\r\n\t\t\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"hidFlag\" id=\"hidFlag\" value=\"0\">\r\n\t\t\t\t\t\t\t\t\t\t\t<span id=\"lblReviewNote\"></span>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t\t<td>\r\n\t\t\t\t\t\t\t\t\t\t\t<span id=\"lPostedBy\">LAST NAME, FIRST NAME M</span>\r\n\t\t\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t</tbody>\r\n\t\t\t\t</table>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\r\n<div class=\"modal fade\" id=\"detailModal\" tabindex=\"-1\" aria-hidden=\"true\">\r\n\t<div class=\"modal-dialog modal-dialog-centered\">\r\n\t\t<div class=\"modal-content\">\r\n\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t<h5 class=\"modal-title\">Note</h5>\r\n\t\t\t\t<button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"modal-body modal-body-scroll\">\r\n\t\t\t\t<p id=\"fullTextBody\"></p>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"modal-footer\">\r\n\t\t\t\t<button type=\"button\" class=\"btn btn-secondary\" data-bs-dismiss=\"modal\">Close</button>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n<script>\r\n\tfunction ReportNextStepSelectedChanged(obj)\r\n\t{\r\n\t\tvar selectVal=$(obj).val();\r\n\t\t$.ajax({\r\n\t\t\t\turl: '?handler=ReportNextStepSelectedChanged',\r\n\t\t\t\ttype: 'POST',\r\n\t\t\t\tdata: { nextStep:selectVal,reportIds:$(\"#reportIds\").val(),CurrentReportStatus:$(\"#CurrentReportStatus\").val(),reportStatus:$(\"#reportStatus\").val() },\r\n\t\t\t\theaders: {\r\n\t\t\t\t\t\t\t'Content-Type': 'application/x-www-form-urlencoded',\r\n\t\t\t\t\t\t\t'RequestVerificationToken': document.querySelector('input[name=\"__RequestVerificationToken\"]').value\r\n\t\t\t\t\t\t},\r\n\t\t\t\tbeforeSend: function () {\r\n\t\t\t\t\tShowWaitBox();\r\n\t\t\t\t\t\t},\r\n\t\t\t\tsuccess: function (result)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"#hldRouteType\").val(result.hldRouteTypeValue);\r\n\t\t\t\t\t$(\"#hldDSKey\").val(result.hldDSKeyValue);\r\n\t\t\t\t\t$(\"#hldDSAuto\").val(result.hldDSAutoValue);\r\n\t\t\t\t\t$(\"#hldRouteGroupType\").val(result.hldRouteGroupTypeValue);\r\n\t\t\t\t\t$(\"#lReportStatus\").text(result.lReportStatusText);\r\n\t\t\t\t\tif(result.disableSaveBtn)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$('input[name*=btnSave]').prop('disabled',true);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse{\r\n\t\t\t\t\t\t$('input[name*=btnSave]').prop('disabled',false);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(result.tdRouteTypeVisible)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"#tdRouteType\").empty().html(result.routeTypeHtmlStr).show();\r\n\t\t\t\t\t\t$(\"#tdRouteTypeCaption\").show();\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"#tdRouteType\").hide();\r\n\t\t\t\t\t\t$(\"#tdRouteTypeCaption\").hide();\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif(result.tdRouteVisible)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"#tdRoute\").empty().html(result.routeHtmlStr).show();\r\n\t\t\t\t\t\t$(\"#tdRouteCaption\").show();\r\n\t\t\t\t\t}else\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"#tdRoute\").hide();\r\n\t\t\t\t\t\t$(\"#tdRouteCaption\").hide();\r\n\t\t\t\t\t}\r\n\t\t\t\t},\r\n\t\t\t\tcomplete: function () {\r\n\t\t\t\t\tHideWaitBox();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t}\r\n\r\n\tfunction RouteTypeChange(obj)\r\n\t{\r\n\t\tvar selectVal=$(obj).val();\r\n\t\tif(selectVal==''||selectVal==\"\")\r\n\t\t{\r\n\t\t\t$(\"#tdRoute\").hide();\r\n\t\t\t$(\"#tdRouteCaption\").hide();\r\n\t\t\treturn;\r\n\t\t}\r\n\t\t$.ajax({\r\n\t\t\t\turl: '?handler=RouteTypeSelectedChanged',\r\n\t\t\t\ttype: 'POST',\r\n\t\t\t\tdata: { RouteTypeVal:selectVal,reportIds:$(\"#reportIds\").val(),ReportNextStepVal:$(\"#ReportNextStep\").val() ,reportStatus:$(\"#reportStatus\").val()},\r\n\t\t\t\theaders: {\r\n\t\t\t\t\t\t\t'Content-Type': 'application/x-www-form-urlencoded',\r\n\t\t\t\t\t\t\t'RequestVerificationToken': document.querySelector('input[name=\"__RequestVerificationToken\"]').value\r\n\t\t\t\t\t\t},\r\n\t\t\t\tbeforeSend: function () {\r\n\t\t\t\t\tShowWaitBox();\r\n\t\t\t\t\t\t},\r\n\t\t\t\tsuccess: function (result)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"#hldRouteType\").val(result.hldRouteTypeValue);\r\n\t\t\t\t\t$(\"#hldDSKey\").val(result.hldDSKeyValue);\r\n\t\t\t\t\t$(\"#hldDSAuto\").val(result.hldDSAutoValue);\r\n\r\n\t\t\t\t\tif(result.tdRouteVisible)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"#tdRoute\").empty().html(result.routeHtmlStr).show();\r\n\t\t\t\t\t\t$(\"#tdRouteCaption\").show();\r\n\t\t\t\t\t}else\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"#tdRoute\").hide();\r\n\t\t\t\t\t\t$(\"#tdRouteCaption\").hide();\r\n\t\t\t\t\t}\r\n\t\t\t\t},\r\n\t\t\t\tcomplete: function () {\r\n\t\t\t\t\tHideWaitBox();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t}\r\n\r\n\tfunction SaveWorkFlow()\r\n\t{\r\n\t\tif (!checkInput())\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tvar data={};\r\n\t\tdata.OriginalReportStatus=$(\"#OriginalReportStatus\").val();\r\n\t\tdata.ParentManagerId=$(\"#ParentManagerId\").val();\r\n\t\tdata.CurrentWorkflowLookupId=$(\"#CurrentWorkflowLookupId\").val();\r\n\t\tdata.reportIds=$(\"#reportIds\").val();\r\n\t\tdata.ddlReportNextStep=$(\"#ReportNextStep\").val();\r\n\t\tdata.ddlRouteType=$(\"#ddlRouteType\").val();\r\n\t\tdata.reportStatus=$(\"#reportStatus\").val();\r\n\t\tdata.hldRouteTypeValue=$(\"#hldRouteType\").val();\r\n\t\tdata.hldRouteGroupTypeValue=$(\"#hldRouteGroupType\").val();\r\n\t\tdata.ddlReportRouteTo=$(\"#ddlReportRouteTo\").val();\r\n\t\tdata.nbReviewNoteText=$('textarea[name=\"nbReviewNote\"]').val();\r\n\t\tdata.hldDSKeyValue=$(\"#hldDSKey\").val();\r\n\t\tdata.hldDSAutoValue=$(\"#hldDSAuto\").val();\r\n\t\t$.ajax({\r\n\t\t\turl: '?handler=SaveWorkFlow',\r\n\t\t\ttype: 'POST',\r\n\t\t\tdata: data,\r\n\t\t\theaders: {\r\n\t\t\t\t'Content-Type': 'application/x-www-form-urlencoded',\r\n\t\t\t\t'RequestVerificationToken': document.querySelector('input[name=\"__RequestVerificationToken\"]').value\r\n\t\t\t},\r\n\t\t\tbeforeSend: function () {\r\n\t\t\t\tShowWaitBox();\r\n\t\t\t},\r\n\t\t\tsuccess: function (result)\r\n\t\t\t{\r\n\t\t\t\tif(result.code==201||result.code==202)\r\n\t\t\t\t{\r\n\t\t\t\t\talert(result.message);\r\n\t\t\t\t\tCloseDialog(1);\r\n\t\t\t\t}else{\r\n\t\t\t\t\tCloseDialog(result.returnValue);\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\tcomplete: function () {\r\n\t\t\t\tHideWaitBox();\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\r\n</script>\r\n\r\n<script type=\"text/javascript\">\r\n\t$(document).ready(function () {\r\n\t\t$(\"span[id*=lblReviewNote]\").each(function () {\r\n\t\t\tif ($(this).siblings(\"input[id$=hidFlag]\").val() == 1) {\r\n\t\t\t\tvar realNote = $(this).siblings(\"input[id$=hidReviewNote]\").val();\r\n\t\t\t\t$(this).attr({ \"content\": realNote, \"title\": \"Click it to show all text.\" });\r\n\t\t\t\t$(this).css(\"cursor\", \"pointer\");\r\n\t\t\t\t$(this).on(\"click\", function () {\r\n\t\t\t\t\tdocument.getElementById('fullTextBody').textContent = realNote;\r\n\t\t\t\t\tconst modal = new bootstrap.Modal(document.getElementById('detailModal'));\r\n\t\t\t\t\tmodal.show();\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t});\r\n\t});\r\n\r\n\twindow.addEventListener('beforeunload', function () {\r\n\t\tconst fd = new FormData();\r\n\t\tfd.append('report_ids', document.getElementById('reportIds').value);\r\n\t\tconst token = document.querySelector('input[name=\"__RequestVerificationToken\"]').value;\r\n\t\tfd.append('__RequestVerificationToken', token);\r\n\t\tnavigator.sendBeacon('?handler=Clear', fd);\r\n\t});\r\n\r\n\tfunction pageLoad(sender, args)\r\n\t{\r\n\t\t$('textarea[id$=nbReviewNote]').blur();\r\n\t\t$(\"select[name=ReportNextStep]\").change(function () {\r\n\t\t\tShowWaitBox();\r\n\t\t});\r\n\t}\r\n</script>\r\n\r\n\t\t\t<input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"CfDJ8Lt5bHFAdgVKqAT8Txuezcl7psAlzZkxg33ijiwWUUE7LfS73fk66Tn1dDkPCDu6ENM-1QUQ25KlWts-0d5tWBfjtGHssBXLdPTr6DjkQ96Sd45mCS5zpJ2ZPTyyngK_qGRi6ig72rsg4jZ39Cdi9FKLeR3LQCicKxe3M08GYgZRYGAy6-Va5pWdfTy4zpObew\" /></form>\r\n\t\t</div>\r\n\t</div>\r\n\t<div class=\"p-2\">\r\n\t\t\r\n<div class=\"mt-auto pt-4\"></div>\r\n\t<div class=\"app-footer-tips-container d-flex align-items-center\">\r\n\t\t<span class=\"app-footer-tips text-body-tertiary\">\r\n\t\t\t<b>Tips: </b>\r\n\t\t\tClick <b>Save</b> button to save added record.\r\n\t\t</span>\r\n\t\t\t<img alt=\"Show/Hide Footer\" class=\"ms-auto\" src=\"/RMS/images/2downarrow.png\" onclick=\"showFooter(this);return false;\" style=\"cursor: pointer;\">\r\n\t</div>\r\n<div id=\"tabBarBottom\" style=display:none>\r\n\t\t<hr class=\"my-1\" />\r\n\t<div class=\"app-footer d-flex align-items-center\">\r\n\t\t<ul class=\"nav ms-auto\"