s=\"svg-icon EventLighter\"\r\n\t\t\t\t\t\t\t  style=\"width: 2rem;height: 2rem;\"\r\n\t\t\t\t\t\t\t  data-info='{\"nodeId\":127,\"toggle\":true,\"greyIconClassName\":\"EventGrey\",\"lighterIconClassName\":\"EventLighter\",\"category\":\"Event\"}'\r\n\t\t\t\t\t\t\t  type=\"button\" title=\"Hide Event\"></span>\r\n\t\t\t\t\t\t<span class=\"svg-icon MailLighter\"\r\n\t\t\t\t\t\t\t  style=\"width: 2rem;height: 2rem;\"\r\n\t\t\t\t\t\t\t  data-info='{\"nodeId\":123,\"toggle\":true,\"greyIconClassName\":\"MailGrey\",\"lighterIconClassName\":\"MailLighter\",\"category\":\"Mail\"}'\r\n\t\t\t\t\t\t\t  type=\"button\" title=\"Hide Mail\"></span>\r\n\t\t\t\t\t\t<span class=\"svg-icon NewsLighter\"\r\n\t\t\t\t\t\t\t  style=\"width: 2rem;height: 2rem;\"\r\n\t\t\t\t\t\t\t  data-info='{\"nodeId\":160,\"toggle\":true,\"greyIconClassName\":\"NewsGrey\",\"lighterIconClassName\":\"NewsLighter\",\"category\":\"News\"}'\r\n\t\t\t\t\t\t\t  type=\"button\" title=\"Hide News\"></span>\r\n\t\t\t\t\t<i class=\"info-icon-close text-xl fw-bold\" type=\"button\"></i>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"desktop-panel-list row g-3\">\r\n\r\n<style>\r\n\t#accordionInboxEvent #datepicker {\r\n\t\tfont-size: 14px;\r\n\t}\r\n\r\n\t#datepicker .ui-widget-content {\r\n\t\tbox-shadow: none;\r\n\t}\r\n\r\n\t#accordionInboxEvent #datepicker .ui-datepicker-inline.ui-datepicker {\r\n\t\tborder: none;\r\n\t\tborder-radius: 10px;\r\n\t\tpadding: 5px 10px;\r\n\t\tbackground-color: var(--csi-list-event-card-datepicker-bg);\r\n\t}\r\n\r\n\t#accordionInboxEvent #datepicker .ui-datepicker-header {\r\n\t\tdisplay: none\r\n\t}\r\n\r\n\t#accordionInboxEvent #datepicker .ui-datepicker {\r\n\t\twidth: auto\r\n\t}\r\n\r\n\t\t#accordionInboxEvent #datepicker .ui-datepicker .ui-datepicker-header {\r\n\t\t\tpadding: .2em 0;\r\n\t\t\tposition: relative\r\n\t\t}\r\n\r\n\t\t#accordionInboxEvent #datepicker .ui-datepicker table {\r\n\t\t\tborder-collapse: collapse;\r\n\t\t\twidth: 100%\r\n\t\t}\r\n\r\n\t\t#accordionInboxEvent #datepicker .ui-datepicker th {\r\n\t\t\tborder: 0;\r\n\t\t\tfont-weight: 700;\r\n\t\t\tpadding: 4px;\r\n\t\t\ttext-align: center\r\n\t\t}\r\n\r\n\t\t\t#accordionInboxEvent #datepicker .ui-datepicker th span,\r\n\t\t\t#accordionInboxEvent #datepicker .ui-datepicker td a,\r\n\t\t\t#accordionInboxEvent #datepicker .ui-datepicker td span {\r\n\t\t\t\ttext-decoration: none;\r\n\t\t\t\tcolor: var(--csi-body-color) !important;\r\n\t\t\t}\r\n\r\n\t\t#accordionInboxEvent #datepicker .ui-datepicker .ui-datepicker-today a {\r\n\t\t\tbackground-color: var(--csi-list-event-card-datepicker-today-bg);\r\n\t\t\tcolor: var(--csi-list-event-card-datepicker-today-color) !important;\r\n\t\t}\r\n\r\n\t\t#accordionInboxEvent #datepicker .ui-datepicker .ui-datepicker-current-day a {\r\n\t\t\tbackground-color: var(--csi-list-event-card-datepicker-current-day-bg);\r\n\t\t\tcolor: var(--csi-list-event-card-datepicker-current-day-color) !important;\r\n\t\t}\r\n\r\n\t#accordionInboxEvent #datepicker .ui-state-default {\r\n\t\tbackground: none;\r\n\t\tborder: none;\r\n\t\tborder-radius: 50%;\r\n\t\twidth: 25px;\r\n\t\theight: 25px;\r\n\t\tposition: relative;\r\n\t\ttext-align: center;\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: center;\r\n\t\talign-items: center;\r\n\t\tmargin: 2px;\r\n\t}\r\n\r\n\t#accordionInboxEvent #datepicker a.point:after {\r\n\t\tbackground-color: var(--csi-info);\r\n\t\tborder-radius: 50%;\r\n\t\tcontent: \"\";\r\n\t\theight: 4px;\r\n\t\tleft: 50%;\r\n\t\tposition: absolute;\r\n\t\ttop: 88%;\r\n\t\ttransform: translate(-50%, -50%);\r\n\t\twidth: 4px\r\n\t}\r\n\r\n\t.event-item {\r\n\t\tdisplay: grid;\r\n\t\tgrid-template-columns: 100px 1fr;\r\n\t\tgrid-template-areas: \"c1 c2\" \"c1 c3\" \"c1 c4\";\r\n\t\talign-items: center;\r\n\t\tpadding: 5px 0;\r\n\t}\r\n\r\n\t.event-time-range {\r\n\t\tgrid-area: c1;\r\n\t\ttext-align: left;\r\n\t\tmargin-right: 10px;\r\n\t\tpadding: 3px 6px;\r\n\t\tborder-radius: 5px;\r\n\t\tbackground-color: light-dark(#E4E6EA,rgba(206, 212, 218, 0.25));\r\n\t}\r\n\r\n\t.event-type {\r\n\t\tgrid-area: c2;\r\n\t\ttext-align: left;\r\n\t}\r\n\r\n\t.event-title {\r\n\t\tgrid-area: c3;\r\n\t\ttext-align: left;\r\n\t\ttext-decoration: underline;\r\n\t}\r\n\r\n\t.case-no {\r\n\t\tgrid-area: c4;\r\n\t\ttext-align: left;\r\n\t\ttext-decoration: underline;\r\n\t}\r\n</style>\r\n<div class=\"col-6 \"\r\n\t data-panel-category=\"Event\"\r\n\t data-panel-code=\"Event\">\r\n\t<div id=\"accordionInboxEvent\" class=\"card border\" x-data=\"eventData\">\r\n\t\t<div class=\"card-header bg-body-secondary\">\r\n\t\t\t<div class=\"d-flex align-items-center gap-2\">\r\n\t\t\t\t<span class=\"svg-icon EventLighter icon-sizes-3\"></span>\r\n\t\t\t\t<a class=\"more-link text-lg link-body-emphasis text-uppercase fw-bold m-0 text-decoration-none text-body me-auto\" href=\"/RMS/AspSoft/Event/MyCalendarV2?nextPID=MyCalendarV2\">\r\n\t\t\t\t\tWednesday, July 29, 2026\r\n\t\t\t\t</a>\r\n\t\t\t\t<span class=\"badge rounded-pill ms-auto\" x-text=\"count\" x-bind:data-value=\"count\">\r\n\t\t\t\t</span>\r\n\t\t\t\t<a class=\"collapse-trigger collapsed text-decoration-none text-body-tertiary\" data-bs-toggle=\"collapse\"\r\n\t\t\t\t   href=\"#collapseInboxEvent\"\r\n\t\t\t\t   role=\"button\">\r\n\t\t\t\t\t<i class=\"info-icon-arrow_down\"></i>\r\n\t\t\t\t</a>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t<div id=\"collapseInboxEvent\" class=\"accordion-collapse collapse\"\r\n\t\t\t data-bs-parent=\"#accordionInboxEvent\">\r\n\t\t\t<div class=\"card-body border-0 bg-body-tertiary\">\r\n\t\t\t\t<div class=\"row h-100\">\r\n\t\t\t\t\t<div class=\"col h-100 overflow-y-auto\">\r\n\t\t\t\t\t\t<template x-if=\"data.length>0\">\r\n\t\t\t\t\t\t\t<ul class=\"list-group\">\r\n\t\t\t\t\t\t\t\t<template x-for=\"item in data\">\r\n\t\t\t\t\t\t\t\t\t<li class=\"event-item list-group-item py-1 border-0 fw-semibold\">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"event-time-range text-xs\" x-html=\"item.eventDatetime\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"event-type text-sm text-body-tertiary text-truncate\" x-text=\"item.eventType\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"event-title text-sm text-primary text-truncate\" role=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t x-on:click='editEvent(item.eventId,item.caseId,item.eventStage,item.eventCategory);return false;'\r\n\t\t\t\t\t\t\t\t\t\t\t x-text=\"item.eventTitle\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"case-no text-sm text-primary text-truncate\" role=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t x-on:click=\"gotoCase(item.caseId)\"\r\n\t\t\t\t\t\t\t\t\t\t\t x-text=\"item.caseNo\"></div>\r\n\t\t\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t\t</template>\r\n\t\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t\t</template>\r\n\t\t\t\t\t\t<template x-if=\"data.length == 0\">\r\n\t\t\t\t\t\t\t<div class=\"h-100 w-100 d-flex justify-content-center align-items-center\">\r\n\t\t\t\t\t\t\t\t<span class=\"svg-icon icon-empty opacity-40\"></span>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</template>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"col-auto\">\r\n\t\t\t\t\t\t<div id=\"datepicker\"></div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n<script>\r\n\t$(function() {\r\n\t\tconst myCollapsible = document.getElementById('collapseInboxEvent')\r\n\t\tmyCollapsible.addEventListener('shown.bs.collapse', () => {\r\n\t\t\t$(\"#accordionInboxEvent\").find(\".card-header .more-link\").removeClass(\"text-decoration-none\");\r\n\t\t})\r\n\t\tmyCollapsible.addEventListener('hidden.bs.collapse', () => {\r\n\t\t\t$(\"#accordionInboxEvent\").find(\".card-header .more-link\").addClass(\"text-decoration-none\");\r\n\t\t})\r\n\t\t$(\"#allMessage\").on(\"mouseleave\",function () {\r\n\t\t\t$(this).hide();\r\n\t\t})\r\n\t})\r\n\tdocument.addEventListener(\"alpine:init\", () => {\r\n\t\tAlpine.data(\"eventData\", () => ({\r\n\t\t\tdata: [],\r\n\t\t\tcurrentDate: \"2026-07-29\",\r\n\t\t\teventDateRangeInfo:[{\"eventStartDay\":7,\"eventEndDay\":9},{\"eventStartDay\":7,\"eventEndDay\":6},{\"eventStartDay\":7,\"eventEndDay\":6}],\r\n\t\t\tget count(){\r\n\t\t\t\treturn this.data.length;\r\n\t\t\t},\r\n\t\t\tinit() {\r\n\t\t\t\t$(\"#datepicker\").datepicker({\r\n\t\t\t\t\tdayNamesMin: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],\r\n\t\t\t\t\tonSelect: async (selectedDate) => {\r\n\t\t\t\t\t\tthis.currentDate = selectedDate;\r\n\t\t\t\t\t\tawait this.updateEvent();\r\n\t\t\t\t\t}\r\n\t\t\t\t})\r\n\t\t\t\tthis.autoCount();\r\n\t\t\t},\r\n\t\t\tautoCount() {\r\n\t\t\t\tconst eventDateRangeInfo = this.eventDateRangeInfo;\r\n\t\t\t\t$(\"table[class=ui-datepicker-calendar]\").find(\"a\").each(function () {\r\n\t\t\t\t\t$(this).closest(\"td\").find(\"div\").remove();\r\n\t\t\t\t\tvar isHaveCount = 0;\r\n\t\t\t\t\tvar day = $(this).text();\r\n\t\t\t\t\t$.each(eventDateRangeInfo, function (i, item) {\r\n\t\t\t\t\t\tvar startDate = item.eventStartDay;\r\n\t\t\t\t\t\tvar endDate = item.eventEndDay;\r\n\t\t\t\t\t\tif (day >= startDate && day <= endDate) {\r\n\t\t\t\t\t\t\tisHaveCount = 1;\r\n\t\t\t\t\t\t\treturn;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\tif (isHaveCount == 1) {\r\n\t\t\t\t\t\t$(this).addClass(\"point\");\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\t$(this).removeClass(\"point\");\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t},\r\n\t\t\tasync updateEvent() {\r\n\t\t\t\tconst url = \"/RMS/AspSoft/HomeHandler/GetStaffEventListByDate\" + \"?date=\" + this.currentDate;\r\n\t\t\t\tconst response = await fetch(url);\r\n\t\t\t\tif (response.ok) {\r\n\t\t\t\t\tconst data = await response.json()\r\n\t\t\t\t\tthis.data = data.eventListByDate;\r\n\t\t\t\t\tthis.eventDateRangeInfo = data.eventDateRangeInfo;\r\n\t\t\t\t\tthis.autoCount();\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\tgotoCase(case_id){\r\n\t\t\t\tvar url = ResolveClientUrl(\"~/\") + 'AspSoft/Dispatcher?nextPID=inquireCaseInvestigation&case_id=' + case_id;\r\n\t\t\t\tlocation.href = url\r\n\t\t\t},\r\n\t\t\teditEvent(event_id, case_id, event_stage, event_category) {\r\n\t\t\t\tconst self = this;\r\n\t\t\t\tif (case_id)\r\n\t\t\t\t{\r\n\t\t\t\t\tPopUp(ResolveClientUrl(\"~/\") + 'AspSoft/popupdispatcher?case_id=' + case_id + '&id_type=CASE_INFO&show_type=CASE&event_id=' + event_id + '&nextPID=updateCaseEvent&parentPID=CaseCalendar', 950, 750, \"\", function (retObj)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif (retObj != null)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tself.updateEvent();\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tif (event_stage == \"PERSONAL\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tPopUp(ResolveClientUrl(\"~/\") + 'AspSoft/popupdispatcher?nextPID=updateMyEvent&parentPID=MyCalendarV2&event_id=' + event_id, 950, 750, \"\", function (retObj)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tif (retObj != null)\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tself.updateEvent();\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tPopUp(ResolveClientUrl(\"~/\") + 'AspSoft/Event/StaffEvent?event_id=' + event_id + '&nextPID=updateStaffEvent&parentPID=StaffCalendarV2', 950, 750, \"\", function (retObj)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tif (retObj != null)\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tself.updateEvent();\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}))\r\n\t})\r\n</script>\r\n\r\n<style>\r\n\t#accordionInboxMail .dropdown-menu {\r\n\t\t--csi-dropdown-link-active-color: var(--csi-body-color);\r\n\t\t--csi-dropdown-link-active-bg: rgb(var(--csi-secondary-bg-rgb));\r\n\t\t--csi-dropdown-link-hover-bg: rgb(var(--csi-secondary-bg-rgb))\r\n\t}\r\n\r\n\t#accordionInboxMail .mail-content {\r\n\t\ttext-align: left;\r\n\t\tmax-height: 40px;\r\n\t\tline-height: 20px;\r\n\t\tdisplay: -webkit-box;\r\n\t\t-webkit-line-clamp: 2;\r\n\t\toverflow: hidden;\r\n\t\ttext-overflow: ellipsis;\r\n\t\t-webkit-box-orient: vertical;\r\n\t}\r\n\r\n\t#accordionInboxMail .item-notification {\r\n\t\tposition: relative\r\n\t}\r\n\r\n\t#accordionInboxMail .item-notification:before {\r\n\t\tbackground-color: var(--csi-danger);\r\n\t\tborder-radius: 50%;\r\n\t\tcontent: \"\";\r\n\t\twidth: .5rem;\r\n\t\theight: .5rem;\r\n\t\tleft: -11px;\r\n\t\tposition: absolute;\r\n\t\ttop: 0.75rem;\r\n\t\ttransform: translateY(-50%);\r\n\t}\r\n</style>\r\n<div class=\"col-6 \"\r\n\t data-panel-category=\"Mail\"\r\n\t data-panel-code=\"Mail\">\r\n\t<div id=\"accordionInboxMail\" class=\"card border\" x-data=\"mailData\">\r\n\t\t<div class=\"card-header bg-body-secondary\">\r\n\t\t\t<div class=\"d-flex align-items-center gap-2\">\r\n\t\t\t\t<span class=\"svg-icon MailLighter icon-sizes-3\"></span>\r\n\t\t\t\t<a class=\"more-link text-lg link-body-emphasis text-uppercase fw-bold m-0 text-decoration-none me-auto\" href=\"/RMS/AspSoft/Dispatcher?nextPID=listInfoMail\">\r\n\t\t\t\t\tMail\r\n\t\t\t\t</a>\r\n\t\t\t\t<span class=\"badge rounded-pill ms-auto\" x-text=\"unReadCount\" x-bind:data-value=\"unReadCount\">\r\n\t\t\t\t</span>\r\n\t\t\t\t<a class=\"collapse-trigger collapsed text-decoration-none\" data-bs-toggle=\"collapse\"\r\n\t\t\t\t   href=\"#collapseInboxMail\"\r\n\t\t\t\t   role=\"button\">\r\n\t\t\t\t\t<i class=\"info-icon-arrow_down\"></i>\r\n\t\t\t\t</a>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t<div id=\"collapseInboxMail\" class=\"accordion-collapse collapse\"\r\n\t\t\t data-bs-parent=\"#accordionInboxMail\">\r\n\t\t\t<div class=\"card-body border-0 bg-body-tertiary overflow-y-auto\">\r\n\t\t\t\t<template x-if=\"data.length>0\">\r\n\t\t\t\t\t<ul class=\"list-group\">\r\n\t\t\t\t\t\t<template x-for=\"item in data\">\r\n\t\t\t\t\t\t\t<li class=\"list-group-item p-0 border-0 mb-2\" x-bind:class=\"{'item-notification':!item.isRead}\">\r\n\t\t\t\t\t\t\t\t<div class=\"row\">\r\n\t\t\t\t\t\t\t\t\t<div class=\"col\" style=\"min-width: 0;\">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"mail-title fw-bold text-truncate\" x-text=\"item.title\"></div>\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"text-sm\">\r\n\t\t\t\t\t\t\t\t