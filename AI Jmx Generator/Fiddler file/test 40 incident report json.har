Token\", \"eyJhbGciOiJodHRwOi8vd3d3LnczLm9yZy8yMDAxLzA0L3htbGRzaWctbW9yZSNobWFjLXNoYTI1NiIsInR5cCI6IkpXVCJ9.eyJodHRwOi8vc2NoZW1hcy54bWxzb2FwLm9yZy93cy8yMDA1LzA1L2lkZW50aXR5L2NsYWltcy9uYW1laWRlbnRpZmllciI6IjEiLCJuYmYiOjE3ODUzMDQ4NzYsImV4cCI6MTc4NTM5MTI3NiwiaXNzIjoiQ1NJSW5mb1NoYXJlIiwiYXVkIjoiSW5mb1JNU01hcHBpbmcifQ.PCCLNlCY0onZQPRtarr7Y6inEcTQZpdWHvjvCLAysoI\");\r\n    sessionStorage.setItem(\"MappingKey\", \"InfoVMcTH8d8qNANFsK2U40BjNwSrsLdtvJAOE48xIvXrPaRel2R\");\r\n    sessionStorage.setItem(\"MappingService\", \"https://parms42test.csitech.com/InfoMapping\");\r\n    sessionStorage.setItem(\"QueryConditions\", \"[{&quot;Name&quot;:&quot;local&quot;,&quot;Enabled&quot;:true,&quot;Count&quot;:10},{&quot;Name&quot;:&quot;azure&quot;,&quot;Enabled&quot;:true,&quot;Count&quot;:5}]\");\r\n    sessionStorage.setItem(\"QueryAddressRegion\", \"39.7214,-76.4402,40.7874,-74.7215\");\r\n    sessionStorage.setItem(\"staffRegionId\", \"100000\");\r\n</script>\r\n<script type=\"text/javascript\" src=\"https://parms42test.csitech.com/InfoMapping/bundles/map-sdk.js\"></script>\r\n<link type=\"text/css\" href=\"https://parms42test.csitech.com/InfoMapping/bundles/map-sdk.css\" rel=\"stylesheet\"/>\r\n<script src=\"/RMS/infomapping/crimemapping/js/location-mapping.js?v=c8ltvf2NjiXEU2jb8hFM39sH9w0nIC4gyzfeLJDsI30\"></script>\r\n\t<script defer src=\"/RMS/lib/alpinejs-sort/cdn.min.js?v=tFKFh4yWJOYN69Holh9DDjSctbLmWsWgHQLDroJAnjw\"></script>\r\n\t<script defer src=\"/RMS/lib/alpinejs/cdn.min.js?v=4EHxtjnR5rL8JzbY12OKQJr81ESm7JBEb49ORPo29AY\"></script>\r\n\t\r\n\t<script src=\"/RMS/lib/jquery.Observe.js?v=1OkU-ikLTC8G_vhW97spSv3vuEU11oMavrAd4gEiPjQ\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/jquery.maskedinput.js?v=KfM1b1r69sNxKEzlcNUfS6ETLt-Du5Dbx-xrDCi3oNE\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/jquery.blockUI.js?v=4tEFtRVrLfKuSrqWVi7j6GtBCjipd5BMwWzkLcurZ3s\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/jquery.metadata.js?v=pcsBJulryiNXnIX9HvSMHaNlE6R0J0k6yQRaS10Amb0\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/jquery.validate.js?v=SzI2JVW8jIqk05XvKPEVx47yjrx0E6m8qkmVrgbdPXQ\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/jquery-ui-timepicker-addon.js?v=BhR06TjCn-QeBkVjs0_m0-oi7CD5-cjk0yJuGj0mRfY\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/jquery.editable-select.js?v=egjS-ZAy2zdwtUUR0qz10yFeqlyhmQ6puk3FdX9A_NQ\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/jquery.spellchecker.js?v=K1cTGIHPRuea-9ffS_-LR-zxl-6mY-KRFmR0RcXt7II\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/textarea.spellchecker.js?v=--aFRtOys_Z1kW3qPmmd2be8gFs8JNMnNKAjm21lXGA\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/Utility.js?v=Gnw6g5DIS21msaaNeMQgV7VrLZGnrnen8C5edn22ZIk\"></script>\r\n\t<script src=\"/RMS/js/IntakeForm/intake.js?v=HT9ayPnfVbSQRVJsOGFE-qOsvREOPlXqAAWxU6Dqy70\"></script>\r\n\r\n\t<!--start of webpage-append--><script type=\"text/javascript\" language=\"javascript\">$(function ()\n{\n\tvar token = $('input[name=\"__RequestVerificationToken\"]').val();\n\t$(\":button[workflow=1]\").on('click', function ()\n\t{\n\t\tvar ids = \"\";\n\t\t$(\":checkbox:checked[ObjectName=report_id]\").each(function ()\n\t\t{\n\t\t\tids += $(this).val() + \",\";\n\t\t});\n\t\tif (ids == \"\")\n\t\t{\n\t\t\talert(\"Please select at least one record.\");\n\t\t\treturn;\n\t\t}\n\n\t\tvar $sender = $(this);\n\t\t$sender.prop('disabled', true);\n\t\tShowWaitBox()\n\n\t\t$.ajax({\n\t\t\turl: ResolveClientUrl(\"/Aspsoft/IntakeForm/Intake\"),\n\t\t\ttype: 'POST',\n\t\t\tdata: {\n\t\t\t\taction: \"auto_batch_confirm\",\n\t\t\t\treport_ids: ids,\n\t\t\t\trnd: Math.random()\n\t\t\t},\n\t\t\theaders: {\n\t\t\t\t\"RequestVerificationToken\": token\n\t\t\t},\n\t\t\tsuccess: function (result)\n\t\t\t{\n\t\t\t\tif (result == \"OK\")\n\t\t\t\t{\n\t\t\t\t\tvar url = ResolveClientUrl(\"/Aspsoft/IntakeForm/IntakeReportAssignWorkflow\");\n\t\t\t\t\tvar popupData = {\n\t\t\t\t\t\tnextPID: \"updateReportWorkflowBatch\",\n\t\t\t\t\t\treport_ids: ids,\n\t\t\t\t\t\trnd: Math.random()\n\t\t\t\t\t};\n\n\t\t\t\t\tvar popupUrl = url + \"?\" + $.param(popupData);\n\t\t\t\t\tPopUp(popupUrl, 900, 600, null, function (res)\n\t\t\t\t\t{\n\t\t\t\t\t\tif (res == undefined)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t$.ajax({\n\t\t\t\t\t\t\t\turl: ResolveClientUrl(\"/Aspsoft/IntakeForm/Intake\"),\n\t\t\t\t\t\t\t\ttype: 'POST',\n\t\t\t\t\t\t\t\tdata: {\n\t\t\t\t\t\t\t\t\treport_ids: ids,\n\t\t\t\t\t\t\t\t\taction: \"cancel_batch_confirm\",\n\t\t\t\t\t\t\t\t\trnd: Math.random()\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\theaders: {\n\t\t\t\t\t\t\t\t\t\"RequestVerificationToken\": token\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\tsuccess: function (result)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\twindow.location.reload();\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\terror: function (xhr, status, error)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tconsole.error(\"Cancel batch confirm failed: \" + status + \", \" + error);\n\t\t\t\t\t\t\t\t\twindow.location.reload();\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\twindow.location.reload();\n\t\t\t\t\t\t}\n\t\t\t\t\t});\n\t\t\t\t}\n\t\t\t\telse\n\t\t\t\t{\n\t\t\t\t\t$sender.prop('disabled', false);\n\t\t\t\t\talert(result); //error message\n\t\t\t\t}\n\t\t\t\tHideWaitBox();\n\t\t\t},\n\t\t\terror: function (xhr, status, error)\n\t\t\t{\n\t\t\t\tconsole.error(\"Auto batch confirm failed: \" + status + \", \" + error);\n\t\t\t\t$sender.prop('disabled', false);\n\t\t\t\tHideWaitBox();\n\t\t\t\talert(\"Request failed: \" + error);\n\t\t\t}\n\t\t});\n\n\t});\n});\n\n$(function ()\r\n{\n\n\tvar $right_side = $(\"input[objectname='right_side_case_no']\");\n\tif ($right_side)\n\t{\n\t\t$right_side.css(\"width\", \"19pt\").css(\"height\", \"140pt\");\n\t\t$right_side.parent(\"div\").css(\"width\", \"19pt\").css(\"height\", \"143pt\");\n\t\t$right_side.css(\"-ms-layout-flow\", \"vertical-ideographic\");\n\t\t$right_side.closest(\"td\").css(\"width\", \"150pt\").css(\"height\", \"155pt\");\n\t}\n\tvar $right_side1 = $(\"span[original_bookmark_name='right_side_case_no']\");\n\tif ($right_side1)\n\t{\n\t\t//$right_side1.css(\"width\",\"19pt\").css(\"height\",\"140pt\");\n\t\t$right_side1.closest(\"p\").css(\"width\", \"19pt\").css(\"height\", \"143pt\");\n\t\t//$right_side1.css(\"-ms-layout-flow\",\"vertical-ideographic\"); \n\t\t$right_side1.closest(\"td\").css(\"width\", \"150pt\").css(\"height\", \"155pt\");\n\t}\n\n\tvar $file_num1 = $(\"span[original_bookmark_name='sequential_file_num']\");\n\tif ($file_num1)\n\t{\n\t\t//$file_num1.css(\"width\",\"19pt\").css(\"height\",\"140pt\");\n\t\t$file_num1.closest(\"p\").css(\"width\", \"19pt\").css(\"height\", \"143pt\");\n\t\t// $file_num1.css(\"-ms-layout-flow\",\"vertical-ideographic\"); \n\t\t$file_num1.closest(\"td\").css(\"width\", \"150pt\").css(\"height\", \"155pt\");\n\t}\n\n\n\tvar $file_num = $(\"input[objectname='sequential_file_num']\");\n\tif ($file_num)\n\t{\n\t\t$file_num.css(\"width\", \"19pt\").css(\"height\", \"140pt\");\n\t\t$file_num.parent(\"div\").css(\"width\", \"19pt\").css(\"height\", \"143pt\");\n\t\t$file_num.css(\"-ms-layout-flow\", \"vertical-ideographic\");\n\t\t$file_num.closest(\"td\").css(\"width\", \"150pt\").css(\"height\", \"155pt\");\n\t}\n\n\tvar $casenumberimg = $(\"img[src^='data']\");\n\tif ($casenumberimg.length > 0 && \"RMS_PENNSYLVANIA_ACCIDENT_REPORT\" != \"RMS_INCIDENTREPORT\")\n\t{\n\t\t$casenumberimg.hide();\n\t}\n});\n\n\r\nfunction ReopenCheck(document_id, case_id)\r\n{\r\n\tvar url = ResolveClientUrl('~/Include/CommonModule/Remote');\r\n\t$.ajax({\r\n\t\turl: url,\r\n\t\tdata: {\r\n\t\t\taction: \"RMS_REOPEN_PERMISSION\",\r\n\t\t\tdocument_id: document_id,\r\n\t\t\tcase_id: case_id,\r\n\t\t\trnd: Math.random()\r\n\t\t},\r\n\t\tsuccess: function (data)\r\n\t\t{\r\n\t\t\tif (data && data.length>0 && data[0].warning != \"\") // 05/19/2026, DKQI, WO#343757\r\n\t\t\t{\r\n\t\t\t\talert(data[0].warning);\r\n\t\t\t\tlocation.reload();\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tPopUp(ResolveClientUrl(\"/aspsoft/popupdispatcher?nextPID=updateReport_Reopen&document_id=\" + document_id + \"&case_id=\" + case_id), 750, 500, \"RELOAD\");\r\n\t\t\t}\r\n\t\t},\r\n\t\tdataType: 'json',\r\n\t\tasync: false\r\n\t});\r\n\r\n\treturn false;\r\n}</script>\r\n<!--end of webpage-append-->\r\n<script>let multisectionJson = null; try{multisectionJson=[{\"multisection\":\"multisection_njs\",\"DataArray\":[{\"call_type\":\"BAC .02 or Higher - 4th Off or Sub Off\",\"njs_code\":\"1543 B1.1III*\"},{\"call_type\":\"Incest of Minor - Complainant 13-18 Years\",\"njs_code\":\"4302 B2\"}]},{\"multisection\":\"multisection_2\",\"DataArray\":[{\"OTHER_CODE\":\"\",\"OTHER_NAME\":\"\",\"OTHER_ADDRESS\":\"\",\"OTHER_DOB\":\"\",\"OTHER_AGE\":\"\",\"OTHER_SEX\":\"\",\"OTHER_HM\":\"\",\"OTHER_WK\":\"\",\"OTHER_C\":\"\"}]},{\"multisection\":\"multisection_3\",\"DataArray\":[{\"OTHER_CODE2\":\"\",\"OTHER_YEAR\":\"\",\"OTHER_MAKE\":\"\",\"OTHER_MODEL\":\"\",\"OTHER_TYPE\":\"\",\"OTHER_COLOR\":\"\",\"OTHER_DESCRIPTION\":\"\"}]}];} catch(e) { }</script>\n<script>let __textarea_hide_spelling_check='1'</script>\r\n\t<script>\r\n\t\t$(function ()\r\n\t\t{\r\n\t\t\t//***************** handle day/night ui script *****************\r\n\t\t\t//(1) handle day/night icon\r\n\t\t\t$(\"#themeSwitch\").on(\"change\",function ()\r\n\t\t\t{\r\n\t\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/EngineService/UpdateDayNight\") + '?rn=' + Math.random() + '';\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: url,\r\n\t\t\t\t\tsuccess: () => {\r\n\t\t\t\t\t\t// window.location.reload()\r\n\t\t\t\t\t\tdocument.querySelector(\"html\")\r\n\t\t\t\t\t\t\t.setAttribute(\"data-csi-theme\", this.checked ? \"dark\" : \"light\");\r\n\t\t\t\t\t\tdocument.querySelector(\"body\").classList\r\n\t\t\t\t\t\t\t.remove(\"nightmode_none\",\"nightmode\")\r\n\t\t\t\t\t\tdocument.querySelector(\"body\").classList\r\n\t\t\t\t\t\t\t.add(this.checked ? \"nightmode\" : \"nightmode_none\");\r\n\t\t\t\t\t\t__is_night_mode = this.checked ? \"1\" : \"0\";\r\n\t\t\t\t\t\tif (typeof RefreshAllRichTextBoxThemes === 'function')\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tRefreshAllRichTextBoxThemes();\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\tconst channel = new BroadcastChannel(\"nightmode\");\r\n\t\t\t\t\t\tchannel.postMessage({\r\n\t\t\t\t\t\t\ttype: \"update-night-mode\",\r\n\t\t\t\t\t\t\tisNightMode: __is_night_mode\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\treturn false;\r\n\t\t\t});\r\n\r\n\t\t\t//(2) special script\r\n\t\t\tvar currentPageID = queryString(document.location.href, \"nextPID\");\r\n\t\t\tif (__is_night_mode == 1)\r\n\t\t\t{\r\n\t\t\t\t//switch day/night icon\r\n\t\t\t\t$(\"#imgDNMode\").attr(\"src\", ResolveClientUrl(\"~/images/icon_nightmode.png\"));\r\n\t\t\t\t//left side inbox/menu icon\r\n\t\t\t\t$(\"#inbox_menu_text\").attr(\"src\", ResolveClientUrl(\"~/images/icon_night_inbox.png\"));\r\n\t\t\t\t$(\"#popup_menu_text\").attr(\"src\", ResolveClientUrl(\"~/images/icon_night_menu.png\"));\r\n\t\t\t\t//list icon\r\n\t\t\t\t$(\"table.gridview_navigation\").find(\"select[name$='ddlPageSize']\").parent().find(\"img\").each(function (idx, oo)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(oo).attr(\"src\", $(oo).attr(\"src\").replace(\".png\", \"_night.png\"));\r\n\t\t\t\t});\r\n\t\t\t\t//home icon\r\n\t\t\t\t$(\"#imgHome\").attr(\"src\", ResolveClientUrl(\"~/images/Icon_home_key_night.png\"));\r\n\r\n\t\t\t\t//dropcheck button\r\n\t\t\t\t$(\"span.dropcheckbox\").prev(\":button[value='>>']\").css({ \"background-color\": \"#383838\", \"color\": \"#a5a7aa\", \"margin-left\": \"2px\" });\r\n\t\t\t}\r\n\r\n\t\t\t//(3) hide nav_table becuase it will use space row (maybe need adjuest the script if has other type element in this area)\r\n\t\t\tif ($(\"table.nav_table\").find(\":input\").length == 0 && $(\"table.nav_table\").find(\"div.search_condition\").length == 0)\r\n\t\t\t{\r\n\t\t\t\t$(\"table.nav_table\").hide();\r\n\t\t\t}\r\n\r\n\t\t\t//(4) gridview table style\r\n\t\t\t$(\"table.gridview_border\").removeAttr(\"style\").css({ \"border-collapse\": \"separate\" }).attr({ \"cellpadding\": \"0\", \"cellspacing\": \"0\" });\r\n\t\t\t$(\"table.gridview_table,table.gridview_table_embed\").attr({ \"cellspacing\": \"0\" });\r\n\t\t\t// ***************** handle day/night ui script end *****************\r\n\r\n\t\t\tif (window.parent.location.href.indexOf(\"Index\") > 0)\r\n\t\t\t{\r\n\t\t\t\t$(\"#lnkToHome\").attr(\"href\", ResolveClientUrl(\"~/Home\"));\r\n\t\t\t\t$(\"#imgAgencyLogo\").css({ \"cursor\": \"pointer\" });\r\n\t\t\t}\r\n\t\t});\r\n\t\tfunction changeDayNightModeCAD(isNight)\r\n\t\t{\r\n\t\t\tif (isNight == \"1\")\r\n\t\t\t{\r\n\t\t\t\t$(\"body\").removeClass(\"nightmode_none\").addClass(\"nightmode\");\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$(\"body\").removeClass(\"nightmode\").addClass(\"nightmode_none\");\r\n\t\t\t}\r\n\r\n\t\t\tvar siteNightMode = \"0\";\r\n\t\t\tif (isNight != siteNightMode)\r\n\t\t\t{\r\n\t\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/EngineService/UpdateDayNight\") + '?rn=' + Math.random() + '&force_day_night_type=' + (isNight == \"1\" ? \"night\" : \"day\");\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: url,\r\n\t\t\t\t\tsuccess: () => { }\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\t\tfunction RemoteLoginToePro(id)\r\n\t\t{\r\n\t\t\tvar ret = ExecServerMethod(\"POST\", ResolveClientUrl(\"~/AspSoft/EngineService/GetRemoteKey\") + \"?rnd=\" + Math.random());\r\n\t\t\tif (ret == \"true\" || ret == \"false\")\r\n\t\t\t{\r\n\t\t\t\talert(\"Single Sign On function is unavailable, please contact administrators.\");\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tvar guid = ret.substring(0, 32);\r\n\t\t\t\tvar url = ret.substring(33);\r\n\r\n\t\t\t\tvar tempForm = $(\"<form/>\");\r\n\t\t\t\ttempForm.attr(\"id\", \"dynRemoteForm\");\r\n\t\t\t\ttempForm.attr(\"action\", url + \"/Login?action=login_by_remote&guid=\" + guid);\r\n\t\t\t\ttempForm.attr(\"method\", \"post\");\r\n\t\t\t\ttempForm.attr(\"target\", \"_blank\");\r\n\r\n\t\t\t\tvar hldAction = $(\"s<input type=hidden name='action' value='login_by_remote'>\");\r\n\t\t\t\thldAction.appendTo(tempForm);\r\n\r\n\t\t\t\tvar hldGUIDInfo = $(\"<input type='hidden' name='guid' />\");\r\n\t\t\t\thldGUIDInfo.val(guid);\r\n\t\t\t\thldGUIDInfo.appendTo(tempForm);\r\n\r\n\t\t\t\ttempForm.appendTo($(\"body\"));\r\n\r\n\t\t\t\ttempForm.trigger(\"submit\");\r\n\t\t\t\ttempForm.remove();\r\n\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t\tfunction jumpTo(objJumpBase)\r\n\t\t{\r\n\t\t\tvar val = objJumpBase.value;\r\n\t\t\tif (val.replace(/ /g, \"\") == \"\")\r\n\t\t\t{\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tvar menuID = '1';\r\n\t\t\tvar nextPID = 'listPoliceReport';\r\n\t\t\tif (objJumpBase.value != '')\r\n\t\t\t{\r\n\t\t\t\tif (!validValueForSearch(val))\r\n\t\t\t\t{\r\n\t\t\t\t\tobjJumpBase.focus();\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\tvar url = ResolveClientUrl('~/AspSoft/JumpToList' + '?jump_base=' + encodeURIComponent(objJumpBase.value) + '&menu_id=' + menuID + '&nextPID=' + nextPID);\r\n\t\t\t\tPopUp(url + \"&rnd=\" + Math.random(), 800, 800, '', function (ret)\r\n\t\t\t\t{\r\n\t\t\t\t\tif (ret != null && ret != \"\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\turl = ResolveClientUrl('~/aspSoft/dispatcher' + '?jump_base=' + encodeURIComponent(objJumpBase.value) + '&' + ret + '');\r\n\t\t\t\t\t\twindow.location = url;\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfunction openPageWin()\r\n\t\t{\r\n\t\t\tvar nextPID = 'listPoliceReport';\r\n\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/Common/CaptionTab?pageID=\" + nextPID);\r\n\t\t\tPopUp(url, 800, 700, 'RELOAD');\r\n\t\t}\r\n\r\n\r\n\t\tif (''==\"1\"&&''==\"1\")\r\n\t\t{\r\n\t\t\t$(function ()\r\n\t\t\t{\r\n\t\t\t\tShowConcurrentLoginsTips();\r\n\t\t\t})\r\n\t\t}\r\n\r\n\t\tfunction ShowConcurrentLoginsTips()\r\n\t\t{\r\n\t\t\t$(\"#customOverlay, #customModal\").remove();\r\n\r\n\t\t\tvar $overlay = $(\"<div>\", {\r\n\t\t\t\tid: \"customOverlay\"\r\n\t\t\t}).css({\r\n\t\t\t\tposition: \"fixed\"