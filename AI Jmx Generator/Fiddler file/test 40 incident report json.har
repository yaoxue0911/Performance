XRNldFOsP7uok7z_rp-i1seqAJ29Vf_t05aljSzbv4MmGmjcxocHzgKxTs1M1DPyrA4Z3LcRCwJcnzcIBcXYVEjRq8EyiJ7YbVFLiz43W188_y5JHupSpqksQ1fg_T_ucjINIR-Keq_dwv6qypcRyokiu-yrG0ppXCvhVra77HXmk8YCit2lYiRJZgVmpwCfqLvjCQzSrTprOvBEz7MrlKJV8ZHVMcPt18fA2yeUdBieJ0aIsR06LanyUmwpmHdUZYXtlEDZLTBVuF-vgT4W5MdKCzuwnj5190_oRdWO5bEJbeEb0WygXGBaDPP7XhGWPT4Os3uGm9lvmlZjUkDu3KRuEqlBdj4eDEbyo2hEN40iXmuN7_u8u4_-moIh3a1rvqI_pW3IyeS96ZcvHC7u3hUQWLM0FhjDE6Qrbu8j4nKPlaaoWtN6Xp2A98g"}], "method":"GET", "httpVersion":"HTTP/1.1"}, "timings":{"blocked":-1, "ssl":0, "receive":0, "wait":266, "dns":0, "send":0, "connect":0}, "response":{"headersSize":278, "bodySize":3877, "statusText":"OK", "redirectURL":"", "status":200, "httpVersion":"HTTP/1.1", "cookies":[], "content":{"compression":0, "text":"//Leave Waring\r\nvar LeaveWaring = {\r\n\ttargetSelector: ':input:not([type=\"hidden\"]):not([nolw=\"1\"])',\r\n\tIngnoreCheck: false,\r\n\r\n\tFormObserve: function (opt)\r\n\t{\r\n\t\topt = $.extend({\r\n\t\t\tobj: document.forms[0],\r\n\t\t\tchangeClass: \"changed\",\r\n\t\t\tfilterExp: \"\",\r\n\t\t\tmsg: 'You have entered new data on this page and these changes will be lost.\\nReally continue?'\r\n\t\t}, opt || {});\r\n\r\n\t\tvar object = this;\r\n\t\tvar $form = $(opt.obj);\r\n\t\tvar clearObject = [];\r\n\r\n\t\tfunction beforeunload(e)\r\n\t\t{\r\n\t\t\tif (LeaveWaring.IngnoreCheck)\r\n\t\t\t{\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\tif (DataHasChanged())\r\n\t\t\t{\r\n\t\t\t\te = e || window.event;\r\n\t\t\t\tif (e) e.returnValue = opt.msg;\r\n\t\t\t\treturn opt.msg;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfunction DataHasChanged()\r\n\t\t{\r\n\t\t\tvar changed = false;\r\n\t\t\t$form.each(function ()\r\n\t\t\t{\r\n\t\t\t\tif (object.FormObserve_isChanged($(this).find(':input')))\r\n\t\t\t\t{\r\n\t\t\t\t\tchanged = true;\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\treturn changed;\r\n\t\t}\r\n\r\n\t\tfunction ObserveChange(node)\r\n\t\t{\r\n\t\t\tvar def = $.data(node.get(0), 'FormObserve_Def');\r\n\t\t\tvar currentVal = object.FormObserve_ifVal(node);\r\n\r\n\t\t\tif (currentVal === def)\r\n\t\t\t{\r\n\t\t\t\tif (opt.changeClass)\r\n\t\t\t\t{\r\n\t\t\t\t\tnode.removeClass(opt.changeClass);\r\n\t\t\t\t}\r\n\t\t\t\tclearObject = $.grep(clearObject, function (val) { return val != node; });\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tif (opt.changeClass)\r\n\t\t\t\t{\r\n\t\t\t\t\tnode.addClass(opt.changeClass);\r\n\t\t\t\t}\r\n\t\t\t\tclearObject.push(node);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t$form.each(function ()\r\n\t\t{\r\n\t\t\t//this.reset();\r\n\t\t\tobject.FormObserve_save($(this));\r\n\t\t});\r\n\r\n\t\tif (opt.changeClass)\r\n\t\t{\r\n\t\t\t$form.on(\"change input\", object.targetSelector, function ()\r\n\t\t\t{\r\n\t\t\t\tObserveChange($(this));\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\tvar isClear = false;\r\n\t\t$(\"input[objectName=reset_button]\").on(\"click\", function ()\r\n\t\t{\r\n\t\t\tisClear = true;\r\n\t\t\tif (opt.changeClass)\r\n\t\t\t{\r\n\t\t\t\t$.each(clearObject, function (index, value)\r\n\t\t\t\t{\r\n\t\t\t\t\tvalue.removeClass(opt.changeClass);\r\n\t\t\t\t})\r\n\t\t\t\tclearObject = [];\r\n\t\t\t}\r\n\t\t\tisClear = false;\r\n\t\t});\r\n\r\n\t\t$form.on('submit', function ()\r\n\t\t{\r\n\t\t\tvar $hdnWorkflowStatus = $(\"input[type='hidden'][id$='_case_intake_workflow_status']\");\r\n\t\t\tif ($hdnWorkflowStatus.length > 0)  //this is for special intake\r\n\t\t\t{\r\n\t\t\t\tvar lstHasData = false;\r\n\t\t\t\t/*var $lstTables = $(\"table.section_table\").find(\"table[objectname^='list']\");*/\r\n\t\t\t\tvar $lstTables = $(\"div.engine-legend table[objectname^='list']\");\r\n\t\t\t\tvar lstHasData = $lstTables.toArray().some(function (tbObj)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar $trs = $(tbObj).find(\"tr\");\r\n\t\t\t\t\treturn $trs.length >= 3 || ($trs.length >= 2 && $trs.eq(1).find(\"td\").length > 1); //the second row is multi TD\r\n\t\t\t\t});\r\n\r\n\t\t\t\tif (lstHasData || DataHasChanged())\r\n\t\t\t\t{\r\n\t\t\t\t\t$hdnWorkflowStatus.val('1');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\twindow.onbeforeunload = null;\r\n\t\t});\r\n\r\n\t\twindow.onbeforeunload = beforeunload;\r\n\t},\r\n\r\n\t//cache the original value\r\n\tFormObserve_save: function (obj)\r\n\t{\r\n\t\tvar node = $(obj);\r\n\t\tif (node.is('form'))\r\n\t\t{\r\n\t\t\tnode.find(LeaveWaring.targetSelector).each(function ()\r\n\t\t\t{\r\n\t\t\t\tLeaveWaring.FormObserve_save($(this));\r\n\t\t\t});\r\n\t\t}\r\n\t\telse if (node.is(':input[type!=hidden]')) // node.is(LeaveWaring.targetSelector)\r\n\t\t{\r\n\t\t\t$.data(node.get(0), 'FormObserve_Def', LeaveWaring.FormObserve_ifVal(node));\r\n\t\t}\r\n\t},\r\n\r\n\t//whether the value changed\r\n\tFormObserve_isChanged: function (obj)\r\n\t{\r\n\t\tvar changed = false;\r\n\t\t$(obj).filter(LeaveWaring.targetSelector).each(function ()\r\n\t\t{\r\n\t\t\tvar node = $(this);\r\n\t\t\tvar def = $.data(node.get(0), 'FormObserve_Def');\r\n\t\t\tif (typeof def !== 'undefined' && def !== LeaveWaring.FormObserve_ifVal(node))\r\n\t\t\t{\r\n\t\t\t\tchanged = true;\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t});\r\n\t\treturn changed;\r\n\t},\r\n\r\n\t//get the object value\r\n\tFormObserve_ifVal: function (obj)\r\n\t{\r\n\t\tvar $node = obj;\r\n\t\tvar r = null;\r\n\t\tif ($node.is(':radio,:checkbox'))\r\n\t\t{\r\n\t\t\tr = $node.prop('checked');\r\n\t\t}\r\n\t\telse if ($node.is(':input'))\r\n\t\t{\r\n\t\t\tr = $node.val();\r\n\t\t}\r\n\t\treturn r;\r\n\t}\r\n};\r\n\r\n", "size":3877, "mimeType":"text/javascript"}, "headers":[{"name":"Content-Type", "value":"text/javascript"}, {"name":"Last-Modified", "value":"Tue, 28 Jul 2026 12:31:15 GMT"}, {"name":"Accept-Ranges", "value":"bytes"}, {"name":"ETag", "value":"\"1dd1e8cfb3824a5\""}, {"name":"Vary", "value":"Accept-Encoding"}, {"name":"Server", "value":"Microsoft-IIS/10.0"}, {"name":"X-Powered-By", "value":"ASP.NET"}, {"name":"Date", "value":"Wed, 29 Jul 2026 06:04:16 GMT"}, {"name":"Content-Length", "value":"3877"}]}, "startedDateTime":"2026-07-29T14:04:16.9827635