set ID Reader\\\" style=\\\"cursor:pointer\\\" id=\\\"ResetIDReader\\\" />\");\r\n\r\n\t$(\"#IDReaderResetDiv\").dialog(\r\n\t{\r\n\t\ttitle: \"Reset ID Reader\",\r\n\t\twidth: 300,\r\n\t\theight: 100\r\n\t}).dialog(\"close\");\r\n\r\n\t$(\"#ResetIDReader\").on(\"click\", function ()\r\n\t{\r\n\t\t$(\"#IDReaderResetDiv\").dialog(\"open\");\r\n\t});\r\n\r\n\tif (CheckNewIDReader())\r\n\t{\r\n\t\t$(window).on(\"unload\", function ()\r\n\t\t{\r\n\t\t\tIDReader.close();\r\n\t\t});\r\n\t}\r\n\telse\r\n\t{\r\n\t\t$(\"#DeviceNotReady\").html(\"Please setup IDReader.\").show();\r\n\t}\r\n}\r\n\r\nfunction IDReaderConnect(obj)\r\n{\r\n\tIDReader.Connect(obj);\r\n}\r\n\r\nfunction IDReaderReConnect()\r\n{\r\n\tsetTimeout(\"IDReader.ReConnect()\", 1000);\r\n}\r\n\r\nvar _bindElementsDefault =\r\n{\r\n\t\"DAA\": \"full_name\",\r\n\t\"DAG\": \"street1\",\r\n\t\"DAI\": \"city\",\r\n\t\"DAJ\": \"state\",\r\n\t\"DAK\": \"zip\",\r\n\t\"DAQ\": \"driver_license\",\r\n\t\"DBA\": \"driver_license_expire_date\",\r\n\t\"DBB\": \"dob\",\r\n\t\"DBC\": \"sex\",\r\n\t\"DAU\": \"height\",\r\n\t\"DAY\": \"eye_color\",\r\n\t\"DAZ\": \"hair_color\",\r\n\t\"DAC\": \"first_name\",\r\n\t\"DAD\": \"middle_name\",\r\n\t\"DAJ\": \"driver_license_state\",\r\n\t\"DCS\": \"last_name\",\r\n\t\"DCT\": \"first_middle_name\",\r\n\t\"RBD\": \"last_name\",\r\n\t\"RBE\": \"first_name\",\r\n\t\"ZDB\": \"dob\",\r\n\t\"RBK\": \"city\",\r\n\t\"RBI\": \"street1\",\r\n\t\"NAR\": \"street1\",\r\n\t\"RBM\": \"zip\",\r\n\t\"NAV\": \"zip\"\r\n\t//\t,\r\n\t//\t\"RAM\": \"driver_license\"\r\n};\r\nfunction getWsUrlRoot()\r\n{\r\n\tvar wsUrlPrefix = \"ws://127.0.0.1:19999/\";\r\n\tif (navigator.userAgent != null\r\n\t\t&& navigator.userAgent.indexOf(\"Chrome\") == -1\r\n\t\t&& document.location.protocol == \"https:\")\r\n\t{//IE+https\r\n\t\twsUrlPrefix = \"wss://127.0.0.1:19998/\";\r\n\t}\r\n\treturn wsUrlPrefix;\r\n}\r\n\r\nfunction CheckTicketField()\r\n{\r\n\tif ($(\"input[objectname=no_registration]\").length > 0)\r\n\t{\r\n\t\t$(\"input[objectname=no_registration]\").attr(\"checked\", false).trigger(\"change\");\r\n\t\t$(\"input[objectname=registration_presented][value=Y]\").attr(\"checked\", true).trigger(\"change\");\r\n\t}\r\n\r\n\tif ($(\"input[objectname=no_driver_license]\").length > 0)\r\n\t{\r\n\t\t$(\"input[objectname=no_driver_license]\").attr(\"checked\", false).trigger(\"change\");\r\n\t\t$(\"input[objectname=license_presented][value=Y]\").attr(\"checked\", true).trigger(\"change\");\r\n\t}\r\n}\r\n\r\nfunction CheckNewIDReader()\r\n{\r\n\tIDReader = {\r\n\t\twebsocket: null,\r\n\t\t_enableClearData: true,\r\n\t\t_ResultOriginalALL: \"\",\r\n\t\t_bindElements: {},\r\n\t\t_timer: 0,\r\n\t\tIsGetElementInSeq: IDReader.IsGetElementInSeq,\r\n\t\t_checkPortCookie: true,\r\n\t\tInit: function ()\r\n\t\t{\r\n\t\t\tif ('WebSocket' in window)\r\n\t\t\t{\r\n\t\t\t\tthis.websocket = new WebSocket(getWsUrlRoot() + \"IDReaderService\");\r\n\r\n\t\t\t\t//call back when connect success\r\n\t\t\t\tthis.websocket.onopen = function (e)\r\n\t\t\t\t{\r\n\t\t\t\t\tconsole.log(\"WebSocket connect success\");\r\n\t\t\t\t\tconsole.log(e);\r\n\t\t\t\t};\r\n\r\n\t\t\t\t//call back when connetion closed\r\n\t\t\t\tthis.websocket.onclose = function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tconsole.log(\"WebSocket connection closed\");\r\n\t\t\t\t\t// re-connect if off line\r\n\t\t\t\t\t//initWebSocket();\r\n\t\t\t\t}\r\n\r\n\t\t\t\t//call back when connect error\r\n\t\t\t\tthis.websocket.onerror = function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tconsole.log(\"WebSocket connect error\");\r\n\t\t\t\t\t$(\"#DeviceNotReady\").html(\"Please setup IDReader.\").show();\r\n\t\t\t\t\t//$(\"#IDReaderResetDiv\").dialog(\"open\");\r\n\t\t\t\t};\r\n\r\n\t\t\t\t//call back when receive message\r\n\t\t\t\tthis.websocket.onmessage = function (e)\r\n\t\t\t\t{\r\n\t\t\t\t\t//console.log(\"received: \", e.data);\r\n\t\t\t\t\tvar result = JSON.parse(e.data);\r\n\t\t\t\t\tif (result.type == \"comport\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t//console.log(\"comport\");\r\n\t\t\t\t\t\tIDReader.InitComPort(result.value);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse if (result.type == \"scantext\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t//console.log(\"scantext\");\r\n\t\t\t\t\t\tIDReader.Read(result.value);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse if (result.type == \"connect\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t//console.log(\"connect\");\r\n\t\t\t\t\t\tIDReader.ConnectResult(result.value);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse if (result.type == \"close\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tconsole.log(\"Idreader close: \" + result.value);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tconsole.log(\"others\");\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tif (typeof (_IDReaderElements) != \"undefined\")\r\n\t\t\t\t{\r\n\t\t\t\t\tIDReader._bindElements = _IDReaderElements;\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tIDReader._bindElements = _bindElementsDefault;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tconsole.info(\"Browser Not support websocket\");\r\n\t\t\t\talert('Browser Not support websocket');\r\n\t\t\t}\r\n\t\t},\r\n\t\tConnectResult: function (text)\r\n\t\t{\r\n\t\t\tif (text != \"\")\r\n\t\t\t{\r\n\t\t\t\t$(\"#DeviceNotReady\").html(\"Device not ready.\").show();\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$(\"#DeviceNotReady\").hide();\r\n\t\t\t}\r\n\t\t\t//console.log('ConnectResult: ' + text);\r\n\t\t},\r\n\t\tClearData: function ()\r\n\t\t{\r\n\t\t\tfor (var i in this._bindElements)\r\n\t\t\t{\r\n\t\t\t\tvar input = $(\"input[objectname=\" + this._bindElements[i] + \"]\");\r\n\t\t\t\tvar select = $(\"select[objectname=\" + this._bindElements[i] + \"]\");\r\n\t\t\t\tif ($(input).length > 0)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(input).val(\"\");\r\n\t\t\t\t}\r\n\t\t\t\tif ($(select).length > 0)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(select).val(\"\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t},\r\n\t\tRead: function (text)\r\n\t\t{\r\n\t\t\tif (text != \"\")\r\n\t\t\t{\r\n\t\t\t\t$(\"#ComPort\").prop(\"disabled\", true);\r\n\t\t\t\t$(\"input[value=Connect]\").val(\"Reconnect\");\r\n\t\t\t\tconsole.log('get text: ' + text);\r\n\t\t\t\tthis._timer = 0;\r\n\t\t\t\tif (text != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tthis._ResultOriginalALL += text;\r\n\t\t\t\t\t//this.getall(ret);\r\n\t\t\t\t\tif (this._enableClearData)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tthis.ClearData();\r\n\t\t\t\t\t}\r\n\t\t\t\t\tthis._enableClearData = false;\r\n\r\n\t\t\t\t\tfor (var i in this._bindElements)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tthis.BindElement(this._ResultOriginalALL, i, this._bindElements[i]);\r\n\t\t\t\t\t}\r\n\t\t\t\t\tCheckTicketField();\r\n\r\n\t\t\t\t\tthis._ElementInSeq = 0;\r\n\t\t\t\t\tthis._RetTextLastIndex = 0;\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tthis._enableClearData = true;\r\n\t\t\t\t\tthis._ResultOriginalALL = \"\";\r\n\t\t\t\t\tthis._ElementInSeq = 0;\r\n\t\t\t\t\tthis._RetTextLastIndex = 0;\r\n\t\t\t\t}\r\n\t\t\t\t$(\"#DeviceNotReady\").hide();\r\n\t\t\t}\r\n\t\t},\r\n\t\tBindElementExt: IDReader.BindElementExt,\r\n\t\tBindElement: IDReader.BindElement,\r\n\t\tSetDropDown: IDReader.SetDropDown,\r\n\t\tSetVal: IDReader.SetVal,\r\n\t\tIsGetElementInSeq: false,\r\n\t\tgetElementVal: IDReader.getElementVal,\r\n\t\tgetElementValBySC: IDReader.getElementValBySC,\r\n\t\t_ElementInSeq: 0,\r\n\t\t_RetTextLastIndex: 0,\r\n\t\t_MaxElementInSeq: 0,\r\n\t\tgetElementValByEleInSeq: IDReader.getElementValByEleInSeq,\r\n\t\tTestRead: function (text)\r\n\t\t{\r\n\t\t\tconsole.log('get text: ' + text);\r\n\t\t\tthis.websocket.send(text);\r\n\t\t},\r\n\t\tGetScan: function (text)\r\n\t\t{\r\n\t\t\tconsole.log('get text: ' + text);\r\n\t\t\tthis.websocket.send(text);\r\n\t\t},\r\n\t\tSendMsg: function (msg)\r\n\t\t{\r\n\t\t\t//console.info(\"msg=\"+msg);\r\n\t\t\tthis.websocket.send(msg);\r\n\t\t},\r\n\t\tGetComPort: function ()\r\n\t\t{\r\n\t\t\tconsole.log('Getting ComPort...');\r\n\t\t\tIDReader.LoopComPort();\r\n\t\t},\r\n\t\tLoopComPort: function ()\r\n\t\t{\r\n\t\t\t//console.log('loopComPort');\r\n\t\t\tif ($(\"#ComPort option\").length == 0)\r\n\t\t\t{\r\n\t\t\t\tif (this.websocket == null || this.websocket.readyState != 1)\r\n\t\t\t\t{\r\n\t\t\t\t\tconsole.log('please connect first')\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tthis.SendMsg('getComPort');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tconsole.log('Get ComPort Success.');\r\n\t\t\t}\r\n\t\t},\r\n\t\tInitComPort: function (comPort)\r\n\t\t{\r\n\t\t\t$(\"#ComPort\").show().css(\"width\", \"100px\").empty();  //07/01/2026, DKQI, WO#345088, adjust width\r\n\t\t\tarrComPort = comPort.split(';');\r\n\t\t\tfor (var i = 0; i < arrComPort.length; i++)\r\n\t\t\t{\r\n\t\t\t\tif (arrComPort[i] != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"#ComPort\").append(\"<option value='\" + arrComPort[i] + \"'>\" + arrComPort[i] + \"</option>\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif ($(\"#ComPort option\").length > 0)\r\n\t\t\t{\r\n\t\t\t\tvar commPort = $.cookie(\"IDReaderCommPort\");\r\n\t\t\t\tif (commPort != null && commPort != \"\" && commPort != undefined)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"#ComPort\").val(commPort);\r\n\t\t\t\t}\r\n\t\t\t\t$(\"#ComPort\").prop(\"disabled\", true);\r\n\t\t\t\t$(\"#DeviceNotReady\").html(\"Device not ready.\").hide();\r\n\t\t\t\tIDReader.ConnectCom();\r\n\t\t\t}\r\n\t\t},\r\n\t\tConnectCom: function ()\r\n\t\t{\r\n\t\t\tvar commPort = $.cookie(\"IDReaderCommPort\");\r\n\t\t\tif (this._checkPortCookie)\r\n\t\t\t{\r\n\t\t\t\tif (commPort == null || commPort == \"\" || commPort == undefined)\r\n\t\t\t\t{\r\n\t\t\t\t\tcommPort = $(\"#ComPort\").val();\r\n\t\t\t\t\t$.cookie(\"IDReaderCommPort\", commPort, { expires: 1000, path: '/' });\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tvar isExist = false;\r\n\t\t\t\t\t$('#ComPort option').each(function ()\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif ($(this).val() == commPort)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$('#ComPort').val(commPort);\r\n\t\t\t\t\t\t\tisExist = true;\r\n\t\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\tif (!isExist)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tcommPort = $(\"#ComPort\").val();\r\n\t\t\t\t\t\t$.cookie(\"IDReaderCommPort\", commPort, { expires: 1000, path: '/' });\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tthis._checkPortCookie = false;\r\n\t\t\t}\r\n\r\n\t\t\ttry\r\n\t\t\t{\r\n\t\t\t\tthis.SendMsg(\"connect:\" + commPort);\r\n\t\t\t\tconsole.log(commPort);\r\n\t\t\t}\r\n\t\t\tcatch (e)\r\n\t\t\t{\r\n\t\t\t}\r\n\t\t},\r\n\t\tConnect: function (obj)\r\n\t\t{\r\n\t\t\tconsole.log(\"web connect\");\r\n\t\t\tif ($(obj).val() == \"Connect\")\r\n\t\t\t{\r\n\t\t\t\tif (this.ctlIDReader != null)\r\n\t\t\t\t{\r\n\t\t\t\t\ttry\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tthis.close();\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcatch (e) { }\r\n\t\t\t\t}\r\n\t\t\t\tif ($(\"#ComPort option\").length > 0)\r\n\t\t\t\t{\r\n\t\t\t\t\tcommPort = $(\"#ComPort\").val();\r\n\t\t\t\t\t$.cookie(\"IDReaderCommPort\", commPort, { expires: 1000, path: '/' });\r\n\t\t\t\t\ttry\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tthis.SendMsg(\"close\");\r\n\t\t\t\t\t\tthis.SendMsg('getComPort');\r\n\t\t\t\t\t\t$.cookie(\"IDReaderCommPort\", commPort, { expires: 1000, path: '/' });\r\n\t\t\t\t\t}\r\n\t\t\t\t\tcatch (e)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t}\r\n\t\t\t\t\tconsole.log(\"connect:\" + commPort);\r\n\t\t\t\t\t$(obj).val(\"Reconnect\");\r\n\t\t\t\t\t$(\"#ComPort\").prop(\"disabled\", true);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$(\"#ComPort\").prop(\"disabled\", false);\r\n\t\t\t\t$(obj).val(\"Connect\");\r\n\t\t\t\tthis.SendMsg(\"close\");\r\n\t\t\t}\r\n\t\t},\r\n\t\tReConnect: function ()\r\n\t\t{\r\n\t\t\tconsole.log(\"web connect\");\r\n\t\t\tif ($(\"#ComPort option\").length > 0)\r\n\t\t\t{\r\n\t\t\t\tcommPort = $(\"#ComPort\").val();\r\n\t\t\t\t$.cookie(\"IDReaderCommPort\", commPort, { expires: 1000, path: '/' });\r\n\t\t\t\ttry\r\n\t\t\t\t{\r\n\t\t\t\t\t$.cookie(\"IDReaderCommPort\", commPort, { expires: 1000, path: '/' });\r\n\t\t\t\t\tthis.SendMsg(\"close\");\r\n\t\t\t\t\tthis.SendMsg('getComPort');\r\n\t\t\t\t}\r\n\t\t\t\tcatch (e)\r\n\t\t\t\t{\r\n\t\t\t\t}\r\n\t\t\t\tconsole.log(\"connect:\" + commPort);\r\n\t\t\t\t$(\"#btnConnect\").val(\"Reconnect\");\r\n\t\t\t\t$(\"#ComPort\").prop(\"disabled\", true);\r\n\t\t\t}\r\n\t\t},\r\n\r\n\t\tclose: function ()\r\n\t\t{\r\n\t\t\ttry\r\n\t\t\t{\r\n\t\t\t\tthis.SendMsg(\"close\");\r\n\t\t\t}\r\n\t\t\tcatch (e) { }\r\n\t\t}\r\n\t}\r\n\tIDReader.Init();\r\n\tsetTimeout(\"IDReader.GetComPort()\", 1000);\r\n\treturn true;\r\n}\r\n\r\n\r\nvar IDReader = IDReader ||\r\n{\r\n\tctlIDReader: null,\r\n\t_enableClearData: true,\r\n\t_bindElements: {},\r\n\t_ResultOriginalALL: \"\",\r\n\tBindObjectName: null,\r\n\t_timer: 0,\r\n\tBindElementExt: null,\r\n\tBindElement: function (input, type, objectname)\r\n\t{\r\n\t\tvar val = this.getElementVal(type, input);\r\n\t\tval = $.trim(val);\r\n\t\tvar ret = val;\r\n\r\n\t\tif (val != \"\")\r\n\t\t{\r\n\t\t\tif (type == \"ZDB\" || type == \"DBA\" || type == \"DBB\" || type == \"RAG\" || type == \"RAGT\")//datetime format\r\n\t\t\t{\r\n\t\t\t\tif (ret.substring(0, 2) == \"19\" || ret.substring(0, 2) == \"20\")\r\n\t\t\t\t{\r\n\t\t\t\t\tret = val.substring(4, 6) + \"/\" + val.substring(6, 8) + \"/\" + val.substring(0, 4);\r\n\t\t\t\t}\r\n\t\t\t\telse if (ret.indexOf(\"/\") > 0)\r\n\t\t\t\t{\r\n\t\t\t\t\tret = val;\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tret = val.substring(0, 2) + \"/\" + val.substring(2, 4) + \"/\" + val.substring(4, 8);\r\n\t\t\t\t}\r\n\t\t\t\t//ret = val.substring(6, 8) + \"/\" + val.substring(4, 6) + \"/\" + val.substring(0, 4);\r\n\t\t\t}\r\n\t\t\telse if (type == \"DBC\") // sex\r\n\t\t\t{\r\n\t\t\t\tif (val == \"1\" || val == \"M\")\r\n\t\t\t\t{\r\n\t\t\t\t\tret = \"M\";\r\n\t\t\t\t}\r\n\t\t\t\telse if (val == \"2\" || val == \"F\")\r\n\t\t\t\t{\r\n\t\t\t\t\tret = \"F\";\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tret = \"U\";\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse if (type == \"DAA\")//full name\r\n\t\t\t{\r\n\t\t\t\tif (objectname == \"full_name\")\r\n\t\t\t\t{\r\n\t\t\t\t\tvar names = val.split(\",\");\r\n\t\t\t\t\tif (names.length > 2)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"input[objectname=last_name]\").val(names[0] + \", \" + names[1]);\r\n\t\t\t\t\t\tvar tempName = names[2].split(\" \");\r\n\t\t\t\t\t\tif (tempName.length > 1)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$(\"input[objectname=first_name]\").val(tempName[0]);\r\n\t\t\t\t\t\t\t$(\"input[objectname=middle_name]\").val(tempName[1]);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\telse\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$(\"input[objectname=first_name]\").val(names[2]);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse if (names.length > 1)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"input[objectname=last_name]\").val(names[0]);\r\n\t\t\t\t\t\t$(\"input[objectname=first_name]\").val(names[1]);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tnames = val.split(\" \");\r\n\t\t\t\t\t\tif (names.length > 2)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$(\"input[objectname=first_name]\").val(names[0]);\r\n\t\t\t\t\t\t\t$(\"input[objectname=middle_name]\").val(names[1]);\r\n\t\t\t\t\t\t\t$(\"input[objectname=last_name]\").val(names[2]);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\telse if (names.length > 1)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$(\"input[objectname=first_name]\").val(names[0]);\r\n\t\t\t\t\t\t\t$(\"input[objectname=last_name]\").val(names[1]);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\telse\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$(\"input[objectname=last_name]\").val(val);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tret = \"\";\r\n\t\t\t}\r\n\t\t\telse if (type == \"RBD\")//last name\r\n\t\t\t{\r\n\t\t\t\tif (objectname == \"last_name\")\r\n\t\t\t\t{\r\n\t\t\t\t\tvar names = val.split(\" \");\r\n\t\t\t\t\tif (names.length > 1)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"input[objectname=last_name]\").val(names[0]);\r\n\t\t\t\t\t\t$(\"input[objectname=suffix_name]\").val(names[1]);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(\"input[objectname=last_name]\").val(val);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tret = \"\";\r\n\t\t\t}\r\n\t\t\telse if (type == \"DAY\")\r\n\t\t\t{\r\n\t\t\t\tthis.SetDropDown(val, \"eye_color\");\r\n\t\t\t}\r\n\t\t\telse if (type == \"VAK\" || type == \"ZVK\")\r\n\t\t\t{\r\n\t\t\t\tthis.SetDropDown(val, \"make\");\r\n\t\t\t}\r\n\t\t\telse if (type == \"VBD\")\r\n\t\t\t{\r\n\t\t\t\tthis.SetDropDown(val, \"color\");\r\n\t\t\t}\r\n\t\t\telse if (type == \"DAZ\")\r\n\t\t\t{\r\n\t\t\t\tthis.SetDropDown(val, \"hair_color\");\r\n\t\t\t}\r\n\t\t\telse if (type == \"DCT\") //first name, middle name : @@ CP 07/01/2014\r\n\t\t\t{\r\n\t\t\t\tvar names = val.split(\",\");\r\n\t\t\t\tif (names.length > 1)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"input[objectname=first_name]\").val(names[0]);\r\n\t\t\t\t\t$(\"input[objectname=middle_name]\").val(names[1]);\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"input[objectname=first_name]\").val(names);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse if (type == \"DAK\" || type == \"RBM\" || type == \"NAV\") //format zip code when zip code > 5 : @@ CP 07/11/2014\r\n\t\t\t{\r\n\t\t\t\tif (val.length > 5)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar zip = val\r\n\t\t\t\t\tif (zip.indexOf(\"-\") < 0)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tzip = val.substr(0, 5) + \"-\" + val.substr(5);\r\n\t\t\t\t\t}\r\n\t\t\t\t\t$(\"input[objectname=zip]\").val(zip);\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"input[objectname=zip]\").val(val);\r\n\t\t\t\t}\r\n\t\t\t\tret = \"\";\r\n\t\t\t}\r\n\t\t\telse if (type == \"DAJ\")\r\n\t\t\t{\r\n\t\t\t\tif ($(\"select[objectname=state]\").val() != val)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"select[objectname=county]\").val(\"\");\r\n\t\t\t\t\t$(\"select[objectname=municipality]\").val(\"\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif ($(\"select[objectname=o_state]\").val() != val)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"select[objectname=o_county]\").val(\"\");\r\n\t\t\t\t\t$(\"select[objectname=o_municipality]\").val(\"\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\t$(\"select[objectname=driver_license_state]\").v