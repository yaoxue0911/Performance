or (var idx = 0; idx < totalPageNumber; idx++)\r\n\t\t{\r\n\t\t\tvar sel = \"\";\r\n\t\t\tif (idx == currentPageIndex)\r\n\t\t\t{\r\n\t\t\t\tsel = \" selected \";\r\n\t\t\t}\r\n\t\t\tpnList.push(\"<option value='\" + idx + \"'\" + sel + \">\" + (idx + 1) + \"</option>\");\r\n\t\t}\r\n\t\tpnList.push(\"</select>\");\r\n\t}\r\n\r\n\t$templateContent.find(\"[id$=pageNavigation]\")\r\n\t\t.append(pnList.join(\"\"))\r\n\t\t.find(\"a\").click(function ()\r\n\t\t{\r\n\t\t\tif (currentReportID > 0 && canSave)\r\n\t\t\t{\r\n\t\t\t\tautoSave(false);\r\n\t\t\t}\r\n\t\t}).end().find(\"select\").on(\"change\", function ()\r\n\t\t{\r\n\t\t\tvar toPageIndex = $(this).val();\r\n\t\t\tif (toPageIndex != \"\")\r\n\t\t\t{\r\n\t\t\t\tif (currentReportID > 0 && canSave)\r\n\t\t\t\t{\r\n\t\t\t\t\tautoSave(false);\r\n\t\t\t\t}\r\n\t\t\t\twindow.location = toPageURL + \"&current_page_index=\" + toPageIndex;\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t//duplicate template\r\n\tvar rnList = [];\r\n\tvar totalReportNumber = parseInt($hiddenElementsContainer.find(\":hidden[name$='hdnTotalReportNumber']\").val());\r\n\tvar currentReportIndex = parseInt($hiddenElementsContainer.find(\":hidden[name$='hdnCurrentReportIndex']\").val());\r\n\tvar toReportURL = $hiddenElementsContainer.find(\":hidden[name$='hdnToReportURL']\").val();\r\n\tif (totalReportNumber > 0 && currentReportIndex >= 0)\r\n\t{\r\n\t\tif (currentReportIndex == 0)\r\n\t\t{\r\n\t\t\trnList.push(\"First&nbsp;&nbsp;\");\r\n\t\t\trnList.push(\"Prev&nbsp;&nbsp;\");\r\n\t\t}\r\n\t\telse if (currentReportIndex > 0)\r\n\t\t{\r\n\t\t\trnList.push(\"<a href='\" + toReportURL + \"&current_report_index=0' class='listlink'>First</a>&nbsp;&nbsp;\");\r\n\t\t\trnList.push(\"<a href='\" + toReportURL + \"&current_report_index=\" + (currentReportIndex - 1) + \"' class='listlink'>Prev</a>&nbsp;&nbsp;\");\r\n\t\t}\r\n\r\n\t\tif (currentReportIndex >= totalReportNumber - 1)\r\n\t\t{\r\n\t\t\trnList.push(\"Next&nbsp;&nbsp;\");\r\n\t\t\trnList.push(\"Last&nbsp;&nbsp;\");\r\n\t\t}\r\n\t\telse if (currentReportIndex >= 0)\r\n\t\t{\r\n\t\t\trnList.push(\"<a href='\" + toReportURL + \"&current_report_index=\" + (currentReportIndex + 1) + \"' class='listlink'>Next</a>&nbsp;&nbsp;\");\r\n\t\t\trnList.push(\"<a href='\" + toReportURL + \"&current_report_index=\" + (totalReportNumber - 1) + \"' class='listlink'>Last</a>&nbsp;&nbsp;\");\r\n\t\t}\r\n\r\n\t\trnList.push(\"&nbsp;<select style='width: 60px' name='ddl_nav_page_index'>\");\r\n\t\trnList.push(\"<option value=''></option>\");\r\n\t\tfor (var idx = 0; idx < totalReportNumber; idx++)\r\n\t\t{\r\n\t\t\tvar sel = \"\";\r\n\t\t\tif (idx == currentReportIndex)\r\n\t\t\t{\r\n\t\t\t\tsel = \" selected \";\r\n\t\t\t}\r\n\t\t\trnList.push(\"<option value='\" + idx + \"'\" + sel + \">\" + (idx + 1) + \"</option>\");\r\n\t\t}\r\n\t\trnList.push(\"</select>\");\r\n\t}\r\n\r\n\t$templateContent.find(\"[id$=reportNavigation]\")\r\n\t\t.append(rnList.join(\"\"))\r\n\t\t.find(\"a\").click(function ()\r\n\t\t{\r\n\t\t\tif (currentReportID > 0 && canSave)\r\n\t\t\t{\r\n\t\t\t\tautoSave(false);\r\n\t\t\t}\r\n\t\t}).end().find(\"select\").on(\"change\", function ()\r\n\t\t{\r\n\t\t\tvar toReportIndex = $(this).val();\r\n\t\t\tif (toReportIndex != \"\")\r\n\t\t\t{\r\n\t\t\t\tif (currentReportID > 0 && canSave)\r\n\t\t\t\t{\r\n\t\t\t\t\tautoSave(false);\r\n\t\t\t\t}\r\n\t\t\t\twindow.location = toReportURL + \"&current_report_index=\" + toReportIndex;\r\n\t\t\t}\r\n\t\t});\r\n\r\n\tif (currentReportID > 0 && canSave)\r\n\t{\r\n\t\tif (AutoSaveIntakeFormData)\r\n\t\t{\r\n\t\t\tvar interval = AutoSaveIntakeFormDataInterval;\r\n\t\t\tif (interval == \"\")\r\n\t\t\t{\r\n\t\t\t\tinterval = 5;\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tinterval = parseInt(interval);\r\n\t\t\t\tif (interval <= 5)\r\n\t\t\t\t{\r\n\t\t\t\t\tinterval = 5;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tsetInterval(function ()\r\n\t\t\t{\r\n\t\t\t\tvar $hiddenElementsContainer = $(\"#divHiddenElementsContainer\");\r\n\t\t\t\tvar richTextBoxNames = $hiddenElementsContainer.find(\":hidden[name$='hdnRichTextBoxNames']\").val();\r\n\r\n\t\t\t\tif (!_hasAutoSavedReportData || richTextBoxNames != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\t_hasAutoSavedReportData = true;\r\n\t\t\t\t\tautoSave(false);  //save data to intake_report_data\r\n\t\t\t\t}\r\n\t\t\t}, 60000 * interval);\r\n\t\t}\r\n\r\n\t\t$(\"span[id$='lblNav']\").find(\"a[name=crash_page_index_link]\").click(function ()\r\n\t\t{\r\n\t\t\tautoSave(false);\r\n\t\t});\r\n\t}\r\n\r\n\t$templateContent.on('change', 'input[type=\"text\"]:visible, textarea:visible, select:visible', function ()\r\n\t{\r\n\t\t//console.log(\"Input changed: \" + $(this).attr(\"name\"));\r\n\t\t_hasAutoSavedReportData = false;\r\n\t});\r\n\r\n\t//auto focus first element\r\n\tvar $firstObj = $(\"[mode='E']\").not(\"[DATATYPE^='DATE']\").not(\"[DATATYPE^='TIME']\").eq(0);\r\n\tif ($firstObj != null)\r\n\t{\r\n\t\ttry\r\n\t\t{\r\n\t\t\t$firstObj[0].focus();\r\n\t\t}\r\n\t\tcatch (e)\r\n\t\t{ }\r\n\t}\r\n\r\n\tErrorWindowControl();\r\n\r\n\tsetTimeout(function ()\r\n\t{\r\n\t\t$.unblockUI();\r\n\t}, 200);\r\n});\r\n\r\nfunction CustomStyleSingleFrame($iframe)\r\n{\r\n\tvar $body = $iframe.contents().find(\"body\");\r\n\r\n\t$iframe.each(function ()\r\n\t{\r\n\t\t$.each(this.attributes, function ()\r\n\t\t{\r\n\t\t\tif (this.specified)\r\n\t\t\t{\r\n\t\t\t\tvar attr_name = this.name;\r\n\t\t\t\tif (attr_name.substring(0, 4) == \"_cs_\" && this.value != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tvar css_name = attr_name.substring(4);\r\n\t\t\t\t\t$body.css(css_name, \"\").css(css_name, this.value);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t});\r\n}\r\n\r\nfunction customStyle()\r\n{\r\n\t$(\"iframe\").each(function (i, e)\r\n\t{\r\n\t\tvar id = $(this).attr(\"id\");\r\n\t\tvar $body = $(\"iframe[id=\" + id + \"]\").contents().find(\"body\");\r\n\r\n\t\t$(this).each(function ()\r\n\t\t{\r\n\t\t\t$.each(this.attributes, function ()\r\n\t\t\t{\r\n\t\t\t\tif (this.specified)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar attr_name = this.name;\r\n\t\t\t\t\tif (attr_name.substring(0, 4) == \"_cs_\" && this.value != \"\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar css_name = attr_name.substring(4);\r\n\t\t\t\t\t\t$body.css(css_name, \"\").css(css_name, this.value);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t});\r\n\t});\r\n}\r\n\r\nfunction registTextareaMaxLength()\r\n{\r\n\t$(\"textarea[mode='E'][maxlen]\").on(\"keyup blur\", function ()\r\n\t{\r\n\t\t//get the limit from maxlength attribute  \r\n\t\tvar limit = parseInt($(this).attr('maxlen'));\r\n\t\t//get the current text inside the textarea  \r\n\t\tvar text = $(this).val();\r\n\t\t//count the number of characters in the text  \r\n\t\tvar chars = text.length;\r\n\r\n\t\t//check if there are more characters then allowed  \r\n\t\tif (chars > limit)\r\n\t\t{\r\n\t\t\t//and if there are use substr to get the text before the limit  \r\n\t\t\tvar new_text = text.substr(0, limit);\r\n\r\n\t\t\t//and change the current text with the new text  \r\n\t\t\t$(this).val(new_text);\r\n\t\t}\r\n\r\n\t\tif ($(this).attr(\"keep_lines\"))\r\n\t\t{\r\n\t\t\t//if keep the line's count, then not allow scrollbar appeared\r\n\t\t\tvar flag = 0;  //to avoid crash issue\r\n\t\t\tvar h1 = $(this).height() + 10;  // \"+10\" to fix IE issue\r\n\t\t\tvar h2 = $(this)[0].scrollHeight;\r\n\t\t\twhile (h1 < h2 && flag < 2000 && text.length > 1)\r\n\t\t\t{\r\n\t\t\t\t++flag;\r\n\t\t\t\ttext = text.substr(0, text.length - 1);\r\n\t\t\t\t$(this).val(text);\r\n\r\n\t\t\t\th1 = $(this).height() + 10;\r\n\t\t\t\th2 = $(this)[0].scrollHeight;\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n}\r\n\r\n//override the default function\r\nfunction object_focus() { }\r\nfunction object_blur() { }\r\n\r\nfunction showSpellCheckDialog(sender, isAutoCheck)\r\n{\r\n\tif (sender == undefined)\r\n\t{\r\n\t\treturn;\r\n\t}\r\n\tvar $textarea = $(sender).closest(\"div\").find(\"textarea[mode='E']\");\r\n\tif ($textarea.length == 0)\r\n\t{\r\n\t\treturn;\r\n\t}\r\n\r\n\tif ($.trim($textarea.val()) == \"\")\r\n\t{\r\n\t\treturn;\r\n\t}\r\n\r\n\t$(\"#divSpellCheckDialog\").dialog({\r\n\t\tautoOpen: false,\r\n\t\ttitle: \"Check Spelling\",\r\n\t\theight: 400,\r\n\t\twidth: 700,\r\n\t\tmodal: true,\r\n\t\tresizable: true,\r\n\t\tbuttons: [\r\n\t\t\t{\r\n\t\t\t\ttext: \"OK\",\r\n\t\t\t\tclass: \"btn btn-primary\",\r\n\t\t\t\tclick: function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tvar v = $(\"#divCheckText\").html();\r\n\t\t\t\t\tv = v.replace(/<BR> /g, '\\r\\n')\r\n\t\t\t\t\t\t.replace(/<br> /g, '\\r\\n')\r\n\t\t\t\t\t\t.replace(/<BR>/g, '\\r\\n')\r\n\t\t\t\t\t\t.replace(/<br>/g, '\\r\\n');\r\n\t\t\t\t\tvar regex = /(<([^>]+)>)/ig;\r\n\t\t\t\t\tv = v.replace(regex, \"\");\r\n\t\t\t\t\tv = v.replace(/&nbsp;/g, ' ')\r\n\t\t\t\t\t\t.replace(/&amp;/g, '&')\r\n\t\t\t\t\t\t.replace(/&quot;/g, '\"')\r\n\t\t\t\t\t\t.replace(/&#39;/g, '\\'')\r\n\t\t\t\t\t\t.replace(/&lt;/g, '<')\r\n\t\t\t\t\t\t.replace(/&gt;/g, '>');\r\n\t\t\t\t\t$textarea.val(v);\r\n\r\n\t\t\t\t\t$(\"#divSpellCheckDialog\").dialog(\"close\");\r\n\t\t\t\t\t$(\"#divCheckText\").html(\"\");\r\n\t\t\t\t\t$textarea.data(\"spell_checked_flag\", \"1\");\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\t{\r\n\t\t\t\ttext: \"Cancel\",\r\n\t\t\t\tclass: \"btn btn-primary\",\r\n\t\t\t\tclick: function ()\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"#divSpellCheckDialog\").dialog(\"close\");\r\n\t\t\t\t\t$(\"#divCheckText\").html(\"\");\r\n\t\t\t\t\t$textarea.data(\"spell_checked_flag\", \"1\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t],\r\n\t\tclose: function (e, ui)\r\n\t\t{\r\n\t\t\t$(\"#divSpellCheckDialog\").dialog(\"destroy\");\r\n\t\t},\r\n\t\tcreate: function (e, ui)\r\n\t\t{\r\n\t\t\t//\r\n\t\t},\r\n\t\topen: function (e, ui)\r\n\t\t{\r\n\t\t\t$(\"#divCheckText span\").css(\"font-size\", \"20px\");\r\n\t\t}\r\n\t});\r\n\tspellCheck($textarea, isAutoCheck);\r\n}\r\n\r\nfunction set_divCheckText($textarea)\r\n{\r\n\tvar txt = [];\r\n\tvar lines = $textarea.val().replace(/\\r\\n/g, \"\\n\").split(\"\\n\");\r\n\tfor (var i = 0; i < lines.length; ++i)\r\n\t{\r\n\t\tif (i)\r\n\t\t{\r\n\t\t\ttxt.push(\"<br />\");\r\n\t\t}\r\n\t\ttxt.push(lines[i]);\r\n\t}\r\n\t$(\"#divCheckText\").html(txt.join(\"\"));\r\n}\r\n\r\nfunction spellCheck($txtObj, isAutoCheck)\r\n{\r\n\tset_divCheckText($txtObj);\r\n\t$(\"#divCheckText\").spellchecker({\r\n\t\tlang: \"en\",\r\n\t\t//engine: \"google\",\r\n\t\tengine: \"pspell\",\r\n\t\t//addToDictionary: true, //show \"Ignore forevet\" add word to dictionary\r\n\t\turl: ResolveClientUrl(\"/AspSoft/SpellingCheck?action=spell_check&rnd=\" + Math.random()),\r\n\t\tinnerDocument: true,\r\n\t\tsuggestBoxPosition: \"above\"\r\n\t}).spellchecker(\"check\", function (result)\r\n\t{\r\n\t\t// if result is true then there are no badly spelt words\r\n\t\tif (result)\r\n\t\t{\r\n\t\t\tif (isAutoCheck)\r\n\t\t\t{\r\n\t\t\t\t$txtObj.data(\"spell_checked_flag\", \"1\");\r\n\t\t\t\t//$(\"#divSpellCheckDialog\").dialog(\"close\");  //it will not trigger close event\r\n\t\t\t\t$(\"#divSpellCheckDialog\").dialog(\"destroy\");\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\talert('There are no incorrectly spelled words.');\r\n\t\t\t}\r\n\t\t}\r\n\t\telse //it has error word\r\n\t\t{\r\n\t\t\t$(\"#divSpellCheckDialog\").dialog(\"open\");\r\n\t\t}\r\n\t});\r\n}\r\n\r\n//set element width by custom setting\r\nfunction adjustWidth()\r\n{\r\n\t$(\":text[ObjectName][c_width]\").each(function (i, obj)\r\n\t{\r\n\t\tvar $obj = $(obj);\r\n\t\t$obj.width($obj.attr(\"c_width\"));\r\n\t});\r\n\t$(\"select[ObjectName][c_width]\").each(function (i, obj)\r\n\t{\r\n\t\tvar $obj = $(obj);\r\n\t\t$obj.width($obj.attr(\"c_width\"));\r\n\t});\r\n\t$(\"textarea[ObjectName][c_width]\").each(function (i, obj)\r\n\t{\r\n\t\tvar $obj = $(obj);\r\n\t\tvar c_width = $obj.attr(\"c_width\");\r\n\t\t$obj.width(c_width.split(\",\")[0]);\r\n\t\t$obj.height(c_width.split(\",\")[1]);\r\n\t});\r\n}\r\n\r\nfunction autoSave(isTempSave, no_message, isAsync)\r\n{\r\n\tvar is_no_message = (typeof (no_message) == \"undefined\") ? isTempSave : no_message;\r\n\r\n\tif (!is_no_message)\r\n\t{\r\n\t\t$.blockUI({ message: \"<h3>Auto save...</h3>\", bindEvents: false });\r\n\t}\r\n\r\n\t//step 1 => handle checkbox\r\n\t$(\":hidden[DATATYPE='INFOCHECKBOX']\").each(function (index, objHdn)\r\n\t{\r\n\t\tvar hdnValue = \"\";\r\n\t\t$(objHdn).closest(\"td\").find(\":checkbox:checked[ObjectName='\" + $(objHdn).attr(\"name\") + \"']\").each(function (i, cb)\r\n\t\t{\r\n\t\t\thdnValue += (hdnValue != \"\" ? \",\" : \"\") + $(cb).val();\r\n\t\t});\r\n\t\tif (hdnValue != \"\") { hdnValue = \",\" + hdnValue + \",\"; }\r\n\t\t$(objHdn).val(hdnValue);\r\n\t});\r\n\r\n\t//step 2 => handle radiobutton (radiobutton must return a value in multisection even not radio selected)\r\n\t$(\":hidden[DATATYPE='INFORADIOBUTTON']\").each(function (index, objHdn)\r\n\t{\r\n\t\tvar hdnValue = \"\";\r\n\t\t$(objHdn).closest(\"span\").find(\":radio:checked[ObjectName='\" + $(objHdn).attr(\"name\") + \"']\").each(function (i, cb)\r\n\t\t{\r\n\t\t\thdnValue += (hdnValue != \"\" ? \",\" : \"\") + $(cb).val();\r\n\t\t});\r\n\t\t$(objHdn).val(hdnValue);\r\n\t});\r\n\r\n\t//step 3 => richtextbox\r\n\tCheckInputRichTextBox();\r\n\r\n\tvar tt = $(\"#infoForm\").serialize();\r\n\tvar action = \"auto_save\";\r\n\r\n\tif (isTempSave)\r\n\t{\r\n\t\taction = \"auto_save_to_temp\";\r\n\t}\r\n\r\n\tisAsync = (isAsync == false) ? isAsync : true;\r\n\r\n\t$.ajax({\r\n\t\ttype: \"POST\",\r\n\t\turl: ResolveClientUrl(\"/AspSoft/IntakeForm/Intake?action=\" + action + \"&rnd=\" + Math.random()),\r\n\t\tdata: tt,\r\n\t\tasync: isAsync\r\n\t}).done(function (result)\r\n\t{\r\n\t\tif (!is_no_message)\r\n\t\t{\r\n\t\t\t$.unblockUI();\r\n\t\t}\r\n\t}).fail(function (jqXHR, textStatus, errorThrown)\r\n\t{\r\n\t\tif (!is_no_message)\r\n\t\t{\r\n\t\t\t$.unblockUI();\r\n\t\t}\r\n\t\tif (textStatus == \"error\")\r\n\t\t{\r\n\t\t\talert(\"Error \" + jqXHR.status + \": \" + jqXHR.statusText);\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\talert(jqXHR.responseText);\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction setEditableSelect()\r\n{\r\n\t$('input[editableselect=1], select[editableselect=1]').addClass(\"editable-select\").editableSelect({\r\n\t\tbg_iframe: true,\r\n\t\tcase_sensitive: false,\r\n\t\titems_then_scroll: 10\r\n\t});\r\n}\r\n\r\nfunction setReadOnlyElements($container)\r\n{\r\n\tvar $objs = $container.find(\"*[mode='R'],*[mode='D']\");\r\n\t$objs.each(function (idx, obj)\r\n\t{\r\n\t\tvar $obj = $(obj);\r\n\t\tvar mode = $obj.attr(\"mode\");\r\n\t\tvar text = \"\";\r\n\t\tvar type = $obj.prop(\"type\");\r\n\r\n\t\tif (type == \"text\" || type == \"textarea\" || type == \"hidden\")\r\n\t\t{\r\n\t\t\ttext = $obj.val();\r\n\t\t}\r\n\t\telse if (type == \"select-one\")\r\n\t\t{\r\n\t\t\ttext = $obj.find(\"option:selected\").text();\r\n\t\t\tif (text == \"\" && $obj.data(\"filled_value\") != null)\r\n\t\t\t{\r\n\t\t\t\ttext = $obj.data(\"filled_value\");\r\n\t\t\t}\r\n\t\t}\r\n\t\telse if (type == \"radio\" || type == \"checkbox\")\r\n\t\t{\r\n\t\t\t$obj.prop(\"disabled\", true);\r\n\t\t\tif ($obj.is(\":checked\"))\r\n\t\t\t{\r\n\t\t\t\t$obj.css(\"background-color\", \"#ffcd58\")\r\n\t\t\t}\r\n\t\t\treturn;\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tif (mode == \"D\")\r\n\t\t{\r\n\t\t\tif (text == \"\")\r\n\t\t\t{\r\n\t\t\t\ttext = \"&nbsp;\";\r\n\t\t\t}\r\n\t\t\t//WO#262742 add checking whether the attribute \"maxlength\" is exist or not to avoid error (for multisection)\r\n\t\t\tif (typeof $obj.attr(\"maxlength\") !== typeof undefined)\r\n\t\t\t{\r\n\t\t\t\t$obj.removeAttr(\"maxlength\").after(text).hide();  //it can't post form if text length large maxlength attribute under IE11\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$obj.after(text).hide();\r\n\t\t\t}\r\n\t\t}\r\n\t\telse //R\r\n\t\t{\r\n\t\t\t$obj.attr({ \"readonly\": true }).css(\"background-color\", \"#eeeeee\");\r\n\t\t\tif (obj.tagName == \"SELECT\")\r\n\t\t\t{\r\n\t\t\t\t//remove the items for Readonly select, please consider elements in multisection\r\n\t\t\t\tvar oldData = $obj.val();\r\n\t\t\t\t$obj.find(\"option\").each(function (k, opt)\r\n\t\t\t\t{\r\n\t\t\t\t\tif ($(this).val() != oldData)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(opt).remove();\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction hightLightObject()\r\n{\r\n\t$(\"*[id_name][mode='E']:visible,*[id_name][mode='R']:visible\").each(function (idx, obj)\r\n\t{\r\n\t\tif ($(obj).val() != \"\")\r\n\t\t{\r\n\r\n\t\t\t$(obj).css(\"background-color\", \"#ffe4a1\");\r\n\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction handleMultisection(reportID)\r\n{\r\n\tvar $mul = $(\"a[name^='multisection']\");\r\n\t$mul.each(function (i, obj)\r\n\t{\r\n\t\tvar name = $(obj).attr(\"name\");\r\n\t\tvar imgUrl1 = ResolveClientUrl(\"~/js/IntakeForm/Images/add-btn.png\");\r\n\t\tvar imgUrl2 = ResolveClientUrl(\"~/js/IntakeForm/Images/minus-btn.png\");\r\n\t\tvar imgHtml = \"<img pname='\" + name + \"' pvalue='+' src='\" + imgUrl1 + \"' style='cursor: pointer; display: inline;' alt='' />\" +\r\n\t\t\t\"<img pname='\" + name + \"' pvalue='-' src='\" + imgUrl2 + \"' style='cursor: pointer; display: inline;' alt='' />\";\r\n\t\t$(obj).closest(\"td\").css({ \"vertical-align\": \"bottom\", \"width\": \"60px\" }).html(imgHtml);\r\n\t});\r\n\r\n\t//set the \"repeat=true\" & \"p=xxx\" attribute to TABLE or TR container\r\n\t$(\"img[pname^='multisection'][pvalue='+']\").each(function (i, sender)\r\n\t{\r\n\t\tvar $container = null;\r\n\t\tvar $sender = $(sender);\r\n\r\n\t\tvar pName = $sender.attr(\"pname\");\r\n\t\tvar $tb = $(this).closest(\"table\").css(\"margin-bottom\", \"2px\");\r\n\r\n\t\tif ($tb.find(\"tr\").eq(0).find(\"img[pname='\" + pName + \"']\").length > 0)  //the \"+\" & \"-\" button in the first TR\r\n\t\t{\r\n\t\t\t//$sender.attr(\"m_type\", \"layout\");\r\n\t\t\t$container = $tb;\r\n\t\t\t$container.find(\"img[pname]\").attr(\"m_type\", \"layout\");\r\n\t\t}\r\n\t\telse  //List Mode, it will copy TR for list mode, and copy TABLE for layout mode\r\n\t\t{\r\n\t\t\t//$sender.attr(\"m_type\", \"list\");\r\n\t\t\t$container = $sender.closest(\"tr\");\r\n\t\t\t$container.find(\"img[pname]\").attr(\"m_type\", \"list\");\r\n\t\t}\r\n\t\t$container.attr(\"repeat\", \"true\").attr(\"p\", pName);\r\n\r\n\t\t//$container.css(\"border\", \"2px solid green\");\r\n\r\n\t\t//hide the \"+\" & \"-\" if the multisection matched intake_element_lib bookmark\r\n\t\tif ($container.find(\"*[bookmark][bookmark!='']\").length > 0)\r\n\t\t{\r\n\t\t\t$(\"img[pname='\" + pName + \"']\").hide();\r\n\t\t}\r\n\t});\r\n\r\n\t//\"+\" or \"-\" click event\r\n\t$(\"img[pname^='multisection']\").on(\"click\", function ()\r\n\t{\r\n\t\tvar $container = null;\r\n\t\tvar $sender = $(this);\r\n\t\tvar pName = $sender.attr(\"pname\");\r\n\r\n\t\tif ($sender.attr(\"m_type\") == \"list\")\r\n\t\t{\r\n\t\t\t$container = $sender.closest(\"tr[repeat]\");\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\t$container = $sender.closest(\"table[repeat]\");\r\n\t\t}\r\n\r\n\t\tif ($sender.attr(\"pvalue\") == \"+\")\r\n\t\t{\r\n\t\t\tmakeDatePickerNew($container.clone(true).find(\"img.ui-datepicker-trigger\").hide().end()).insertAfter($container);\r\n\t\t\t$sender.css(\"visibility\", \"hidden\");\r\n\t\t\tvar $lastSection = $(\"table[repeat][p=\" + pName + \"],tr[repeat][p=\" + pName + \"]\").last();\r\n\t\t\t//Empty value\r\n\t\t\t$lastSection.find(\":text,select,textarea\").val(\"\");\r\n\t\t\t$lastSection.find(\":checkbox\").removeAttr(\"checked\");\r\n\t\t\t//WO325525 Empty filled value\r\n\t\t\t$lastSection.find(\":text,select,textarea[ObjectName]\").each(function (i, rd)\r\n\t\t\t{\r\n\t\t\t\tvar $obj = $(rd);\r\n\t\t\t\t$obj.data(\"filled_value\", \"\");\r\n\r\n\t\t\t});\r\n\t\t\t$lastSection.find(\":radio[ObjectName]\").each(function (i, rd)\r\n\t\t\t{\r\n\t\t\t\tvar rnd = Math.random().toString().replace(\".\", \"\");\r\n\t\t\t\tvar objName = $(rd).attr(\"ObjectName\");\r\n\t\t\t\tvar newName = \"ctrl_\" + rnd + \"$\" + objName + \"_tmp\";  //the \"_tmp\" is as server side\r\n\t\t\t\t//the same ObjectName radiobutton group has the same new name\r\n\t\t\t\t$lastSection.find(\":radio[ObjectName='\" + objName + \"']\").each(function (idx, oo)\r\n\t\t\t\t{\r\n\t\t\t\t\too.name = newName;\r\n\t\t\t\t});\r\n\t\t\t});\r\n\t\t\tsetMask($lastSection);\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tvar $remain = $(\"table[repeat][p=\" + pName + \"],tr[repeat][p=\" + pName + \"]\");\r\n\t\t\tif ($remain.length == 1)\r\n\t\t\t{\r\n\t\t\t\t$remain.find(\":text,select,textarea\").val(\"\"); //only clear value\r\n\t\t\t\t$remain.find(\":checkbox\").removeAttr(\"checked\");\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\t$container.remove();\r\n\t\t\t//always can see the last \"+\" button\r\n\t\t\t$(\"table[repeat][p=\" + pName + \"],tr[repeat][p=\" + pName + \"]\").find(\"img[pvalue='+']\").last().css(\"visibility\", \"visible\");\r\n\t\t}\r\n\r\n\t\t$(\"table[repeat][p=\" + pName + \"],tr[repeat][p=\" + pName + \"]\").each(function (i, rpt)\r\n\t\t{\r\n\t\t\t$(rpt).attr(\"class\", i % 2 == 0 ? \"grideven\" : \"gridodd\");\r\n\t\t});\r\n\t});\r\n\r\n\t//initialize the multisection data for update mode\r\n\tif (reportID != \"\")\r\n\t{\r\n\t\tinitMultisectionData();\r\n\t}\r\n}\r\n\r\nfunction initMultisectionData()\r\n{\r\n\tif (typeof (multisectionJson) != \"undefined\" && multisectionJson != null)\r\n\t{\r\n\t\t//console.log(\"start :\"+new Date());\r\n\t\t$.each(multisectionJson, function (i, mul)\r\n\t\t{\r\n\t\t\tvar multisection = mul.multisection;\r\n\t\t\tif (mul.DataArray != null)\r\n\t\t\t{\r\n\t\t\t\tvar i = 0;\r\n\t\t\t\tvar count = mul.DataArray.length;\r\n\t\t\t\t$.each(mul.DataArray, function (j, currentData)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar $lastMultiSection = $(\"table[repeat][p=\" + multisection + \"],tr[repeat][p=\" + multisection + \"]\").last();\r\n\r\n\t\t\t\t\tfor (var objectname in currentData)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar objectvalue = currentData[objectname];\r\n\r\n\t\t\t\t\t\tvar $element = $lastMultiSection.find(\"[objectname=\" + objectname + \"]\");\r\n\t\t\t\t\t\tif ($element != null && $element.length > 0 && objectvalue != null && objectvalue != \"\")\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t//Use the same set value function with Old method\r\n\t\t\t\t\t\t\tSetMultisectionObjectValue($element, objectvalue);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\t//create the next multisection items \r\n\t\t\t\t\ti++;\r\n\t\t\t\t\tif (i < count)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$lastMultiSection.find(\"img[pvalue='+']\").click();\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t});\r\n\t\t//console.log(\"end :\"+new Date());\r\n\t}\r\n}\r\n\r\nfunction SetMultisectionObjectValue($element, val)\r\n{\r\n\tif ($element[0].type == \"radio\")\r\n\t{\r\n\t\t$element.each(function (_idx, rd)\r\n\t\t{\r\n\t\t\tif ($(rd).val() == val)\r\n\t\t\t{\r\n\t\t\t\t//$(rd).attr(\"checked\", \"checked\");\r\n\t\t\t\trd.setAttribute(\"checked\", \"checked\");\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\telse if ($element[0].type == \"checkbox\")\r\n\t{\r\n\t\tvar tmp = val.toLowerCase();\r\n\t\t$element.each(function (_idx, rd)\r\n\t\t{\r\n\t\t\tif ((\",\" + tmp + \",\").indexOf(\",\" + $(rd).val().toLowerCase() + \",\") != -1)\r\n\t\t\t{\r\n\t\t\t\t$(rd).attr(\"checked\", \"checked\");\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\telse if ($element[0].type == \"hidden\" && $element.attr(\"ForImage\") == \"1\")\r\n\t{\r\n\t\tvar $imgElement = $element.eq(0); //the first is Hidden type, and the second is the File type\r\n\t\t$imgElement.val(val);\r\n\t\tif (val == \"\")\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar imgHTML = \"<img src='\" + ResolveClientUrl(val) + \"' \";\r\n\t\tvar imgW = $imgElement.attr(\"ImgW\");\r\n\t\tvar imgH = $imgElement.attr(\"ImgH\");\r\n\t\tif (imgW != undefined && imgW != \"0\")\r\n\t\t{\r\n\t\t\timgHTML += \" width=\" + imgW;\r\n\t\t}\r\n\t\tif (imgH != undefined && imgH != \"0\")\r\n\t\t{\r\n\t\t\timgHTML += \" height=\" + imgH;\r\n\t\t}\r\n\t\timgHTML += \" /><br>\";\r\n\t\t$imgElement.after(imgHTML);\r\n\t}\r\n\telse if ($element[0].type == \"select-one\")\r\n\t{\r\n\t\tif (val != \"\")\r\n\t\t{\r\n\t\t\tif ($element.find(`option[value=\"${val}\"]`).length === 0)\t//the value doesn't exist in select\r\n\t\t\t{\r\n\t\t\t\t$element.find(\"option[value='']\").after(\"<option selected value='\" + val + \"' style='background-color: yellow;'>\" + val + \"</option>\");\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$element.val(val);\r\n\t\t\t\t$element.data(\"filled_value\", val);\r\n\t\t\t}\r\n\t\t}\r\n\t\t$element.attr(\"title\", $element.find(\"option:selected\").text());\r\n\t}\r\n\telse\r\n\t{\r\n\t\tif ($element.attr(\"SetHTML\") == \"1\")\r\n\t\t{\r\n\t\t\t$element.html(val);\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\t$element.val(val);\r\n\t\t\t$element.data(\"filled_value\", val); //some value hasn't item in dropdown, so use data to store the vlaue\r\n\t\t}\r\n\t\t/*if ($element[0].type == \"select-one\")\r\n\t\t{\r\n\t\t\tif (val != \"\")\r\n\t\t\t{\r\n\t\t\t\tif ($element[0].selectedIndex == 0)\t//the value doesn't exist in select\r\n\t\t\t\t{\r\n\t\t\t\t\t$element.find(\"option[value='']\").after(\"<option selected value='\" + val + \"' style='background-color: yellow;'>\" + val + \"</option>\");\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\t$element.attr(\"title\", $element.find(\"option:selected\").text());\r\n\t\t}*/\r\n\t}\r\n}\r\n\r\nfunction makeDatePicker($container)\r\n{\r\n\t//the \"timeFormat: 'hh:mm tt'\" will show \"am\" \"pm\", but not \"AM\" \"PM\"\r\n\r\n\tvar date_parameter = {\r\n\t\tchangeMonth: true,\r\n\t\tchangeYear: true,\r\n\t\tshowOtherMonths: true,\r\n\t\tselectOtherMonths: true,\r\n\t\ttimeFormat: \"hh:mm TT\"\r\n\t};\r\n\r\n\tvar date_parameter_12 = {\r\n\t\tampm: true,\r\n\t\tchangeMonth: true,\r\n\t\tchangeYear: true,\r\n\t\tshowOtherMonths: true,\r\n\t\tselectOtherMonths: true,\r\n\t\ttimeFormat: \"hh:mm TT\"\r\n\t};\r\n\r\n\tvar $obj = $container.find(\"[DATATYPE=DATE][mode=E]\");\r\n\t$obj.each(function (index, ele)\r\n\t{\r\n\t\tvar $ele = $(ele);\r\n\t\tvar dateFormatValue = $ele.attr(\"date_format\");\r\n\t\tvar dateFormatOption = (typeof dateFormatValue !== 'undefined' && dateFormatValue !== false) ? { dateFormat: dateFormatValue } : {};\r\n\t\t$ele.datepicker($.extend(date_parameter, dateFormatOption));\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"DATE\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=TIME][mode=E]\").timepicker({ timeFormat: \"hh:mm TT\" });\r\n\tsetMaskForPlaceHolder($obj, \"TIME\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=TIME12][mode=E]\").timepicker({ ampm: true, timeFormat: \"hh:mm TT\" });\r\n\t$obj.on(\"change\", function ()\r\n\t{\r\n\t\tvar d = $(this).val().replace(\"12:00 AM\", \"\");\r\n\t\t$(this).val(d);\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"TIME12\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=TIME24][mode=E]\").timepicker({ timeFormat: \"hh:mm TT\" });\r\n\t$obj.on(\"change\", function ()\r\n\t{\r\n\t\tvar d = $(this).val().replace(\"00:00\", \"\");\r\n\t\tif (d != \"\" && d.length == 4)\r\n\t\t{\r\n\t\t\td = d.substr(0, 2) + \":\" + d.substr(2, 2);\r\n\t\t}\r\n\t\t$(this).val(d);\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"TIME24\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=DATETIME][mode=E]\").datetimepicker(date_parameter);\r\n\tsetMaskForPlaceHolder($obj, \"DATETIME\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=DATETIME12][mode=E]\").datetimepicker(date_parameter_12);\r\n\t$obj.on(\"change\", function ()\r\n\t{\r\n\t\tvar d = $(this).val().replace(\" 12:00 AM\", \"\");\r\n\t\t$(this).val(d);\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"DATETIME12\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=DATETIME24][mode=E]\").datetimepicker(date_parameter);\r\n\t$obj.on(\"change\", function ()\r\n\t{\r\n\t\tvar d = $(this).val().replace(\" 00:00\", \"\");\r\n\t\t$(this).val(d);\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"DATETIME24\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=TIME24_NO_COLON][mode=E]\").timepicker({ timeFormat: \"hhmm TT\" });\r\n\t$obj.on(\"change\", function ()\r\n\t{\r\n\t\tvar d = $(this).val().replace(\"0000\", \"\") + ($(this).attr(\"no_hour\") == \"1\" ? \"\" : \" Hours\");\r\n\t\td = (d == \" Hours\") ? \"\" : d;\r\n\t\t$(this).val(d);\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"TIME24_NO_COLON\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=TIME_MILITARY][mode=E]\").timepicker({ timeFormat: \"hhmm TT\" });\r\n\t$obj.on(\"change\", function ()\r\n\t{\r\n\t\tvar unit_string = $(this).attr(\"unit\");\r\n\t\tunit_string = ((typeof (unit_string) == \"undefined\") ? \"\" : \" \" + unit_string);\r\n\r\n\t\tvar d = $(this).val().replace(\"0000\", \"\") + unit_string;\r\n\t\td = (d == unit_string) ? \"\" : d;\r\n\t\t$(this).val(d);\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"TIME_MILITARY\");\r\n\r\n\t$obj = $container.find(\"[DATATYPE=DATETIME_MILITARY][mode=E]\").datetimepicker({ changeMonth: true, changeYear: true, showOtherMonths: true, selectOtherMonths: true, timeFormat: \"hhmm TT\" });\r\n\t$obj.on(\"change\", function ()\r\n\t{\r\n\t\tvar unit_string = $(this).attr(\"unit\");\r\n\t\tunit_string = ((typeof (unit_string) == \"undefined\") ? \"\" : \" \" + unit_string);\r\n\r\n\t\tvar d = ($(this).val() + unit_string).replace(\" 0000\" + unit_string, \"\");\r\n\t\td = (d == unit_string) ? \"\" : d;\r\n\t\t$(this).val(d);\r\n\t});\r\n\tsetMaskForPlaceHolder($obj, \"DATETIME_MILITARY\");\r\n}\r\n\r\nfunction setMaskForPlaceHolder(obj, type)\r\n{\r\n\tvar isIE11 = !!navigator.userAgent.match(/Trident.*rv[ :]*11\\./);\r\n\tif (obj != null && !isIE11)\r\n\t{\r\n\t\tswitch (type)\r\n\t\t{\r\n\t\t\tcase \"TIME\":\r\n\t\t\tcase \"TIME24\":\r\n\t\t\t\t$(obj).attr(\"placeholder\", \"__:__\");\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"TIME12\":\r\n\t\t\t\t$(obj).attr(\"placeholder\", \"__:__ AM\");\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"DATE\":\r\n\t\t\t\t$(obj).attr(\"placeholder\", \"__/__/____\");\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"DATETIME\":\r\n\t\t\tcase \"DATETIME24\":\r\n\t\t\t\t$(obj).attr(\"placeholder\", \"__/__/____ __:__\");\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"DATETIME12\":\r\n\t\t\t\t$(obj).attr(\"placeholder\", \"__/__/____ __:__ AM\");\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"TIME24_NO_COLON\":\r\n\t\t\t\t$(obj).each(function ()\r\n\t\t\t\t{\r\n\t\t\t\t\t$(this).attr(\"placeholder\", \"____ \" + ($(this).attr(\"no_hour\") == \"1\" ? \"\" : \" Hours\"));\r\n\t\t\t\t});\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"TIME_MILITARY\":\r\n\t\t\t\t$(obj).each(function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tvar unit_string = $(this).attr(\"unit\");\r\n\t\t\t\t\tunit_string = ((typeof (unit_string) == \"undefined\") ? \"\" : \" \" + unit_string);\r\n\t\t\t\t\t$(this).attr(\"placeholder\", \"____\" + unit_string);\r\n\t\t\t\t});\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"DATETIME_MILITARY\":\r\n\t\t\t\t$(obj).each(function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tvar unit_string = $(this).attr(\"unit\");\r\n\t\t\t\t\tunit_string = ((typeof (unit_string) == \"undefined\") ? \"\" : \" \" + unit_string);\r\n\t\t\t\t\t$(this).attr(\"placeholder\", \"__/__/____ ____\" + unit_string);\r\n\t\t\t\t});\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction makeDatePickerNew($container)\r\n{\r\n\tvar date_parameter = { changeMonth: true, changeYear: true, showOtherMonths: true, selectOtherMonths: true, timeFormat: \"hh:mm TT\" };\r\n\tvar date_parameter_12 = { ampm: true, changeMonth: true, changeYear: true, showOtherMonths: true, selectOtherMonths: true, timeFormat: \"hh:mm TT\" };\r\n\t$container.find(\":text[mode=E]\").each(function (idx, txt)\r\n\t{\r\n\t\tvar $txt = $(txt);\r\n\t\tif ($txt.hasClass(\"hasDatepicker\"))\r\n\t\t{\r\n\t\t\t$txt.attr(\"id\", \"\");\r\n\t\t\t$txt.removeClass('hasDatepicker');\r\n\r\n\t\t\tvar dataType = $txt.attr(\"DATATYPE\");\r\n\t\t\tif (dataType == \"DATE\")\r\n\t\t\t{\r\n\t\t\t\t$txt.datepicker(date_parameter).attr(\"placeholder\", \"__/__/____\");\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"TIME\")\r\n\t\t\t{\r\n\t\t\t\t$txt.timepicker({ timeFormat: \"hh:mm TT\" }).attr(\"placeholder\", \"__:__\");\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"TIME12\")\r\n\t\t\t{\r\n\t\t\t\t$txt.timepicker({ ampm: true, timeFormat: \"hh:mm TT\" }).attr(\"placeholder\", \"__:__ AM\");\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"TIME24\")\r\n\t\t\t{\r\n\t\t\t\t$txt.timepicker({ timeFormat: \"hh:mm TT\" }).attr(\"placeholder\", \"__:__\");\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"DATETIME\")\r\n\t\t\t{\r\n\t\t\t\t$txt.datetimepicker(date_parameter).attr(\"placeholder\", \"__/__/____ __:__\");\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"DATETIME12\")\r\n\t\t\t{\r\n\t\t\t\t$txt.datetimepicker(date_parameter_12).attr(\"placeholder\", \"__/__/____ __:__ AM\");\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"DATETIME24\")\r\n\t\t\t{\r\n\t\t\t\t$txt.datetimepicker(date_parameter).attr(\"placeholder\", \"__/__/____ __:__\");\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"TIME_MILITARY\")\r\n\t\t\t{\r\n\t\t\t\t$txt.timepicker({ timeFormat: \"hhmm TT\" })\r\n\t\t\t\t$txt.attr(\"placeholder\", \"____\" + (typeof ($txt.attr(\"unit\")) != \"undefined\" ? \" \" + $txt.attr(\"unit\") : \"\"));\r\n\t\t\t}\r\n\t\t\telse if (dataType == \"DATETIME_MILITARY\")\r\n\t\t\t{\r\n\t\t\t\t$txt.attr(\"placeholder\", \"__/__/____ ____\" + (typeof ($txt.attr(\"unit\")) != \"undefined\" ? \" \" + $txt.attr(\"unit\") : \"\"));\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\r\n\treturn $container;\r\n}\r\n\r\nfunction setMask($container)\r\n{\r\n\t$container.find(\"[mask][mode=E]\").each(function (i, obj)\r\n\t{\r\n\t\t//a - alpha character (A-Z,a-z)   9 - numeric character (0-9)  * - alphanumeric character (A-Z,a-z,0-9)\r\n\r\n\t\tvar mask = $(obj).attr(\"mask\");\r\n\t\tif (mask != \"\") { mask = mask.replace(/D/gi, '9').replace(/X/gi, '*'); }\r\n\t\tif (mask != \"\")\r\n\t\t{\r\n\t\t\t$(obj).unbind();\r\n\t\t\t$(obj).mask(\"?\" + mask);\r\n\t\t\t$(obj).attr(\"placeholder\", mask.replace(/9/gi, \"_\").replace(/\\*/gi, \"_\").replace(/a/gi, \"_\"));\r\n\t\t}\r\n\t});\r\n}\r\n//Handle multisection end~~\r\n\r\nfunction delIntake()\r\n{\r\n\t_hasAutoSavedReportData = true;\r\n\r\n\tvar $hiddenElementsContainer = $(\"#divHiddenElementsContainer\");\r\n\tvar templateCode = $hiddenElementsContainer.find(\":hidden[name$='hdnTemplateCode']\").val();\r\n\tvar requiredTemplateCode = $hiddenElementsContainer.find(\":hidden[name$='hdnRequiredTemplateCode']\").val();\r\n\tvar divisionID = $hiddenElementsContainer.find(\":hidden[name$='hdnDivisionID']\").val();\r\n\r\n\tif (divisionID == \"14\" && requiredTemplateCode.indexOf(\",\" + templateCode + \",\") > -1)\r\n\t{\r\n\t\tif (confirm(\"This action will delete the whole Fire Report if it has several pages. \\nDo you really want to delete them?\"))\r\n\t\t{\r\n\t\t\t$.blockUI({ message: \"<h2>Working...</h2>\", bindEvents: false });\r\n\t\t\treturn true;\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\treturn false;\r\n\t\t}\r\n\t}\r\n\telse\r\n\t{\r\n\t\tif (confirm(\"Are you sure you want to delete the record?\"))\r\n\t\t{\r\n\t\t\t$.blockUI({ message: \"<h2>Working...</h2>\", bindEvents: false });\r\n\t\t\treturn true;\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\treturn false;\r\n\t\t}\r\n\t}\r\n}\r\n\r\nfunction CheckInputRichTextBox()\r\n{\r\n\ttry\r\n\t{\r\n\t\tvar $hiddenElementsContainer = $(\"#divHiddenElementsContainer\");\r\n\t\tvar richTextBoxNames = $hiddenElementsContainer.find(\":hidden[name$='hdnRichTextBoxNames']\").val();\r\n\t\t//console.log(\"richTextBoxNames \" + richTextBoxNames);\r\n\r\n\t\tvar arrRTB = richTextBoxNames.split(',');\r\n\t\tfor (var i = 0; i < arrRTB.length; i++)\r\n\t\t{\r\n\t\t\t//console.log('arrRTB[i] ' + arrRTB[i]);\r\n\t\t\tif (arrRTB[i] != \"\")\r\n\t\t\t{\r\n\t\t\t\tif (!RichTextBox_CheckInput(arrRTB[i]))\r\n\t\t\t\t{\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tcatch (e)\r\n\t{\r\n\t}\r\n\r\n\treturn true;\r\n}\r\n\r\nfunction confirmIntake(sender, is_async)\r\n{\r\n\tvar async = (typeof is_async == \"boolean\") ? is_async : true;\r\n\tif (!intakeFormCheckInput(false))\r\n\t{\r\n\t\treturn false;\r\n\t}\r\n\tif ($(\"input[name*=hdnIntakeWorkflowConfirmKey]\") && $(\"input[name*=hdnIntakeWorkflowConfirmKey]\").val() == \"Y\")\r\n\t{\r\n\t\tif (!confirm(\"Are you sure you want to \" + $(sender).val() + \"?\"))\r\n\t\t{\r\n\t\t\treturn false;\r\n\t\t}\r\n\t}\r\n\r\n\tif (LeaveWaring)\r\n\t{\r\n\t\tLeaveWaring.IngnoreCheck = true;\r\n\t}\r\n\r\n\tif ($(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnParentID']\").val().length != 0)\r\n\t{\r\n\t\tautoSave(false, false, false);\r\n\t}\r\n\r\n\t$.blockUI({ message: \"<h2>Working...</h2>\", bindEvents: false });\r\n\tvar $hiddenElementsContainer = $(\"#divHiddenElementsContainer\");\r\n\tvar templateID = $hiddenElementsContainer.find(\":hidden[name$='hdnTemplateID']\").val();\r\n\tvar reportID = $hiddenElementsContainer.find(\":hidden[name$='hdnReportID']\").val();\r\n\tvar caseID = $hiddenElementsContainer.find(\":hidden[name$='hdnCaseID']\").val();\r\n\tvar divisionID = $hiddenElementsContainer.find(\":hidden[name$='hdnDivisionID']\").val();\r\n\tvar nextPID = $hiddenElementsContainer.find(\":hidden[name$='hdnNextPID']\").val();\r\n\tvar reDirectPID = $hiddenElementsContainer.find(\":hidden[name$='hdnReDirectPID']\").val();\r\n\tif ((reDirectPID != \"\") && (reDirectPID != undefined))\r\n\t{\r\n\t\tnextPID = reDirectPID;\r\n\t}\r\n\tvar richTextBoxNames = $hiddenElementsContainer.find(\":hidden[name$='hdnRichTextBoxNames']\").val();\r\n\tvar printPopup = $hiddenElementsContainer.find(\":hidden[name$='hdnPrintPopup']\").val();\r\n\r\n\tCheckInputRichTextBox();\r\n\r\n\t//don't need for PA.\r\n\t/*if ($hiddenElementsContainer.find(\":hidden[name$='hdnParentID']\").val().length != 0)\r\n\t{\r\n\t\treportID = $hiddenElementsContainer.find(\":hidden[name$='hdnParentID']\").val();\r\n\t\tautoSave(false, true);\r\n\t}\r\n\tif ($hiddenElementsContainer.find(\":hidden[name$='hdnParentTemplateID']\").val().length != 0)\r\n\t{\r\n\t\ttemplateID = $hiddenElementsContainer.find(\":hidden[name$='hdnParentTemplateID']\").val();\r\n\t}*/\r\n\r\n\tvar urlOtherIDs = $(\"#hdnUrlOtherIds\").val();\r\n\t$.ajax({\r\n\t\ttype: \"post\",\r\n\t\turl: ResolveClientUrl(\"/AspSoft/IntakeForm/Intake?action=auto_confirm&save_data=1&case_id=\" + caseID + \"&template_id=\" + templateID + \"&report_id=\" + reportID + urlOtherIDs + \"&rnd=\" + Math.random()),\r\n\t\tdata: $(\"#infoForm\").serialize(),\r\n\t\tasync: async\r\n\t}).done(function (result)\r\n\t{\r\n\t\t$.unblockUI();\r\n\t\tvar masterpagetype = $hiddenElementsContainer.find(\":hidden[name$='hdnMasterPageFile']\").val() + \"\";\r\n\t\tvar printDirectly = $hiddenElementsContainer.find(\":hidden[name$='hdnPrintDirectly']\").val() + \"\";\r\n\t\tvar isPopUp = masterpagetype.toLocaleLowerCase().includes(\"popup\");\r\n\r\n\t\tif (result == \"OK\") //auto workflow\r\n\t\t{\r\n\t\t\tif (isPopUp)\r\n\t\t\t{\r\n\t\t\t\tif (printDirectly === \"1\" && printPopup == \"Y\")\r\n\t\t\t\t{\r\n\t\t\t\t\tif (confirm('Do you wish to print the report?'))\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tPopUp(ResolveClientUrl(\"/include/rms/document/BatchDownload_DM?nextPID=batchPrint_dm&Doc_Keys=\" + reportID), 200, 200, null, function (ret)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\twindow.CloseDialog(reportID);\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.CloseDialog(reportID);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tvar url = ResolveClientUrl(\"/Aspsoft/Dispatcher?nextPID=\" + nextPID + \"&case_id=\" + caseID + urlOtherIDs + \"&report_workflow_type=INTAKE&division_id=\" + divisionID);\r\n\t\t\t\t//prompt the print when \"Save & Confirm\"\r\n\t\t\t\tif (confirm('Do you wish to print the report?'))\r\n\t\t\t\t{\r\n\t\t\t\t\tPopUp(ResolveClientUrl(\"/include/rms/document/BatchDownload_DM?nextPID=batchPrint_dm&Doc_Keys=\" + reportID), 200, 200, null, function (ret)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\twindow.location.href = url;\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.location.href = url;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t\telse if (result == \"WF\") //need pupup workflow window\r\n\t\t{\r\n\t\t\tvar workflowURL = \"/AspSoft/IntakeForm/IntakeReportAssignWorkflow?nextPID=updateReportWorkflowBatch&report_ids=\" + reportID + \"&rnd=\" + Math.random();\r\n\t\t\tvar token = $('input[name=\"__RequestVerificationToken\"]').val();\r\n\t\t\tPopUp(ResolveClientUrl(workflowURL), 800, 600, '', function (res)\r\n\t\t\t{\r\n\t\t\t\tif (res == undefined)\r\n\t\t\t\t{\r\n\t\t\t\t\t$.post(ResolveClientUrl(\"/AspSoft/IntakeForm/Intake?report_ids=\" + reportID + \"&rnd=\" + Math.random()), { action: \"cancel_batch_confirm\", __RequestVerificationToken: token }, function (result)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t//do nothing after cancel workflow, just close the workflow popup, and keep the current page\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tif (isPopUp)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\twindow.CloseDialog(reportID);\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar url = ResolveClientUrl(\"/Aspsoft/Dispatcher?nextPID=\" + nextPID + \"&case_id=\" + caseID + urlOtherIDs + \"&division_id=\" + divisionID);\r\n\t\t\t\t\t\twindow.location.href = url;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\t\telse if (result.indexOf(\"REPORT_ERROR_LIST\") > 0)\r\n\t\t{\r\n\t\t\tPopUp(ResolveClientUrl(\"~/AspSoft/PopupDispatcher?nextPID=listIntakeReportValidateResult&report_id=\" + reportID), \"1200\", \"800\");\r\n\t\t}\r\n\t\telse if (result.indexOf(\"ValidateFail\") === 0)\r\n\t\t{\r\n\t\t\tvar arr = result.split(\"#\");\r\n\t\t\tif (arr.length == 2)\r\n\t\t\t{\r\n\t\t\t\tvar err = handleValidateMessage(arr[1]);\r\n\t\t\t\talert(err);\r\n\t\t\t}\r\n\t\t}\r\n\t\telse if (result != \"\")\r\n\t\t{\r\n\t\t\tif (result.indexOf(\"Invalid post data.\") >= 0)\r\n\t\t\t{\r\n\t\t\t\talert(\"Invalid post data.\");\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t//remove all html tag\r\n\t\t\t\talert(result.rep