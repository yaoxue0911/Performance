e .ui-slider-handle\r\n{\r\n\tborder-color: black;\r\n}\r\n\r\n.ui-tpicker-grid-label\r\n{\r\n\tbackground: none;\r\n\tborder: none;\r\n\tmargin: 0;\r\n\tpadding: 0;\r\n}\r\n\r\n.intake_container\r\n{\r\n\twidth: 100%;\r\n\tbackground-color: #c3c7cc;\r\n}\r\n.nightmode .intake_container\r\n{\r\n\tbackground-color: #1C1C1C;\r\n}\r\n\r\n.intake_content\r\n{\r\n\twidth: 100%;\r\n\tbackground-color: White;\r\n\tborder: outset 2px #c3c7cc;\r\n\tmargin-top: 20px;\r\n\tmargin-bottom: 20px;\r\n}\r\n.nightmode .intake_content\r\n{\r\n\tbackground-color: #1C1C1C;\r\n\tborder: outset 2px #0b4264;\r\n\tcolor: white;\r\n}\r\n\r\ninput.editable-select\r\n{\r\n\tbackground-color: #e6eef1;\r\n}\r\n\r\n.ui-widget-content\r\n{\r\n\tborder: 1px solid #aaaaaa; /*background: #ffffff url(images/ui-bg_flat_75_ffffff_40x100.png) 50% 50% repeat-x;*/\r\n\tcolor: #222222;\r\n\tfont-size: 80%;\r\n}\r\n.ui-widget-content a\r\n{\r\n\tcolor: #222222;\r\n\tfont-family: 'Lato' , Calibri, sans-serif;\r\n\ttext-decoration: none;\r\n\tfont-size: 13px;\r\n\tmargin-left: 0;\r\n\tdisplay: block;\r\n\tpadding-top: 0;\r\n}\r\n\r\n.ui-datepicker-title\r\n{\r\n\tcolor: black;\r\n}\r\n\r\n.nightmode .ui-datepicker-title\r\n{\r\n\tcolor: white;\r\n}\r\n.nightmode .ui-widget-header\r\n{\r\n\tbackground: rgba(41, 41, 41, 1);\r\n}\r\n\r\n.nightmode .ui-widget-content\r\n{\r\n\tborder: 1px solid #464646;\r\n}\r\n\r\n.tooltip-text {\r\n\tvisibility: hidden;\r\n\tposition: absolute;\r\n\tz-index: 1;\r\n\twidth: 130px;\r\n\tcolor: white;\r\n\tfont-size: 12px;\r\n\tbackground-color: #192733;\r\n\tborder-radius: 10px;\r\n\tpadding: 10px 15px 10px 15px;\r\n}\r\n\r\n.nightmode .tooltip-text {\r\n\tvisibility: hidden;\r\n\tposition: absolute;\r\n\tz-index: 1;\r\n\twidth: 130px;\r\n\tcolor: white;\r\n\tfont-size: 12px;\r\n\tbackground-color: #0b76d1;\r\n\tborder-radius: 10px;\r\n\tpadding: 10px 15px 10px 15px;\r\n}\r\n\r\n.hover-text:hover .tooltip-text {\r\n\tvisibility: visible;\r\n}\r\n\r\n.hover-text {\r\n\tposition: r