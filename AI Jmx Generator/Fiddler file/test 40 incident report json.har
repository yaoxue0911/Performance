ethod: \"delete\"\r\n\t\t\t\t})\r\n\t\t\t\tif(response.ok){\r\n\t\t\t\t\tthis.data = this.data.filter(i=>i.bulletinId !=bulletinId)\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}))\r\n\t})\r\n</script>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t\t<div class=\"tab-pane fade\" id=\"mainInbox-tab-pane\" role=\"tabpanel\" tabindex=\"1\">\r\n<style>\r\n\t#mainInbox .card {\r\n\t\tbackground-color: var(--csi-inbox-card-bg)\r\n\t}\r\n\r\n\t#mainInbox .inbox-item:not([data-count=\"0\"]) .inboxSubName {\r\n\t\tcolor: var(--csi-body-color) !important;\r\n\t}\r\n\t@media (max-width: 1500px) {\r\n\t\t#mainInbox .card-body .col-3 {\r\n\t\t\tflex: 0 0 auto;\r\n\t\t\twidth: 33.3333333%;\r\n\t\t}\r\n\t}\r\n</style>\r\n<div id=\"mainInbox\">\r\n\t\t<div class=\"card border mb-2\">\r\n\t\t\t<div class=\"card-body\">\r\n\t\t\t\t<div class=\"card-title text-sm text-body-tertiary fw-bold\">RMS - Officer</div>\r\n\t\t\t\t<div class=\"row g-2\">\r\n\t\t\t\t\t\t<div class=\"col-3\">\r\n\t\t\t\t\t\t\t<div class=\"inbox-item d-flex align-items-center gap-2\" data-page-id=\"listInbox_MyActiveCase\" data-count=\"0\">\r\n\t\t\t\t\t\t\t\t<i class=\"info-icon-star \" data-is-fav=\"true\"></i>\r\n\t\t\t\t\t\t\t\t<a href=\"/RMS/inbox/list?nextPID=listInbox_MyActiveCase&amp;inbox_staff_id=1&amp;inbox_sub_id=10030101&amp;UseDefault=1&amp;is_temp_page_size=1&amp;page_size=100\" class=\"inboxSubName d-flex align-items-center text-decoration-none text-body-tertiary\">\r\n\t\t\t\t\t\t\t\t\tMy Active Incidents/Cases\r\n\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t<div class=\"badge rounded-pill text-bg-danger\"></div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<div class=\"col-3\">\r\n\t\t\t\t\t\t\t<div class=\"inbox-item d-flex align-items-center gap-2\" data-page-id=\"listInbox_ReturnedReport\" data-count=\"0\">\r\n\t\t\t\t\t\t\t\t<i class=\"info-icon-star \" data-is-fav=\"true\"></i>\r\n\t\t\t\t\t\t\t\t<a href=\"/RMS/inbox/list?nextPID=listInbox_ReturnedReport&amp;inbox_staff_id=1&amp;inbox_sub_id=10030102&am