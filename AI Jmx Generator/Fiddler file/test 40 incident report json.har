ar aReturn;\n\n    var parent = $(obj).closest('tr[repeat=true]');\n    objStatute = parent.find(\"input[objectname='njs_code']\");\n    objCharge = parent.find(\"input[objectname='njs_description']\");\n\n    strStatute = objStatute.val();\n    strCharge = objCharge.val();\n    strStatute = strStatute.replace(/\\'/g, \"''\");\n    strCharge = strCharge.replace(/\\'/g, \"''\");\n    if (strStatute == '' && strCharge == '') return;\n\n    var strURL = '~/Aspsoft/PopUpDispatcher?nextPID=listPopupCharge_PA&case_id=1100017412&charge=' + escape(strCharge) + '&statute=' + escape(strStatute) + '&rnd=' + Math.random();\n\n    isMatching = true;\n\n    PopUp(ResolveClientUrl(strURL), 600, 350, '', function (retValue)\n    {\n        if (retValue != null)\n        {\n            aReturn = retValue.split('~');\n            $(objStatute).val(CSIDecode(aReturn[0]));\n            $(objCharge).val(CSIDecode(aReturn[1]));\n        }\n        isMatching = false;\n    });\n\n    $(\"button[id='rb_cmdAdd']\").last().focus();\n}\n\n$(function ()\n{\n    var firstVal = $(\"input[objectname='njs_code']\").first().val();\n    $(document)\n        .off(\"blur.njsCode\")\n        .on(\"blur.njsCode\", \"input[objectname='njs_code']\", function () { NjsCodeMatch(this, \"code\", firstVal); })\n        .off(\"blur.njsDesc\")\n        .on(\"blur.njsDesc\", \"input[objectname='njs_description']\", function () { NjsCodeMatch(this, \"desc\", firstVal); });\n    $(\"button[id='rb_cmdDel']\").last().focus();\n\n})\n\n// Jack D. 20120412\nvar newCheckInput = checkInput;\ncheckInput = function (x)\n{\n    return newCheckInput(false);\n}\n\n$(function ()\n{\n    $(\"input[name='submit_button']\").on(\"click\", function ()\n    {\n        var flag = true;\n        $(\"table[objectname='addNJSCode']\").first().find(\"tr\").each(function (i)\n        {\n            if (flag)\n            {\n                var _emptyCount = 0;\n                var _emptyEles = [];\n                $(this).find(\"input[type!='hidden']\").each(function (i)\n                {\n                    var _ele = $(this);\n                    var _value = _ele.val();\n                    if (_value == \"\" && _ele.attr('name').indexOf('njs_code') < 0)\n                    {\n                        _emptyEles.push(_ele);\n                    }\n                });\n\n                if (_emptyEles.length > 0 && _emptyEles.length < 3)\n                {\n                    alert(\"Please enter the required field!\");\n                    _emptyEles[0].focus();\n                    flag = false;\n                }\n            } // ~~ flag\n        }); // ~~ tr\n\n        return flag;\n    });\n    $(document).on(\"click\", \"button[id='rb_cmdAdd']\", function ()\n    {\n        resetCount();\n    });\n});\nfunction resetCount()\n{\n    $(\"input[objectname='njs_count']\").each(function (index)\n    {\n        $(this).val(index + 1);\n    });\n}</script>\r\n<!--end of webpage-append-->\r\n\t<script type=\"text/javascript\">\r\n\t\t$(function ()\r\n\t\t{\r\n\t\t\tvar pageTitle = 'Add Crime/Incident';\r\n\t\t\tif (pageTitle)\r\n\t\t\t{\r\n\t\t\t\tif (typeof window.SetDialogTitle === \"function\")\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.SetDialogTitle(pageTitle);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (typeof window.parent !== \"undefined\" && typeof window.parent.SetDialogTitle === \"function\")\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.parent.SetDialogTitle(pageTitle);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t})\r\n\t</script>\r\n\t\r\n\t\r\n</body>\r\n</html>", "size":16459, "mimeType":"text/html; charset=utf-8"}, "headers":[{"name":"Cache-Control", "value":"no-cache, no-store"}, {"name":"Pragma", "value":"no-cache"}, {"name":"Content-Type", "value":"text/html; charset=utf-8"}, {"name":"Vary", "value":"Accept-Encoding"}, {"name":"Server", "value":"Microsoft-IIS/10.0"}, {"name":"Set-Cookie", "value":"tst=0; path=/; secure; samesite=strict"}, {"name":"Set-Cookie", "value":".AspNetCore.Mvc.CookieTempDataProvider=; expires=Thu, 0