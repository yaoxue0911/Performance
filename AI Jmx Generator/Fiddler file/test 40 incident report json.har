tJhycEb2G8lmZDqpIKQ4pKiikMqwaLtkrcCadd4npe8\" />\r\n\t\r\n\t<script type=\"text/javascript\">\r\n\t\tvar __client_request_root_url = \"/RMS/\";\r\n\t\tvar __is_night_mode = \"0\";\r\n\t\tvar __new_validation_alert = 1;\r\n\t\tvar __engine_service_handler = '/RMS/aspsoft/engineservice';\r\n\t\tvar __disclaimer_config__ = \"3@Disclaimer.htm,20@Disclaimer.htm\";\r\n\t\t// division change\r\n\t\tfunction changeDivision(divisionId)\r\n\t\t{\r\n\t\t\tif (refreshMenu(divisionId) == false) return;\r\n\t\t\tconst url = ResolveClientUrl('~/Home?division_id=') + divisionId;\r\n\t\t\t$(\"iframe[name='main']\", window.top.document).attr(\"src\", url);\r\n\t\t}\r\n\r\n\t\tfunction refreshMenu(newDevId)\r\n\t\t{\r\n\t\t\tvar newDivisionID = newDevId;\r\n\t\t\tvar files = __disclaimer_config__;\r\n\t\t\tif (files != '')\r\n\t\t\t{\r\n\t\t\t\tvar fileName = \"\", showDivisionID = \"\";\r\n\t\t\t\tvar filesArray = files.split(',');\r\n\t\t\t\tfor (var i = 0; i < filesArray.length; i++)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar fileArray = filesArray[i].split('@');\r\n\t\t\t\t\tif (fileArray[0] == newDivisionID)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tshowDivisionID = fileArray[0];\r\n\t\t\t\t\t\tfileName = fileArray[1];\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (fileName != \"\" && showDivisionID == newDivisionID)\r\n\t\t\t\t{\r\n\t\t\t\t\tPopUp(ResolveClientUrl(\"~/AspSoft/Disclaimer/\" + fileName), 650, 650, \"\", function (retVal)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif (!retVal)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tnewDivisionID = 0;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tconst tmp = jumpModuleByDivision(newDivisionID);\r\n\t\t\t\t\t\tif (tmp)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tconst url = ResolveClientUrl('~/Home?division_id=') + newDivisionID;\r\n\t\t\t\t\t\t\t$(\"iframe[name='main']\", window.top.document).attr(\"src\", url);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\tSetDialogTitle(\"Agreement\");\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tvar re = jumpModuleByDivision(newDivisionID);\r\n\t\t\treturn re;\r\n\t\t}\r\n\r\n\t\tfunction jumpModuleByDivision(newDivisionID)\r\n\t\t{\r\n\t\t\tconst requestUrl = ResolveClientUrl(\"~/AspSoft/EngineService/changeconnection?source=menu&division_id=\") + newDivisionID;\r\n\t\t\tlet result = false;\r\n\t\t\t$.post({\r\n\t\t\t\turl: requestUrl,\r\n\t\t\t\tasync: false,\r\n\t\t\t\tsuccess: function (data)\r\n\t\t\t\t{\r\n\t\t\t\t\tif (data.status == \"true\" || data.status == \"false\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tresult = true;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif (data.indexOf(\"<\") != -1 || data.indexOf(\">\") != -1)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tresult = true;\r\n\t\t\t\t\t\t} else\r\n\t\t\t\t\t\t{\r\n\r\n\t\t\t\t\t\t\tvar guid = data.substring(0, 32);\r\n\t\t\t\t\t\t\tvar url = data.substring(33);\r\n\t\t\t\t\t\t\tvar str = \"<form id='dynForm' action='\" + url + \"/Login' method='post' target='_top'>\";\r\n\t\t\t\t\t\t\tstr += \"<input type=hidden name='action' value='login_by_ticket'>\";\r\n\t\t\t\t\t\t\tstr += \"<input type=hidden name='guid' value='\" + guid + \"'>\";\r\n\t\t\t\t\t\t\tstr += \"<input type=hidden name='division_id' value='\" + newDivisionID + \"'>\";\r\n\t\t\t\t\t\t\tstr += \"<form>\";\r\n\t\t\t\t\t\t\tvar doc = $(\"iframe[name='main']\", window.top.document).get(0).contentWindow.document;\r\n\t\t\t\t\t\t\tdoc.body.innerHTML = str;\r\n\t\t\t\t\t\t\tdoc.getElementById(\"dynForm\").submit();\r\n\t\t\t\t\t\t\tresult = false;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t\treturn result;\r\n\t\t}\r\n\t\tfunction RemoteLoginToePro(id)\r\n\t\t{\r\n\t\t\treturn RemoteLoginCommon(id);\r\n\t\t}\r\n\r\n\t\tfunction RemoteLoginCommon(id, node_id)\r\n\t\t{\r\n\t\t\tconst requestUrl = ResolveClientUrl(\"~/AspSoft/EngineService/getremotekey?node_id=\" + node_id + \"&rnd=\") + Math.random();\r\n\t\t\tExec(requestUrl, {}, function (ret)\r\n\t\t\t{\r\n\t\t\t\tif (ret == \"true\" || ret == \"false\")\r\n\t\t\t\t{\r\n\t\t\t\t\talert(\"Single Sign On function is unavailable, please contact administrators.\");\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tvar guid = ret.substring(0, 32);\r\n\t\t\t\t\tvar url = ret.substring(33);\r\n\t\t\t\t\tconst formHtml = `\r\n\t\t\t\t\t<form id=\"dynRemoteForm\" action=\"${url}/Login.aspx\" method=\"post\" target=\"_blank\">\r\n\t\t\t\t\t\t<input type=\"hidden\" name=\"action\" value=\"login_by_remote\">\r\n\t\t\t\t\t\t<input type=\"hidden\" name=\"guid\"   value=\"${guid}\">\r\n\t\t\t\t\t</form>`;\r\n\r\n\t\t\t\t\tconst $form = $(formHtml).appendTo('body');\r\n\r\n\t\t\t\t\t$form[0].submit();\r\n\t\t\t\t\t$form.remove();\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t}\r\n\t</script>\r\n\t<script src=\"/RMS/lib/jquery/dist/jquery.min.js\"></script>\r\n<!--<script>$.uiBackCompat = true;</script>-->\r\n<script src=\"/RMS/lib/bootstrap/dist/js/bootstrap.bundle.min.js\"></script>\r\n<script src=\"/RMS/lib/jqueryui/jquery-ui.min.js\"></script>\r\n<script src=\"/RMS/js/lang/1/message.js?v=qPYP8omv6WTHdxYbBZOnrq0oW6LlYUHaAMvANgD0zOc\"></script>\r\n<script src=\"/RMS/js/aspsoft/Flex2Table.js?v=taaa9CVltK-ljuPtgx4OerzsX04oV-0vrqOKkALjU-g\"></script>\r\n<script src=\"/RMS/js/aspsoft/Validation.js?v=m71ibgn4bNtDpSwsTXL-rWw478B2s5buCFgqHira2Ls\"></script>\r\n<script src=\"/RMS/js/aspsoft/CommonParam.js?v=8yn-HMK90Ov2aE3W-8tS3MxOiU4kTLmTHffXkFa80Vc\"></script>\r\n<script src=\"/RMS/js/aspsoft/CommonRemote.js?v=GlDHDT76qMXe2nu1-4FUEOhTzLdYP3iYTu0tXp89aa8\"></script>\r\n<script src=\"/RMS/js/aspsoft/CommonNavigation.js?v=AQd9Cib5RpvJIJO0WweSVIZVeyiuGHDc3NHr0kJss0Y\"></script>\r\n<script src=\"/RMS/js/global.js?v=1f3CwWam8TavC2uqWUrDlCa2LyayLQQgSx5WjKSrx8Q\"></script>\r\n<script src=\"/RMS/js/aspsoft/RichTextBox.js\"></script>\r\n\t<script src=\"/RMS/lib/jquery-validation/jquery.validate.min.js\"></script>\r\n<script src=\"/RMS/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js\"></script>\r\n\r\n\t<script type=\"text/javascript\">\r\n\