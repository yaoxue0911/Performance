/RMS/js/aspsoft/AsyncFilter.js?v=YSWYthbcUI4sy_rfKfOVJk4vBjuCyLawjgLZG63Zk44\" type=\"module\"></script>\r\n<script src=\"/RMS/js/aspsoft/AsyncSearch.js?v=XOUWx_WQp4NOpxLjRp-xs4q5PVeQJ7Cb0U8gTupbZTU\" type=\"module\"></script>\r\n\r\n<script src=\"/RMS/js/aspsoft/Common.js?v=LXM95vuqDnIh-ugZGk_Bi_9d7d4XzhXmvyrZrfsKej8\"></script>\r\n<script src=\"/RMS/js/aspsoft/Mask.js?v=_HLJUyY4xP2IISjF0DxXazTQS_tkaakoPP5NGI4mmvg\"></script>\r\n<script src=\"/RMS/js/aspsoft/Calendar.js?v=m8GhRGG-tMUhkO5SBsFOmg3ykj_YV5bi1G_qiifjqxc\"></script>\r\n<script src=\"/RMS/js/aspsoft/NoteBox.js?v=92l6lMfleoNc_RPD2-DyKV-NKeVs472KHy_9SQfAwd0\"></script>\r\n<script src=\"/RMS/js/aspsoft/ComboBox.js?v=HB3hcGX_OoF3WLxK8G1CuAt_GxlGF8YWFJdYwxb_gaY\"></script>\r\n<script src=\"/RMS/js/aspsoft/DropdownComboBox.js?v=f5-2zO17nOPdFR5OKH5FtvQwLNCtHcKTJLQYJpSvs9U\"></script>\r\n<script src=\"/RMS/js/aspsoft/DropCheckBox.js?v=yYW2H6efNbegLxVyO77Jytg90T_iRUOj1GGHJ7grZkg\"></script>\r\n\r\n<script src=\"/RMS/js/aspsoft/DynamicDropdown.js?v=_11kW5G3rOw7FxMUJ6Dn0_NHp64iyahSlaEtJNcTh3g\"></script>\r\n<script src=\"/RMS/js/aspsoft/ChangeDynamicArea.js?v=ptnQ6lMbQPgacIaxQQusSj9HYsTcugm-txnygXa-IP8\"></script>\r\n<script src=\"/RMS/js/aspsoft/ShowMasterName.js?v=OGmWT8WB7NRfB8cesHjjEp0sbJ01BhoOCTcFQM62sEc\"></script>\r\n\r\n<script src=\"/RMS/js/aspsoft/MultiSection.js?v=svpfB6A8WZXES6UiOpqt1N7s2D8B-J6v_PqzJqaXIvI\"></script>\r\n<script src=\"/RMS/js/aspsoft/MultiLayerDialog.js?v=3LawXtRbI6ed6QQ1rYekdJG74IpK3g3pMr1Kw5yJtxI\"></script>\r\n\t<script src=\"/RMS/lib/jquery/dist/jquery.min.js\"></script>\r\n\t<!--<script>$.uiBackCompat = true;</script>-->\r\n\t<script src=\"/RMS/lib/jqueryui/jquery-ui.min.js\"></script>\r\n\r\n\t<style>\r\n\t\t.app-main {\r\n\t\t\tmargin: .25rem;\r\n\t\t}\r\n\r\n\t\t.nightmode .app-main {\r\n\t\t\tbackground-color: transparent;\r\n\t\t}\r\n\t</style>\r\n</head>\r\n<body class=\"nightmode_none d-flex flex-column\">\r\n\t<div class=\"app-body app-body-popup\">\r\n\t\t<div class=\"app-main\" id=\"app-main\">\r\n\t\t\t<form id=\"infoForm\" method=\"post\">\r\n\t\t\t\t<style type=\"text/css\">\r\n\t.gridoddunderscore {\r\n\t\tpadding-top: 5px;\r\n\t\tpadding-left: 5px;\r\n\t\tpadding-bottom: 5px;\r\n\t}\r\n\r\n\t\t.gridoddunderscore td {\r\n\t\t\tborder-bottom: #000000 1px solid;\r\n\t\t}\r\n\r\n\t.gridevenunderscore {\r\n\t\tpadding-top: 5px;\r\n\t\tpadding-left: 5px;\r\n\t\tpadding-bottom: 5px;\r\n\t\tbackground-color: #fffce4;\r\n\t}\r\n\r\n\t\t.gridevenunderscore td {\r\n\t\t\tborder-bottom: #000000 1px solid;\r\n\t\t}\r\n\r\n\t.selectedrow {\r\n\t\t/* outline: 3px solid #FFB800; */\r\n\t\tbackground-color: rgba(255,184,0,0.35) !important;\r\n\t}\r\n</style>\r\n<script type=\"text/javascript\">\r\n\t//-----------------------------------------------------------------------------\r\n\t//Client user global variable\r\n\t//-----------------------------------------------------------------------------\r\n\r\n\tvar g_strSelBGColor = \"#666666\";\r\n\tvar g_strSelColor = \"#FFFFFF\";\r\n\tvar g_strBGColor = \"#EEEEEE\";\r\n\tvar g_strColor = \"blue\";\r\n\r\n\r\n\tvar oddBGColor = \"white\";\r\n\tvar evenBGColor = \"#ebebeb\";\r\n\tvar currentBGColor = \"#666666\";\r\n\t//-----------------------------------------------------------------------------\r\n\t//Client user function\r\n\t//-----------------------------------------------------------------------------\r\n\t$(function ()\r\n\t{\r\n\t\tif (parent != undefined && parent.SetDialogTitle != undefined)\r\n\t\t{\r\n\t\t\tparent.SetDialogTitle(document.title);\r\n\t\t}\r\n\t\t$(document).keydown(moveInList);\r\n\t\t$('#TableFooter').hide();\r\n\t\tparent.SetDialogTitle('Matched Person List');\r\n\t});\r\n\r\n\tfunction IsIPad()\r\n\t{\r\n\t\tvar agent = navigator.userAgent.toLowerCase();\r\n\t\tif (agent.indexOf('iphone') >= 0 || agent.indexOf('ipad') >= 0)\r\n\t\t{\r\n\t\t\treturn true;\r\n\t\t}\r\n\t\treturn false;\r\n\t}\r\n\r\n\tfunction getKeyValue(trObj)\r\n\t{\r\n\t\tvar hiddenObj = null;\r\n\t\tvar objectName = $(\"#hidKeyObjectName\").val();\r\n\t\t$(trObj).find(\"input:hidden\").each(function ()\r\n\t\t{\r\n\t\t\t// TODO: In INFOSHERE30, KeyObjectionName is a single value, but in INFOSHERE40, KeyObjectionName is multiple comma separated values for an unknown reason\r\n\t\t\t// if (objectName.indexOf($(this).attr(\"name\")) != -1)\r\n\t\t\t// {\r\n\t\t\tif ($(this).attr(\"name\").indexOf(objectName) != -1)\r\n\t\t\t{\r\n\t\t\t\thiddenObj = $(this);\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t});\r\n\t\tif (hiddenObj != null)\r\n\t\t{\r\n\t\t\treturn $(hiddenObj).val();\r\n\t\t}\r\n\t\treturn null;\r\n\t}\r\n\r\n\tfunction handleSelected(v_objSelected)\r\n\t{\r\n\t\tif ($(v_objSelected).find('td').length > 0 && $(v_objSelected).index() >= 0)\r\n\t\t{\r\n\t\t\t$(\"#hidValue\").val(getKeyValue(v_objSelected));\r\n\t\t\tGetExtentionCondition(v_objSelected);\r\n\t\t\tdocument.forms[0].submit();\r\n\t\t}\r\n\t}\r\n\r\n\tfunction selectItem(el)\r\n\t{\r\n\t\tif ($(el).find('td').length > 0 && $(el).index() >= 0)\r\n\t\t{\r\n\t\t\tvar existflag = $(el).find('input[objectname=mn_existincase]').val();\r\n\t\t\tif (existflag == \"1\")\r\n\t\t\t{\r\n\t\t\t\tvar msg = $(el).find('[objectname=mn_existalertmsg]').val();\r\n\t\t\t\tvar msg = (typeof (msg) == \"undefined\") ? \"The selected item is already in this case, please select another one or update existing one.\" : msg;\r\n\t\t\t\talert(msg);\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$(\"#hidValue\").val(getKeyValue(el));\r\n\t\t\t\tGetExtentionCondition(el);\r\n\t\t\t\tdocument.forms[0].submit();\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\tfunction focusItem(el)\r\n\t{\r\n\t\tif (el == null) return;\r\n\t\tvar otr = null;\r\n\t\tvar ctrl = null;\r\n\t\tif ($(el).find('td').length > 0)\r\n\t\t{\r\n\t\t\tif (\"0\" == \"1\")\r\n\t\t\t{\r\n\t\t\t\tvar keyValue = getKeyValue(el);\r\n\t\t\t\t$(el).attr(\"title\", keyValue);\r\n\t\t\t}\r\n\t\t\tif ($(el).find('input[type=hidden]').length != 0)\r\n\t\t\t{\r\n\t\t\t\totr = el;\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (otr == null) return;\r\n\t\tvar currentRowIndex = $(otr).index() + 1;\r\n\t\tintLocation = parseInt($(\"#hidCurrentRow\").val());\r\n\t\tif (currentRowIndex == intLocation)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar o_bg_color = $(objTable).find(\"tr\").eq(intLocation).attr(\"o_bg_color\");\r\n\r\n\t\tif (typeof o_bg_color == \"undefined\")\r\n\t\t{\r\n\t\t\tif (intLocation % 2 == 0)\r\n\t\t\t{\r\n\t\t\t\to_bg_color = evenBGColor;\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\to_bg_color = oddBGColor;\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t$(objTable).find(\"tr\").eq(intLocation).css(\"backgroundColor\", o_bg_color);\r\n\r\n\t\t// if (intLocation % 2 == 0)\r\n\t\t// {\r\n\t\t// \t$(objTable).find(\"tr\").eq(intLocation).css(\"backgroundColor\", evenBGColor);\r\n\t\t// }\r\n\t\t// else\r\n\t\t// {\r\n\t\t// \t$(objTable).find(\"tr\").eq(intLocation).css(\"backgroundColor\", oddBGColor);\r\n\t\t// }\r\n\t\t// $(objTable).find(\"tr\").eq(currentRowIndex).css(\"color\", \"white\");\r\n\t\t// $(objTable).find(\"tr\").eq(currentRowIndex).css(\"backgroundColor\", currentBGColor);\r\n\t\t$(objTable).find(\"tr\").eq(intLocation).css(\"color\", \"black\");\r\n\t\t$(objTable).find(\"tr\").eq(currentRowIndex).addClass(\"selectedrow\");\r\n\t\t$(objTable).find(\"tr\").eq(intLocation).removeClass(\"selectedrow\");\r\n\t\t$(\"#hidCurrentRow\").val(currentRowIndex);\r\n\t}\r\n\tfunction isIE()\r\n\t{\r\n\t\treturn /MSIE|Trident/.test(navigator.userAgent);\r\n\t}\r\n\r\n\tfunction moveInList(e)\r\n\t{\r\n\t\tvar e = e || event;\r\n\t\tvar currKey = e.keyCode || e.which || e.charCode;\r\n\t\tif (objTable == null)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tvar intLocation, intTotal, intTDHeight;\r\n\t\tif (objTable != null)\r\n\t\t{\r\n\t\t\tintLocation = parseInt($(\"#hidCurrentRow\").val());\r\n\t\t\tintTotal = parseInt($(\"#hidTotal\").val());\r\n\t\t\tintTDHeight = $(objTable).find(\"tr\").eq(1).offsetHeight + 3;\r\n\t\t}\r\n\t\tvar evt = GetEvent();\r\n\t\tvar _temp_obj = evt.srcElement || evt.target;\r\n\t\tif (_temp_obj.name == 'ScopeLookup' || _temp_obj.name == 'cmdClose')\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tswitch (currKey)\r\n\t\t{\r\n\t\t\tcase 13:\r\n\t\t\t\tif (objTable != null)\r\n\t\t\t\t{\r\n\t\t\t\t\thandleSelected($(objTable).find(\"tr\").eq(intLocation));\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 27:\r\n\t\t\t\tparent.CloseDialog();\r\n\t\t\t\tbreak;\r\n\t\t\tcase 38:\r\n\t\t\t\tif (objTable != null)\r\n\t\t\t\t{\r\n\t\t\t\t\tif (isIE())\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\twindow.event.returnValue = false;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\te.preventDefault();\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif (intLocation > 1)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar o_bg_color = $(objTable).find(\"tr\").eq(intLocation).attr(\"o_bg_color\");\r\n\r\n\t\t\t\t\t\tif (typeof o_bg_color == \"undefined\")\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tif (intLocation % 2 == 0)\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\to_bg_color = evenBGColor;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\to_bg_color = oddBGColor;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t$(objTable).find(\"tr\").eq(intLocation).css(\"backgroundColor\", o_bg_color);\r\n\r\n\t\t\t\t\t\t$(objTable).find(\"tr\").eq(intLocation).css(\"color\", \"black\");\r\n\r\n\t\t\t\t\t\t$(objTable).find(\"tr\").eq(intLocation - 1).addClass(\"selectedrow\");\r\n\t\t\t\t\t\t$(objTable).find(\"tr\").eq(intLocation).removeClass(\"selectedrow\");\r\n\t\t\t\t\t\t$(\"#hidCurrentRow\").val(intLocation - 1);\r\n\r\n\t\t\t\t\t\t$(objTable).find(\"tr\").eq(intLocation - 1)[0].scrollIntoView(false);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase 40:\r\n\t\t\t\tif (objTable != null)\r\n\t\t\t\t{\r\n\t\t\t\t\tif (isIE())\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\twindow.event.returnValue = false;\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\te.preventDefault();\r\n\t\t\t\t\t}\r\n\t\t\t\t\tif (intLocation < intTotal)\r\n\t