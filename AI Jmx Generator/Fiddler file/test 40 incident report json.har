+ \") Invalid day: \" + v + \"</a>\");\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"HOUR_ONLY\":\r\n\t\t\t\tif (!isCorrectNumber(v, 23))\r\n\t\t\t\t{\r\n\t\t\t\t\t$(obj).addClass(\"ui-state-error\");\r\n\t\t\t\t\t$(obj).css(\"background-color\", \"#fddfdf\");\r\n\t\t\t\t\t$(obj).attr(\"errorMsg\", \"Invalid hour: \" + v);\r\n\t\t\t\t\terrorMsg.push(\"<a errorObj='\" + $(obj).attr(\"objectname\") + \"'>(\" + (errorMsg.length + 1) + \") Invalid hour: \" + v + \"</a>\");\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"MINUTE_ONLY\":\r\n\t\t\t\tif (!isCorrectNumber(v, 59))\r\n\t\t\t\t{\r\n\t\t\t\t\t$(obj).addClass(\"ui-state-error\");\r\n\t\t\t\t\t$(obj).css(\"background-color\", \"#fddfdf\");\r\n\t\t\t\t\t$(obj).attr(\"errorMsg\", \"Invalid minute: \" + v);\r\n\t\t\t\t\terrorMsg.push(\"<a errorObj='\" + $(obj).attr(\"objectname\") + \"'>(\" + (errorMsg.length + 1) + \") Invalid minute: \" + v + \"</a>\");\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t\tcase \"REGULAR\":\r\n\t\t\t\tvar expression = obj.getAttribute(\"EXPRESSION\");\r\n\t\t\t\tif (obj.value.match(expression) == null)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(obj).addClass(\"ui-state-error\");\r\n\t\t\t\t\t$(obj).css(\"background-color\", \"#fddfdf\");\r\n\t\t\t\t\terrorMsg.push(\"(\" + (errorMsg.length + 1) + \") Invalid value: \" + obj.getAttribute(\"DATAMSG\"));\r\n\t\t\t\t}\r\n\t\t\t\tbreak;\r\n\t\t}\r\n\t\tif (dataType.indexOf(\"FLOAT\") == 0)\r\n\t\t{\r\n\t\t\tif (!isFloat(v, dataType))\r\n\t\t\t{\r\n\t\t\t\t$(obj).addClass(\"ui-state-error\");\r\n\t\t\t\t$(obj).css(\"background-color\", \"#fddfdf\");\r\n\t\t\t\t$(obj).attr(\"errorMsg\", \"Invalid floating point: \" + v);\r\n\t\t\t\terrorMsg.push(\"<a errorObj='\" + $(obj).attr(\"objectname\") + \"'>(\" + (errorMsg.length + 1) + \") Invalid floating point: \" + v + \"</a>\");\r\n\t\t\t}\r\n\t\t}\r\n\t});\r\n\r\n\t//step 6 => check group  (flagbox or textbox element)\r\n\tvar groupNameList = [];\r\n\r\n\t//checkbox / flagbox\r\n\t$(\":checkbox[group_name][req_type^='1']\").each(function (idx, obj)\r\n\t{\r\n\t\tvar $obj = $(obj);\r\n\t\tvar group_name = $obj.attr(\"group_name\");\r\n\t\tvar req_type = $obj.attr(\"req_type\");\r\n\r\n\t\tif ($.inArray(group_name, groupNameList) >= 0)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tgroupNameList.push(group_name);\r\n\r\n\t\tif ($(\":checkbox[group_name='\" + group_name + \"'][req_type^='1']:checked\").length == 0)\r\n\t\t{\r\n\t\t\t$(\":checkbox[group_name='\" + group_name + \"'][req_type^='1']\").addClass(\"ui-state-error\");\r\n\t\t\t$(\":checkbox[group_name='\" + group_name + \"'][req_type^='1']\").attr(\"errorMsg\", \"Please check data for the group: \" + group_name);\r\n\t\t\terrorMsg.push(\"<a errorObj='\" + $(obj).attr(\"objectname\") + \"'>(\" + (errorMsg.length + 1) + \") Please check data for the group: \" + group_name + \"</a>\");\r\n\t\t\treturn false;\r\n\t\t}\r\n\t});\r\n\r\n\t//textbox\r\n\tgroupNameList = [];\r\n\t$(\":text[group_name]\").each(function (idx, obj)\r\n\t{\r\n\t\tvar $obj = $(obj);\r\n\t\tvar group_name = $obj.attr(\"group_name\");\r\n\t\tvar req_type = $obj.attr(\"req_type\");\r\n\t\tif (req_type == undefined || req_type == \"\" || req_type.length != 2)\r\n\t\t{\r\n\t\t\treq_type = \"01\";\r\n\t\t}\r\n\r\n\t\tif ($.inArray(group_name, groupNameList) >= 0)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tgroupNameList.push(group_name);\r\n\r\n\t\tvar hasDataCount = 0;\r\n\t\tvar $txts = $(\":text[group_name='\" + group_name + \"']\");\r\n\t\t$txts.each(function (idx, obj)\r\n\t\t{\r\n\t\t\tif ($(obj).val().trim() != \"\")\r\n\t\t\t{\r\n\t\t\t\t++hasDataCount;\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\tvar isReq = req_type.substr(0, 1) == \"1\";\r\n\t\tvar onlyAllowOne = req_type.substr(1, 1) == \"1\";\r\n\t\tif (isReq && hasDataCount == 0)\r\n\t\t{\r\n\t\t\t$txts.addClass(\"ui-state-error\");\r\n\t\t\t$(txts).css(\"background-color\", \"#fddfdf\");\r\n\t\t\t$txts.attr(\"errorMsg\", \"Please input data for the group: \" + group_name);\r\n\t\t\terrorMsg.push(\"<a errorObj='\" + $(obj).attr(\"objectname\") + \"'>(\" + (errorMsg.length + 1) + \") Please input data for the group: \" + group_name + \"</a>\");\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\telse if (onlyAllowOne && hasDataCount > 1)\r\n\t\t{\r\n\t\t\t$txts.addClass(\"ui-state-error\");\r\n\t\t\t$(txts).css(\"background-color\", \"#fddfdf\");\r\n\t\t\t$txts.attr(\"errorMsg\", \"Please input data in one textbox for the group: \" + group_name);\r\n\t\t\terrorMsg.push(\"<a errorObj='\" + $(obj).attr(\"objectname\") + \"'>(\" + (errorMsg.length + 1) + \") Please input data in one textbox for the group: \" + group_name + \"</a>\");\r\n\t\t\treturn false;\r\n\t\t}\r\n\t});\r\n\r\n\tif (errorMsg.length > 0)\r\n\t{\r\n\t\t$(\"div.check-input-error-msg\").html(errorMsg.join(\"<br>\")).removeClass(\"d-none\");\r\n\t\t$(\"div.check-input-error\").removeClass(\"d-none\");\r\n\t\t$divMsg.html(errorMsg.join(\"<br>\"));\r\n\t\tvar $trMsg = $(\"#trMsg\");\r\n\t\t$trMsg.show();\r\n\t\treturn false;\r\n\t}\r\n\r\n\t//step x => other check\r\n\r\n\t//remove ISREQ attribute from checkbox because it can pass check under firefox\r\n\t$(\":checkbox[ISREQ]\").removeAttr(\"ISREQ\");\r\n\r\n\t/*if (FireDivisionID == \"14\")\r\n\t{\r\n\t\t$(\":text[objectname^=NFIRS_],select[objectname^=NFIRS_]\").removeAttr(\"disabled\");\r\n\t}*/\r\n\r\n\t/*if (showWaitbox == null || showWaitbox)\r\n\t{\r\n\t\t$.blockUI({ message: \"<h2>Working...</h2>\", bindEvents: false });\r\n\t}*/\r\n\r\n\tvar isNetwork = true;\r\n\t/*if (__checknetwork_offine_config == \"y\")\r\n\t{\r\n\t\tisNetwork = checkNetWorkConnection('init', false);\r\n\t}*/\r\n\r\n\treturn isNetwork;\r\n}\r\n\r\n//Validate report when click validate report button\r\nfunction ValidateReport()\r\n{\r\n\tif (intakeFormCheckInput(true, false))\r\n\t{\r\n\t\t$.blockUI({ message: \"<h3>Auto save...</h3>\", bindEvents: false });\r\n\r\n\t\tvar tt = $(\"#infoForm\").serialize();\r\n\r\n\t\t$.ajax({\r\n\t\t\ttype: \"POST\",\r\n\t\t\turl: ResolveClientUrl(\"/AspSoft/IntakeForm/Intake?action=auto_save&case_id=\" + CurrentCaseID + \"&rnd=\" + Math.random()),\r\n\t\t\tdata: tt\r\n\t\t}).done(function (result)\r\n\t\t{\r\n\t\t\t$.unblockUI();\r\n\t\t\t$.blockUI({ message: \"<h3>Validate...</h3>\", bindEvents: false });\r\n\t\t\tvar reportID = $(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnReportID']\").val();\r\n\t\t\tvar parentID = getParameterByName(\"parent_id\", location.search);\r\n\t\t\tvar rID = reportID;\r\n\t\t\tif (parentID != \"\" && parentID != null)\r\n\t\t\t{\r\n\t\t\t\trID = parentID;\r\n\t\t\t}\r\n\r\n\t\t\t$.ajax({\r\n\t\t\t\ttype: \"POST\",\r\n\t\t\t\turl: ResolveClientUrl(\"/AspSoft/IntakeForm/Intake?action=validate_report&report_id=\" + reportID + \"&case_id=\" + CurrentCaseID + \"&rnd=\" + Math.random()),\r\n\t\t\t\tdata: tt\r\n\t\t\t}).done(function (result)\r\n\t\t\t{\r\n\t\t\t\t$.unblockUI();\r\n\r\n\t\t\t\tif (result == \"NFIRS_REPORT_ERROR_LIST\")\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.location.href = window.location.href;\r\n\t\t\t\t\t//PopUp(ResolveClientUrl(\"~/AspSoft/PopupDispatcher?nextPID=listNFIRSReportError_Fire&report_id=\" + rID), \"MAX\", \"MAX\");\r\n\t\t\t\t}\r\n\t\t\t\telse if (result == \"PA_CRASH_REPORT_ERROR_LIST\")\r\n\t\t\t\t{\r\n\t\t\t\t\tPopUp(ResolveClientUrl(\"~/AspSoft/PopupDispatcher?nextPID=listCrashPennDOTValidResult_PA&reportID=\" + rID), \"1200\", \"800\", null, function (value)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tpartailRefreshError(\"inquireReportValidateError\", \"listReportValidateError\", rID);\r\n\t\t\t\t\t\tif (value == \"1\")\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tsetTimeout(function ()\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\treturn confirmIntake(this);\r\n\t\t\t\t\t\t\t}, 50);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t\telse if (result.indexOf(\"ValidateFail\") === 0)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar arr = result.split(\"#\");\r\n\t\t\t\t\tif (arr.length == 2)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar err = handleValidateMessage(arr[1]);\r\n\t\t\t\t\t\talert(err);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\telse if (result == \"REPORT_ERROR_LIST\")\r\n\t\t\t\t{\r\n\t\t\t\t\tPopUp(ResolveClientUrl(\"~/AspSoft/PopupDispatcher?nextPID=listIntakeReportValidateResult&report_id=\" + rID), \"1200\", \"800\");\r\n\t\t\t\t}\r\n\t\t\t\telse if (result == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\talert(\"Validation Successful!\");\r\n\t\t\t\t\tvar $template_code = $(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnTemplateCode']\");\r\n\t\t\t\t\tif ($template_code != undefined && $template_code.val().substring(0, 5) == \"NFIRS\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif (!confirm(\"Are you sure you want to Send to Supervisor?\"))\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$.blockUI({ message: \"<h2>Working...</h2>\", bindEvents: false });\r\n\t\t\t\t\t\t\twindow.location.href = window.location.href;\r\n\t\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\tvar report_id = $(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnReportID']\").val();\r\n\t\t\t\t\t\tvar case_id = $(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnCaseID']\").val();\r\n\t\t\t\t\t\t$.blockUI.defaults.overlayCSS.opacity = \"0.3\";\r\n\t\t\t\t\t\t$.blockUI({ message: \"<h2>Working...</h2>\", bindEvents: false });\r\n\t\t\t\t\t\t$.post(ResolveClientUrl(\"/AspSoft/IntakeForm/FireMiddlePage?action=confirm_report_fromintake&rnd=\") + Math.random(), { report_id: report_id }, function (result)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tif (result == \"OK\")\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\twindow.location.href = ResolveClientUrl(\"/AspSoft/Dispatcher?nextPID=listPoliceReport&report_type=C&case_id=\") + case_id;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse if (result.substring(0, 2) == \"WF\")\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t$.unblockUI();\r\n\r\n\t\t\t\t\t\t\t\tvar mainReportID = result.replace(/WF/g, \"\");\r\n\t\t\t\t\t\t\t\tvar workflowURL = \"/AspSoft/IntakeForm/IntakeReportAssignWorkflow?nextPID=updateReportWorkflowBatch&report_ids=\" + mainReportID + \"&rnd=\" + Math.random();\r\n\t\t\t\t\t\t\t\tPopUp(ResolveClientUrl(workflowURL), 800, 600, '', function (res)\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\tif (res == undefined)\r\n\t\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\t\tCloseDialog(1);\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\telse\r\n\t\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\t\tvar firemasterpagetype = $(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnMasterPageFile']\").val() + \"\";\r\n\t\t\t\t\t\t\t\t\t\tvar isPopUp = firemasterpagetype.toLocaleLowerCase().includes(\"popup\");\r\n\t\t\t\t\t\t\t\t\t\tif (isPopUp)\r\n\t\t\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\t\t\tCloseDialog(1);\r\n\t\t\t\t\t\t\t\t\t\t} else\r\n\t\t\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\t\t\tvar url = ResolveClientUrl(\"/AspSoft/Dispatcher?nextPID=listPoliceReport&report_type=C&case_id=\") + case_id;\r\n\t\t\t\t\t\t\t\t\t\t\twindow.location.href = url;\r\n\t\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\telse if (result != \"\")\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t$.unblockUI();\r\n\t\t\t\t\t\t\t\talert(result);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\talert(result);\r\n\t\t\t\t}\r\n\t\t\t}).fail(function (jqXHR, textStatus, errorThrown)\r\n\t\t\t{\r\n\t\t\t\t$.unblockUI();\r\n\t\t\t\tif (textStatus == \"error\")\r\n\t\t\t\t{\r\n\t\t\t\t\tif (jqXHR.status == \"12029\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\talert(\"The attempt to connect to the server failed.\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse if (jqXHR.status == \"12007\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\talert(\"The server name could not be resolved.\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\talert(\"Error \" + jqXHR.status + \": \" + jqXHR.statusText);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\talert(jqXHR.responseText);\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}).fail(function (jqXHR, textStatus, errorThrown)\r\n\t\t{\r\n\t\t\t$.unblockUI();\r\n\t\t\tif (textStatus == \"error\")\r\n\t\t\t{\r\n\t\t\t\tif (jqXHR.status == \"12029\")\r\n\t\t\t\t{\r\n\t\t\t\t\talert(\"The attempt to connect to the server failed.\");\r\n\t\t\t\t}\r\n\t\t\t\telse if (jqXHR.status == \"12007\")\r\n\t\t\t\t{\r\n\t\t\t\t\talert(\"The server name could not be resolved.\");\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\talert(\"Error \" + jqXHR.status + \": \" + jqXHR.statusText);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\talert(jqXHR.responseText);\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\telse\r\n\t{\r\n\t\treturn false;\r\n\t}\r\n\treturn false;\r\n}\r\n\r\nfunction getParameterByName(name, url)\r\n{\r\n\tif (!url)\r\n\t{\r\n\t\turl = window.location.href;\r\n\t}\r\n\tname = name.replace(/[\\[\\]]/g, \"\\\\$&\");\r\n\tvar regex = new RegExp(\"[?&]\" + name + \"(=([^&#]*)|&|#|$)\"), results = regex.exec(url);\r\n\tif (!results) return null;\r\n\tif (!results[2]) return '';\r\n\treturn decodeURIComponent(results[2].replace(/\\+/g, \" \"));\r\n}\r\n\r\n//Recover report data from intake_report_data_log table, user lost narrative sometimes, and can't find the root reason\r\nfunction RecoverIntakeReportData(obj)\r\n{\r\n\tvar $obj = $(obj);\r\n\tvar originalBookmarkName = $obj.attr(\"obn\");\r\n\r\n\tvar reportID = $(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnReportID']\").val();\r\n\tvar url = ResolveClientUrl(\"/Aspsoft/PopUpDispatcher?nextPID=listRecoverIntakeReportData&report_id=\" + reportID + \"&original_bookmark_name=\" + originalBookmarkName + \"&rnd=\" + Math.random());\r\n\tPopUp(ResolveClientUrl(url), 950, 700, '', function (res)\r\n\t{\r\n\t\tif (res != null && res != undefined)\r\n\t\t{\r\n\t\t\t$.blockUI({ message: \"<h3>Recover Data...</h3>\", bindEvents: false });\r\n\r\n\t\t\t$.ajax({\r\n\t\t\t\ttype: \"POST\",\r\n\t\t\t\turl: ResolveClientUrl(\"/AspSoft/IntakeForm/Intake?action=recover_data_log&log_id=\" + res + \"&rnd=\" + Math.random()),\r\n\t\t\t\tdata: $(\"#infoForm\").serialize()\r\n\t\t\t}).done(function (result)\r\n\t\t\t{\r\n\t\t\t\tif (result != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\t$obj.closest(\"div\").find(\"textarea[name='\" + originalBookmarkName + \"']\").val(result);\r\n\t\t\t\t}\r\n\t\t\t\t$.unblockUI();\r\n\t\t\t}).fail(function (jqXHR, textStatus, errorThrown)\r\n\t\t\t{\r\n\t\t\t\t$.unblockUI();\r\n\t\t\t\talert(\"Recover data failed, please try again later.\");\r\n\t\t\t});\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction RecoverIntakeReportDataRichTextbox(obj)\r\n{\r\n\tvar $obj = $(obj);\r\n\tvar originalBookmarkName = $obj.attr(\"obn\");\r\n\r\n\tvar reportID = $(\"#divHiddenElementsContainer\").find(\":hidden[name$='hdnReportID']\").val();\r\n\tvar url = ResolveClientUrl(\"/Aspsoft/PopUpDispatcher?nextPID=listRecoverIntakeReportData&report_id=\" + reportID + \"&original_bookmark_name=\" + originalBookmarkName + \"&rnd=\" + Math.random());\r\n\tPopUp(ResolveClientUrl(url), 950, 700, '', function (res)\r\n\t{\r\n\t\tif (res != null && res != undefined)\r\n\t\t{\r\n\t\t\t$.blockUI({ message: \"<h3>Recover Data...</h3>\", bindEvents: false });\r\n\r\n\t\t\t$.ajax({\r\n\t\t\t\ttype: \"POST\",\r\n\t\t\t\turl: ResolveClientUrl(\"/AspSoft/IntakeForm/Intake?action=recover_data_log&log_id=\" + res + \"&rnd=\" + Math.random()),\r\n\t\t\t\tdata: $(\"#infoForm\").serialize()\r\n\t\t\t}).done(function (result)\r\n\t\t\t{\r\n\t\t\t\tif (result != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"div.toolbar[toolbar='1']\").next(\"iframe[id='\" + originalBookmarkName + \"']\").contents().find(\"body\").html(result);\r\n\t\t\t\t}\r\n\t\t\t\t$.unblockUI();\r\n\t\t\t}).fail(function (jqXHR, textStatus, errorThrown)\r\n\t\t\t{\r\n\t\t\t\t$.unblockUI();\r\n\t\t\t\talert(\"Recover data failed, please try again later.\");\r\n\t\t\t});\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction ErrorWindowControl()\r\n{\r\n\tif ($(\".pf_parent\").css(\"display\") != \"none\")\r\n\t{\r\n\t\tErrorTableScroll();\r\n\t\twindow.onscroll = function ()\r\n\t\t{\r\n\t\t\tErrorTableScroll();\r\n\t\t}\r\n\t\t$('#hideErrorButton').click(function ()\r\n\t\t{\r\n\t\t\t$(this).hide();\r\n\t\t\t$('#showErrorButton').show();\r\n\t\t\t$('.pf').hide();\r\n\t\t});\r\n\t\t$('#showErrorButton').click(function ()\r\n\t\t{\r\n\t\t\t$(this).hide();\r\n\t\t\t$('#hideErrorButton').show();\r\n\t\t\t$('.pf').show();\r\n\t\t});\r\n\t}\r\n}\r\n\r\nfunction ErrorTableScroll()\r\n{\r\n\tif ($(document).scrollTop() > 200)\r\n\t{\r\n\t\t$(\".pf_parent\").addClass('float').css(\"width\", ($('#tbTemplateContent').width().toString()) + \"px\");\r\n\t}\r\n\telse\r\n\t{\r\n\t\t$(\".pf_parent\").removeClass('float').css(\"width\", \"100%\");\r\n\t}\r\n}\r\n\r\nfunction partailRefreshError(parentPageid, partialPageid, report_id)\r\n{\r\n\tvar refreshURL = ResolveClientUrl(\"/AspSoft/Dispatcher?nextPID=\" + parentPageid + \"&report_id=\" + report_id + \"&PartialRefresh_ajax=\" + partialPageid + \"&rnd=\" + Math.random());\r\n\t$.get(refreshURL, function (data)\r\n\t{\r\n\t\tvar searchText = 'Table[ObjectName=\"' + partialPageid + '\"]';\r\n\t\tvar finalObj = $(searchText);\r\n\t\tvar $tempDiv = $(\"<div></div>\");\r\n\r\n\t\tif (finalObj.length == 0)\r\n\t\t{\r\n\t\t\t$(\".pf\").append(\"<table class=content_table><tbody><tr><td><table ObjectName=\" + partialPageid + \"></table></td></tr></tbody></table>\");\r\n\t\t\tfinalObj = $(searchText);\r\n\t\t}\r\n\r\n\t\tvar content2 = $tempDiv.html(data.substr(1)).find(searchText).parent().html();\r\n\t\t$tempDiv.html(\"\");\r\n\t\tfinalObj.parent().html(content2).hide().fadeIn(1000);\r\n\r\n\t\tErrorWindowControl();\r\n\t});\r\n}", "size":67848, "mimeType":"text/javascript"}, "headers":[{"name":"Content-Type", "value":"text/javascript"}, {"name":"Last-Modified", "value":"Tue, 28 Jul 2026 12:31:14 GMT"}, {"name":"Accept-Ranges", "value":"bytes"}, {"name":"ETag", "value":"\"1dd1e8cfa9e9c08\""}, {"name":"Vary", "value":"Accept-Encoding"}, {"name":"Server", "value":"Microsoft-IIS/10.0"}, {"name":"X-Powered-By", "value":"ASP.NET"}, {"name":"Date", "value":"Wed, 29 Jul 202