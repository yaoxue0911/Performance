00\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030104,\"inboxSubName\":\"My Reports Pending Review\",\"inboxSubPageId\":\"listInbox_MyPendingReport\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_MyPendingReport\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030104\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030103,\"inboxSubName\":\"My Incomplete Reports\",\"inboxSubPageId\":\"listInbox_IncompleteReport\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_IncompleteReport\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030103\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030102,\"inboxSubName\":\"My Returned Reports\",\"inboxSubPageId\":\"listInbox_ReturnedReport\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_ReturnedReport\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030102\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030105,\"inboxSubName\":\"My Closed Cases (7 Days)\",\"inboxSubPageId\":\"listInbox_MyClosedCase\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_MyClosedCase\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030105\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030106,\"inboxSubName\":\"All Agency Cases (96 hours)\",\"inboxSubPageId\":\"listInbox_AllAgencyCase96\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_AllAgencyCase96\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030106\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030107,\"inboxSubName\":\"All Agency Cases (72 hours)\",\"inboxSubPageId\":\"listInbox_AllAgencyCase24\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_AllAgencyCase24\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030107\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030108,\"inboxSubName\":\"All Agency Cases (12 hours)\",\"inboxSubPageId\":\"listInbox_AllAgencyCase12\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_AllAgencyCase12\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030108\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"}],\r\n\t\t\tsortVersion: 0,\r\n\t\t\tinit() {\r\n\t\t\t\tconst $this = this;\r\n\t\t\t\t$(\"#inboxSetModal\").on(\"hidden.bs.modal\", function ()\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.location.reload();\r\n\t\t\t\t})\r\n\t\t\t\t$(\"#inboxSetModal\").on(\"shown.bs.modal\", function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tif (($this.addToFavSubInboxes.length + $this.favoriteInboxCount) >= $this.maxFavInboxCount) {\r\n\t\t\t\t\t\talert(\"The maximum number of favorite items has been reached. Please delete an existing item before adding a new one.\");\r\n\t\t\t\t\t}\r\n\t\t\t\t})\r\n\t\t\t},\r\n\t\t\tget currentCategorySubInboxes() {\r\n\t\t\t\tconst index = this.data.findIndex(i => i.inboxId == this.activeCategoryId);\r\n\t\t\t\tif(index > -1){\r\n\t\t\t\t\treturn this.data[index].items;\r\n\t\t\t\t}\telse {\r\n\t\t\t\t\treturn [];\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\taddToFavSubInboxes: [],\r\n\t\t\tremoveFromFavSubIndexIds: [],\r\n\t\t\tget favoriteInboxCount() {\r\n\t\t\t\treturn this.favoriteInboxes.length;\r\n\t\t\t},\r\n\t\t\tonClickCategoryItem(inboxId) {\r\n\t\t\t\tif (this.activeCategoryId != inboxId) {\r\n\t\t\t\t\tthis.activeCategoryId = inboxId;\r\n\t\t\t\t\tthis.addToFavSubInboxes = [];\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\ttoggleAddToFav(inboxSubId) {\r\n\t\t\t\tif (this.addToFavSubInboxes.findIndex(i => i.inboxSubId == inboxSubId) > -1) {\r\n\t\t\t\t\tthis.addToFavSubInboxes = this.addToFavSubInboxes.filter(i => i.inboxSubId != inboxSubId);\r\n\t\t\t\t} else {\r\n\t\t\t\t\tif ((this.addToFavSubInboxes.length + this.favoriteInboxCount) >= this.maxFavInboxCount) {\r\n\t\t\t\t\t\talert(\"The maximum number of favorite items has been reached. Please delete an existing item before adding a new one.\");\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tlet categoryInfo = this.data.find(i => i.inboxId == this.activeCategoryId);\r\n\t\t\t\t\tlet subInboxInfo = categoryInfo.items.find(i => i.inboxSubId == inboxSubId);\r\n\t\t\t\t\tthis.addToFavSubInboxes.push({\r\n\t\t\t\t\t\tinboxId: this.activeCategoryId,\r\n\t\t\t\t\t\tinboxDesc: categoryInfo.inboxDesc,\r\n\t\t\t\t\t\tinboxSubId: subInboxInfo.inboxSubId,\r\n\t\t\t\t\t\tinboxSubName: subInboxInfo.inboxSubName,\r\n\t\t\t\t\t})\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\ttoggleRemoveFromFav(inboxSubId) {\r\n\t\t\t\tif (this.removeFromFavSubIndexIds.indexOf(inboxSubId) > -1) {\r\n\t\t\t\t\tthis.removeFromFavSubIndexIds = this.removeFromFavSubIndexIds.filter(i => i != inboxSubId);\r\n\t\t\t\t} else {\r\n\t\t\t\t\tthis.removeFromFavSubIndexIds.push(inboxSubId)\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\tasync addToFavSubInbox_submit() {\r\n\t\t\t\tlet inboxSubIds = [];\r\n\t\t\t\tthis.favoriteInboxes.forEach(i => {\r\n\t\t\t\t\tinboxSubIds.push(i.inboxSubId);\r\n\t\t\t\t})\r\n\t\t\t\tthis.addToFavSubInboxes.forEach(i => {\r\n\t\t\t\t\tinboxSubIds.push(i.inboxSubId);\r\n\t\t\t\t})\r\n\t\t\t\tlet result = await updateFavInbox(inboxSubIds);\r\n\t\t\t\tif (result.ok) {\r\n\t\t\t\t\tthis.addToFavSubInboxes.forEach(i => {\r\n\t\t\t\t\t\tthis.favoriteInboxes.push(i);\r\n\t\t\t\t\t})\r\n\t\t\t\t\tthis.addToFavSubInboxes = [];\r\n\t\t\t\t\tthis.data.forEach(category => {\r\n\t\t\t\t\t\tcategory.items.forEach(i => {\r\n\t\t\t\t\t\t\tlet favIndex = this.favoriteInboxes.findIndex(j => j.inboxSubId == i.inboxSubId);\r\n\t\t\t\t\t\t\ti.isInFav = favIndex != -1;\r\n\t\t\t\t\t\t})\r\n\t\t\t\t\t})\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\tasync removeFromFav_submit() {\r\n\t\t\t\tlet inboxSubIds = [];\r\n\t\t\t\tthis.favoriteInboxes.forEach(i => {\r\n\t\t\t\t\tif (this.removeFromFavSubIndexIds.findIndex(j => j == i.inboxSubId) == -1) {\r\n\t\t\t\t\t\tinboxSubIds.push(i.inboxSubId)\r\n\t\t\t\t\t}\r\n\t\t\t\t})\r\n\t\t\t\tlet result = await updateFavInbox(inboxSubIds)\r\n\t\t\t\tif (result.ok) {\r\n\r\n\t\t\t\t}\r\n\t\t\t\tthis.favoriteInboxes = this.favoriteInboxes.filter(i => this.removeFromFavSubIndexIds.findIndex(j => j == i.inboxSubId) == -1)\r\n\t\t\t\tthis.removeFromFavSubIndexIds = [];\r\n\t\t\t\tthis.data.forEach(category => {\r\n\t\t\t\t\tcategory.items.forEach(i => {\r\n\t\t\t\t\t\tlet favIndex = this.favoriteInboxes.findIndex(j => j.inboxSubId == i.inboxSubId);\r\n\t\t\t\t\t\ti.isInFav = favIndex != -1;\r\n\t\t\t\t\t})\r\n\t\t\t\t})\r\n\t\t\t},\r\n\t\t\tasync sortFavSubInboxes(item, targetIndex) {\r\n\t\t\t\t/* x-sort not work with x-for\r\n\t\t\t\t * :key=\"Math.floor( Math.random() * 999999 )\r\n\t\t\t\t *  ref https://github.com/alpinejs/alpine/discussions/4157#discussioncomment-13537722\r\n\t\t\t\t */\r\n\t\t\t\tconst itemIndex = this.favoriteInboxes.indexOf(item)\r\n\t\t\t\tthis.favoriteInboxes.splice(itemIndex, 1);\r\n\t\t\t\tthis.favoriteInboxes.splice(targetIndex, 0, item);\r\n\t\t\t\tthis.sortVersion = this.sortVersion + 1;\r\n\t\t\t\tconsole.table(this.favoriteInboxes);\r\n\t\t\t\tlet inboxSubIds = [];\r\n\t\t\t\tthis.favoriteInboxes.forEach(i => {\r\n\t\t\t\t\tinboxSubIds.push(i.inboxSubId);\r\n\t\t\t\t})\r\n\t\t\t\tlet result = await updateFavInbox(inboxSubIds)\r\n\t\t\t\t\tif (result.ok) {\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}));\r\n\t})\r\n</script>\t<div id=\"allMessage\" class=\"position-absolute p-2 border bg-body text-body\"\r\n\t\t style=\"max-height: 250px;overflow-y: auto;display:none;z-index:2000;\"></div>\r\n\t<!-- concurrent logins tips -->\r\n\t<div id=\"divConcurrentLoginsTips\" class=\"concurrent_logins_tips_bak\" style=\"display: none;\">\r\n\t\t<div style=\"height: 80px; margin: 20px; font-size: 20px;font-family:'Lato', Calibri, sans-serif;\">\r\n\t\t\t<b>WARNING:</b> Your account has logged on to another session.  To retain this other session hit continue To terminate the other session hit Force Logout.\r\n\t\t</div>\r\n\t\t<table style=\"width: 100%;\">\r\n\t\t\t<tr>\r\n\t\t\t\t<td style=\"text-align: right;\">\r\n\t\t\t\t\t<input type=\"button\" action_type=\"LOGOUT\" class=\"btn btn-danger\" value=\"Force Logout\" onclick=\"SetConcurrentLoginsAction('LOGOUT')\" />\r\n\t\t\t\t</td>\r\n\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t<input type=\"button\" action_type=\"CONTINUE\" class=\"btn btn-secondary\" value=\"Continue\" onclick=\"SetConcurrentLoginsAction('CONTINUE')\" />\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n<div id=\"systemAbout\" class=\"position-fixed z-100 bg-body border text-body p-2 shadow\"\r\n\t style=\"top:96px;width: 700px;display:none;\">\r\n\t<div class=\"d-flex justify-content-center\">\r\n\t\t<img id=\"imgInfoShare\" src=\"/RMS/images/infoshare_day.png\" alt=\"INFOSHARE\" />\r\n\t</div>\r\n\t<div id=\"versionInfo\"></div>\r\n\t<div class=\"text-xs\">\r\n\t\t<div class=\"text-end\">Copyright \u00a9 CSI Technology Group. All rights reserved.</div>\r\n\t\t<div class=\"text-end\">\r\n\t\t\t<span>INFOSHARE &trade;</span> &nbsp;\r\n\t\t\t<a onclick=\"parent.window.open('http://www.csitech.com','_blank');\" href=\"#\" hidefocus=\"hidefocus\">\r\n\t\t\t\tVisit\r\n\t\t\t\tour site: http://www.csitech.com\r\n\t\t\t</a>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n<script>\r\n\tfunction showAbout()\r\n\t{\r\n\t\t$.get(ResolveClientUrl(\"~/\") + 'home?handler=systemVersionInfo', (data) =>\r\n\t\t{\r\n\t\t\t$(\"#versionInfo\").html(data);\r\n\t\t\t$(\"#systemAbout\").slideDown(\"fast\");\r\n\t\t});\r\n\t}\r\n\tdocument.addEventListener('click', function (event)\r\n\t{\r\n\t\tconst popup = document.getElementById('systemAbout');\r\n\t\tconst banner = document.querySelector(\".app-header__banner\");\r\n\t\tif (!popup.contains(event.target) && !banner.contains(event.target))\r\n\t\t{\r\n\t\t\tpopup.style.display = 'none';\r\n\t\t}\r\n\t});\r\n</script>\r\n\t<script src=\"/RMS/lib/jquery/dist/jquery.min.js\"></script>\r\n\t<!--<script>$.uiBackCompat = true;</script>-->\r\n\t<script src=\"/RMS/lib/jqueryui/jquery-ui.min.js\"></script>\r\n\t<script src=\"/RMS/lib/bootstrap/dist/js/bootstrap.bundle.min.js?v=Bh8LHqeebiyiT0YD5V0-kJ90cboLJ5zbbepAVUEGxqI\"></script>\r\n\t<script src=\"/RMS/js/aspsoft/CommonParam.js?v=8yn-HMK90Ov2aE3W-8tS3MxOiU4kTLmTHffXkFa80Vc\"></script>\r\n\t<script src=\"/RMS/js/aspsoft/MultiLayerDialog.js?v=3LawXtRbI6ed6QQ1rYekdJG74IpK3g3pMr1Kw5yJtxI\"></script>\r\n\t<script src=\"/RMS/js/global.js?v=1f3CwWam8TavC2uqWUrDlCa2LyayLQQgSx5WjKSrx8Q\"></script>\r\n\t<script defer src=\"/RMS/lib/alpinejs-sort/cdn.min.js?v=tFKFh4yWJOYN69Holh9DDjSctbLmWsWgHQLDroJAnjw\"></script>\r\n\t<script defer src=\"/RMS/lib/alpinejs/cdn.min.js?v=4EHxtjnR5rL8JzbY12OKQJr81ESm7JBEb49ORPo29AY\"></script>\r\n\t<script>\r\n\t\tvar __client_request_root_url = \"/RMS/\";\r\n\t\tvar __disclaimer_config__ = \"3@Disclaimer.htm,20@Disclaimer.htm\";\r\n\t\t// division change\r\n\t\tfunction changeDivision(divisionId) {\r\n\t\t\tif (refreshMenu(divisionId) == false) return;\r\n\t\t\tconst url = ResolveClientUrl('~/Home?division_id=') + divisionId;\r\n\t\t\t$(\"iframe[name='main']\", window.top.document).attr(\"src\", url);\r\n\t\t}\r\n\r\n\t\tfunction refreshMenu(newDevId) {\r\n\t\t\tvar newDivisionID = newDevId;\r\n\t\t\tvar files = __disclaimer_config__;\r\n\t\t\tif (files != '') {\r\n\t\t\t\tvar fileName = \"\", showDivisionID = \"\";\r\n\t\t\t\tvar filesArray = files.split(',');\r\n\t\t\t\tfor (var i = 0; i < filesArray.length; i++) {\r\n\t\t\t\t\tvar fileArray = filesArray[i].split('@');\r\n\t\t\t\t\tif (fileArray[0] == newDivisionID) {\r\n\t\t\t\t\t\tshowDivisionID = fileArray[0];\r\n\t\t\t\t\t\tfileName = fileArray[1];\r\n\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (fileName != \"\" && showDivisionID == newDivisionID) {\r\n\t\t\t\t\tPopUp(ResolveClientUrl(\"~/AspSoft/Disclaimer/\" + fileName), 650, 650, \"\", function (retVal) {\r\n\t\t\t\t\t\tif (!retVal) {\r\n\t\t\t\t\t\t\tnewDivisionID = 0;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tconst tmp = jumpModuleByDivision(newDivisionID);\r\n\t\t\t\t\t\tif (tmp) {\r\n\t\t\t\t\t\t\tconst url = ResolveClientUrl('~/Home?division_id=') + newDivisionID;\r\n\t\t\t\t\t\t\t$(\"iframe[name='main']\", window.top.document).attr(\"src\", url);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n\t\t\t\t\tSetDialogTitle(\"Agreement\");\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tvar re = jumpModuleByDivision(newDivisionID);\r\n\t\t\treturn re;\r\n\t\t}\r\n\r\n\t\tfunction jumpModuleByDivision(newDivisionID) {\r\n\t\t\tconst requestUrl = ResolveClientUrl(\"~/AspSoft/EngineService/changeconnection?source=menu&division_id=\") + newDivisionID;\r\n\t\t\tlet result = false;\r\n\t\t\tExecSync(requestUrl, {}, function (data)\r\n\t\t\t{\r\n\t\t\t\tif (data.status == \"true\" || data.status == \"false\")\r\n\t\t\t\t{\r\n\t\t\t\t\tresult = true;\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tif (data.status.indexOf(\"<\") != -1 || data.status.indexOf(\">\") != -1)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tresult = true;\r\n\t\t\t\t\t} else\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar guid = data.status.substring(0, 32);\r\n\t\t\t\t\t\tvar url = data.status.substring(33);\r\n\t\t\t\t\t\tconst formHtml = `\r\n\t\t\t\t\t\t\t<form id=\"dynForm\" action=\"${url}/Login.aspx\" method=\"post\" target=\"_top\">\r\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"action\" value=\"login_by_ticket\">\r\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"guid\"   value=\"${guid}\">\r\n\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"division_id\"   value=\"${newDivisionID}\">\r\n\t\t\t\t\t\t\t</form>`;\r\n\t\t\t\t\t\tconst $form = $(formHtml).appendTo('body');\r\n\t\t\t\t\t\t$form[0].submit();\r\n\t\t\t\t\t\t$form.remove();\r\n\t\t\t\t\t\tresult = false;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t\treturn result;\r\n\t\t}\r\n\t\tfunction AutoClickSubmit() {\r\n\t\t\tvar evt = GetEvent();\r\n\t\t\tvar element = evt.srcElement || evt.target;\r\n\t\t\tvar key = evt.keyCode || evt.which;\r\n\t\t\tif (key == 13) {\r\n\t\t\t\tevt.cancelBubble = true;\r\n\t\t\t\tevt.returnValue = false;\r\n\t\t\t\tvar $submit = $(element).closest('form').find(':submit');\r\n\t\t\t\tif ($submit.length > 0) {\r\n\t\t\t\t\t$submit[0].click();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfunction RemoteLoginToePro(id)\r\n\t\t{\r\n\t\t\treturn RemoteLoginCommon(id);\r\n\t\t}\r\n\r\n\t\tfunction RemoteLoginCommon(id, node_id)\r\n\t\t{\r\n\t\t\tconst requestUrl = ResolveClientUrl(\"~/AspSoft/EngineService/getremotekey?node_id=\" + node_id + \"&rnd=\") + Math.random();\r\n\t\t\tExec(requestUrl, {}, function (ret)\r\n\t\t\t{\r\n\t\t\t\tif (ret == \"true\" || ret == \"false\")\r\n\t\t\t\t{\r\n\t\t\t\t\talert(\"Single Sign On function is unavailable, please contact administrators.\");\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tvar guid = ret.substring(0, 32);\r\n\t\t\t\t\tvar url = ret.substring(33);\r\n\t\t\t\t\tconst formHtml = `\r\n\t\t\t\t\t<form id=\"dynRemoteForm\" action=\"${url}/Login.aspx\" method=\"post\" target=\"_blank\">\r\n\t\t\t\t\t\t<input type=\"hidden\" name=\"action\" value=\"login_by_remote\">\r\n\t\t\t\t\t\t<input type=\"hidden\" name=\"guid\"   value=\"${guid}\">\r\n\t\t\t\t\t</form>`;\r\n\r\n\t\t\t\t\tconst $form = $(formHtml).appendTo('body');\r\n\r\n\t\t\t\t\t$form[0].submit();\r\n\t\t\t\t\t$form.remove();\r\n\t\t\t\t\treturn false;\r\n\t\t\t\t}\r\n\t\t\t})\r\n\t\t}\r\n\r\n\t\t$(function () {\r\n\t\t\t$(\"#themeSwitch\").on(\"change\",function () {\r\n\t\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/EngineService/UpdateDayNight\") + '?rn=' + Math.random() + '';\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: url,\r\n\t\t\t\t\tsuccess: () => {\r\n\t\t\t\t\t\t// window.location.reload()\r\n\t\t\t\t\t\tdocument.querySelector(\"html\")\r\n\t\t\t\t\t\t\t.setAttribute(\"data-csi-theme\", this.checked ? \"dark\" : \"light\");\r\n\t\t\t\t\t\tdocument.querySelector(\"body\").classList\r\n\t\t\t\t\t\t\t.remove(\"nightmode_none\",\"nightmode\")\r\n\t\t\t\t\t\tdocument.querySelector(\"body\").classList\r\n\t\t\t\t\t\t\t.add(this.checked ? \"nightmode\" : \"nightmode_none\");\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\treturn false;\r\n\t\t\t});\r\n\t\t})\r\n\t</script>\r\n\t<script>\r\n\t\t$(function ()\r\n\t\t{\r\n\t\t\tif (\"0\" == \"1\")\r\n\t\t\t{\r\n\t\t\t\tvar url = \"AspSoft/PopupDispatcher?nextPID=authenWillExpire&rnd=\" + Math.random();\r\n\t\t\t\tPopUp(url, 650, 300, '', function (res)\r\n\t\t\t\t{\r\n\t\t\t\t\t//alert(\"Res: \" + res);\r\n\t\t\t\t});\r\n\t\t\t}\r\n\r\n\t\t\tif (\"\" == \"Y\")\r\n\t\t\t{\r\n\t\t\t\talert(1)\r\n\t\t\t\tvar url = \"AspSoft/PopupDispatcher?nextPID=recoveryCodeWarning&rnd=\" + Math.random();\r\n\t\t\t\tPopUp(url, 650, 400, '', function (res)\r\n\t\t\t\t{\r\n\t\t\t\t\t//alert(\"Res: \" + res);\r\n\t\t\t\t});\r\n\t\t\t}\r\n\r\n\r\n\t\t\tif (''==\"1\"&&''==\"1\")\r\n\t\t\t{\r\n\t\t\t\t\tShowConcurrentLoginsTips();\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\tfunction ShowConcurrentLoginsTips()\r\n\t\t{\r\n\t\t\t$(\"#customOverlay, #customModal\").remove();\r\n\r\n\t\t\tvar $overlay = $(\"<div>\", {\r\n\t\t\t\tid: \"customOverlay\"\r\n\t\t\t}).css({\r\n\t\t\t\tposition: \"fixed\",\r\n\t\t\t\ttop: 0,\r\n\t\t\t\tleft: 0,\r\n\t\t\t\twidth: \"100%\",\r\n\t\t\t\theight: \"100%\",\r\n\t\t\t\tbackground: \"rgba(0,0,0,0.3)\",\r\n\t\t\t\tzIndex: 9998\r\n\t\t\t});\r\n\r\n\t\t\tvar isNightMode =\"0\";\r\n\r\n\t\t\tvar $modal = $(\"<div>\", {\r\n\t\t\t\tid: \"customModal\",\r\n\t\t\t\thtml: $(\"#divConcurrentLoginsTips\").html()\r\n\t\t\t}).css({\r\n\t\t\t\tposition: \"fixed\",\r\n\t\t\t\twidth: \"500px\",\r\n\t\t\t\theight: \"180px\",\r\n\t\t\t\tcursor: \"default\",\r\n\t\t\t\ttextAlign: \"left\",\r\n\t\t\t\tzIndex: 9999,\r\n\t\t\t\tpadding: \"15px\",\r\n\t\t\t\tboxSizing: \"border-box\",\r\n\t\t\t\tborderRadius: \"6px\",\r\n\t\t\t\tboxShadow: \"0 2px 10px rgba(0,0,0,0.2)\",\r\n\r\n\t\t\t\ttop: \"50%\",\r\n\t\t\t\tleft: \"50%\",\