tive-bg: #364759;\r\n\t}\r\n\r\n\t#inboxSetModal .list-group-item:active,\r\n\t#inboxSetModal .list-group-item.active {\r\n\t\tbackground-color: var(--csi-list-group-active-bg);\r\n\t}\r\n\r\n\t.fav-inboxes-list .info-icon-drag_handle {\r\n\t\topacity: 0.9;\r\n\t}\r\n\r\n\tbody.sorting\r\n\t#inboxSetModal\r\n\t.fav-inboxes-list\r\n\t.list-group-item-action:not(.sortable-ghost) {\r\n\t\tbackground-color: unset !important;\r\n\t}\r\n\r\n\t.sortable-ghost {\r\n\t\topacity: 1 !important;\r\n\t\tbackground-color: var(--csi-list-group-active-bg);\r\n\t}\r\n</style>\r\n<div class=\"modal fade\" id=\"inboxSetModal\" x-data=\"favSettings\">\r\n\t<div class=\"modal-dialog modal-xl\">\r\n\t\t<div class=\"modal-content rounded-0 border-top-highlight\">\r\n\t\t\t<div class=\"modal-header\">\r\n\t\t\t\t<h6 class=\"modal-title mx-auto ps-4 text-primary fw-semibold\">My Favorite Inbox Setting</h6>\r\n\t\t\t\t<button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n\t\t\t</div>\r\n\t\t\t<div class=\"modal-body\" style=\"height: 800px\">\r\n\t\t\t\t<div class=\"row h-100\">\r\n\t\t\t\t\t<div class=\"col bg-body-tertiary position-relative h-100 d-flex flex-column\">\r\n\t\t\t\t\t\t<ul class=\"inbox-category navbar-nav flex-row flex-wrap\">\r\n\t\t\t\t\t\t\t<template x-for=\"(item,index) in data\">\r\n\t\t\t\t\t\t\t\t<li class=\"nav-item\" x-on:click=\"onClickCategoryItem(item.inboxId)\">\r\n\t\t\t\t\t\t\t\t\t<div class=\"d-flex align-items-center\">\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"inbox-category-name fw-semibold py-1 px-2\" type=\"button\"\r\n\t\t\t\t\t\t\t\t\t\t\t  x-bind:class=\"item.inboxId == activeCategoryId?'text-bg-primary':'text-primary'\"\r\n\t\t\t\t\t\t\t\t\t\t\t  x-text=\"item.inboxDesc\">\r\n\t\t\t\t\t\t\t\t\t\t</span>\r\n\t\t\t\t\t\t\t\t\t\t<div style=\"height:16px\">\r\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"vr\" x-show=\"index!=data.length-1\"></div>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t</template>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t\t<hr />\r\n\t\t\t\t\t\t<div class=\"subInbox-list list-group flex-fill overflow-y-auto\">\r\n\t\t\t\t\t\t\t<template x-for=\"item in currentCategorySubInboxes\">\r\n\t\t\t\t\t\t\t\t<div class=\"list-group-item list-group-item-action border-0 d-flex justify-content-between align-items-center\"\r\n\t\t\t\t\t\t\t\t\t x-bind:class=\"{'active':addToFavSubInboxes.findIndex(i=>i.inboxSubId == item.inboxSubId)>-1,'disabled':item.isInFav}\"\r\n\t\t\t\t\t\t\t\t\t x-on:click=\"toggleAddToFav(item.inboxSubId)\">\r\n\t\t\t\t\t\t\t\t\t<div x-text=\"item.inboxSubName\"></div>\r\n\t\t\t\t\t\t\t\t\t<i class=\"info-icon-checked text-primary text-xl\"\r\n\t\t\t\t\t\t\t\t\t   x-show=\"addToFavSubInboxes.findIndex(i=>i.inboxSubId == item.inboxSubId)>-1\"></i>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</template>\r\n\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class=\"fav-inboxes-list col h-100\">\r\n\t\t\t\t\t\t<div class=\"row h-100\">\r\n\t\t\t\t\t\t\t<div class=\"col-auto h-100\">\r\n\t\t\t\t\t\t\t\t<div class=\"d-flex flex-column justify-content-center align-items-center h-100\">\r\n\t\t\t\t\t\t\t\t\t<button class=\"btn border-0 \"\r\n\t\t\t\t\t\t\t\t\t\t\tx-bind:class=\"removeFromFavSubIndexIds.length>0?'text-primary':'disabled'\"\r\n\t\t\t\t\t\t\t\t\t\t\tx-on:click=\"removeFromFav_submit()\">\r\n\t\t\t\t\t\t\t\t\t\t<i class=\"info-icon-arrow_circle_left text-2xl\"></i>\r\n\t\t\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t\t\t\t<button class=\"btn border-0\"\r\n\t\t\t\t\t\t\t\t\t\t\tx-bind:class=\"addToFavSubInboxes.length>0?'text-primary':'disabled'\"\r\n\t\t\t\t\t\t\t\t\t\t\tx-on:click=\"addToFavSubInbox_submit()\">\r\n\t\t\t\t\t\t\t\t\t\t<i class=\"info-icon-arrow_circle_right text-2xl\"></i>\r\n\t\t\t\t\t\t\t\t\t</button>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t<div class=\"col h-100 d-flex flex-column\">\r\n\t\t\t\t\t\t\t\t<div class=\"d-flex justify-content-between align-items-center mb-2\">\r\n\t\t\t\t\t\t\t\t\t<div class=\"text-sm fw-bold text-uppercase\">My Favorite</div>\r\n\t\t\t\t\t\t\t\t\t<div class=\"badge rounded-pill bg-body-secondary text-body-tertiary\">\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"text-body\" x-text=\"favoriteInboxCount\"></span>\r\n\t\t\t\t\t\t\t\t\t\t/\r\n\t\t\t\t\t\t\t\t\t\t<span x-text=\"maxFavInboxCount\"></span>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<template x-if=\"favoriteInboxes.length ==0\">\r\n\t\t\t\t\t\t\t\t\t<div class=\"d-flex flex-column justify-content-center align-items-center mt-5 opacity-20\">\r\n\t\t\t\t\t\t\t\t\t\t<span class=\"svg-icon icon-empty\"></span>\r\n\t\t\t\t\t\t\t\t\t\tAdd up to EIGHT items from the left.\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</template>\r\n\t\t\t\t\t\t\t\t<div class=\"list-group flex-fill overflow-y-auto\" x-sort=\"sortFavSubInboxes.bind($data)\"\r\n\t\t\t\t\t\t\t\t\t x-sort:config=\"{handle:'.info-icon-drag_handle'}\">\r\n\t\t\t\t\t\t\t\t\t<template x-for=\"(item,index) in favoriteInboxes\" :key=\"`${sortVersion}_${item.inboxSubId}`\">\r\n\t\t\t\t\t\t\t\t\t\t<div class=\"list-group-item list-group-item-action border-0 border-bottom d-flex justify-content-between align-items-center mb-1\"\r\n\t\t\t\t\t\t\t\t\t\t\t x-bind:class=\"{'active':removeFromFavSubIndexIds.findIndex(i=>i == item.inboxSubId)>-1}\"\r\n\t\t\t\t\t\t\t\t\t\t\t x-sort:item=\"item\"\r\n\t\t\t\t\t\t\t\t\t\t\t x-on:click.prevent=\"toggleRemoveFromFav(item.inboxSubId)\">\r\n\t\t\t\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"d-flex align-items-center\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t<i class=\"info-icon-star me-2\" data-is-fav=\"true\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"text-xs text-body-tertiary\"\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t  x-text=\"item.inboxDesc\"></span>\r\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"text-sm\" x-text=\"item.inboxSubName\"></div>\r\n\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t\t<div>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<template x-if=\"removeFromFavSubIndexIds.indexOf(item.inboxSubId)>-1\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t<i class=\"info-icon-checked text-primary text-xl\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t\t</template>\r\n\t\t\t\t\t\t\t\t\t\t\t\t<template x-if=\"removeFromFavSubIndexIds.indexOf(item.inboxSubId)==-1\">\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t<i class=\"info-icon-drag_handle text-body-secondary text-xl\"\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t   style=\"cursor: move\"></i>\r\n\t\t\t\t\t\t\t\t\t\t\t\t</template>\r\n\t\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t</template>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\t\t\t<template x-if=\"favoriteInboxCount==maxFavInboxCount\">\r\n\t\t\t\t<div class=\"warning\">\r\n\t\t\t\t\tThe maximum number of favorite items has been reached.\r\n\t\t\t\t\t<br />\r\n\t\t\t\t\tPlease delete an existing item before adding a new one.\r\n\t\t\t\t</div>\r\n\t\t\t</template>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n<script>\r\n\tasync function updateFavInbox(sortedInboxSubIds) {\r\n\t\tlet url = \"/RMS/AspSoft/HomeHandler/updateFavInboxes\";\r\n\t\treturn await fetch(url, {\r\n\t\t\tmethod: 'POST',\r\n\t\t\tbody: JSON.stringify(sortedInboxSubIds),\r\n\t\t\theaders: {\r\n\t\t\t\t\"Content-Type\": \"application/json\"\r\n\t\t\t},\r\n\t\t});\r\n\t}\r\n\r\n\tdocument.addEventListener(\"alpine:init\", () => {\r\n\t\tAlpine.data(\"favSettings\", () => ({\r\n\t\t\tdata: [{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"items\":[{\"inboxSubId\":10030101,\"inboxSubName\":\"My Active Incidents/Cases\",\"inboxSubPageId\":\"listInbox_MyActiveCase\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_MyActiveCase\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030101\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\",\"isInFav\":true,\"count\":1,\"hasCount\":true},{\"inboxSubId\":10030102,\"inboxSubName\"