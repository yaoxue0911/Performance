.1", "cookies":[], "content":{"compression":0, "text":"class Middle\r\n{\r\n\tconstructor(templateID, caseID, reportID, nextPID, PID, $masterSections, extConfig)\r\n\t{\r\n\t\tthis.version = \"4.0.1\";\r\n\t\tthis.title = \"Middle Page Process\";\r\n\t\tthis.apiUrl = \"MiddlePage\";\r\n\t\tthis.templateID = templateID;\r\n\t\tthis.caseID = caseID;\r\n\t\tthis.reportID = reportID;\r\n\t\tthis.nextPID = nextPID;\r\n\t\tthis.PID = PID;\r\n\t\tthis.$btnCreateReport = $(\"#btnCreateReport\");\r\n\t\tthis.$masterSections = $masterSections || null;\r\n\t\tthis.extConfig = extConfig || {};\r\n\r\n\t\t//this.consoleLog('Middle class initialized, templateID: ' + this.templateID + ', caseID: ' + this.caseID + ', reportID: ' + this.reportID + ', nextPID: ' + this.nextPID + ', PID: ' + this.PID);\r\n\t\t//console.log(this.extConfig);\r\n\r\n\t\t//Used to store all checkbox/radio element IDs in master sections.\r\n\t\tthis.AllIDs = [];\r\n\r\n\t\t//Save checked IDs before PartialRefresh\r\n\t\tthis.CacheIDs = \"\";\r\n\r\n\t\t//Save checked note IDs before PartialRefresh, since the Narrative is displayed in a <div> and users may click other hyperlinks.\r\n\t\tthis.CacheNoteIDs = \"\";\r\n\r\n\t\tthis.init();\r\n\r\n\t\tif (this.extConfig.AutoSubmit)\r\n\t\t{\r\n\t\t\tthis.createReport();\r\n\t\t}\r\n\t}\r\n\r\n\tgetVersion()\r\n\t{\r\n\t\treturn `version ${this.version}`;\r\n\t}\r\n\r\n\r\n\tinit()\r\n\t{\r\n\t\tthis.bindEvents();\r\n\t\tthis.handleParentChildSection();\r\n\t\tthis.initMasterCheckBoxStatus();\r\n\r\n\t\tif (this.reportID > 0)\r\n\t\t{\r\n\t\t\tthis.$btnCreateReport.val(\"Update Report\");\r\n\t\t}\r\n\t}\r\n\r\n\t//Handle both parent and child sections\r\n\thandleParentChildSection()\r\n\t{\r\n\t\tvar $tbChilds = this.$masterSections.filter(function ()\r\n\t\t{\r\n\t\t\tvar val = $(this).data(\"parent-master-index-type\");\r\n\t\t\treturn typeof val !== \"undefined\" && String(val).trim() !== \"\";\r\n\t\t});\r\n\r\n\t\t/*$tbChilds.each(function (idx, obj)\r\n\t\t{\r\n\t\t\tvar s1 = $(obj).data(\"parent-master-index-type\");\r\n\t\t\tvar s2 = $(obj).data(\"parentMasterIndexType\");\r\n\t\t\tconsole.log(`${idx}  s1:${s1}  s2:${s2}`);\r\n\t\t});*/\r\n\r\n\t\tthis.extConfig.HasChildSection = $tbChilds.length > 0;\r\n\t\tvar that = this;\r\n\t\tvar tbChild, tbParent, tbParentSection;  //Track the current parent and child sections.\r\n\r\n\t\tif (this.extConfig.HasChildSection)\r\n\t\t{\r\n\t\t\t$tbChilds.each((i, el) =>\r\n\t\t\t{\r\n\t\t\t\tvar $el = $(el);\r\n\r\n\t\t\t\ttbChild = $el.find(\"table[ObjectName^='listIntakeFormMaster']\");\r\n\t\t\t\t$(tbChild).find(\":checkbox,:radio\").prop(\"checked\", false);\r\n\t\t\t\t$(tbChild).find(\"tr.gridodd, tr.grideven\").hide();\r\n\r\n\t\t\t\tvar childtObjectName = $el.data(\"master-index-type\");\r\n\t\t\t\tvar parentObjectName = $el.data(\"parent-master-index-type\");\r\n\r\n\t\t\t\ttbParentSection = $(\"div[data-master-index-type='\" + parentObjectName + \"']\");\r\n\t\t\t\ttbParent = $(tbParentSection).find(\"table[ObjectName^='listIntakeFormMaster']\");\r\n\t\t\t\tvar parentKeyFieldName = $(tbParentSection).data(\"object-keyfield-name\");\r\n\t\t\t\tvar childKeyFieldName = $el.data(\"object-keyfield-name\");\r\n\t\t\t\tvar parent_qty = tbParentSection.find(\":hidden[data-obj-name='qty']\").val();\r\n\r\n\t\t\t\t// part 1\r\n\t\t\t\t$(document).on(\"click\", \"#\" + $(tbParent).closest(\"div[data-master-index-type]\").attr(\"id\") + \" :checkbox,#\" + $(tbParent).closest(\"div[data-master-index-type]\").attr(\"id\") + \" :radio\",\r\n\t\t\t\t\t{ parentKeyFieldName: parentKeyFieldName, parent_qty: parent_qty, childKeyFieldName: childKeyFieldName },\r\n\t\t\t\t\tfunction (e)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tvar cur_parent_main_id = $(e.currentTarget).parent().find(\":hidden[ObjectName='\" + e.data.parentKeyFieldName + \"']\").val();\r\n\t\t\t\t\t\tvar cur_parentSelected = $(e.currentTarget).is(\":checked\");\r\n\t\t\t\t\t\tvar cur_parentSection = $(e.currentTarget).closest(\"div[data-master-index-type]\");\r\n\t\t\t\t\t\tvar cur_parentObjectName = $(cur_parentSection).data(\"master-index-type\");\r\n\t\t\t\t\t\tvar cur_parentKeyFieldName = $(cur_parentSection).data(\"object-keyfield-name\");\r\n\r\n\t\t\t\t\t\t// part 2\r\n\t\t\t\t\t\tvar $cur_tbChilds = $(\"div[data-obj-name=master_section][data-parent-master-index-type='\" + cur_parentObjectName + \"']\");\r\n\t\t\t\t\t\t$cur_tbChilds.each((i, cel) =>\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tvar $cel = $(cel);\r\n\t\t\t\t\t\t\tvar cur_childtObjectName = $cel.data(\"master-index-type\");\r\n\t\t\t\t\t\t\tvar cur_childKeyFieldName = $cel.data(\"object-keyfield-name\");\r\n\t\t\t\t\t\t\tvar cur_tbChild = $cel.find(\"table[ObjectName^='listIntakeFormMaster']\");\r\n\t\t\t\t\t\t\t$(cur_tbChild).find(\":checkbox,:radio\").prop(\"checked\", false);\r\n\t\t\t\t\t\t\t$(cur_tbChild).find(\"tr.gridodd, tr.grideven\").hide();\r\n\r\n\t\t\t\t\t\t\t//var childs_count = $(cur_tbChild).find(\"[ObjectName='\" + cur_parentKeyFieldName + \"'][value='\" + cur_parent_main_id + \"']\").length;\r\n\t\t\t\t\t\t\t//var unmatch_row_count = (parent_qty < childs_count);  //It's RI function\r\n\r\n\t\t\t\t\t\t\t// part 3\r\n\t\t\t\t\t\t\t$(cur_tbChild).find(\":hidden[ObjectName='\" + cur_parentKeyFieldName + \"'][value='\" + cur_parent_main_id + \"']\").each(function (idx, hdn)\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tvar willCheck = false;\r\n\t\t\t\t\t\t\t\tvar $childObj = $(hdn).closest(\"td\").find(\":checkbox[ObjectName='\" + cur_childKeyFieldName + \"'],:radio[ObjectName='\" + cur_childKeyFieldName + \"']\");\r\n\t\t\t\t\t\t\t\tvar child_id = $childObj.val();\r\n\r\n\t\t\t\t\t\t\t\tif (!cur_parentSelected) //If the suspect is not checked, do not select the related charge.\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\twillCheck = false;\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t/*else if (unmatch_row_count)\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\twillCheck = false;\r\n\t\t\t\t\t\t\t\t}*/\r\n\t\t\t\t\t\t\t\telse if (that.reportID == \"0\" || that.reportID == \"\")\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\twillCheck = true;\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\telse //Determine checkbox status based on the previous selection (last status).\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\twillCheck = that.valueInList(cur_childtObjectName + \"_\" + cur_childKeyFieldName, child_id, that.extConfig.SeletedMasterID);\r\n\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t\t$childObj.prop(\"checked\", willCheck);\r\n\r\n\t\t\t\t\t\t\t\tif (cur_parentSelected || willCheck)\r\n\t\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\t\t$(hdn).closest(\"tr\").show();\r\n\t\t\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\t\t}); //End click event.  -> part 3\r\n\r\n\t\t\t\t\t\t}); //$cur_tbChilds.each  -> part 2\r\n\r\n\t\t\t\t\t});\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\t//A custom script is used to handle charge-related logic (e.g., in Arrest Reports).\r\n\t\t//Ensure a hidden input element named \"person_id\" is added to the charge section.\r\n\t\tvar $tbCharge = $(\"table[ObjectName='listIntakeFormMaster_Charge'],table[ObjectName='listIntakeFormMaster_Citation']\");\r\n\t\tif ($tbCharge.length <= 0)\r\n\t\t{\r\n\t\t\t$tbCharge = $(\"table[ObjectName='listIntakeFormMaster_Charge_JV']\");\r\n\t\t}\r\n\r\n\t\tvar hasChargeSection = $tbCharge.length > 0;\r\n\t\tif (hasChargeSection)\r\n\t\t{\r\n\t\t\t$tbCharge.find(\":checkbox,:radio\").prop(\"checked\", false);\r\n\t\t\t$tbCharge.find(\"tr.gridodd, tr.grideven\").hide();\r\n\r\n\t\t\t//After changing the suspect checkbox status, hide or show the related charge items accordingly.\r\n\t\t\tvar that = this;\r\n\t\t\t$(document).on(\"click\", \"table[ObjectName^='listIntakeFormMaster_Suspect'] :checkbox[islist=1],table[ObjectName='listIntakeFormMaster_Suspect'] :radio\",\r\n\t\t\t\tfunction (e)\r\n\t\t\t\t{\r\n\t\t\t\t\tthat.middlePageSelectChargeByPerson($(e.currentTarget));\r\n\t\t\t\t});\r\n\r\n\t\t\t$(document).on(\"click\", \"table[ObjectName='listIntakeFormMaster_Arrestee_NIBRS'] :checkbox,table[ObjectName='listIntakeFormMaster_Arrestee_NIBRS'] :radio\",\r\n\t\t\t\tfunction (e)\r\n\t\t\t\t{\r\n\t\t\t\t\tthat.middlePageSelectChargeByPerson($(e.currentTarget));\r\n\t\t\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\tmiddlePageSelectChargeByPerson($sender)\r\n\t{\r\n\t\tvar index_type = \"CHARGE\";\r\n\t\tvar $charge = $(\"div[data-master-index-type='\" + index_type + \"'],div[data-master-index-type='CITATION']\");\r\n\t\tif ($charge.length <= 0)\r\n\t\t{\r\n\t\t\tindex_type = \"JV_CHARGE\";\r\n\t\t\t$charge = $(\"div[data-master-index-type='\" + index_type + \"']\");\r\n\t\t}\r\n\r\n\t\tvar that = this;\r\n\r\n\t\t//Uncheck and hide all charge items.\r\n\t\t$charge.find(\":checkbox,:radio\").prop(\"checked\", false);\r\n\t\t$charge.find(\"tr.gridodd, tr.grideven\").hide();\r\n\t\tvar parent_main_id = $sender.val();\r\n\t\tvar parentSelected = $sender.is(\":checked\");\r\n\r\n\t\tvar parent_qty = $charge.find(\":hidden[data-obj-name='qty']\").val();\r\n\t\t//var childs_count = $charge.find(\":hidden[ObjectName='person_id'][value='\" + parent_main_id + \"']\").length;\r\n\t\t//var unmatch_row_count = (parent_qty < childs_count);  //it's RI function\r\n\r\n\t\t/*console.log(\"Parent main id: \" + parent_main_id + \", selected? \" + parentSelected\r\n\t\t\t+ \", charge qty: \" + parent_qty + \", related charge count: \" + childs_count\r\n\t\t\t+ \", unmatch row count: \" + unmatch_row_count);*/\r\n\r\n\t\t//Only retrieve charges that belong to the current person (suspect).\r\n\t\t$charge.find(\":hidden[ObjectName='person_id'][value='\" + parent_main_id + \"']\").each(function (idx, el)\r\n\t\t{\r\n\t\t\tvar $el = $(el);\r\n\r\n\t\t\tindex_type = $el.closest(\"div[data-master-index-type]\").data(\"master-index-type\");\r\n\t\t\tvar willCheck = false;\r\n\t\t\tvar $chargeObj = $el.closest(\"td\").find(\":checkbox[ObjectName='charge_id'],:radio[ObjectName='charge_id']\");\r\n\t\t\tvar charge_id = $chargeObj.val();\r\n\r\n\t\t\tif (!parentSelected) //If the suspect is not checked, then do not select the charge either.\r\n\t\t\t{\r\n\t\t\t\twillCheck = false;\r\n\t\t\t}\r\n\t\t\t/*else if (unmatch_row_count)\r\n\t\t\t{\r\n\t\t\t\twillCheck = false;\r\n\t\t\t}*/\r\n\t\t\telse if (that.reportID == \"0\" || that.reportID == \"\")\r\n\t\t\t{\r\n\t\t\t\twillCheck = true;\r\n\t\t\t}\r\n\t\t\telse //Check it based on the last status.\r\n\t\t\t{\r\n\t\t\t\twillCheck = that.valueInList(index_type + \"_charge_id\", charge_id, that.extConfig.SeletedMasterID);\r\n\t\t\t}\r\n\r\n\t\t\t//Determine if this is a new charge item\r\n\t\t\t//if (!willCheck && !unmatch_row_count && that.reportID != \"\" && that.reportID != \"0\" && that.extConfig.CacheIDs && that.extConfig.CacheIDs != \"\")\r\n\t\t\tif (!willCheck && that.reportID != \"\" && that.reportID != \"0\" && that.extConfig.CacheIDs && that.extConfig.CacheIDs != \"\")\r\n\t\t\t{\r\n\t\t\t\twillCheck = that.extConfig.CacheIDs.indexOf(\",\" + charge_id + \",\") >= 0;\r\n\t\t\t}\r\n\r\n\t\t\tif (idx < parent_qty)  //for PA function, sync function from 30 (WO#344564)\r\n\t\t\t{\r\n\t\t\t\t$chargeObj.prop(\"checked\", willCheck);\r\n\t\t\t}\r\n\r\n\t\t\tif (parent_qty == 999)\r\n\t\t\t{\r\n\t\t\t\t$chargeObj.prop(\"checked\", willCheck);\r\n\t\t\t}\r\n\r\n\t\t\tif (parentSelected || willCheck)\r\n\t\t\t{\r\n\t\t\t\t$(this).closest(\"tr\").show();\r\n\t\t\t}\r\n\t\t}); //end click event\r\n\r\n\t}\r\n\r\n\tvalueInList(checkName, checkID, ids)\r\n\t{\r\n\t\tconst idList = ids ? ids.split(\"|\") : [];\r\n\t\tvar match = false;\r\n\t\tfor (var i = 0; i < idList.length; i++)\r\n\t\t{\r\n\t\t\tvar p = idList[i].split(\":\");\r\n\t\t\tif (p.length != 2)\r\n\t\t\t{\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tvar key = p[0];\r\n\t\t\tif (key.toUpperCase() != checkName.toUpperCase())\r\n\t\t\t{\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tif (p[1].indexOf(\",\" + checkID + \",\") >= 0)\r\n\t\t\t{\r\n\t\t\t\tmatch = true;\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\t\t}\r\n\t\treturn match;\r\n\t}\r\n\r\n\r\n\t//Initialize each list's checkbox status e.g., auto-check if it is required and only one object exists.\r\n\tinitMasterCheckBoxStatus()\r\n\t{\r\n\t\t//Auto-check if quantity is \"1\" in the section.\r\n\t\tif (this.reportID == \"0\" || this.reportID == \"\")\r\n\t\t{\r\n\t\t\t$(\"div[data-obj-name='master_section']\").each((idx, section) =>\r\n\t\t\t{\r\n\t\t\t\tvar $section = $(section);\r\n\t\t\t\tvar qty = $section.find(\":hidden[data-obj-name='qty']\").val();\r\n\t\t\t\tvar $checkbox = $section.find(\"table[ObjectName]\").find(\":checkbox\");\r\n\t\t\t\tvar isRequired = $section.find(\":hidden[data-obj-name='is_required']\").val().toUpperCase();\r\n\t\t\t\t//console.log(\"Section: \" + $section.data(\"master-index-type\") + \", qty: \" + qty + \", isRequired: \" + isRequired + \", length: \"+ $checkbox.length);\r\n\t\t\t\tif (qty == \"1\" && $checkbox.length == 1 && isRequired == \"R\") //only one checkbox under the section, then select it\r\n\t\t\t\t{\r\n\t\t\t\t\t//TODO: test it again, it not same with 3.0?? test RI template: DC-CR-1 CRIMINAL COMPLAINT (add mode)\r\n\t\t\t\t\t//$checkbox.prop(\"checked\", true); //if enable it, then Charge section will not auto chech whnen \"Suspect Section\"\" qty is 1 and is required. !!!!!!\r\n\r\n\t\t\t\t\t$checkbox.trigger(\"click\");\r\n\t\t\t\t\t//$checkbox.prop(\"checked\", true);\r\n\r\n\t\t\t\t\t//Disable selection for other persons\r\n\t\t\t\t\tthis.excludeOtherObjectsInGroup($checkbox.eq(0));\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\t//Special JS: auto-check all objects for the Operation Report - select all vehicle items.\r\n\t\t\tif (this.extConfig.IsAutoWorkflow)\r\n\t\t\t{\r\n\t\t\t\t$(\"div[data-obj-name='master_section'][data-master-index-type='VEHICLE']\").each(function (i, section)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(section).find(\":checkbox[islist=1]:visible\").each(function (ii, oo)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(oo).prop(\"checked\", true);\r\n\t\t\t\t\t});\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\t\telse  //Auto-check in update mode.\r\n\t\t{\r\n\t\t\tvar masterIndex = this.extConfig.MasterIndex;\r\n\t\t\t$.each(masterIndex, function (i, mi)\r\n\t\t\t{\r\n\t\t\t\tvar $section = null;\r\n\t\t\t\t$(\"div[data-obj-name='master_section'][data-master-index-type='\" + mi.master_object_name + \"']\").find('input[ObjectName=master_id_list]').each(function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tif ($(this).val() == mi.relation_objects)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$section = $(this).parent();\r\n\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\r\n\t\t\t\tvar $filterObjs = null;\r\n\t\t\t\tif ($section == null)\r\n\t\t\t\t{\r\n\t\t\t\t\t//For compatibility with site version 2.2. do NOT remove it!\r\n\t\t\t\t\t$filterObjs = $(\"div[data-obj-name='master_section'][data-master-index-type='\" + mi.master_object_name + \"']\")\r\n\t\t\t\t\t\t.find(\":checkbox[islist=1][value='\" + mi.id_value + \"'],:radio[islist=1][value='\" + mi.id_value + \"']\");\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\t$filterObjs = $section.find(\":checkbox[islist=1],:radio[islist=1]\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (mi.extension_type == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\t//TODO: test it again, it not same with 3.0?? test RI template: DC-CR-1 CRIMINAL COMPLAINT (update mode)\r\n\t\t\t\t\t//jQuery 3.6 Simulate a real click to automatically toggle the checkbox state\r\n\t\t\t\t\t//jQuery 1.8.3 Trigger the event without changing the checkbox state\r\n\t\t\t\t\t//$filterObjs.prop(\"checked\", true);  //if enable it, then Charge section will not show out under update mode !!!!!!\r\n\r\n\t\t\t\t\t$filterObjs.trigger(\"click\");\r\n\t\t\t\t\t$filterObjs.prop(\"checked\", true);\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tvar ext = mi.extension_type.split(\",\");\r\n\t\t\t\t\tfor (var i = 0; i < ext.length; i++)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif (ext[i] != \"\")\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$filterObjs.closest(\"tr\").find(\":checkbox[islist!=1][value='\" + ext[i] + \"'],:radio[islist!=1][value='\" + ext[i] + \"']\").prop(\"checked\", true);\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\r\n\t\t//Always check 'case_id' to retrieve case information.\r\n\t\t$(\":checkbox[ObjectName=case_id]\").prop(\"checked\", true);\r\n\t\t//$(\"div[master_index_type='CASE']\").show();\r\n\r\n\t\tif (this.extConfig.IsPartPages)\r\n\t\t{\r\n\t\t\tvar wordPageNum = this.extConfig.WordPageNum ?? \"\";\r\n\t\t\t//If empty, it means this is the first time be generated.\r\n\t\t\tif (wordPageNum == \"\")\r\n\t\t\t{\r\n\t\t\t\twordPageNum = this.defaultSeletecdPartPage(this.extConfig.TemplateCode);\r\n\t\t\t}\r\n\r\n\t\t\t$(\"#trSelectPagesSection\").show();\r\n\r\n\t\t\tvar thumbnails = this.extConfig.Thumbnails;\r\n\t\t\tvar h = [];\r\n\t\t\tfor (var i = 0; i < thumbnails.length; i++)\r\n\t\t\t{\r\n\t\t\t\tvar matches = thumbnails[i].Value.match(/\\/AspSoft\\/HandlerDocument\\/FilePath\\?file_relative_path=(.*)/i);\r\n\t\t\t\tif (matches == null)\r\n\t\t\t\t{\r\n\t\t\t\t\tcontinue;\r\n\t\t\t\t}\r\n\t\t\t\tvar image_result = atob(matches[1]).match(/\\d+.png/ig);\r\n\t\t\t\tvar num = image_result[0].replace(\".png\", \"\");\r\n\t\t\t\tvar checked = \"\";\r\n\t\t\t\tif ((\",\" + wordPageNum + \",\").indexOf(\",\" + num + \",\") >= 0 || wordPageNum == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\t$(\"#thumbnail_item_\" + num).prop(\"checked\", true);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tdefaultSeletecdPartPage(templateCode)\r\n\t{\r\n\t\tconst defaultPartPageSetting = '{\"RMS_REQUESTFOREXAMINATIONOFEVIDENCE\":\"0\"}';\r\n\t\tvar PageNum = \"\"\r\n\t\tvar arrPageNum = JSON.parse(defaultPartPageSetting);\r\n\t\tif (typeof (arrPageNum[templateCode]) != \"undefined\")\r\n\t\t{\r\n\t\t\tPageNum = arrPageNum[templateCode];\r\n\t\t}\r\n\t\treturn PageNum;\r\n\t}\r\n\r\n\t//Deselect other items within the same section.\r\n\texcludeOtherObjectsInGroup($sender)\r\n\t{\r\n\t\tvar selected = $sender.is(\":checked\");\r\n\t\tvar $senderSection = $sender.closest(\"[data-obj-name=master_section]\");\r\n\t\tvar senderMasterGroup = $senderSection.data(\"master-group\");\r\n\t\t//var senderMasterIndexType = $senderSection.data(\"master-index-type\");\r\n\t\tif (senderMasterGroup != undefined && senderMasterGroup != \"\")\r\n\t\t{\r\n\t\t\tvar $selectedObjs = $(\"[data-master-group='\" + senderMasterGroup + \"']\").find(\":checkbox[islist=1],:radio:checked[islist=1]\")\r\n\t\t\tvar selectedRecords = $selectedObjs.filter(\":checked\").length;\r\n\r\n\t\t\t//Indicates the selected person from another section.\r\n\t\t\tif (selected || selectedRecords > 0)\r\n\t\t\t{\r\n\t\t\t\t$selectedObjs.prop({ \"checked\": false });\r\n\t\t\t}\r\n\t\t\tif (selected)\r\n\t\t\t{\r\n\t\t\t\t$sender.prop({ \"checked\": true });\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\r\n\t/* \r\n\t\t\"e\" refers to the event object, not the button itself.\r\n\t\tIt is a jQuery-wrapped click event object.\r\n\t\tYou can use e.currentTarget or e.target to get the button that triggered the event.\r\n\r\n\t\tIt contains all the information about the click event, such as:\r\n\t\te.type -> 'click'\r\n\t\te.target -> the element you clicked (a native DOM element)\r\n\t\te.currentTarget -> the element to which the event handler is bound (usually the same as e.target, unless event bubbling is involved)\r\n\t*/\r\n\tbindEvents()\r\n\t{\r\n\t\t//(1) \"Add\" button under the Search Section legend.\r\n\t\t$(\"[data-obj-name='master_add_link']\").on(\"click\", (e) => this.addMasterObject(e));\r\n\r\n\t\t//(2) If \"master_group\" is configured for the section, only one item can be selected within that group.\r\n\t\t//Unclear why this config is needed - setting \"Max Qty\" to 1 should be sufficient.\r\n\t\t$(document).on(\"click\", \"div[data-master-group!=''] :checkbox[islist=1], div[data-master-group!=''] :radio[islist=1]\",\r\n\t\t\t(e) => this.excludeOtherObjectsInGroup($(e.currentTarget)));\r\n\r\n\t\t//(3) Each section (object legend & list) has related events.\r\n\t\tthis.handleSectionEvents();\r\n\r\n\t\t//(4) template thumbnail\r\n\t\t$(\"img.thumbnail-item\").on(\"click\", (e) => this.showPageThumbnail(e));\r\n\r\n\t\t//(4) Create Report button\r\n\t\t$(\"#btnCreateReport\").on(\"click\", (e) => this.createReport(e));\r\n\t}\r\n\r\n\r\n\tshowPageThumbnail(e)\r\n\t{\r\n\t\tvar src = $(e.currentTarget).attr(\"src\");\r\n\t\t$(\"#imgThumbnailLarge\").attr(\"src\", src).removeClass(\"d-none\");\r\n\t}\r\n\r\n\r\n\t//Add a master object with a popup window, e.g. \"Add\" button under section\r\n\taddMasterObject(e)\r\n\t{\r\n\t\tconst $btn = $(e.currentTarget);\r\n\t\tvar url = $btn.attr(\"data-add-page-url\");// $btn.data(\"add-page-url\");\r\n\t\turl = url.replace(/\\.aspx/gi, \"\");\r\n\r\n\t\tvar w = 1000;\r\n\t\tvar h = 650;\r\n\t\tif (url.indexOf(\"ww=\") > 0)\r\n\t\t{\r\n\t\t\tvar ww = queryString(url, \"ww\");  //defined in global.js\r\n\t\t\tif (ww != null && ww != \"\")\r\n\t\t\t{\r\n\t\t\t\tif (ww == \"max\")\r\n\t\t\t\t{\r\n\t\t\t\t\tw = $(window).width();\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tw = ww;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif (url.indexOf(\"wh=\") > 0)\r\n\t\t{\r\n\t\t\tvar wh = queryString(url, \"wh\");\r\n\t\t\tif (wh != null && wh != \"\")\r\n\t\t\t{\r\n\t\t\t\tif (wh == \"max\")\r\n\t\t\t\t{\r\n\t\t\t\t\th = $(window).height();\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\th = wh;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tPopUp(url, w, h, location.href);\r\n\t}\r\n\r\n\r\n\thandleSectionEvents()\r\n\t{\r\n\t\tthis.$masterSections.each((idx, section) =>\r\n\t\t{\r\n\t\t\tvar $section = $(section);\r\n\r\n\t\t\t//Hide button if the button's text is empty.\r\n\t\t\tvar $addLinkObj = $section.find(\"[data-obj-name='master_add_link']\");\r\n\t\t\tvar addLinkText = $addLinkObj.val() ?? \"\";\r\n\t\t\tif (addLinkText.trim() == \"\")\r\n\t\t\t{\r\n\t\t\t\t$addLinkObj.closest(\"div\").removeClass(\"d-flex\").hide();\r\n\t\t\t}\r\n\r\n\t\t\t//Cache all checkbox/radio IDs for later use.\r\n\t\t\tvar indexType = $section.data(\"master-index-type\");\r\n\t\t\t$section.find(\":checkbox[islist=1],:radio[islist=1]\").each((idx, el) =>\r\n\t\t\t{\r\n\t\t\t\tthis.AllIDs.push(indexType + \"_\" + $(el).val());\r\n\t\t\t});\r\n\r\n\t\t\t//this.consoleLog('AllIDs: ' + this.AllIDs.join(\",\"));\r\n\r\n\t\t\t//Auto-select all checkbox/radio elements if the section is \"select-only\".\r\n\t\t\tif ($section.data(\"select-only\") == \"Y\")\r\n\t\t\t{\r\n\t\t\t\tif (this.reportID == \"0\" || this.reportID == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\t$section.find(\":checkbox[data-obj-name='select_all']\").prop(\"checked\", true);\r\n\t\t\t\t\t$section.find(\":checkbox[islist=1],:radio[islist=1]\").each((idx, el) =>\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$(el).prop(\"checked\", true);\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\t//For objects marked \"delete=9\", hide them by default but auto-check them - e.g., CASE section.\r\n\t\t\tif (!$section.is(\":visible\"))\r\n\t\t\t{\r\n\t\t\t\t$section.find(\":checkbox[islist='1']\").prop(\"checked\", true)\r\n\r\n\t\t\t\t//only for debug, show flag_delete=9 section\r\n\t\t\t\tif (this.extConfig.IsDebugMode)\r\n\t\t\t\t{\r\n\t\t\t\t\t$section.find(\"div.engine-list-page-container\").css({ \"background-color\": \"yellow\" }).show();\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t});\r\n\r\n\t\t// Select all checkboxes in the master list\r\n\t\tthis.$masterSections.on(\"click\", \":checkbox[data-obj-name='select_all']\", (e) =>\r\n\t\t{\r\n\t\t\tvar $checkbox = $(e.currentTarget);\r\n\t\t\t$checkbox.closest(\"div[data-obj-name='master_list']\").find(\":checkbox[islist=1]\").each(function ()\r\n\t\t\t{\r\n\t\t\t\tif (!$(this).prop(\"disabled\"))\r\n\t\t\t\t{\r\n\t\t\t\t\t$(this).prop(\"checked\", $checkbox.is(\":checked\"));\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t});\r\n\r\n\t\t//uncheck other checkbox if qty is \"1\"\r\n\t\tthis.$masterSections.on(\"click\", \":checkbox[ObjectName][islist='1']\", (e) =>\r\n\t\t{\r\n\t\t\tthis.checkBoxExclusion(e.currentTarget);\r\n\t\t\tthis.excludePersonStatus(e.currentTarget);\r\n\t\t});\r\n\r\n\t}\r\n\r\n\t//If 'qty = 1', only allow one checkbox to be checked in the section.\r\n\tcheckBoxExclusion(cbEl)\r\n\t{\r\n\t\tvar $sender = $(cbEl);\r\n\t\t//console.log(`${Math.random()} / ${$sender.val()} / ${$sender.attr(\"name\")} / checked? ${$(cbEl).is(\":checked\")}`);\r\n\r\n\t\tvar $section = $sender.closest(\"div[data-obj-name='master_section']\");\r\n\r\n\t\tif ($section.find(\":hidden[data-obj-name='qty']\").val() == \"1\"\r\n\t\t\t&& $sender.is(\":checked\"))\r\n\t\t{\r\n\t\t\t$section.find(\"table[ObjectName]\").find(\":checkbox[islist=1][value!=\"\r\n\t\t\t\t+ $sender.val() + \"]\").each((idx, el) =>\r\n\t\t\t\t{\r\n\t\t\t\t\t$(el).prop(\"checked\", false);\r\n\t\t\t\t\tthis.excludePersonStatus(el);\r\n\t\t\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\t//*** special control ***\r\n\t//If a \"person_id\" is checked, auto-uncheck and disable the same \"person_id\" in the \"Contact Section\" records.\r\n\texcludePersonStatus(cbEl)\r\n\t{\r\n\t\tvar $sender = $(cbEl);\r\n\t\tif ($sender.attr(\"ObjectName\") != \"person_id\")\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar selected = $sender.is(\":checked\");\r\n\t\tvar person_id = $sender.val();\r\n\r\n\t\t//Handle repeated \"person_id\" entries within the \"Contact Section\".\r\n\t\tvar $objs1 = $(\"div[data-master-index-type='CONTACT']\").find(\":checkbox[ObjectName=person_id][value=\" + person_id + \"]\");\r\n\t\tvar $objs2 = $(\"div[data-master-index-type='CONTACT']\").find(\":radio[ObjectName=person_id][value=\" + person_id + \"]\");\r\n\r\n\t\tif (selected\r\n\t\t\t|| $(\"#master_total\").find(\":checkbox[ObjectName=person_id][value=\" + person_id + \"]:checked\").length > 0\r\n\t\t\t|| $(\"#master_total\").find(\":radio[ObjectName=person_id][value=\" + person_id + \"]:checked\").length > 0)\r\n\t\t{\r\n\t\t\t$objs1.prop({ \"checked\": false, \"disabled\": true });\r\n\t\t\t$objs2.attr({ \"checked\": false, \"disabled\": true });\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\t$objs1.removeAttr(\"disabled\");\r\n\t\t\t$objs2.removeAttr(\"disabled\");\r\n\t\t}\r\n\r\n\t\tif (selected)\r\n\t\t{\r\n\t\t\t$sender.prop({ \"checked\": true }).removeAttr(\"disabled\");\r\n\t\t}\r\n\t}\r\n\r\n\tdialogBeforeOpenPopup(url)\r\n\t{\r\n\t\tif (url.toLowerCase().indexOf(\"pageid=search\") > 0\r\n\t\t\t|| url.toLowerCase().indexOf(\"mvlookupsearch\") > 0\r\n\t\t\t|| this.getQSParamByName(\"ignorerefresh\", url) == 'Y') //it show master name page, ignore it.\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tconst element = document.activeElement;\r\n\t\tif (!element)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\t// Further validate whether the element is an <a>, <button>, etc.\r\n\t\tif (!(element && (element.tagName === 'A'\r\n\t\t\t|| element.tagName === 'BUTTON'\r\n\t\t\t|| (element.tagName === 'INPUT' && element.type.toLowerCase() === 'button'))))\r\n\t\t{\r\n\t\t\t//console.log(\"Current caller element: \", element);\r\n\t\t\t//console.log(\"objectname attribute: \", element.getAttribute(\"objectname\"));\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar that = this;\r\n\t\tthat.extConfig.CacheIDs = \",\";\r\n\t\tthat.extConfig.$CacheContainer = $(element).closest(\"div[data-obj-name='master_section']\");\r\n\r\n\t\tthat.extConfig.$CacheContainer.find(\":checkbox:checked, :radio:checked\").each(function ()\r\n\t\t{\r\n\t\t\tif ($(this).val().indexOf(\"_\") < 0)\r\n\t\t\t{\r\n\t\t\t\tthat.extConfig.CacheIDs += $(this).val() + \",\";\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tvar extension_val = $(this).closest(\"span\").attr(\"extension\");\r\n\t\t\t\tthat.extConfig.CacheIDs += $(this).val() + extension_val + \",\";\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\t//Work for not current Container objs\r\n\t\tvar paraRefresh = this.getURLParameter(\"PartialRefresh\", url);\r\n\t\tif (paraRefresh == null)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar refArr = paraRefresh.split(\",\");\r\n\t\tif (refArr.length <= 0)\r\n\t\t{\r\n\t\t\tthat.extConfig.OtherContainerCacheIDs = undefined;\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar arrIds = new Array();\r\n\t\tvar index = 0;\r\n\t\tfor (var i = 0; i < refArr.length; i++)\r\n\t\t{\r\n\t\t\tif ($(element).closest(\"div[data-obj-name='master_section']\").find(\"table[ObjectName='\" + refArr[i] + \"']\").length == 0)\r\n\t\t\t{\r\n\t\t\t\tvar selectStr = \"table[objectname='\" + refArr[i] + \"']\";\r\n\t\t\t\tvar $tmpContainer = $(\"table[objectname='\" + refArr[i] + \"']\");\r\n\t\t\t\tvar tmpBtns = $tmpContainer.closest(\"div[data-obj-name='master_section']\").find(\":checkbox:checked, :radio:checked\");\r\n\t\t\t\tif (tmpBtns.length > 0)\r\n\t\t\t\t{\r\n\t\t\t\t\tarrIds[index] = {}\r\n\t\t\t\t\tarrIds[index].SelectStr = selectStr;\r\n\t\t\t\t\tarrIds[index].CacheIDs = \",\";\r\n\t\t\t\t\tfor (var j = 0; j < tmpBtns.length; j++)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tarrIds[index].CacheIDs += $(tmpBtns[j]).val() + \",\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\tindex++;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tif (arrIds.length > 0)\r\n\t\t{\r\n\t\t\tthat.extConfig.OtherContainerCacheIDs = arrIds;\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tthat.extConfig.OtherContainerCacheIDs = undefined;\r\n\t\t}\r\n\t}\r\n\r\n\r\n\tdialogAfterClosePopup(ret)\r\n\t{\r\n\t\tvar result = ret;\r\n\t\tif (result == \"1\")\r\n\t\t{\r\n\t\t\tthis.resetCheckBox('0');\r\n\t\t}\r\n\r\n\t\tvar that = this;\r\n\t\tif (!that.extConfig.HasChildSection)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar $theContainer = null;\r\n\t\tif (result == \"1\")\r\n\t\t{\r\n\t\t\t$theContainer = that.extConfig.$CacheContainer;\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\t$theContainer = that.extConfig.$CacheNoteContainer;\r\n\t\t}\r\n\r\n\t\tif ($theContainer == null)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar cur_indexType = $theContainer.data(\"master-index-type\");\r\n\t\tvar cur_parentIndexType = $theContainer.data(\"parent-master-index-type\");\r\n\r\n\t\tif (cur_parentIndexType != undefined && cur_parentIndexType != \"\")\r\n\t\t{\r\n\t\t\tvar tbChild = $theContainer.find(\"table[ObjectName^='listIntakeFormMaster']\");\r\n\t\t\t$(tbChild).find(\":checkbox,:radio\").attr(\"checked\", false);\r\n\t\t\t$(tbChild).find(\"tr.gridodd, tr.grideven\").hide();\r\n\r\n\t\t\tvar cur_tbParentSection = $(\"div[data-master-index-type='\" + cur_parentIndexType + \"']\");\r\n\t\t\tvar cur_tbParent = $(cur_tbParentSection).find(\"table[ObjectName^='listIntakeFormMaster']\");\r\n\t\t\t$(cur_tbParent).find(\":checkbox,:radio\").each(function (i, index)\r\n\t\t\t{\r\n\t\t\t\tvar parentSelected = $(this).is(\":checked\");\r\n\t\t\t\tif (parentSelected)\r\n\t\t\t\t{\r\n\t\t\t\t\t//$(this).attr(\"checked\", true);\r\n\t\t\t\t\t$(this).trigger(\"click\");\r\n\t\t\t\t\t$(this).attr(\"checked\", true);\r\n\t\t\t\t\t$(this).trigger(\"click\");\r\n\t\t\t\t}\r\n\t\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\r\n\t//after PartialRefresh, set the checkbox status as before update data\r\n\t//type:  1(narrative)  0(except narrative)\r\n\tresetCheckBox(type)\r\n\t{\r\n\t\tvar $theContainer = null;\r\n\t\tvar theIDs = \"\";\r\n\t\tvar that = this;\r\n\r\n\t\tif (type == \"1\")\r\n\t\t{\r\n\t\t\t$theContainer = that.extConfig.$CacheNoteContainer;\r\n\t\t\ttheIDs = that.extConfig.CacheNoteIDs;\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\t$theContainer = that.extConfig.$CacheContainer;\r\n\t\t\ttheIDs = that.extConfig.CacheIDs;\r\n\t\t}\r\n\r\n\t\tif ($theContainer == null)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar indexType = $theContainer.data(\"master-index-type\");\r\n\t\tvar qty = $theContainer.find(\":hidden[data-obj-name='qty']\").val();\r\n\t\tvar hasChecked = false;\r\n\r\n\t\t$theContainer.find(\":checkbox, :radio\").each(function (i, obj)\r\n\t\t{\r\n\t\t\tif (!hasChecked)\r\n\t\t\t{\r\n\t\t\t\tvar extension_val = \"\";\r\n\t\t\t\tif ($(this).val().indexOf(\"_\") >= 0)\r\n\t\t\t\t{\r\n\t\t\t\t\textension_val = $(this).closest(\"span\").attr(\"extension\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (theIDs.indexOf(\",\" + $(this).val() + \",\") >= 0)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(this).attr(\"checked\", true);\r\n\t\t\t\t}\r\n\t\t\t\telse if (theIDs.indexOf(\",\" + $(this).val() + extension_val + \",\") >= 0)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(this).attr(\"checked\", true);\r\n\t\t\t\t}\r\n\t\t\t\telse if ($(this).attr(\"islist\") == \"1\")\r\n\t\t\t\t{\r\n\t\t\t\t\tvar tmpID = indexType + \"_\" + $(this).val();\r\n\t\t\t\t\tvar isNewItem = true;\r\n\t\t\t\t\tfor (var i = 0; i < that.AllIDs.length; i++)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tif (tmpID == that.AllIDs[i])\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tisNewItem = false;\r\n\t\t\t\t\t\t\tbreak;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tif (isNewItem)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tthat.AllIDs.push(tmpID);\r\n\t\t\t\t\t\tthat.extConfig.CacheIDs += $(this).val() + \",\";  //to remember selected items and reset it for charge\r\n\t\t\t\t\t\t$(this).attr(\"checked\", true);\r\n\t\t\t\t\t\tif (qty == \"1\")\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\thasChecked = true;\r\n\t\t\t\t\t\t\t$(this).trigger(\"click\");\r\n\t\t\t\t\t\t\t$(this).attr(\"checked\", true);\r\n\t\t\t\t\t\t\tthat.checkBoxExclusion(this);\r\n\t\t\t\t\t\t\t$(this).trigger(\"click\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t})\r\n\r\n\t\tif (that.extConfig.OtherContainerCacheIDs)\r\n\t\t{\r\n\t\t\tvar otherIds = that.extConfig.OtherContainerCacheIDs;\r\n\t\t\tfor (var i = 0; i < otherIds.length; i++)\r\n\t\t\t{\r\n\t\t\t\tvar $tempCon = $(otherIds[i].SelectStr);\r\n\t\t\t\tvar $currentBtns = $tempCon.closest(\"div[data-obj-name='master_section']\").find(\":checkbox, :radio\");\r\n\t\t\t\tfor (var j = 0; j < $currentBtns.length; j++)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar $this = $($currentBtns[j]);\r\n\t\t\t\t\tif (otherIds[i].CacheIDs.indexOf(\",\" + $this.val() + \",\") >= 0)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$this.attr(\"checked\", true);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\tgetQSParamByName(name, url)\r\n\t{\r\n\t\tif (!url)\r\n\t\t{\r\n\t\t\turl = window.location.href;\r\n\t\t}\r\n\t\tname = name.replace(/[\\[\\]]/g, \"\\\\$&\");\r\n\t\tvar regex = new RegExp(\"[?&]\" + name + \"(=([^&#]*)|&|#|$)\");\r\n\r\n\t\tvar results = regex.exec(url);\r\n\t\tif (!results)\r\n\t\t{\r\n\t\t\treturn null;\r\n\t\t}\r\n\r\n\t\tif (!results[2])\r\n\t\t{\r\n\t\t\treturn '';\r\n\t\t}\r\n\r\n\t\treturn decodeURIComponent(results[2].replace(/\\+/g, \" \"));\r\n\t}\r\n\r\n\r\n\tgetURLParameter(name, url)\r\n\t{\r\n\t\tif (!url) url = location.href;\r\n\t\tname = name.replace(/[\\[]/, \"\\\\\\[\").replace(/[\\]]/, \"\\\\\\]\");\r\n\t\tvar regexS = \"[\\\\?&]\" + name + \"=([^&#]*)\";\r\n\t\tvar regex = new RegExp(regexS);\r\n\t\tvar results = regex.exec(url);\r\n\t\treturn results == null ? null : results[1];\r\n\t}\r\n\r\n\r\n\t//Create Report button event\r\n\tasync createReport(e)\r\n\t{\r\n\t\t$.blockUI({ message: \"<h2>Working...</h2>\", bindEvents: false });\r\n\t\tif (!this.reportDataValidation())\r\n\t\t{\r\n\t\t\t$.unblockUI();\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar ps = this.getCheckedObjects();\r\n\t\tvar tips = ps.tips;\r\n\t\tvar reportTitle = \"\";\r\n\t\tif ($(\"input[name='txtReportTitle']\").length > 0)\r\n\t\t{\r\n\t\t\treportTitle = $(\"input[name='txtReportTitle']\").val().trim();\r\n\t\t\tif (reportTitle == \"\")\r\n\t\t\t{\r\n\t\t\t\ttips.push(\"Please input report title\");\r\n\t\t\t}\r\n\t\t}\r\n\t\tif (tips.length > 0)\r\n\t\t{\r\n\t\t\tthis.showTips(tips.join(\"<br>\"));\r\n\t\t\t$.unblockUI();\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\t$.blockUI.defaults.overlayCSS.opacity = \"0.3\";\r\n\t\tconst queryString = window.location.search;\r\n\t\tconst handlerUrl = `${queryString}&handler=CreateIntake`;\r\n\r\n\t\tconst formData = new URLSearchParams();\r\n\t\tformData.append('template_id', this.extConfig.TemplateID);\r\n\t\tformData.append('report_id', this.extConfig.ReportID);\r\n\t\tformData.append(\"objects_parameter\", this.textToBase64(ps.objects_parameter.join(\"\")));\r\n\t\tformData.append(\"objects_data_index\", this.textToBase64(ps.objects_data_index.join(\"\")));\r\n\t\tformData.append(\"addional_data\", this.textToBase64(ps.addional_data.join(\"\")));\r\n\t\tformData.append(\"page_num\", this.extConfig.WordPageNum ?? \"\");\r\n\t\tformData.append(\"report_title\", reportTitle);\r\n\r\n\t\tlet resData = {};\r\n\t\ttry\r\n\t\t{\r\n\t\t\tconst response = await fetch(handlerUrl, {\r\n\t\t\t\tmethod: \"POST\",\r\n\t\t\t\theaders: {\r\n\t\t\t\t\t'Content-Type': 'application/x-www-form-urlencoded',\r\n\t\t\t\t\t'RequestVerificationToken': document.querySelector('input[name=\"__RequestVerificationToken\"]').value\r\n\t\t\t\t},\r\n\t\t\t\tbody: formData\r\n\t\t\t});\r\n\r\n\t\t\t$.unblockUI();\r\n\t\t\tif (!response.ok)\r\n\t\t\t{\r\n\t\t\t\talert(`HTTP error! status: ${response.status}`);\r\n\t\t\t\t$.unblockUI();\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\tresData = await response.json();\r\n\t\t\t//console.log(\"Success:\" + JSON.stringify(resData));\r\n\t\t}\r\n\t\tcatch (error)\r\n\t\t{\r\n\t\t\t$.unblockUI();\r\n\t\t\talert(\"Error:\" + error);\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tif (resData && resData.message && resData.message != \"OK\")\r\n\t\t{\r\n\t\t\t$.unblockUI();\r\n\t\t\talert(resData.message);\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\tvar pid = this.extConfig.PID ?? \"\";\r\n\t\tvar mpid = this.extConfig.MPID ?? \"\";\r\n\t\tvar data = \"\";\r\n\t\tif (resData.master_page_type)\r\n\t\t{\r\n\t\t\tdata += \"&MasterPageType=\" + resData.master_page_type;\r\n\t\t}\r\n\t\tif (resData.is_pop)\r\n\t\t{\r\n\t\t\tdata += \"&IsPop=\" + resData.is_pop;\r\n\t\t}\r\n\t\tvar urlOtherIDs = $(\"#UrlOtherIds\").val();\r\n\t\tvar url = `Intake?nextPID=${pid}&MPID=${mpid}&case_id=${resData.case_id}&template_id=${resData.template_id}&report_id=${resData.report_id}${urlOtherIDs}&rnd=${Math.random()}`;\r\n\t\twindow.location.href = url;\r\n\t}\r\n\r\n\r\n\treportDataValidation()\r\n\t{\r\n\t\tvar msg = [];\r\n\t\tvar selectedPageNum = \"\";\r\n\r\n\t\tif (!this.extConfig.TemplateID)\r\n\t\t{\r\n\t\t\tmsg.push(\"Please select report template first.\");\r\n\t\t}\r\n\r\n\t\tif (this.extConfig.IsPartPages)\r\n\t\t{\r\n\t\t\t$(\"div.thumbnail-container\").find(\":checkbox[data-thumbnail-item]:checked\").each(function (idx, el)\r\n\t\t\t{\r\n\t\t\t\tif (selectedPageNum == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tselectedPageNum = $(el).val();\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tselectedPageNum += \",\" + $(el).val();\r\n\t\t\t\t}\r\n\t\t\t});\r\n\r\n\t\t\tif (selectedPageNum == \"\")\r\n\t\t\t{\r\n\t\t\t\tmsg.push(\"Please select pages.\");\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tthis.extConfig.WordPageNum = selectedPageNum;\r\n\r\n\t\tif (msg.length > 0)\r\n\t\t{\r\n\t\t\tthis.showTips(msg.join(\"<br>\"));\r\n\t\t\treturn false;\r\n\t\t}\r\n\r\n\t\t/*if (!checkInput())\r\n\t\t{\r\n\t\t\treturn false;\r\n\t\t}*/\r\n\r\n\t\treturn true;\r\n\t}\r\n\r\n\r\n\ttextToBase64(text)\r\n\t{\r\n\t\t//const base64 = btoa(text);\r\n\r\n\t\t//Using the TextEncoder API (modern browsers)\r\n\t\tconst encoder = new TextEncoder();\r\n\t\tconst data = encoder.encode(text);\r\n\t\tconst base64 = btoa(String.fromCharCode(...data));\r\n\t\treturn base64;\r\n\t}\r\n\r\n\r\n\tgetCheckedObjects()\r\n\t{\r\n\t\tvar reqInfoTips = [], masterGroups = [];\r\n\t\tvar parameter = [], dataIndex = [];\r\n\r\n\t\tvar that = this;\r\n\r\n\t\t//(1) Collect first main parameter -- all checked objects info.\r\n\t\tthis.$masterSections.each(function (i, section)\r\n\t\t{\r\n\t\t\tvar $section = $(section);\r\n\r\n\t\t\tvar totalRecords = $section.find(\"table[ObjectName]\").find(\":checkbox,:radio\").length;\r\n\t\t\tvar masterIndexSectionText = $section.find(\":hidden[data-obj-name='master_index_section_text']\").val();\r\n\t\t\tvar masterIndexType = $section.data(\"master-index-type\");  //SUSPECT, VICTIM\r\n\t\t\tvar masterObjectType = $section.data(\"master-object-type\");  //DE, VI\r\n\t\t\tvar isRequired = $section.find(\":hidden[data-obj-name='is_required']\").val().toUpperCase();\r\n\t\t\tvar qty = $section.find(\":hidden[data-obj-name='qty']\").val();\r\n\t\t\t//var selectOnly = $section.data(\"select-only\");\r\n\t\t\t//var parentMasterIndexType = $section.data(\"parent-master-index-type\");\r\n\t\t\t//var objectKeyFieldName = $section.data(\"object-keyfield-name\");\r\n\t\t\t//var masterGroup = $section.data(\"master-group\");\r\n\r\n\t\t\tvar masterGroup = $section.data(\"master-group\");\r\n\t\t\tif (masterGroup != undefined && masterGroup != \"\")\r\n\t\t\t{\r\n\t\t\t\tmasterGroups.push(masterGroup);\r\n\t\t\t\tvar p = masterGroup.split(\"_\");\r\n\t\t\t\tmasterObjectType = p[0];\r\n\t\t\t}\r\n\r\n\t\t\tvar $allValidTr = null;\r\n\t\t\tvar parentObjectName = $section.data(\"parent-master-index-type\");\r\n\t\t\tif (parentObjectName == \"\")\r\n\t\t\t{\r\n\t\t\t\t$allValidTr = $section.find(\"div[data-obj-name='master_list']\").find(\"table[ObjectName^='listIntakeFormMaster']\");\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$allValidTr = $section.find(\"div[data-obj-name='master_list']\").find(\"table[ObjectName^='listIntakeFormMaster']\").find(\"tr:visible\");\r\n\t\t\t}\r\n\r\n\t\t\tvar $selectedObjs = $allValidTr.find(\":checkbox:checked[islist=1],:radio:checked[islist=1]\");\r\n\t\t\tvar selectedRecords = $selectedObjs.filter(\":checked\").length;\r\n\t\t\tvar $addLinkObj = $section.find(\"[data-obj-name='master_add_link']\");\r\n\t\t\tvar addLinkText = $addLinkObj.val() ? $addLinkObj.val().trim() : \"\";\r\n\r\n\r\n\t\t\tvar msg = \"\";\r\n\t\t\tif (isRequired == \"R\")\r\n\t\t\t{\r\n\t\t\t\tif (totalRecords == 0)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar msg = \"Please click \\\"\" + addLinkText + \"\\\" button to add \" + masterIndexType + \".\";\r\n\t\t\t\t\tif (that.extConfig.TipMessage[\"intakeform_add_\" + masterIndexType.toLowerCase()] != undefined)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tmsg = that.extConfig.TipMessage[\"intakeform_add_\" + masterIndexType.toLowerCase()]\r\n\t\t\t\t\t\tmsg = msg.replaceAll('{0} ', addLinkText).replaceAll(\"\\\\\", \"\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\treqInfoTips.push(msg);\r\n\t\t\t\t\t//return false;\r\n\t\t\t\t}\r\n\t\t\t\telse if (selectedRecords == 0)\r\n\t\t\t\t{\r\n\t\t\t\t\tmsg = \"Please select '\" + masterIndexType + \"' under '\" + masterIndexSectionText + \"'.\";\r\n\t\t\t\t\tif (that.extConfig.TipMessage[\"intakeform_req_\" + masterIndexType.toLowerCase()] != undefined)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tmsg = that.extConfig.TipMessage[\"intakeform_req_\" + masterIndexType.toLowerCase()];\r\n\t\t\t\t\t\tmsg = msg.replaceAll('{0} ', masterIndexSectionText).replaceAll(\"\\\\\", \"\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\treqInfoTips.push(msg);\r\n\t\t\t\t\t//return false;\r\n\t\t\t\t}\r\n\t\t\t}\r\n\r\n\t\t\tif (selectedRecords > qty)\r\n\t\t\t{\r\n\t\t\t\tmsg = \"The most allowed to choose \" + qty + \" \\\"\" + masterIndexType + \"\\\" under \\\"\" + masterIndexSectionText + \"\\\".\";\r\n\t\t\t\tif (that.extConfig.TipMessage[\"intakeform_max_\" + masterIndexType.toLowerCase()] != undefined)\r\n\t\t\t\t{\r\n\t\t\t\t\tmsg = that.extConfig.TipMessage[\"intakeform_max_\" + masterIndexType.toLowerCase()]\r\n\t\t\t\t\tmsg = msg.replaceAll('{0}', qty).replaceAll(\"\\\\\", \"\");\r\n\t\t\t\t\tmsg = msg.replaceAll('{1}', masterIndexSectionText).replaceAll(\"\\\\\", \"\");\r\n\t\t\t\t}\r\n\t\t\t\treqInfoTips.push(msg);\r\n\t\t\t\t//return false;\r\n\t\t\t}\r\n\r\n\t\t\t/*if (selectedRecords == 0)\r\n\t\t\t{\r\n\t\t\t\treturn;\r\n\t\t\t}*/\r\n\r\n\t\t\tvar selectedRow = \"\";\r\n\t\t\t$selectedObjs.each(function (idx, el)\r\n\t\t\t{\r\n\t\t\t\tvar $el = $(el);\r\n\t\t\t\tvar objectKey = $el.attr(\"objectname\");\r\n\r\n\t\t\t\t//get custom id list, example asp express for layout.DefaultStatus:\r\n\t\t\t\t//person_id#[ado:person_id]#DE | contact_id#[ado:contact_id]#DE | location_id#[ado:location_id]#DE\r\n\r\n\t\t\t\tvar masterIDList = $el.closest(\"td\").find(\":hidden[objectname='master_id_list']\").val();\r\n\t\t\t\tif (masterIDList == undefined || masterIDList == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tif ($el.val() == \"\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tmasterIDList = objectKey + \"#\" + $el.val() + \"#\" + masterObjectType;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (selectedRow == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tselectedRow = masterIDList;\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tselectedRow += \"\\x02\" + masterIDList;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif ($el.val() != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tif (dataIndex.length > 0)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tdataIndex.push(\"\\x02\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\tdataIndex.push(masterIndexType + \":\" + masterObjectType + \":\" + objectKey + \":\" + $el.val() + \":\" + masterIDList);\r\n\t\t\t\t}\r\n\r\n\t\t\t\t//WO#257407: provide a notice when existing req_tip_info data, and push each section tip to global tip message container.\r\n\t\t\t\tvar tip = $el.closest(\"td\").find(\":hidden[objectname='req_tip_info']\").val() ?? \"\";\r\n\t\t\t\ttip = tip.trim();\r\n\t\t\t\tif (tip != \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\treqInfoTips.push(`[${masterIndexSectionText}] ${tip}`);\r\n\t\t\t\t}\r\n\r\n\t\t\t});\r\n\r\n\t\t\tif (selectedRow == \"\")\r\n\t\t\t{\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\tif (parameter.length > 0)\r\n\t\t\t{\r\n\t\t\t\tparameter.push(\"\\x03\"); //new section\r\n\t\t\t}\r\n\t\t\tparameter.push(`${masterIndexType}:${masterObjectType}:${selectedRow}`);\r\n\t\t});\r\n\r\n\t\t//(2) Validation -> handler master group -- require at least one.\r\n\t\tvar lastGroup = \"\";\r\n\t\tfor (var g = 0; g < masterGroups.length; g++)\r\n\t\t{\r\n\t\t\tvar curGroup = masterGroups[g];\r\n\t\t\tif (curGroup == lastGroup)\r\n\t\t\t{\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\t\t\tvar p = curGroup.split(\"_\");\r\n\t\t\tif (p.length != 2)\r\n\t\t\t{\r\n\t\t\t\tcontinue;\r\n\t\t\t}\r\n\r\n\t\t\tvar sectionText = \"\";\r\n\t\t\tvar addLinkText = \"\";\r\n\t\t\tif (p[1] == \"REQUIRED\")\r\n\t\t\t{\r\n\t\t\t\tvar totalRecords = 0;\r\n\t\t\t\tvar selectedRecords = 0;\r\n\t\t\t\tthat.$masterSections.find(\"[master_group='\" + curGroup + \"']\").each(function (i, section)\r\n\t\t\t\t{\r\n\t\t\t\t\tvar $section = $(section);\r\n\t\t\t\t\tif (sectionText == \"\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tsectionText = \"[\" + $section.find(\":hidden[data-obj-name='master_index_section_text']\").val() + \"]\";\r\n\t\t\t\t\t\taddLinkText = \"[\" + $section.find(\"[data-obj-name='master_add_link']\").val().trim() + \"] on \" + sectionText + \"\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tsectionText = sectionText + \" Or [\" + $section.find(\":hidden[data-obj-name='master_index_section_text']\").val() + \"]\";\r\n\t\t\t\t\t\taddLinkText = addLinkText + \" Or [\" + $section.find(\"[data-obj-name='master_add_link']\").val().trim() + \"] on [\" + $section.find(\":hidden[data-obj-name='master_index_section_text']\").val() + \"]\";\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\ttotalRecords = totalRecords + $section.find(\"table[ObjectName]\").find(\":checkbox,:radio\").length;\r\n\r\n\t\t\t\t\tvar $selectedObjs = $section.find(\"div[data-obj-name='master_list']\").find(\":checkbox:checked[islist=1],:radio:checked[islist=1]\");\r\n\t\t\t\t\tselectedRecords = selectedRecords + $selectedObjs.filter(\":checked\").length;\r\n\t\t\t\t});\r\n\t\t\t}\r\n\r\n\t\t\tif (totalRecords == 0)\r\n\t\t\t{\r\n\t\t\t\treqInfoTips.push(`Please click \"${addLinkText}\"\" to add record first.`);\r\n\t\t\t}\r\n\t\t\telse if (selectedRecords == 0)\r\n\t\t\t{\r\n\t\t\t\treqInfoTips.push(`Please select one under \"${sectionText}\".`);\r\n\t\t\t\t$.unblockUI();\r\n\t\t\t\treturn false;\r\n\t\t\t\tbreak;\r\n\t\t\t}\r\n\r\n\t\t\tlastGroup = curGroup;\r\n\t\t}\r\n\r\n\r\n\t\t//(3) handle extension columns\r\n\t\tthis.$masterSections.each(function (i, section)\r\n\t\t{\r\n\t\t\tvar $section = $(section);\r\n\t\t\t//var sectionText = $section.find(\":hidden[data-obj-name='master_index_section_text']\").val();\r\n\t\t\tvar masterIndexType = $section.find(\":hidden[data-obj-name='master_index_type']\").val(); //SUSPECT, VICTIM\r\n\t\t\tvar masterObjectType = $section.find(\":hidden[data-obj-name='master_object_type']\").val(); //DE, VI\r\n\t\t\tvar $selectedObjs = $section.find(\"div[data-obj-name='master_list']\").find(\":checkbox[islist!=1]:checked,:radio[islist!=1]:checked\");\r\n\r\n\t\t\tvar selectedRow = \"\";\r\n\t\t\t$selectedObjs.each(function (idx, el)\r\n\t\t\t{\r\n\t\t\t\tvar $el = $(el);\r\n\t\t\t\tvar objectKey = $el.attr(\"ObjectName\");\r\n\r\n\t\t\t\t//get custom id list, example asp express for layout.DefaultStatus:\r\n\t\t\t\t//person_id#[ado:person_id]#DE | contact_id#[ado:contact_id]#DE | location_id#[ado:location_id]#DE\r\n\r\n\t\t\t\tvar masterIDList = $el.closest(\"tr\").find(\":hidden[ObjectName='master_id_list']\").val();\r\n\t\t\t\tvar $extObjs = $el.closest(\"span[extension]\").find(\":checkbox:checked,:radio:checked\");\r\n\t\t\t\tvar $objID = $el.closest(\"tr\").find(\":checkbox[islist=1],:radio[islist=1]\");\r\n\t\t\t\tif ($objID.length != 1)  //it should only one checkbox\r\n\t\t\t\t{\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\tif (masterIDList == undefined || masterIDList == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tif ($el.val() == \"\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\r\n\t\t\t\t\tmasterIDList = objectKey + \"#\" + $el.val() + \"#\" + masterObjectType;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tvar extValue = \"\";\r\n\t\t\t\t$extObjs.each(function ()\r\n\t\t\t\t{\r\n\t\t\t\t\textValue += \",\" + $(this).val();\r\n\t\t\t\t});\r\n\r\n\t\t\t\tif (extValue == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tmasterIDList += \"$\" + extValue;\r\n\t\t\t\tif (selectedRow == \"\")\r\n\t\t\t\t{\r\n\t\t\t\t\tselectedRow = masterIDList;\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\tselectedRow += \"\\x02\" + masterIDList;\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (dataIndex.length > 0)\r\n\t\t\t\t{\r\n\t\t\t\t\tdataIndex.push(\"\\x02\");\r\n\t\t\t\t}\r\n\r\n\t\t\t\tdataIndex.push(masterIndexType + \":\" + masterObjectType + \":\" + objectKey + \":\" + $objID.val() + \":\" + masterIDList);\r\n\r\n\t\t\t});\r\n\t\t\t//end object row\r\n\r\n\t\t\tif (selectedRow == \"\")\r\n\t\t\t{\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\tif (parameter.length > 0)\r\n\t\t\t{\r\n\t\t\t\tparameter.push(\"\\x03\"); //new section\r\n\t\t\t}\r\n\t\t\tparameter.push(masterIndexType + \":\" + masterObjectType + \":\" + selectedRow);\r\n\t\t});\r\n\r\n\r\n\t\t//Operations Report special check\r\n\t\tif (this.extConfig.IsAutoWorkflow)\r\n\t\t{\r\n\t\t\tvar $cfsType = $(\":hidden[ObjectName='agency_cfs_type']\");\r\n\t\t\tif ($cfsType.length > 0 && $cfsType.eq(0).val() == \"\")\r\n\t\t\t{\r\n\t\t\t\tvar $addLinkObj = $cfsType.eq(0).closest(\"div[data-obj-name=master_section]\").find(\"[data-obj-name='master_add_link']\");\r\n\t\t\t\treqInfoTips.push(`Please click hyperlink \"${$addLinkObj.text().trim()}\" to update Agency CFS Type.`);\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\t//Get Addional Options\r\n\t\tvar addionalData = [];\r\n\t\t//TODO: test it !!\r\n\t\t$(\"[ctype=AddionalOption]\").each(function (index, e)\r\n\t\t{\r\n\t\t\taddionalData.push($(this).attr(\"bookmark_name\") + \";\");\r\n\t\t\taddionalData.push($(this).attr(\"original_name\") + \";\");\r\n\t\t\tvar objectname = $(this).attr(\"objectname\");\r\n\t\t\tvar val = $(this).val();\r\n\t\t\tvar $ctrlHidden = $(this).closest(\"td\").find(\"input[datatype=INFOCHECKBOX][name*=\" + objectname + \"]\");\r\n\t\t\tif ($ctrlHidden.length > 0)\r\n\t\t\t{\r\n\t\t\t\tval = $($ctrlHidden).val();\r\n\t\t\t}\r\n\t\t\taddionalData.push(val + \"\\x03\");\r\n\t\t});\r\n\r\n\t\tif (this.extConfig.IsDebugMode)\r\n\t\t{\r\n\t\t\tvar debugInfo = `Debug info for selected object(s):\\r\\nTableKey#KeyValue#TableType format.\\r\\n\\r\\n${parameter.join(\"\").replace(/\\x03/g, '\\r\\n\\r\\n')}`;\r\n\t\t\tdebugInfo += `\\r\\n\\r\\nData Index:\\r\\n${dataIndex.join(\"\").replace(/\\x02/g, '\\r\\n')}`;\r\n\t\t\talert(debugInfo);\r\n\t\t}\r\n\r\n\t\treturn { tips: reqInfoTips, objects_parameter: parameter, objects_data_index: dataIndex, addional_data: addionalData };\r\n\t}\r\n\r\n\r\n\tshowTips(data)\r\n\t{\r\n\t\t$.unblockUI();\r\n\t\tif (data)\r\n\t\t{\r\n\t\t\t$(\"#resultDiv\").html(typeof data === \"object\" ? JSON.stringify(data) : data).removeClass(\"d-none\");\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\t$(\"#resultDiv\").html(\"\").addClass(\"d-none\");\r\n\t\t}\r\n\t}\r\n\r\n\r\n\t//************* Common Methods **************//\r\n\tconsoleLog(...args)\r\n\t{\r\n\t\tconst prefix = '[MyLog]';\r\n\r\n\t\tconst timestamp = new Date().toISOString();\r\n\r\n\t\tconsole.groupCollapsed(`${prefix} ${timestamp}`);\r\n\t\targs.forEach(arg =>\r\n\t\t{\r\n\t\t\tif (typeof arg === 'object' && arg !== null)\r\n\t\t\t{\r\n\t\t\t\tconsole.dir(arg); // better display with dir\r\n\t\t\t} else\r\n\t\t\t{\r\n\t\t\t\tconsole.log(arg);\r\n\t\t\t}\r\n\t\t});\r\n\t\tconsole.groupEnd();\r\n\t}\r\n\r\n\t// Common fetch function with support for response types and custom headers\r\n\tasync fetchWithResponseType(url, options = {}, responseType = 'json')\r\n\t{\r\n\t\tconst res = await fetch(url, options);\r\n\r\n\t\tif (!res.ok)\r\n\t\t{\r\n\t\t\tthrow new Error(`Request error: ${res.status}`);\r\n\t\t}\r\n\r\n\t\tswitch (responseType)\r\n\t\t{\r\n\t\t\tcase 'json': return await res.json();\r\n\t\t\tcase 'text': return await res.text();\r\n\t\t\tcase 'blob': return await res.blob();\r\n\t\t\tcase 'arrayBuffer': return await res.arrayBuffer();\r\n\t\t\tdefault: throw new Error(`Not support response type: ${responseType}`);\r\n\t\t}\r\n\t}\r\n\r\n\t// Common POST and support headers\r\n\tasync post(url, body = {}, responseType = 'json', headers = {})\r\n\t{\r\n\t\t//auto get Anti-Forgery Token from the page\r\n\t\tconst token = $('input[name=\"__RequestVerificationToken\"]').val();\r\n\t\tif (token)\r\n\t\t{\r\n\t\t\theaders['RequestVerificationToken'] = token;\r\n\t\t}\r\n\r\n\t\tconst finalHeaders = {\r\n\t\t\t'Content-Type': 'application/json',\r\n\t\t\t...headers\r\n\t\t};\r\n\r\n\t\treturn await this.fetchWithResponseType(url, {\r\n\t\t\tmethod: 'POST',\r\n\t\t\theaders: finalHeaders,\r\n\t\t\tbody: JSON.stringify(body)\r\n\t\t}, responseType);\r\n\t}\r\n\r\n\t// Common GET and support headers\r\n\tasync get(url, responseType = 'json', headers = {})\r\n\t{\r\n\t\tconst finalHeaders = {\r\n\t\t\t'Accept': 'application/json',\r\n\t\t\t...headers\r\n\t\t};\r\n\r\n\t\treturn await this.fetchWithResponseType(url, {\r\n\t\t\tmethod: 'GET',\r\n\t\t\theaders: finalHeaders\r\n\t\t}, responseType);\r\n\t}\r\n\r\n}", "size":46116, "mimeType":"text/javascript"}, "headers":[{"name":"Content-Type", "value":"text/javascript"}, {"name":"Last-Modified", "value":"Tue, 28 Jul 2026 12:31:15 GMT"}, {"name":"Accept-Ranges", "value":"bytes"}, {"name":"ETag", "value":"\"1dd1e8cfb389fa4\""}, {"name":"Vary", "value":"Accept-Encoding"}, {"name":"Server", "value":"Microsoft-IIS/10.0"}, {"name":"X-Powered-By", "value":"ASP.NET"}, {"name":"Date", "value":"Wed, 29 Jul 2026 06:01:42 GMT"}, {"name":"Content-Length", "value":"46116"}]}, "startedDateTime":"2026-07-29T14:01:41.3033410+08:00", "cache":{}}, {"time":405, "connection":"ClientPort:7574;EgressPort:7648", "comment":"[#39]", "request":{"headersSize":2545, "postData":{"params":[{"name":"menuCaption", "value":"Police Reports"}, {"name":"pageIDs", "value":"inquirecasedetinvestigation,listcasenumber,listpolicereport,showcasecontact,listcasevehicle,showcaselocation,listcaseproperty,showcaseevidenceprelog,showcaseevidence,casepermission,showlejissubmissions,showlejisrequests,documents,listcasenote,listcaseimage_hc,listcaseinvassign,showcaseassignment,showcaseticket_rms,showcasecharge,listcasebooking,listcasediagram,listcasesystemdate,listresponse_newclean_rms,listshowcaseevent,listcase_cyber"}, {"name":"captions", "value":"Investigation,Case Numbers,Police Reports,Party(s),Vehicles,Locations,Property,Evidence Pre Log,Evidence,Permission,LEJIS Submission,LEJIS Search,Document,Notes,Images,Inv Assignment,Staff Assignment,eTicket,Charges,Booking,Case Diagram,System Dat