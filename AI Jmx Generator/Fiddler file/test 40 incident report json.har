, \"checked\");\r\n\t\t}\r\n\t});\r\n\r\n\t//multisection function\r\n\thandleMultisection(currentReportID);\r\n\r\n\t//set editable select, the editable select has conflict with jquery.observe.js leave warning\r\n\tsetEditableSelect();\r\n\r\n\t//init date or time type control\r\n\tmakeDatePicker($templateContent);\r\n\r\n\t//set mask\r\n\tsetMask($templateContent);\r\n\r\n\tadjustWidth();\r\n\r\n\tsetReadOnlyElements($templateContent);\r\n\r\n\t$('img[ObjectName]').on('mouseenter', function ()\r\n\t{\r\n\t\tconst $file = $(`:file[ObjectName='${$(this).attr('ObjectName')}']`);\r\n\t\t$file.stop(true).fadeIn(3000);\r\n\t});\r\n\r\n\t//like press tab key when click Enter\r\n\t$templateContent.find(\":text[mode='E'],select[mode='E'],:checkbox[mode='E'],:radio[mode='E']\").keydown(function (event)\r\n\t//$templateContent.find(\":input[mode='E']\").keydown(function (event)\r\n\t{\r\n\t\tvar keycode = event.keyCode || event.which;\r\n\t\tif (keycode == 13 && document.all) //enter\r\n\t\t{\r\n\t\t\twindow.event.keyCode = 9;\r\n\t\t}\r\n\t});\r\n\r\n\t//spellCheck & Recover data from intake_report_data_log table\r\n\tif (canSave)\r\n\t{\r\n\t\tvar $textareaObjs = $templateContent.find(\"textarea[mode='E']\");\r\n\t\t$textareaObjs.data(\"spell_checked_flag\", \"0\")\r\n\t\t\t.css(\"margin-bottom\", \"2px\")\r\n\t\t\t.wrap(\"<div></div>\")\r\n\t\t\t.each(function (i, txt)\r\n\t\t\t{\r\n\t\t\t\ttry\r\n\t\t\t\t{\r\n\t\t\t\t\tvar txtName = $(txt).attr(\"name\");\r\n\t\t\t\t\tvar $sameNameObjs = $(\"textarea[name='\" + txtName + \"']\");\r\n\t\t\t\t\t//var inRepeater = $(txt).closest(\"table[repeat],tr[repeat]\").size() > 0;\r\n\t\t\t\t\tvar inRepeater = $sameNameObjs.length > 1;\r\n\t\t\t\t\tif (!inRepeater)  //repeater doesn't have this function, if need recover funtion, need enhance it (need get the element index in repeater).\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t$.each(RecoverDataBookmarkList, function (i, bName)\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tif (txtName == bName)\r\n\t\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t\tvar recoverHtml = \"&nbsp;&nbsp;<a obn='\" + bName + \"' class='ui-state-default ui-corner-all' \"\r\n\t\t\t\t\t\t\t\t\t+ \"style='font-size: 12px; text-decoration: none; line-height: 1.4; display:inline-block; padding:5px 2px 2px 2px;' \"\r\n\t\t\t\t\t\t\t\t\t+ \"href='#' onclick='RecoverIntakeReportData(this); return false;'>&nbsp;Recover&nbsp;</a>\";\r\n\t\t\t\t\t\t\t\t$(txt).closest(\"div\").find(\"a[check_spelling]\").after(recoverHtml);\r\n\t\t\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\tcatch (e) { }\r\n\t\t\t});\r\n\r\n\t\t//enable textarea spelling check by default, if exists config textarea_hide_spelling_check and value is 1 then disable spelling check.\r\n\t\tif (typeof __textarea_hide_spelling_check == \"undefined\" || __textarea_hide_spelling_check != \"1\")\r\n\t\t{\r\n\t\t\t$textareaObjs.after(\"<br><a check_spelling='1' class='ui-state-default ui-corner-all' \"\r\n\t\t\t\t+ \"style='font-size: 12px; text-decoration: none; line-height: 1.4; display:inline-block; padding:5px 2px 2px 2px;' \"\r\n\t\t\t\t+ \"href='#' onclick='showSpellCheckDialog(this, false); return false;'>Check Spelling</a>\")\r\n\t\t\t\t.blur(function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tif ($(this).data(\"spell_checked_flag\") == \"0\" && typeof (AutoSpellingCheck) == \"string\" && AutoSpellingCheck == \"1\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tshowSpellCheckDialog(this, true);\r\n\t\t\t\t\t}\r\n\t\t\t\t}).change(function ()\r\n\t\t\t\t{\r\n\t\t\t\t\t$(this).data(\"spell_checked_flag\", \"0\");\r\n\t\t\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\t//richtextbox Recover function\r\n\tif (canSave)\r\n\t{\r\n\t\t$.each(RecoverDataBookmarkList, function (i, bName)\r\n\t\t{\r\n\t\t\tvar $frame = $(\"div.toolbar[toolbar='1']\").next(\"iframe[id='\" + bName + \"']\");\r\n\t\t\tif ($frame.length > 0)\r\n\t\t\t{\r\n\t\t\t\tvar recoverHtml = \"&nbsp;&nbsp;<a obn='\" + bName + \"' class='ui-state-default ui-corner-all' \" +\r\n\t\t\t\t\t\"