|(\\\\([\\x01-\\x09\\x0b\\x0c\\x0d-\\x7f]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]))))*(((\\x20|\\x09)*(\\x0d\\x0a))?(\\x20|\\x09)+)?(\\x22)))@((([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))\\.)+(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))\\.?$/i.test(value);\r\n}\r\n\r\nfunction isURL(value)\r\n{\r\n\treturn /^(https?|ftp):\\/\\/(((([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(%[\\da-f]{2})|[!\\$&'\\(\\)\\*\\+,;=]|:)*@)?(((\\d|[1-9]\\d|1\\d\\d|2[0-4]\\d|25[0-5])\\.(\\d|[1-9]\\d|1\\d\\d|2[0-4]\\d|25[0-5])\\.(\\d|[1-9]\\d|1\\d\\d|2[0-4]\\d|25[0-5])\\.(\\d|[1-9]\\d|1\\d\\d|2[0-4]\\d|25[0-5]))|((([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))\\.)+(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))\\.?)(:\\d*)?)(\\/((([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(%[\\da-f]{2})|[!\\$&'\\(\\)\\*\\+,;=]|:|@)+(\\/(([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(%[\\da-f]{2})|[!\\$&'\\(\\)\\*\\+,;=]|:|@)*)*)?)?(\\?((([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(%[\\da-f]{2})|[!\\$&'\\(\\)\\*\\+,;=]|:|@)|[\\uE000-\\uF8FF]|\\/|\\?)*)?(\\#((([a-z]|\\d|-|\\.|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(%[\\da-f]{2})|[!\\$&'\\(\\)\\*\\+,;=]|:|@)|\\/|\\?)*)?$/i.test(value);\r\n}\r\n\r\nfunction isNumber(value)\r\n{\r\n\treturn !(isNaN(value) || Math.abs(parseFloat(value)) > 2147483647);\r\n}\r\n\r\nfunction isAlphabetic(value)\r\n{\r\n\tvar alphabeticePat = /^[a-zA-Z]?$/;\r\n\r\n\tvar matchArray = value.match(alphabeticePat);\r\n\tif (matchArray == null)\r\n\t{\r\n\t\treturn false;\r\n\t}\r\n\treturn true;\r\n}\r\n\r\nfunction isFloat(value, dataType)\r\n{\r\n\tvar floatPat = /^-?\\d+(\\.\\d+)?$/;\r\n\tvar matchArray = value.match(floatPat);\r\n\tif (matchArray == null)\r\n\t{\r\n\t\treturn false;\r\n\t}\r\n\tvar len = 0;\r\n\tvar flag = true;\r\n\tvar cValue = value;\r\n\twhile (flag)\r\n\t{\r\n\t\tif (cValue.substring(0, 1) == \"0\")\r\n\t\t{\r\n\t\t\tlen = len + 1;\r\n\t\t\tcValue = cValue.substring(1);\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\tflag = false;\r\n\t\t}\r\n\t}\r\n\tif (len > 1 || (len == 1 && value.length > 1 && cValue.substring(0, 1) != \".\"))\r\n\t{\r\n\t\treturn false;\r\n\t}\r\n\tdataType = dataType.substring(5);\r\n\tvar strs = dataType.split(\".\");\r\n\tif (strs.length != 2) { return false; }\r\n\tvar lenbeforeDot = parseInt(strs[0], 10);\r\n\tvar lenafterDot = parseInt(strs[1], 10);\r\n\r\n\tvar strsV = value.split(\".\");\r\n\tvar lenbeforeDotV, lenafterDotV;\r\n\tif (strsV.length != 1 && strsV.length != 2)\r\n\t{\r\n\t\treturn false;\r\n\t}\r\n\telse\r\n\t{\r\n\t\tlenbeforeDotV = strsV[0].length;\r\n\t\tif (lenbeforeDotV > lenbeforeDot)\r\n\t\t{\r\n\t\t\treturn false;\r\n\t\t}\r\n\t\tif (strsV.length == 2)\r\n\t\t{\r\n\t\t\tlenafterDotV = strsV[1].length;\r\n\t\t\tif (lenafterDotV > lenafterDot)\r\n\t\t\t{\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn true;\r\n}\r\n\r\nfunction isCorrectNumber(stringValue, max)\r\n{\r\n\tvar value = stringValue.split(/[\\/-]/g);\r\n\treturn !((value != parseInt(value) || Math.abs(value) > max))\r\n}\r\n\r\nfunction isDate(stringValue)\r\n{\r\n\tvar strDataValue, objDate;\r\n\tvar intOldYear, intOldMonth, intOldDay, strs;\r\n\tvar intYear, intFullYear, intMonth, intDay, strNewDate;\r\n\tstrDataValue = stringValue;\r\n\tstrs = stringValue.split(/[\\/-]/g);\r\n\tif (strs.length != 3) { return false; }\r\n\tintOldYear = parseInt(strs[2], 10);\r\n\tintOldMonth = parseInt(strs[0], 10);\r\n\tintOldDay = parseInt(strs[1], 10);\r\n\tobjDate = new Date(strDataValue);\r\n\tintYear = parseInt(objDate.getYear(), 10);\r\n\tintFullYear = parseInt(objDate.getFullYear(), 10);\r\n\tintMonth = parseInt(objDate.getMonth() + 1, 10);\r\n\tintDay = parseInt(objDate.getDate(), 10);\r\n\tif ((intOldYear == intYear || intOldYear == intFullYear) && intOldMonth == intMonth && intOldDay == intDay && 1800 < objDate.getFullYear() && objDate.getFullYear() < 3000)\r\n\t{\r\n\t\treturn true;\r\n\t}\r\n\telse\r\n\t{\r\n\t\treturn false;\r\n\t}\r\n}\r\n\r\n\r\nfunction isTime(timeStr)\r\n{\r\n\tvar timePat = /^(\\d{1,2}):(\\d{2})(:(\\d{2}))?(\\s?(AM|am|PM|pm))?$/;\r\n\r\n\tvar matchArray = timeStr.match(timePat);\r\n\tif (matchArray == null)\r\n\t{\r\n\t\t//alert(\"Time is not in a valid format.\");\r\n\t\treturn false;\r\n\t}\r\n\r\n\thour = matchArray[1];\r\n\tminute = matchArray[2];\r\n\tsecond = matchArray[4];\r\n\tampm = matchArray[6];\r\n\r\n\tif (second == \"\") { second = null; }\r\n\tif (ampm == \"\") { ampm = null }\r\n\r\n\tif (hour < 0 || hour > 23)\r\n\t{\r\n\t\t//alert(\"Hour must be between 1 and 12. (or 0 and 23 for military time)\");\r\n\t\treturn false;\r\n\t}\r\n\t/*\r\n\tif (hour <= 12 && ampm == null)\r\n\t{\r\n\tif (confirm(\"Please indicate which time format you are using. OK = Standard Time, CANCEL = Military Time\"))\r\n\t{\r\n\talert(\"You must specify AM or PM.\");\r\n\treturn false;\r\n\t}\r\n\t}\r\n\t*/\r\n\tif (hour > 12 && ampm != null)\r\n\t{\r\n\t\t//alert(\"You can't specify AM or PM for military time.\");\r\n\t\treturn false;\r\n\t}\r\n\r\n\tif (minute < 0 || minute > 59)\r\n\t{\r\n\t\t//alert(\"Minute must be between 0 and 59.\");\r\n\t\treturn false;\r\n\t}\r\n\tif (second != null && (second < 0 || second > 59))\r\n\t{\r\n\t\t//alert(\"Second must be between 0 and 59.\");\r\n\t\treturn false;\r\n\t}\r\n\treturn true;\r\n}\r\n//======================= check validate function ~~", "size":6356, "mimeType":"text/javascript"}, "headers":[{"name":"Content-Type", "value":"text/javascript"}, {"name":"Last-Modified", "value":"Tue, 28 Jul 2026 12:31:15 GMT"}, {"name":"Accept-Ranges", "value":"bytes"}, {"name":"ETag", "value":"\"1dd1e8cfb383354\""}, {"name":"Vary", "value":"Accept-Encoding"}, {"name":"Server", "value":"Microsoft-IIS/10.0"}, {"name":"X-Powered-By", "value":"ASP.NET"}, {"name":"Date", "value":"Wed, 29 Jul 2026 06:04:17 GMT"}, {"name":"Content-Length", "value":"6356"}]}, "startedDateTime":"2026-07-29T14:04:17.8433326+08:00", "cache":{}}, {"time":268, "connection":"ClientPort:7772;EgressPort:7773", "comment":"[#154]", "request":{"headersSize":2036, "postData":{"text":"", "mimeType":""}, "queryString":[{"name":"v", "value":"HT9ayPnfVbSQRVJsOGFE-qOsvREOPlXqAAWxU6Dqy70"}], "headers":[{"name":"Host", "value":"parms42test.csitech.com"}, {"name":"Connection", "value":"keep-alive"}, {"name":"sec-ch-ua-platform", "value":"\"Windows\""}, {"name":"User-Agent", "value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36"}, {"name":"sec-ch-ua", "value":"\"Not;A=Brand\";v=\"8\", \"Chromium\";v=\"150\", \"Google Chrome\";v=\"150\""}, {"name":"sec-ch-ua-mobile", "value":"?0"}, {"name":"Accept", "value":"*/*"}, {"name":"Sec-Fetch-Site", "value":"same-origin"}, {"name":"Sec-Fetch-Mode", "value":"no-cors"}, {"name":"Sec-Fetch-Dest", "value":"script"}, {"name":"Referer", "value":"https://parms42test.csitech.com/RMS/Aspsoft/IntakeForm/Intake?nextPID=listPoliceReport&MPID=intakeFormMiddelPage&case_id=1100017412&template_id=1318&report_id=4191&rnd=0.4480235126577403"}, {"name":"Accept-Encoding", "value":"gzip, deflate, br, zstd"}, {"name":"Accept-Language"