box_MyPendingReport\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_MyPendingReport\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030104\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030103,\"inboxSubName\":\"My Incomplete Reports\",\"inboxSubPageId\":\"listInbox_IncompleteReport\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_IncompleteReport\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030103\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030102,\"inboxSubName\":\"My Returned Reports\",\"inboxSubPageId\":\"listInbox_ReturnedReport\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_ReturnedReport\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030102\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030105,\"inboxSubName\":\"My Closed Cases (7 Days)\",\"inboxSubPageId\":\"listInbox_MyClosedCase\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_MyClosedCase\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030105\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030106,\"inboxSubName\":\"All Agency Cases (96 hours)\",\"inboxSubPageId\":\"listInbox_AllAgencyCase96\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_AllAgencyCase96\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030106\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030107,\"inboxSubName\":\"All Agency Cases (72 hours)\",\"inboxSubPageId\":\"listInbox_AllAgencyCase24\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_AllAgencyCase24\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030107\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"},{\"inboxId\":100301,\"inboxDesc\":\"RMS - Officer\",\"inboxSubId\":10030108,\"inboxSubName\":\"All Agency Cases (12 hours)\",\"inboxSubPageId\":\"listInbox_AllAgencyCase12\",\"url\":\"/RMS/inbox/list?nextPID=listInbox_AllAgencyCase12\\u0026inbox_staff_id=1\\u0026inbox_sub_id=10030108\\u0026UseDefault=1\\u0026is_temp_page_size=1\\u0026page_size=100\"}],\r\n\t\t\t\tget favoriteMenus(){\r\n\t\t\t\t\tlet data = [];\r\n\t\t\t\t\tthis.menuCategories.forEach((category)=>{\r\n\t\t\t\t\t\tcategory.menuItems.forEach((item)=>{\r\n\t\t\t\t\t\t\tif(item.isFavorite){\r\n\t\t\t\t\t\t\t\tdata.push({\r\n\t\t\t\t\t\t\t\t ...item,\r\n\t\t\t\t\t\t\t\t categoryId:category.id\r\n\t\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t});\r\n\t\t\t\t\treturn data;\r\n\t\t\t\t},\r\n\t\t\t\tasync modifyFavoriteMenu(categoryId,menuId) {\r\n\t\t\t\t\tlet category = this.menuCategories.find(i=>i.id == categoryId);\r\n\t\t\t\t\tlet menuItem = category.menuItems.find(i=>i.id == menuId);\r\n\t\t\t\t\tconst isFav = !menuItem.isFavorite;\r\n\t\t\t\t\tconst url = `${ResolveClientUrl(\"~/Aspsoft/HomeHandler/modifyFavoriteMenu\")}?nodeId=${menuId}&isFav=${isFav}`;\r\n\t\t\t\t\tconst response = await fetch(url, {\r\n\t\t\t\t\t\tmethod: \"POST\"\r\n\t\t\t\t\t})\r\n\t\t\t\t\tif(response.ok) {\r\n\t\t\t\t\t\tmenuItem.isFavorite = !menuItem.isFavorite;\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t}));\r\n\t\t});\r\n</script>\r\n\t\t\t\t<div class=\"app-main\" id=\"app-main\">\r\n\r\n<div class=\"app-top-bar-wrapper d-flex align-items-center flex-wrap\">\r\n\t\t<nav aria-label=\"breadcrumb\">\r\n\t\t\t<ol class=\"breadcrumb fw-semibold\">\r\n\t\t\t\t<li class=\"breadcrumb-item\">\r\n\t\t\t\t\t<a class=\"nav-link\" href=\"/RMS/Home\">\r\n\t\t\t\t\t\t<i class=\"info-icon-home icon-sizes-3\"></i> Home\r\n\t\t\t\t\t</a>\r\n\t\t\t\t</li>\r\n\t\t\t</ol>\r\n\t\t</nav>\r\n\t<ul class=\"app-top-bar nav ms-auto\">\r\n\t\t\r\n\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t<a class=\"nav-link\" href=\"/RMS/aspsoft/dispatcher?nextPID=listReports\" target=\"main\">Reports</a>\r\n\t\t\t</li>\r\n\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t<a class=\"nav-link\" href=\"/RMS/aspsoft/dispatcher?nextPID=listImportExcel\" target=\"main\">Import Excel</a>\r\n\t\t\t</li>\r\n\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t<a class=\"nav-link\" href=\"/RMS/ASPSoft/ManualPages/ManualsFolderDisplay?nextPID=showProcedureManual\" target=\"main\">Procedures Manual</a>\r\n\t\t\t</li>\r\n\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t<a class=\"nav-link\" href=\"/RMS/aspsoft/eLearning/index\" target=\"_blank\">eLearning</a>\r\n\t\t\t</li>\r\n\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t<a class=\"nav-link\" href=\"/RMS/AspSoft/FullTextSearch/Search?nextPID=fullTextSearch_CaseDocument\" target=\"main\">Full Text Search</a>\r\n\t\t\t</li>\r\n\t</ul>\r\n</div>\r\n\t\t\t\t\t\t<!--tab menu-->\r\n\r\n\t\t\t\t\t<!--Step by step menu-->\r\n\t\t\t\t\t<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\r\n\t\t\t\t\t\t<tbody>\r\n\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t<script>\r\n\t$(function ()\r\n\t{\r\n\t\tvar $wfNavContainer = $(\"table.wf_nav_container\");\r\n\t\t$wfNavContainer.find(\"a[wf_status]\").each(function (idx, obj)\r\n\t\t{\r\n\t\t\tvar $link = $(obj);\r\n\t\t\tif ($link.attr(\"wf_status\") == \"-1\")\r\n\t\t\t{\r\n\t\t\t\t$link.removeAttr(\"href\").css(\"cursor\", \"default\").mouseover(function () { });\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$link.attr(\"href\", $link.attr(\"url\")).css(\"cursor\", \"pointer\");\r\n\t\t\t}\r\n\t\t});\r\n\t});\r\n</script>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t</tbody>\r\n\t\t\t\t\t</table>\r\n\t\t\t\t\t\r\n\t<div class=\"dispatcher-view-container rounded\" id=\"content\">\r\n\t\t<div class=\"dispatcher-view border-0\">\r\n\t\t\t\r\n<div class=\"engine-list-page-container\">\r\n\t\t<div class=\"engine-list-page-top-form-container\">\r\n\t\t\t\r\n\t\t</div>\r\n\r\n\t\t<div class=\"engine-list-page-table-container\">\r\n\t\t\t\r\n\t\t<div class=\"list-navigation-container\"><div class=\"