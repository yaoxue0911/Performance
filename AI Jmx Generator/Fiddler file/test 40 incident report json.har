>\r\n\t\t\t\t<div class=\"form-row footer-row no-border\">\r\n<div class='col row-item footer-row-item no-border flex-nowrap gap-2 row-item-align-center' style='flex: none;'>\t\t\t\t\t<label for=\"submit_button~|~|295987\" class=\"form-label\">Select All</label>\r\n\t\t\t\t\t\t\t<input type=\"checkbox\" class=\"form-check-input\" id=\"submit_button~|~|295987\" objectname=\"submit_button\" onclick=\"selectAllCheckbox(event)\" />\r\n</div><div class='col row-item footer-row-item no-border flex-nowrap gap-2 row-item-justify-center'>\t\t\t\t\t<input name=\"submit_button\" class=\"btn btn-success btngreen\" ObjectName=\"submit_button\" type=\"submit\" value=\"No Report / No Further Action\" onclick=\"if(FselectAll()){return checkInput();}else{return false;}\" layout_id=\"295988\"></input>\r\n</div>\t</div>\r\n\r\n\t\t</div>\r\n</div>\r\n\t\t</div>\r\n\t</div>\r\n\t<input type=\"hidden\" name=\"__nextPID\" id=\"__nextPID\" objectname=\"__nextPID\" value=\"listInbox_MyActiveCase\" />\r\n\t<input type=\"hidden\" name=\"PID\" value=\"listInbox_MyActiveCase\" />\r\n\t<input type=\"hidden\" name=\"doubleEntryTimeStamp\" value=\"7/29/2026 2:01:16 AM\" />\r\n\r\n\r\n\t\t\t\t\t<!-- concurrent logins tips -->\r\n\t\t\t\t\t<div id=\"divConcurrentLoginsTips\" class=\"concurrent_logins_tips_bak\" style=\"display: none;\">\r\n\t\t\t\t\t\t<div style=\"height: 80px; margin: 20px; font-size: 20px;font-family:'Lato', Calibri, sans-serif;\">\r\n\t\t\t\t\t\t\t<b>WARNING:</b> Your account has logged on to another session.  To retain this other session hit continue To terminate the other session hit Force Logout.\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t<table style=\"width: 100%;\">\r\n\t\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t\t\t<td style=\"text-align: right;\">\r\n\t\t\t\t\t\t\t\t\t<input type=\"button\" action_type=\"LOGOUT\" class=\"btn btn-danger\" value=\"Force Logout\" onclick=\"SetConcurrentLoginsAction('LOGOUT')\" />\r\n\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t\t<td style=\"text-align: left;\">\r\n\t\t\t\t\t\t\t\t\t<input type=\"button\" action_type=\"CONTINUE\" class=\"btn btn-secondary\" value=\"Continue\" onclick=\"SetConcurrentLoginsAction('CONTINUE')\" />\r\n\t\t\t\t\t\t\t\t</td>\r\n\t\t\t\t\t\t\t</tr>\r\n\t\t\t\t\t\t</table>\r\n\t\t\t\t\t</div>\r\n\r\n<div class=\"search_criteria_wrapper\">\r\n\t<script type='text/javascript' src=\"/RMS/js/RMS/SearchFilter.js?v=DPHoK52xIRBLC2Z9scfGIHdeuV0F9L0wcgJxDTwBiNc\"></script>\r\n\t<table style=\"border: 0px solid gray; display: none; padding-left: 2px;\" class=\"search_criteria_container\">\r\n\t\t<tr>\r\n\t\t\t<td>\r\n\t\t\t\t<b>Name</b>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t\t<select style=\"width: 200px\" class=\"select_save_criteria\"><option value=\"\"></option>\r\n</select>\r\n\t\t\t</td>\r\n\t\t\t<td>\r\n\t\t\t\t<input type=\"button\" value=\"Save Criteria\" class=\"button_save_criteria btn btn-primary\" />\r\n\t\t\t\t<input type=\"button\" value=\"Change Name\" class=\"button_update_criteria btn btn-success\"\r\n\t\t\t\t\t   style=\"display: none;\" />\r\n\t\t\t\t<input type=\"button\" value=\"Delete\" class=\"button_delete_criteria btn btn-danger\" style=\"display: none;\" />\r\n\t\t\t\t<input type=\"hidden\" id=\"hdnSearchCriteriaPageID\" name=\"hdnSearchCriteriaPageID\" value=\"listInbox_MyActiveCase\" />\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t</table>\r\n\t<div id=\"divSaveSearchHistory\" style=\"display: none; overflow: hidden;\" title=\"Save Search Criteria\">\r\n\t\t<br />\r\n\t\t<table style=\"width: 98%; border: #dddddd 1px solid; margin-left: 5px; margin-right: 5px;\">\r\n\t\t\t<tr>\r\n\t\t\t\t<td style=\"width: 20px;\">\r\n\t\t\t\t\t<b>Name:</b>&nbsp;\r\n\t\t\t\t</td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<input id=\"txtSearchHistoryName\" size=\"36\" maxlength=\"100\" class=\"textbox\" style=\"border: 1px solid black;\"\r\n\t\t\t\t\t\t   autocomplete=\"off\" />\r\n\t\t\t\t\t<select id=\"ddlExistSearchName\" style=\"display: none; width: 320px;\">\r\n\t\t\t\t\t\t<option value=\"\"></option>\r\n\t\t\t\t\t</select>\r\n\t\t\t\t</td>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t<input type=\"button\" value=\"Save\" id=\"btnSaveSearchHistory\" class=\"btn btn-primary\" style=\"display: none;\" />\r\n\t\t\t\t\t<input type=\"button\" value=\"Update\" id=\"btnUpdateSearchHistory\" class=\"btn btn-primary\" style=\"display: none;\" />\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\t<td>\r\n\t\t\t\t\t&nbsp;\r\n\t\t\t\t</td>\r\n\t\t\t\t<td colspan=\"2\">\r\n\t\t\t\t\t<span id=\"spSwitchType\">\r\n\t\t\t\t\t\t<input type=\"checkbox\" id=\"cbSwitchType\" />\r\n\t\t\t\t\t\t<label for=\"cbSwitchType\" style=\"font-weight: bold; cursor: pointer;\">\r\n\t\t\t\t\t\t\tSave to existing filter\r\n\t\t\t\t\t\t</label>\r\n\t\t\t\t\t</span>\r\n\t\t\t\t</td>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t</div>\r\n</div>\r\n\r\n<div class=\"mt-auto pt-4\"></div>\r\n\t<div class=\"app-footer-tips-container d-flex align-items-center\">\r\n\t\t<span class=\"app-footer-tips text-body-tertiary\">\r\n\t\t\t<b>Tips: </b>\r\n\t\t\tClick Underline field to view the record detail.\r\n\t\t</span>\r\n\t</div>\r\n<div id=\"tabBarBottom\" >\r\n\t\t<hr class=\"my-1\" />\r\n\t<div class=\"app-footer d-flex align-items-center\">\r\n\t\t\t<div>\r\n\t\t\t\tCopyright \u00a9 CSI Technology Group. All rights reserved.\r\n\t\t\t</div>\r\n\t\t<ul class=\"nav ms-auto\">\r\n\t\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t\t<a class=\"nav-link px-2\" href=\"/RMS/AspSoft/Common/Debug\" target=\"_blank\">Debug</a>\r\n\t\t\t\t</li>\r\n\t\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t\t<a class=\"nav-link px-2\" href=\"#\" onclick=\"openPageWin(); return false;\">Page<span style='color:red'>*</span></a>\r\n\t\t\t\t</li>\r\n\t\t</ul>\r\n\t</div>\r\n</div>\r\n\t\t\t\t</div>\r\n\t\t\t<input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"CfDJ8Lt5bHFAdgVKqAT8TxuezclQT3smYYSEF30fou8GTMo_7cPiMqtNJvG54LuShNUWC2Frp_zK6lW40yj7D3O6PXjVSvOgUGk4uJRSIoZM1aFdUL84Y96QAvB5xWUPz8dvEbgMlbk_5LLXKvADlQZvNu8Y3xSiHBGg4bAOFcKE7ZglI5oRHc0HnijLbXJ7Y9CGCg\" />