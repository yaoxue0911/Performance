w-item footer-row-item no-border row-item-justify-center\" style=\"width: 0px; padding: 0px; display: none;\"  data-colspan=\"1\" data-width=\"\" >\t\t\t\t\t<div>\n\t\t\t\t\t\t<table>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"o_master_location_id~|other_location_add~|A\" objectname=\"o_master_location_id\" value=\"\"  layout_id=\"301815\" SearchDirection=\"searchto\" ObjectName=\"o_master_location_id\" mapping=\"master_location_id\" mappinggroup=\"other\">\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</div>\n</div><div class=\"col row-item footer-row-item no-border row-item-justify-center\" style=\"width: 0px; padding: 0px; display: none;\"  data-colspan=\"1\" data-width=\"\" >\t\t\t\t\t<div>\n\t\t\t\t\t\t<table>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"o_source~|other_location_add~|A\" objectname=\"o_source\" value=\"\"  layout_id=\"301816\" SearchDirection=\"searchto\" ObjectName=\"o_source\" mapping=\"source\" mappinggroup=\"other\">\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</div>\n</div><div class=\"col row-item footer-row-item no-border row-item-justify-center\" style=\"width: 0px; padding: 0px; display: none;\"  data-colspan=\"1\" data-width=\"\" >\t\t\t\t\t<div>\n\t\t\t\t\t\t<table>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"person_id~|contact_unknown_add~|A\" objectname=\"person_id\" value=\"0\"  layout_id=\"301825\" SearchDirection=\"searchto\" ObjectName=\"person_id\" searchalias=\"p\">\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</div>\n</div><div class=\"col row-item footer-row-item no-border row-item-justify-center\" style=\"width: 0px; padding: 0px; display: none;\"  data-colspan=\"1\" data-width=\"\" >\t\t\t\t\t<div>\n\t\t\t\t\t\t<table>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"case_id~|contact_unknown_add~|A\" objectname=\"case_id\" value=\"1100017412\"  layout_id=\"301826\" ObjectName=\"case_id\">\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</div>\n</div></div></div>\r\n\t\t</div>\r\n</div>\r\n\t\t<input type=\"hidden\" name=\"PID\" id=\"PID\" value=\"addCaseVW\" />\r\n\t\t<input type=\"hidden\" name=\"doubleEntryTimeStamp\" id=\"doubleEntryTimeStamp\" value=\"7/29/2026 2:01:46 AM\" />\r\n</div>\r\n</div>\r\n<script>\r\n\tvar __is_engine_page = true;\r\n\tvar __searchPageID = 'addCaseVW';\r\n</script>\r\n\r\n\t\t\t<input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"CfDJ8Lt5bHFAdgVKqAT8Txuezcm-AULaa5E1jZ2dR7vOCZHDjab_iWtAgtS1GVPTjFhVBRwDocAYOAQpBo3zjGORb0Unh-7RGMID5GpDcUdA4j-dIZ-2Uson-jpF7uqYvWvQS6Mu-1sZ45iOgyvKuA6sqzoUg0n_yDPjE-AAMOsBo2kulczFrij824AhvGd9XEwROQ\" /></form>\r\n\t\t</div>\r\n\t</div>\r\n\t<div class=\"p-2\">\r\n\t\t\r\n<div class=\"mt-auto pt-4\"></div>\r\n\t<div class=\"app-footer-tips-container d-flex align-items-center\">\r\n\t\t<span class=\"app-footer-tips text-body-tertiary\">\r\n\t\t\t<b>Tips: </b>\r\n\t\t\tClick Save button to save added record or Clear button to clear entered data.\r\n\t\t</span>\r\n\t\t\t<img alt=\"Show/Hide Footer\" class=\"ms-auto\" src=\"/RMS/images/2downarrow.png\" onclick=\"showFooter(this);return false;\" style=\"cursor: pointer;\">\r\n\t</div>\r\n<div id=\"tabBarBottom\" style=display:none>\r\n\t\t<hr class=\"my-1\" />\r\n\t<div class=\"app-footer d-flex align-items-center\">\r\n\t\t<ul class=\"nav ms-auto\">\r\n\t\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t\t<a class=\"nav-link px-2\" href=\"/RMS/AspSoft/Common/Debug\" target=\"_blank\">Debug</a>\r\n\t\t\t\t</li>\r\n\t\t\t\t<li class=\"nav-item\">\r\n\t\t\t\t\t\t<a class=\"nav-link px-2\" href=\"#\" onclick=\"openPageWin(); return false;\">Page<span style='color:red'>*</span></a>\r\n\t\t\t\t</li>\r\n\t\t</ul>\r\n\t</div>\r\n</div>\r\n\r\n\t</div>\r\n\t<script src=\"/RMS/js/aspsoft/Utils.js?v=1Dt4UJ0vGlFknbYgBjoLtmnGS8Br8ntlpGELyokOZDE\" type=\"module\"></script>\r\n<script src=\"/RMS/js/aspsoft/WaitBox.js?v=S6nKABXFHLQz06wxy54_jqP3j7q5DawyI_aeHka9K3M\" type=\"module\"></script>\r\n<script src=\"/RMS/js/aspsoft/CustomModal.js?v=RwmwAZxsWg4XNaArApLpswECgs8hokVfTPU955ORyt8\" type=\"module\"></script>\r\n<script src=\"/RMS/js/aspsoft/Ellipsis.js?v=yZ8UMvPsiI8yZp12oMJJUND9dFPbYFnLxZPxsKKoqnU\" type=\"module\"></script>\r\n<script src=\"/RMS/js/aspsoft/AsyncFilter.js?v=YSWYthbcUI4sy_rfKfOVJk4vBjuCyLawjgLZG63Zk44\" type=\"module\"></script>\r\n<script src=\"/RMS/js/aspsoft/AsyncSearch.js?v=XOUWx_WQp4NOpxLjRp-xs4q5PVeQJ7Cb0U8gTupbZTU\" type=\"module\"></script>\r\n\r\n<script src=\"/RMS/js/aspsoft/Common.js?v=LXM95vuqDnIh-ugZGk_Bi_9d7d4XzhXmvyrZrfsKej8\"></script>\r\n<script src=\"/RMS/js/aspsoft/Mask.js?v=_HLJUyY4xP2IISjF0DxXazTQS_tkaakoPP5NGI4mmvg\"></script>\r\n<script src=\"/RMS/js/aspsoft/Calendar.js?v=m8GhRGG-tMUhkO5SBsFOmg3ykj_YV5bi1G_qiifjqxc\"></script>\r\n<script src=\"/RMS/js/aspsoft/NoteBox.js?v=92l6lMfleoNc_RPD2-DyKV-NKeVs472KHy_9SQfAwd0\"></script>\r\n<script src=\"/RMS/js/aspsoft/ComboBox.js?v=HB3hcGX_OoF3WLxK8G1CuAt_GxlGF8YWFJdYwxb_gaY\"></script>\r\n<script src=\"/RMS/js/aspsoft/DropdownComboBox.js?v=f5-2zO17nOPdFR5OKH5FtvQwLNCtHcKTJLQYJpSvs9U\"></script>\r\n<script src=\"/RMS/js/aspsoft/DropCheckBox.js?v=yYW2H6efNbegLxVyO77Jytg90T_iRUOj1GGHJ7grZkg\"></script>\r\n\r\n<script src=\"/RMS/js/aspsoft/DynamicDropdown.js?v=_11kW5G3rOw7FxMUJ6Dn0_NHp64iyahSlaEtJNcTh3g\"></script>\r\n<script src=\"/RMS/js/aspsoft/ChangeDynamicArea.js?v=ptnQ6lMbQPgacIaxQQusSj9HYsTcugm-txnygXa-IP8\"></script>\r\n<script src=\"/RMS/js/aspsoft/ShowMasterName.js?v=OGmWT8WB7NRfB8cesHjjEp0sbJ01BhoOCTcFQM62sEc\"></script>\r\n\r\n<script src=\"/RMS/js/aspsoft/MultiSection.js?v=svpfB6A8WZXES6UiOpqt1N7s2D8B-J6v_PqzJqaXIvI\"></script>\r\n<script src=\"/RMS/js/aspsoft/MultiLayerDialog.js?v=3LawXtRbI6ed6QQ1rYekdJG74IpK3g3pMr1Kw5yJtxI\"></script>\r\n\t<script>\r\n    sessionStorage.setItem(\"InfoMappingToken\", \"eyJhbGciOiJodHRwOi8vd3d3LnczLm9yZy8yMDAxLzA0L3htbGRzaWctbW9yZSNobWFjLXNoYTI1NiIsInR5cCI6IkpXVCJ9.eyJodHRwOi8vc2NoZW1hcy54bWxzb2FwLm9yZy93cy8yMDA1LzA1L2lkZW50aXR5L2NsYWltcy9uYW1laWRlbnRpZmllciI6IjEiLCJuYmYiOjE3ODUzMDQ4NzYsImV4cCI6MTc4NTM5MTI3NiwiaXNzIjoiQ1NJSW5mb1NoYXJlIiwiYXVkIjoiSW5mb1JNU01hcHBpbmcifQ.PCCLNlCY0onZQPRtarr7Y6inEcTQZpdWHvjvCLAysoI\");\r\n    sessionStorage.setItem(\"MappingKey\", \"InfoVMcTH8d8qNANFsK2U40BjNwSrsLdtvJAOE48xIvXrPaRel2R\");\r\n    sessionStorage.setItem(\"MappingService\", \"https://parms42test.csitech.com/InfoMapping\");\r\n    sessionStorage.setItem(\"QueryConditions\", \"[{&quot;Name&quot;:&quot;local&quot;,&quot;Enabled&quot;:true,&quot;Count&quot;:10},{&quot;Name&quot;:&quot;azure&quot;,&quot;Enabled&quot;:true,&quot;Count&quot;:5}]\");\r\n    sessionStorage.setItem(\"QueryAddressRegion\", \"39.7214,-76.4402,40.7874,-74.7215\");\r\n    sessionStorage.setItem(\"staffRegionId\", \"100000\");\r\n</script>\r\n<script type=\"text/javascript\" src=\"https://parms42test.csitech.com/InfoMapping/bundles/map-sdk.js\"></script>\r\n<link type=\"text/css\" href=\"https://parms42test.csitech.com/InfoMapping/bundles/map-sdk.css\" rel=\"stylesheet\"/>\r\n<script src=\"/RMS/infomapping/crimemapping/js/location-mapping.js?v=c8ltvf2NjiXEU2jb8hFM39sH9w0nIC4gyzfeLJDsI30\"></script>\r\n\t\r\n\t<!--start of webpage-append--><script type=\"text/javascript\" language=\"javascript\">var crime_from_date = \"07/29/2026\";\r\n$(function () {\r\n    $(\"[ObjectName=dob]\").on('change',count_age);\r\n    $(\"[ObjectName=dob]\").blur(count_age);\r\n    //wo#335531\r\n    $(\"[ObjectName=contact_age_min]\").on('change',rangeAge);\r\n    $(\"[ObjectName=contact_age_max]\").on('change',rangeAge);\r\n    $(\"input[ObjectName=contact_age]\").blur(function(){\r\n        var objJuv = $(\"[ObjectName=is_juvenile]\");\r\n        let age = Number.parseInt($(this).val())\r\n        if(age <18){\r\n            objJuv.val(6).prop('disabled',true);\r\n        }else if(age >=18){\r\n            objJuv.val(0).prop('disabled',true);\r\n        }else{\r\n            objJuv.val('').prop('disabled',false);\r\n        }\r\n    });\r\n});\r\n\r\nfunction count_age() {\r\n    var objDOB = $(\"[ObjectName=dob]\");\r\n    var objAge = $(\"input[ObjectName=contact_age]\");\r\n    var objJuv = $(\"[ObjectName=is_juvenile]\");\r\n    \r\n    if(CheckFutureDate(objDOB))\r\n    {\r\n        var dob = new Date(objDOB.val());\r\n        var base_date;\r\n        if (crime_from_date !== \"\"){\r\n            base_date = new Date(crime_from_date);\r\n        }\r\n        else{\r\n            base_date = new Date();\r\n        }\r\n\r\n        var age = base_date.getFullYear() - dob.getFullYear() - ((base_date.getMonth() < dob.getMonth() || base_date.getMonth() == dob.getMonth() && base_date.getDate() < dob.getDate()) ? 1 : 0);\r\n        if (isNaN(age)) {\r\n            objAge.val(\"\").prop('disabled', false);\r\n            objJuv.val(\"\").prop('disabled', false);\r\n        }\r\n        else {\r\n            objAge.val(age).prop('disabled', true);\r\n            if(parseInt(age)<18)\r\n            {\r\n                objJuv.val(6).prop('disabled',true);          \r\n            }\r\n            else\r\n            {\r\n                objJuv.val(0).prop('disabled',true);\r\n            }\r\n        }\r\n    }\r\n    else\r\n    {\r\n        objAge.val(\"\").prop('disabled', false);\r\n        objJuv.val(\"\").prop('disabled', false);\r\n    }           \r\n}\r\n\r\nfunction CheckFutureDate(dateObj) {\r\n    var today = new Date();\r\n    var targetDate = new Date($(dateObj).val());\r\n    if (targetDate > today) {\r\n        alert(\"Future Date Time is invalid\");\r\n        $(dateObj).val(\"\");\r\n        $(dateObj).focus();\r\n        return false;\r\n    }\r\n    return true;\r\n}\r\n//wo#335531\r\nfunction rangeAge() {\r\n    var minAge = $(\"select[ObjectName=contact_age_min]\").val();\r\n    var maxAge =  $(\"select[ObjectName=contact_age_max]\").val();\r\n    var objJuv = $(\"select[ObjectName=is_juvenile]\");\r\n    \r\n    if(minAge ==''){\r\n        objJuv.prop('disabled',false);\r\n        return;\r\n    }\r\n\r\n    if(minAge == '00'){\r\n        $(\"select[ObjectName=contact_age_max]\").val('').prop('disabled',true);\r\n        objJuv.prop('disabled',false);\r\n        return;\r\n    }\r\n    else{\r\n        $(\"select[ObjectName=contact_age_max]\").prop('disabled',false);\r\n    }\r\n\r\n    if(maxAge==''){\r\n        if(minAge =='NN' || minAge =='NB' || minAge =='BB'|| Number.parseInt(minAge) <= 17){\r\n            objJuv.val(6).prop('disabled',true);\r\n        }\r\n        else{\r\n            objJuv.val(0).prop('disabled',true);\r\n        }\r\n    }\r\n    else{\r\n        if (Number.parseInt(minAge) > Number.parseInt(maxAge)){\r\n            alert(\"Min Age should not be greater than Max Age\");\r\n            $(\"select[ObjectName=contact_age_max]\").val(\"\");\r\n            return;\r\n        }\r\n        else if(Number.parseInt(minAge)>17){\r\n            objJuv.val(0).prop('disabled',true);\r\n        }else if (Number.parseInt(maxAge) <18){\r\n            objJuv.val(6).prop('disabled',true);\r\n        }else{\r\n            objJuv.prop('disabled',false);\r\n        }\r\n    }\r\n}</script>\r\n<script type=\"text/javascript\" language=\"javascript\">function ShowMvLookupSearch(baseUrl, Type, checkExistInCase) {\r\n            var sFrom_value = '';\r\n            var rnd = Math.random();\r\n            if (Type == 'Person') {\r\n                [\"driver_license_state\", \"driver_license\", \"last_name\",\"first_name\",\"middle_name\",\"dob\",\"ssn\",\"sex\"].forEach(function(name) {\r\n                    var $el = $(\"[ObjectName='\" + name + \"']\");\r\n                    if ($el.length) {\r\n                        sFrom_value += '&' + name + '=' + escape($el.val());\r\n                    }\r\n                });\r\n            }\r\n            else if (Type == 'Vehicle') {\r\n                [\"state\", \"plate_no\", \"vin_no\"].forEach(function(name) {\r\n                    var $el = $(\"[ObjectName='\" + name + \"']\");\r\n                    if ($el.length) {\r\n                        sFrom_value += '&' + name + '=' + escape($el.val());\r\n                    }\r\n                });\r\n            }\r\n            \r\n            if (typeof(checkExistInCase) != 'undefined') \r\n            {\r\n                sFrom_value += '&check_exist_in_case=' + escape(checkExistInCase);\r\n            }\r\n            \r\n            PopUp(baseUrl + sFrom_value + \"&rnd=\" + rnd, 800, 600, \"\", function (revalues)\r\n            {\r\n               if(revalues != null){\r\n                   FillData(Type,revalues);\r\n               }\r\n            });\r\n\r\n        }\r\n\r\nfunction FillData(Type,revalues)\r\n{\r\n    $(\"[ObjectName='state']\").val(\"\");\r\n    $(\"[ObjectName='driver_license_state']\").val(\"\");\r\n    $(revalues).each(function (index, e) {\r\n        var sVal = CSIDecode(e[1]);\r\n        var ls = e[0];\r\n        if (sVal && sVal != \"\") {\r\n            //$(\"[ObjectName='\" + ls + \"']\").val(sVal);\r\n            ElementSetVal(ls,sVal);\r\n            $(\"[ObjectName='\" + ls + \"']\").trigger('change');\r\n        }\r\n        if (sVal == \"\") {\r\n            if (Type == \"Vehicle\" && ls == \"vehicle_id\") {\r\n                ElementSetVal(ls,sVal);\r\n                $(\"[ObjectName='\" + ls + \"']\").trigger('change');\r\n            }\r\n            else if (Type == \"Person\" && ls == \"person_id\") {\r\n                ElementSetVal(ls,sVal);\r\n                $(\"[ObjectName='\" + ls + \"']\").trigger('change');\r\n            }\r\n        }\r\n\r\n        if (ls == \"make\") {\r\n            var result = $(\"[ObjectName='make']\").children(\"[value='\"+sVal+\"']\");\r\n            if (result.length == 0) {\r\n            $(\"[ObjectName='make']\").append(\"<option value='\" + sVal + \"'>\" + sVal + \"</option>\");\r\n                //$(\"[ObjectName='\" + ls + \"']\").val(sVal);\r\n                ElementSetVal(ls,sVal);\r\n                $(\"[ObjectName='\" + ls + \"']\").trigger('change');\r\n            }\r\n        }\r\n        if(ls == \"state\" && Type==\"Vehicle\")\r\n        {\r\n            ElementSetVal(\"vehicle_\"+ls,sVal);\r\n            //$(\"[ObjectName='vehicle_\" + ls + \"']\").val(sVal);\r\n            $(\"[ObjectName='vehicle_\" + ls + \"']\").trigger('change');\r\n        }\r\n    });\r\n}\r\n\r\n\r\nfunction ElementSetVal(objectname,val)\r\n{\r\n\r\n   var input= $(\"[objectname='\"+objectname+\"']\");\r\n   if (input.length>0)\r\n   {\r\n        \r\n        var ctrEle = $(input);\r\n        var tag = input[0].tagName;\r\n        if (tag.toLowerCase() == \"span\")\r\n        {\r\n                var oname = ctrEle.attr(\"ObjectName\");\r\n                var eles = ctrEle.find(\"input[ObjectName=\" + oname + \"]\");\r\n                eles.each(function ()\r\n                {\r\n                        var stype = $(this).attr(\"type\");\r\n                        if (stype == \"radio\" || stype == \"checkbox\")\r\n                        {\r\n                                var eval = $(this).val();\r\n                                if (eval == val && !$(this).is(\":checked\"))\r\n                                {\r\n                                        $(this).prop('checked', true).trigger(\"change\");\r\n                                }\r\n                                else if (eval != val && $(this).is(\":checked\"))\r\n                                {\r\n                                        $(this).prop('checked', false).trigger(\"change\");\r\n                                 }\r\n                        }\r\n                });\r\n        }\r\n    else{\r\n\r\n       $(input).val(val); // select , input\r\n       var span = $(input).closest(\"span[combobox=1]\");\r\n       if (span.length>0) // combo\r\n       {\r\n           var select = $(span).find(\"select\");\r\n           $(\"option\",$(select)).each(function()\r\n           {\r\n                if ($(this).val() == val)\r\n                {\r\n                    $(this).attr(\"selected\",true);\r\n                    $(input).val($(this).text());\r\n                }\r\n                else\r\n                {\r\n                    $(this).attr(\"selected\",false);\r\n                }\r\n            });\r\n        }\r\n    }\r\n  }\r\n}</script>\r\n<script type=\"text/javascript\" language=\"javascript\">$(function(){\r\n    $(\"input[type=hidden]\").each(function(){\r\n        var hld = $(this);\r\n        hld.data(\"defaultValue\", hld.val());\r\n    });\r\n    \r\n    $(\"form\").on(\"reset\", function(){\r\n        $(\"input[type=hidden]\", $(this)).each(function(){\r\n            var hld = $(this);\r\n            hld.val(hld.data(\"defaultValue\"));\r\n        \r\n        });\r\n    });\r\n});</script>\r\n<script type=\"text/javascript\" language=\"javascript\">$(function(){\r\n    $(\"[show_in_unknown='Y']\").closest(\"table[class=section_table]\").attr(\"show_in_unknown\",\"Y\");\r\n    \r\n    var unknown_tables = $(\"table[class=content_table]\").nextAll(\"table[show_in_unknown='Y'][class=section_table]\");\r\n    var tables         = $(\"table[class=content_table]\").nextAll(\"table[class=section_table]:not([show_in_unknown='Y'])\");\r\n    \r\n    if($(\"input[objectname=is_unknown]\").prop('checked') == true){\r\n        $(tables).each(function (i) {\r\n            $(this).hide(); \r\n        });\r\n        //$(\"[objectname=contact_type][show_in_unknown=N]\").parents(\"td[class='cellcaption']\").hide();   \r\n        $(\"[objectname=contact_type][show_in_unknown=N]\").closest(\"div\").hide(); //03/06/2026, DKQI, WO#336230\r\n        $(\"[objectname=person_company_flag]\").prop('disabled', true);\r\n    }else{\r\n        $(unknown_tables).each(function (i) {\r\n            $(this).hide();            \r\n        }); \r\n        //$(\"[objectname=contact_type][show_in_unknown=Y]\").parents(\"td[class='cellcaption']\").hide();   \r\n        $(\"[objectname=contact_type][show_in_unknown=Y]\").closest(\"div\").hide(); //03/06/2026, DKQI, WO#336230    \r\n        $(\"[objectname=person_company_flag]\").prop('disabled', false);\r\n    }  \r\n    $(\"input[objectname=is_unknown]\").on('change',function () {\r\n        var _checked       = $(this).prop('checked');\r\n        \r\n        if (_checked) {\r\n            $(tables).each(function (i) {\r\n                $(this).hide();\r\n            });\r\n            $(unknown_tables).each(function (i) {\r\n                $(this).show(); \r\n            });\r\n            //$(\"[objectname=contact_type][show_in_unknown=N]\").parents(\"td[class='cellcaption']\").hide();   \r\n            //$(\"[objectname=contact_type][show_in_unknown=Y]\").parents(\"td[class='cellcaption']\").show(); \r\n\t\t\t$(\"[objectname=contact_type][show_in_unknown=N]\").closest(\"div\").hide();//03/06/2026, DKQI, WO#336230       \r\n\t\t\t$(\"[objectname=contact_type][show_in_unknown=Y]\").closest(\"div\").show(); //03/06/2026, DKQI, WO#336230    \r\n \r\n            $(\"[objectname=person_company_flag]\").prop('disabled', true).val(\"P\"); \r\n        }\r\n        else {\r\n            $(tables).each(function (i) {\r\n                $(this).show();\r\n            });\r\n            \r\n            $(unknown_tables).each(function (i) {\r\n                $(this).hide();            \r\n            });         \r\n            //$(\"[objectname=contact_type][show_in_unknown=N]\").parents(\"td[class='cellcaption']\").show();  \r\n            //$(\"[objectname=contact_type][show_in_unknown=Y]\").parents(\"td[class='cellcaption']\").hide();  \r\n            $(\"[objectname=contact_type][show_in_unknown=N]\").closest(\"div\").show();  //03/06/2026, DKQI, WO#336230    \r\n            $(\"[objectname=contact_type][show_in_unknown=Y]\").closest(\"div\").hide();  //03/06/2026, DKQI, WO#336230      \r\n            $(\"[objectname=person_company_flag]\").prop('disabled', false);\r\n        }\r\n    });\r\n        \r\n    var is_delete = 0;\r\n    $(\"input[objectname='submit_button'][value=Delete]\").on('click',function(){\r\n        is_delete = 1;\r\n    });\r\n    \r\n    $('form').submit(function(){\r\n        var may_be_unknown = 0;\r\n        \r\n        if($(\"input[objectname=last_name]\").val().toUpperCase()=='UNKNOWN' && $(\"input[objectname=first_name]\").val().toUpperCase()=='UNKNOWN' && is_delete!=1 && $(\"input[objectname=is_unknown]\").prop('checked') == false){\r\n            alert(\"Please check Unknown to Add the Unknown Person!\");\r\n            HideWaitBox(); \r\n            return false;\r\n        }    \r\n        else{\r\n            if($(\"input[objectname=is_unknown]\").prop('checked') == true){\r\n                $(\"table[class=content_table]\").nextAll(\"table[class=section_table]:not([show_in_unknown='Y'])\").each(function(){\r\n                    $(\"input,select,textarea\",this).each(function(){\r\n                        if($(this).attr(\"type\")!=\"hidden\"){\r\n                            $(this).val(\"\");\r\n                        }\r\n                    });\r\n                    \r\n                    $(\"input[name*='person_id~|person_add~|A']\").val(\"\");\r\n                });\r\n                \r\n                $(\"img[class=datepicker_img]\").each(function(){\r\n                    $(\"input\", $(this).closest(\"span\")).val(\"\");\r\n                });           \r\n            \r\n                $(\"[show_in_unknown='N']\").each(function(){\r\n                    $(this).remove();\r\n                });\r\n                $(\"[objectname=contact_type][show_in_unknown=Y]\").parents(\"td[class='cellcaption']\").hide();         \r\n            }\r\n            else{\r\n                $(\"[show_in_unknown='Y']\").each(function(){\r\n                    $(this).remove();\r\n                });            \r\n            }   \r\n        }\r\n    });\r\n});\r\n</script>\r\n<script type=\"text/javascript\" language=\"javascript\">//Canada Postal Code Format Set\r\n//var _GlobalOtherCountry = $(\"select[objectname=o_country]\").val();\r\nvar zip_us = \"Zip\";\r\nvar zip_cd = \"Postal Code\";\r\n$(function () {\r\n    \r\n    CountrySwitchSettingAction();\r\n    //SwitchForeignLayout();\r\n    //$(\"select[objectname=country]\").trigger(\"change\");\r\n    $(\"select[objectname=pob_country]\").trigger(\"change\");\r\n    var cmobo_pob_state = $(\"input[objectname=pob_state][autocomplete]\").closest(\"span[combobox=1]\");\r\n    $(\":button.comboselect\",cmobo_pob_state).hide();\r\n\r\n    countryDynamicAreaInit();\r\n    if ($(\"select[objectname=country]\").length==1){\r\n        homeAddressCountry();\r\n    }\r\n    else if ($(\"select[objectname=country]\").length>1){\r\n        $(\"select[objectname=country]\").each(function(){\r\n            multi_homeAddressCountry($(this).closest(\"tr[repeat=true]\"));\r\n        });\r\n    }\r\n\r\n    if ($(\"select[objectname=m_country]\").length>0)\r\n        mailingAddressCountry();\r\n    if ($(\"select[objectname=o_country]\").length>0)\r\n        otherAddressCountry();\r\n    \r\n    $(\"select[objectname=country]\").on('change',function(){\r\n        if ($(this).closest(\"tr[repeat=true]\").length > 0)\r\n            multi_homeAddressCountry($(this).closest(\"tr[repeat=true]\"));\r\n        else\r\n            homeAddressCountry();\r\n    });\r\n\r\n    $(\"select[objectname=m_country]\").on('change',function(){\r\n        mailingAddressCountry();\r\n    });\r\n    $(\"select[objectname=o_country]\").on('change',function(){\r\n        otherAddressCountry();\r\n    });\r\n\r\n    ClearHiddenLocationData();\r\n    \r\n    $(\":reset\").on('click',function(){\r\n        $(\"[objectname$=county]\").val(\"\").trigger(\"change\");\r\n    });\r\n});\r\n\r\n//Change Address Layout after mapping address\r\nfunction LocationMapping_AfterMatch(obj, geo)\r\n{   \r\n    var addrContainer = $(obj).closest(\"table.section_table\");\r\n    if(addrContainer.length ==0){\r\n        addrContainer = $(obj).closest(\"table.content\");\r\n    }\r\n    addrContainer.find(\"select[objectname$=country]\").trigger(\"change\");\r\n    \r\n    if (geo)\r\n    {\r\n        addrContainer.find(\"select[objectname$=state]\").val(geo.state);\r\n    }\r\n    \r\n    ClearHiddenLocationData();\r\n    \r\n    //var countryVal = relatedCountry.val();\r\n    //if (countryVal!==_GlobalOtherCountry)\r\n    //{\r\n    //    $(obj).closest(\"table.section_table\").find(\"select[objectname$=country]\").trigger(\"change\");\r\n    //    $(obj).closest(\"table.section_table\").find(\"select[objectname=o_state]\").val(countryVal);\r\n    //}\r\n}\r\n\r\nfunction ClearHiddenLocationData()\r\n{\r\n    $(\"[objectname$=zip]:hidden\").each(function(){\r\n        var obj = $(this);\r\n        \r\n        if (MaskValidation(obj)==false)\r\n        {\r\n            $(this).val(\"\");\r\n        }\r\n    });\r\n    $(\"select[objectname$=state]:hidden\").each(function(){\r\n        var val = $(this).val();\r\n        if ($(this).find(\"option[value='\"+val+\"']\").length == 0)\r\n        {\r\n            $(this).val(\"\");\r\n        }\r\n    });\r\n}\r\n\r\nfunction MaskValidation($obj)\r\n{\r\n    var vMask              = $obj.attr(\"mask\");\r\n    var vMaskType          = $obj.attr(\"MaskType\");\r\n    var vMaskDisplay       = $obj.attr(\"maskDisplay\"); \r\n    var vMaskAlpha         = $obj.attr(\"maskAlpha\"); \r\n    var vMaskNumeric       = $obj.attr(\"maskNumeric\"); \r\n    var vMaskAlphaNumberic = $obj.attr(\"maskAlphaNumeric\"); \r\n    var s                  = $obj.val();\r\n    \r\n    if(!vMask)\r\n        return;\r\n\r\n    var objname = $obj.attr(\"objectname\");\r\n    if (objname.indexOf(\"zip\") > -1)\r\n    {\r\n        var s1 = s.split(\"-\");\r\n        if (s1.length == 1)\r\n        {\r\n            vMask = vMask.split(\"-\")[0];\r\n        }\r\n    }\r\n    \r\n    var isValidData = true;\r\n    var reg1        = new RegExp('[A-Za-z]');\r\n    var reg2        = new RegExp('[0-9]');\r\n    var m           = vMask.split(\"\");\r\n    for (var i = 0; i < m.length; i++)\r\n    {\r\n        var maskType = m[i];\r\n        var maskVal = s.substr(i, 1);\r\n        if (maskType == vMaskDisplay)\r\n        {\r\n            if (maskVal != vMaskDisplay)\r\n            {\r\n                isValidData = false;\r\n                break;\r\n            }\r\n        }\r\n        else if (maskType == vMaskAlpha)\r\n        {\r\n            if (!reg1.test(maskVal))\r\n            {\r\n                isValidData = false;\r\n                break;\r\n            }\r\n\r\n            if (vMaskType.toLowerCase() == \"time24\" || vMaskType.toLowerCase() == \"time\")\r\n            {\r\n                if (!MaskBox_CheckPasteTime(s, vMaskType.toLowerCase(), i, maskVal))\r\n                {\r\n                    isValidData = false;\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n        else if (maskType == vMaskNumeric)\r\n        {\r\n            if (!reg2.test(maskVal))\r\n            {\r\n                isValidData = false;\r\n                break;\r\n            }\r\n\r\n            if (vMaskType.toLowerCase() == \"date\")\r\n            {\r\n                if (!MaskBox_CheckPasteDate(s, vMaskDisplay, i, maskVal))\r\n                {\r\n                    isValidData = false;\r\n                    break;\r\n                }\r\n            }\r\n            if (vMaskType.toLowerCase() == \"time24\" || vMaskType.toLowerCase() == \"time\")\r\n            {\r\n                if (!MaskBox_CheckPasteTime(s, vMaskType.toLowerCase(), i, maskVal))\r\n                {\r\n                    isValidData = false;\r\n                    break;\r\n                }\r\n            }\r\n        }\r\n        else if (maskType == vMaskAlphaNumberic)\r\n        {\r\n            if (!reg1.test(maskVal) && !reg2.test(maskVal))\r\n            {\r\n                isValidData = false;\r\n                break;\r\n            }\r\n        }\r\n        else if ((maskType == \"-\" || maskType == \"/\" || maskType == \":\") && maskType != maskVal)\r\n        {\r\n            isValidData = false;\r\n            break;\r\n        }\r\n    }\r\n    \r\n    return isValidData;\r\n}\r\n\r\nfunction SwitchForeignLayout()\r\n{\r\n    var state_us = \"State\";\r\n    var state_cd = \"Province\";\r\n\r\n    var zip_us = \"Zip\";\r\n    var zip_other = \"Postal Code\";\r\n    \r\n    $(document).on(\"change\", \"select[objectname=o_country]\",function(){\r\n        var objSection = $(this).closest(\".section_table\");\r\n        if(objSection.length == 0){\r\n            objSection = $(this).closest(\".content\");\r\n        }\r\n        \r\n        if ($(this).val()==\"CD\")\r\n        {\r\n            $(\"[state_type=nonCD]\",objSection).closest(\".cellcaption\").hide(); \r\n            $(\"[state_type=CD]\",objSection).closest(\".cellcaption\").show();\r\n            \r\n            $(\"[objectname=o_state]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(state_cd);\r\n            $(\"[objectname=o_zip]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(zip_other);\r\n            $(\"[objectname=o_zip]\").attr(\"mask\",\"aDa DaD\");\r\n        }\r\n        else\r\n        {\r\n            $(\"[state_type=nonCD]\",objSection).closest(\".cellcaption\").show();\r\n            $(\"[state_type=CD]\",objSection).closest(\".cellcaption\").hide();\r\n            \r\n            $(\"[objectname=o_state]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(state_us);\r\n            $(\"[objectname=o_zip]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(zip_us);\r\n            $(\"[objectname=o_zip]\").attr(\"mask\",\"DDDDD-DDDD\");\r\n        }\r\n    });\r\n    \r\n    \r\n    $(document).on(\"change\", \"select[objectname=m_country]\",function(){\r\n        var objSection = $(this).closest(\".section_table\");\r\n        if(objSection.length == 0){\r\n            objSection = $(this).closest(\".content\");\r\n        }\r\n        \r\n        if ($(this).val()==\"CD\")\r\n        {\r\n            $(\"[state_type=nonCD]\",objSection).closest(\".cellcaption\").hide(); \r\n            $(\"[state_type=CD]\",objSection).closest(\".cellcaption\").show();\r\n            $(\"[objectname=m_street1][country_type=other]\").closest(\".cellcaption\").hide();\r\n\r\n            $(\"[objectname=m_state]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(state_cd);\r\n            $(\"[objectname=m_zip]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(zip_other);\r\n            $(\"[objectname=m_zip]\").attr(\"mask\",\"aDa DaD\");\r\n        }\r\n        else if ($(this).val()==\"US\" || $(this).val()==\"\")\r\n        {\r\n            $(\"[state_type=nonCD]\",objSection).closest(\".cellcaption\").show();\r\n            $(\"[state_type=CD]\",objSection).closest(\".cellcaption\").hide();\r\n            $(\"[objectname=m_street1][country_type=other]\").closest(\".cellcaption\").hide();\r\n\r\n            $(\"[objectname=m_state]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(state_us);\r\n            $(\"[objectname=m_zip]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(zip_us);\r\n            $(\"[objectname=m_zip]\").attr(\"mask\",\"DDDDD-DDDD\");\r\n        }\r\n        else{\r\n            $(\"[state_type=nonCD],[mappinggroup=mail]\",objSection).closest(\".cellcaption\").hide();\r\n            $(\"[country_type=other]\",objSection).closest(\".cellcaption\").show();            \r\n            \r\n            $(\"[objectname=m_zip]\").closest(\"tr\").prev().find(\"[class=columnheader]\").text(zip_other);\r\n            $(\"[objectname=m_zip]\").removeAttr(\"mask\");\r\n            $(\"[objectname=m_zip]\").attr(\"maxlength\",\"50\");\r\n        }\r\n    });\r\n    \r\n    \r\n    //before trigger, need save the o_state for different country;\r\n    var origin_o_state = $(\"select[objectname=o_state]\").val();\r\n    $(\"select[objectname=o_country]\").trigger(\"change\");\r\n    $(\"select[objectname=o_state]\").val(origin_o_state);\r\n    \r\n    var origin_m_state = $(\"select[objectname=m_state]\").val();\r\n    $(\"select[objectname=m_country]\").trigger(\"change\");\r\n    $(\"select[objectname=m_state]\").val(origin_m_state);\r\n    \r\n    //$(\"select[objectname=pob_state]\").val(\"\");\r\n}\r\n\r\nfunction CountrySwitchSettingAction()\r\n{\r\n    $(\"input[objectName=reset_button]\").on('click',function (){\r\n        this.form.reset();  \r\n\r\n        var ele_country = $(\"select[objectName$=country]:not([objectName^=pob_])\");\r\n        var ele_pob_country = $(\"select[objectName$=country][objectName^=pob_]\");\r\n        if (ele_country.length>0)\r\n        {\r\n            ele_country.each(function(){\r\n                $(this).trigger(\"change\");\r\n            });\r\n        }\r\n\r\n        if (ele_pob_country.length>0)\r\n        {\r\n            ele_pob_country.each(function(){\r\n                $(this).trigger(\"change\");\r\n                $(\":not(:hidden)[objectname=pob_state]\").val($(\":hidden[objectname=pob_state]\").val());\r\n            });\r\n        }\r\n\r\n        return false;\r\n    });\r\n}\r\n\r\nfunction countryDynamicAreaInit(){\r\n    $(\"select[objectname=state]\").closest('div.row-item').attr('affect_from','country1');\r\n    $(\"input[objectname=street1]\").closest('div.row-item').attr('affect_from','country1');\r\n    $(\"select[objectname=m_state]\").closest('div.row-item').attr('affect_from','country2');\r\n    $(\"input[objectname=m_street1]\").closest('div.row-item').attr('affect_from','country2');\r\n    $(\"select[objectname=o_state]\").closest('div.row-item').attr('affect_from','country3');\r\n    $(\"input[objectname=o_street1]\").closest('div.row-item').attr('affect_from','country3');\r\n}\r\nfunction homeAddressCountry(){\r\n    var country = $(\"select[objectname=country]\").val().toUpperCase();\r\n    if(country == 'US' || country =='' || country =='CD'){\r\n        $(\"input[objectname=street2]\").closest('div.row-item').show();\r\n        $(\"input[objectname=common_place_name]\").closest('div.row-item').show();\r\n        $(\"input[objectname=city]\").closest('div.row-item').show();\r\n        dynamicAreaShow($(\"input[objectname=street1][country=US]\"));\r\n        dynamicAreaHide($(\"input[objectname=street1][country=Other]\"));\r\n    }else{\r\n        $(\"input[objectname=street2]\").val('');\r\n        $(\"input[objectname=street2]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=common_place_name]\").val('');\r\n        $(\"input[objectname=common_place_name]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=city]\").val('');\r\n        $(\"input[objectname=city]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=county]\").val('');\r\n        $(\"select[objectname=county]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=po_box]\").val('');\r\n        $(\"input[objectname=po_box]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=municipality]\").val('');\r\n        $(\"select[objectname=municipality]\").closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"input[objectname=street1][country=US]\"));\r\n        dynamicAreaShow($(\"input[objectname=street1][country=Other]\"));\r\n        dynamicAreaHide($(\"select[objectname=state][country=US]\"));\r\n        dynamicAreaHide($(\"select[objectname=state][country=CD]\"));\r\n        $(\"input[objectname=zip]\").closest('div.row-item').find('.columnheader').text(zip_cd); //02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=zip]\").removeAttr('mask').attr(\"maxlength\",\"50\");\r\n        clearAutoAddressInfo($(\"select[objectname=country]\"));\r\n    }\r\n    if(country =='US' || country ==''){\r\n        $(\"select[objectname=county]\").closest('div.row-item').show();\r\n        $(\"input[objectname=po_box]\").closest('div.row-item').show();\r\n        $(\"select[objectname=municipality]\").closest('div.row-item').show();\r\n        dynamicAreaShow($(\"select[objectname=state][country=US]\"));\r\n        dynamicAreaHide($(\"select[objectname=state][country=CD]\"));\r\n        $(\"input[objectname=zip]\").closest('div.row-item').find('.columnheader').text(zip_us); //02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=zip]\").removeAttr('maxlength').attr(\"mask\",\"DDDDD-DDDD\");\r\n    }\r\n    if(country == 'CD'){\r\n        $(\"select[objectname=county]\").val('');\r\n        $(\"select[objectname=county]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=po_box]\").val('');\r\n        $(\"input[objectname=po_box]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=municipality]\").val('');\r\n        $(\"select[objectname=municipality]\").closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"select[objectname=state][country=US]\"));\r\n        dynamicAreaShow($(\"select[objectname=state][country=CD]\"));\r\n        $(\"input[objectname=zip]\").closest('div.row-item').find('.columnheader').text(zip_cd);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=zip]\").removeAttr('maxlength').attr(\"mask\",\"aDa DaD\");\r\n        $(\":hidden[objectname=municipality]\").val('');\r\n    }\r\n}\r\nfunction mailingAddressCountry(){\r\n    var country = $(\"select[objectname=m_country]\").val().toUpperCase();\r\n    if(country == 'US' || country =='' || country =='CD'){\r\n        $(\"input[objectname=m_street2]\").closest('div.row-item').show();\r\n        $(\"input[objectname=m_common_place_name]\").closest('div.row-item').show();\r\n        $(\"input[objectname=m_city]\").closest('div.row-item').show();\r\n        dynamicAreaShow($(\"input[objectname=m_street1][country=US]\"));\r\n        dynamicAreaHide($(\"input[objectname=m_street1][country=Other]\"));\r\n    }else{\r\n        $(\"input[objectname=m_street2]\").val('');\r\n        $(\"input[objectname=m_street2]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=m_common_place_name]\").val('');\r\n        $(\"input[objectname=m_common_place_name]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=m_city]\").val('');\r\n        $(\"input[objectname=m_city]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=m_county]\").val('');\r\n        $(\"select[objectname=m_county]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=m_po_box]\").val('');\r\n        $(\"input[objectname=m_po_box]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=m_municipality]\").val('');\r\n        $(\"select[objectname=m_municipality]\").closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"input[objectname=m_street1][country=US]\"));\r\n        dynamicAreaShow($(\"input[objectname=m_street1][country=Other]\"));\r\n        dynamicAreaHide($(\"select[objectname=m_state][country=US]\"));\r\n        dynamicAreaHide($(\"select[objectname=m_state][country=CD]\"));\r\n        $(\"input[objectname=m_zip]\").closest('div.row-item').find('.columnheader').text(zip_cd);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=m_zip]\").removeAttr('mask').attr(\"maxlength\",\"50\");\r\n        clearAutoAddressInfo($(\"select[objectname=m_country]\"));\r\n    }\r\n    if(country =='US' || country ==''){\r\n        $(\"select[objectname=m_county]\").closest('div.row-item').show();\r\n        $(\"input[objectname=m_po_box]\").closest('div.row-item').show();\r\n        $(\"select[objectname=m_municipality]\").closest('div.row-item').show();\r\n        dynamicAreaShow($(\"select[objectname=m_state][country=US]\"));\r\n        dynamicAreaHide($(\"select[objectname=m_state][country=CD]\"));\r\n        $(\"input[objectname=m_zip]\").closest('div.row-item').find('.columnheader').text(zip_us);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=m_zip]\").removeAttr('maxlength').attr(\"mask\",\"DDDDD-DDDD\");\r\n    }\r\n    if(country == 'CD'){\r\n        $(\"select[objectname=m_county]\").val('');\r\n        $(\"select[objectname=m_county]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=m_po_box]\").val('');\r\n        $(\"input[objectname=m_po_box]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=m_municipality]\").val('');\r\n        $(\"select[objectname=m_municipality]\").closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"select[objectname=m_state][country=US]\"));\r\n        dynamicAreaShow($(\"select[objectname=m_state][country=CD]\"));\r\n        $(\"input[objectname=m_zip]\").closest('div.row-item').find('.columnheader').text(zip_cd);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=m_zip]\").removeAttr('maxlength').attr(\"mask\",\"aDa DaD\");    \r\n        $(\":hidden[objectname=m_municipality]\").val('');\r\n    }\r\n}\r\nfunction otherAddressCountry(){\r\n    var country = $(\"select[objectname=o_country]\").val().toUpperCase();\r\n    if(country == 'US' || country =='' || country =='CD'){\r\n        $(\"input[objectname=o_street2]\").closest('div.row-item').show();\r\n        $(\"input[objectname=o_common_place_name]\").closest('div.row-item').show();\r\n        $(\"input[objectname=o_city]\").closest('div.row-item').show();\r\n        dynamicAreaShow($(\"input[objectname=o_street1][country=US]\"));\r\n        dynamicAreaHide($(\"input[objectname=o_street1][country=Other]\"));\r\n    }else{\r\n        $(\"input[objectname=o_street2]\").val('');\r\n        $(\"input[objectname=o_street2]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=o_common_place_name]\").val('');\r\n        $(\"input[objectname=o_common_place_name]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=o_city]\").val('');\r\n        $(\"input[objectname=o_city]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=o_county]\").val('');\r\n        $(\"select[objectname=o_county]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=o_po_box]\").val('');\r\n        $(\"input[objectname=o_po_box]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=o_municipality]\").val('');\r\n        $(\"select[objectname=o_municipality]\").closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"input[objectname=o_street1][country=US]\"));\r\n        dynamicAreaShow($(\"input[objectname=o_street1][country=Other]\"));\r\n        dynamicAreaHide($(\"select[objectname=o_state][country=US]\"));\r\n        dynamicAreaHide($(\"select[objectname=o_state][country=CD]\"));\r\n        $(\"input[objectname=o_zip]\").closest('div.row-item').find('.columnheader').text(zip_cd);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=o_zip]\").removeAttr('mask').attr(\"maxlength\",\"50\");\r\n        clearAutoAddressInfo($(\"select[objectname=o_country]\"));\r\n    }\r\n    if(country =='US' || country ==''){\r\n        $(\"select[objectname=o_county]\").closest('div.row-item').show();\r\n        $(\"input[objectname=o_po_box]\").closest('div.row-item').show();\r\n        $(\"select[objectname=o_municipality]\").closest('div.row-item').show();\r\n        dynamicAreaShow($(\"select[objectname=o_state][country=US]\"));\r\n        dynamicAreaHide($(\"select[objectname=o_state][country=CD]\"));\r\n        $(\"input[objectname=o_zip]\").closest('div.row-item').find('.columnheader').text(zip_us);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=o_zip]\").removeAttr('maxlength').attr(\"mask\",\"DDDDD-DDDD\");\r\n    }\r\n    if(country == 'CD'){\r\n        $(\"select[objectname=o_county]\").val('');\r\n        $(\"select[objectname=o_county]\").closest('div.row-item').hide();\r\n        $(\"input[objectname=o_po_box]\").val('');\r\n        $(\"input[objectname=o_po_box]\").closest('div.row-item').hide();\r\n        $(\"select[objectname=o_municipality]\").val('');\r\n        $(\"select[objectname=o_municipality]\").closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"select[objectname=o_state][country=US]\"));\r\n        dynamicAreaShow($(\"select[objectname=o_state][country=CD]\"));\r\n        $(\"input[objectname=o_zip]\").closest('div.row-item').find('.columnheader').text(zip_cd);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=o_zip]\").removeAttr('maxlength').attr(\"mask\",\"aDa DaD\");  \r\n        $(\":hidden[objectname=o_municipality]\").val('');    \r\n    }\r\n}\r\n\r\nfunction multi_homeAddressCountry(multisection_row){\r\n    var country = $(\"select[objectname=country]\",multisection_row).val().toUpperCase();\r\n    if(country == 'US' || country =='' || country =='CD'){\r\n        $(\"input[objectname=street2]\",multisection_row).closest('div.row-item').show();\r\n        $(\"input[objectname=common_place_name]\",multisection_row).closest('div.row-item').show();\r\n        $(\"input[objectname=city]\",multisection_row).closest('div.row-item').show();\r\n        dynamicAreaShow($(\"input[objectname=street1][country=US]\",multisection_row));\r\n        dynamicAreaHide($(\"input[objectname=street1][country=Other]\",multisection_row));\r\n    }else{\r\n        $(\"input[objectname=street2]\",multisection_row).val('');\r\n        $(\"input[objectname=street2]\",multisection_row).closest('div.row-item').hide();\r\n        $(\"input[objectname=common_place_name]\",multisection_row).val('');\r\n        $(\"input[objectname=common_place_name]\",multisection_row).closest('div.row-item').hide();\r\n        $(\"input[objectname=city]\",multisection_row).val('');\r\n        $(\"input[objectname=city]\",multisection_row).closest('div.row-item').hide();\r\n        $(\"select[objectname=county]\",multisection_row).val('');\r\n        $(\"select[objectname=county]\",multisection_row).closest('div.row-item').hide();\r\n        $(\"input[objectname=po_box]\",multisection_row).val('');\r\n        $(\"input[objectname=po_box]\",multisection_row).closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"input[objectname=street1][country=US]\",multisection_row));\r\n        dynamicAreaShow($(\"input[objectname=street1][country=Other]\",multisection_row));\r\n        dynamicAreaHide($(\"select[objectname=state][country=US]\",multisection_row));\r\n        dynamicAreaHide($(\"select[objectname=state][country=CD]\",multisection_row));\r\n        $(\"input[objectname=zip]\",multisection_row).closest('div.row-item').find('.columnheader').text(zip_cd);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=zip]\",multisection_row).removeAttr('mask').attr(\"maxlength\",\"50\");\r\n        clearAutoAddressInfo($(\"select[objectname=country]\",multisection_row));\r\n        $(\":hidden[objectname=municipality]\",multisection_row).val('');\r\n    }\r\n    if(country =='US' || country ==''){\r\n        $(\"select[objectname=county]\",multisection_row).closest('div.row-item').show();\r\n        $(\"input[objectname=po_box]\",multisection_row).closest('div.row-item').show();\r\n        $(\"select[objectname=municipality]\",multisection_row).closest('div.row-item').show();\r\n        dynamicAreaShow($(\"select[objectname=state][country=US]\",multisection_row));\r\n        dynamicAreaHide($(\"select[objectname=state][country=CD]\",multisection_row));\r\n        $(\"input[objectname=zip]\",multisection_row).closest('div.row-item').find('.columnheader').text(zip_us);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=zip]\",multisection_row).removeAttr('maxlength').attr(\"mask\",\"DDDDD-DDDD\");\r\n    }\r\n    if(country == 'CD'){\r\n        $(\"select[objectname=county]\",multisection_row).val('');\r\n        $(\"select[objectname=county]\",multisection_row).closest('div.row-item').hide();\r\n        $(\"input[objectname=po_box]\",multisection_row).val('');\r\n        $(\"input[objectname=po_box]\",multisection_row).closest('div.row-item').hide();\r\n        $(\"select[objectname=municipality]\",multisection_row).val('');\r\n        $(\"select[objectname=municipality]\",multisection_row).closest('div.row-item').hide();\r\n        dynamicAreaHide($(\"select[objectname=state][country=US]\",multisection_row));\r\n        dynamicAreaShow($(\"select[objectname=state][country=CD]\",multisection_row));\r\n        $(\"input[objectname=zip]\",multisection_row).closest('div.row-item').find('.columnheader').text(zip_cd);//02/02/2026, DKQI, WO#336230 \r\n        $(\"input[objectname=zip]\",multisection_row).removeAttr('maxlength').attr(\"mask\",\"aDa DaD\");\r\n        $(\":hidden[objectname=municipality]\",multisection_row).val('');\r\n    }\r\n}\r\n\r\nfunction clearAutoAddressInfo(eventObj)\r\n{\r\n    var countrycode = $(eventObj).val();\r\n    if (countrycode == 'US' || countrycode == '' || countrycode == 'CD')\r\n    {\r\n        return;\r\n    }\r\n    var lat;\r\n    var lon;\r\n    var master_location_id;\r\n    var mappinggroup = $(eventObj).attr(\"mappinggroup\");\r\n    if (mappinggroup)\r\n    {\r\n        lat = $(\"[mappinggroup=\" + mappinggroup + \"][mapping=latitude]\");\r\n        lon = $(\"[mappinggroup=\" + mappinggroup + \"][mapping=longitude]\");\r\n        master_location_id = $(\"[mappinggroup=\" + mappinggroup + \"][mapping=master_location_id]\");      \r\n    }\r\n    else\r\n    {\r\n        lat = $(\"[mapping=latitude]\");\r\n        lon = $(\"[mapping=longitude]\");\r\n        master_location_id = $(\"[mapping=master_location_id]\");     \r\n    }   \r\n    lat.val('');\r\n    lon.val('');\r\n    master_location_id.val(''); \r\n}</script>\r\n<script type=\"text/javascript\" language=\"javascript\">if (typeof (form_BeforeCheckInput) == \"function\")\r\n    var o_form_BeforeCheckInput = form_BeforeCheckInput;\r\n\r\nform_BeforeCheckInput = function(){\r\n    if (typeof (o_form_BeforeCheckInput) == \"function\")\r\n        o_form_BeforeCheckInput();\r\n    var ele_driver_license = $(\"input[objectname=driver_license]\");\r\n    var ele_driver_license_state = $(\"select[objectname=driver_license_state]\");\r\n    var ele_driver_license_expire_date = $(\"input[objectname=driver_license_expire_date]\");\r\n\r\n    if (ele_driver_license.val()!==\"\"){\r\n        ele_driver_license_state.attr(\"isreq\",\"Y\");\r\n        ele_driver_license_state.attr(\"reqmsg\",\"Please select Driver License State associated with Driver License #.\");\r\n\r\n        ele_driver_license_expire_date.attr(\"isreq\",\"Y\");\r\n        ele_driver_license_expire_date.attr(\"reqmsg\",\"Please enter Driver's License Expiration Date associated with Driver License #.\");\r\n    }\r\n    else{\r\n        ele_driver_license_state.removeAttr(\"isreq\");\r\n        ele_driver_license_state.removeAttr(\"reqmsg\");\r\n\r\n        ele_driver_license_expire_date.removeAttr(\"isreq\");\r\n        ele_driver_license_expire_date.removeAttr(\"reqmsg\");\r\n    }\r\n}</script>\r\n<script type=\"text/javascript\" language=\"javascript\">//change Dynamic Area with same objectname by JS\r\nfunction initDynamicArea($crtl,drowName){\r\n    $crtl.closest('div.row-item').attr('affect_from',drowName);\r\n}\r\nfunction dynamicAreaHide($crtl){\r\n    $crtl.val();\r\n    $crtl.prop('disabled', true).hide();\r\n    $crtl.closest('div.row-item').attr('usenotin','true').prop('disabled', true).hide();\r\n}\r\nfunction dynamicAreaShow($crtl){\r\n    $crtl.prop('disabled', false).show();\r\n    $crtl.closest('div.row-item').attr('usenotin','false').prop('disabled', false).show();\r\n}\r\n</script>\r\n<script type=\"text/javascript\" language=\"javascript\">$(function(){\r\n    $(\"table[objectname=addPersonPhone]\").find(\"tr[repeat=true]\").each(function(){\r\n    $(\"input[objectname=work_phone]\",this).after($(\"input[objectname=work_phone_ext]\",this));\r\n        $(\"input[objectname=work_phone_ext]\",this).before(\" Ext.\");  \r\n    })\r\n})</script>\r\n<script type=\"text/javascript\" src=\"../js/RMS/IDReader.js\" ></script>\r\n<script type=\"text/javascript\" src=\"../js/RMS/jquery.cookie.js\" ></script>\r\n<script type=\"text/javascript\" language=\"javascript\">\r\nfunction showCustomizeMasterName(is_master)\r\n{\r\n \u00a0\u00a0\u00a0if($('input[objectname=last_name]').val().toUpperCase()=='UNKNOWN' || $('input[objectname=first_name]').val().toUpperCase()=='UNKNOWN')\r\n \u00a0\u00a0\u00a0{\r\n     \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0alert('Please check Unknown Person to add unknown Person!');\r\n \u00a0\u00a0\u00a0}\r\n\u00a0\u00a0\u00a0else if(is_master==1)\r\n \u00a0\u00a0\u00a0{\r\n     \u00a0\u00a0\u00a0showMasterName(null,null, 'SearchMasterNameSys', 860, 600, false, function(){\r\n            if(MasterName){\r\n                MasterName.ReturnAction();\r\n                var o_state = $('select[objectname=o_state]').val();      \r\n                //var m_state = $('select[objectname=m_state]').val();  \r\n                \r\n                $('select[objectname=o_country]').trigger('change');\r\n                $('select[objectname=o_state]').val(o_state);\r\n                \r\n                //$('select[objectname=m_country]').trigger('change');\r\n                //$('select[objectname=m_state]').val(m_state);\r\n            }\r\n        }); \u00a0\u00a0\u00a0\u00a0\u00a0\r\n \u00a0\u00a0\u00a0}\r\n};\r\n</script>\r\n<script type=\"text/javascript\" language=\"javascript\">\r\n$(function () {\r\n    $(\"[ObjectName='person_company_flag']\").on('change',function () {\r\n        if (this.value != \"P\") {\r\n            $(\"[affect_from='o_location_type']\").each(function () {\r\n                this.style.display = 'none';\r\n                this.disabled = true;\r\n            });\r\n        }\r\n        else\r\n        {\r\n            $(\"select[objectname=o_country]\").trigger(\"change\");\r\n            //$(\"select[objectname=m_country]\").trigger(\"change\");\r\n        }\r\n    });\r\n});\r\n\r\n$(function () {\r\n    var tableContentHidens = [];\r\n    $person_company_flag = $(\"[ObjectName='person_company_flag']\");\r\n    $(\"input[objectname='Victim/StateNJ']\").on('change',function () {\r\n        //var tableContents = $(this).closest(\"table[class=content_table]\").nextAll(\"table\");\r\n        var legendDiv = $(this).closest(\"div[class=engine-form-page-content-container]\").next(\"div.engine-form-page-legend-container\"); //02/10/2026, DKQI, WO#336230 \r\n    \r\n        if ($(this).prop('checked')) {\r\n            $(\"select[ObjectName='contact_type']\").each(function()\r\n            {\r\n                $(\"option[value='VI']\",$(this)).attr(\"selected\", true);\r\n            })\r\n\r\n            $(\"input[objectname=is_unknown]\").prop('checked', false).prop('disabled', true);\r\n            $(\"input[objectname=is_unknown]\").trigger('change');\r\n\r\n            $(\"input[ObjectName=person_id]\").val(1);\r\n\r\n            /*$(tableContents).each(function (index) {\r\n                if (index < $(tableContents).length - 1 && $(this).css(\"display\") != \"none\") {\r\n                    tableContentHidens.push(index);\r\n                    $(this).hide();\r\n                }\r\n            });*/\r\n\t\t\t$(legendDiv).hide();\r\n            \r\n            $person_company_flag.attr(\"onchange_bak\",$person_company_flag.attr(\"onchange\"));\r\n            $person_company_flag.removeAttr(\"onchange\");\r\n            \r\n            $(\"option[selected]\", $person_company_flag).removeAttr(\"selected\");\r\n            $(\"option[value='C']\", $person_company_flag).attr(\"selected\", true);\r\n            $person_company_flag.prop('disabled', true);\r\n        }\r\n        else {\r\n            $(\"select[ObjectName='contact_type']\").each(function()\r\n            {\r\n   