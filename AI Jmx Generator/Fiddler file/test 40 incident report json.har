                 htables.push(i);\r\n                    $(this).hide();\r\n                }\r\n            });*/\r\n\t\t\t$(legendDiv).hide();\r\n            \r\n            $person_company_flag.attr(\"onchange_bak\",$person_company_flag.attr(\"onchange\"));\r\n            $person_company_flag.removeAttr(\"onchange\");\r\n            \r\n            $(\"option[selected]\", $person_company_flag).removeAttr(\"selected\");\r\n            $(\"option[value='P']\", $person_company_flag).attr(\"selected\", true);\r\n            $person_company_flag.prop('disabled', true);\r\n        }\r\n        else {\r\n            $(\"input[ObjectName=person_id]\").val(\"\");\r\n            var eleVS = $(\"input[objectname='Victim/StateNJ']\");\r\n            eleVS.prop('disabled', false);\r\n\r\n           /* $(tables).each(function (i) {\r\n                for (var k = 0 ; k < htables.length; k++) {\r\n                    if (htables[k] == i) {\r\n                        $(this).show();\r\n                    }\r\n                }\r\n            });\r\n            htables = [];\r\n\t\t\t*/\r\n\r\n\t\t\t$(legendDiv).show(); //02/10/2026, DKQI, WO#336230 \r\n            \r\n            if ($person_company_flag.attr(\"onchange_bak\") !=\"\" && $person_company_flag.attr(\"onchange_bak\")!= undefined)\r\n            {\r\n                $person_company_flag.prop('disabled', false);\r\n                $person_company_flag.attr(\"onchange\",$person_company_flag.attr(\"onchange_bak\"));\r\n                $person_company_flag.removeAttr(\"onchange_bak\");\r\n                $person_company_flag.trigger('change');\r\n            }\r\n        }\r\n    });\r\n\r\n//  $(\"[objectname=contact_note]\").on('change',function()\r\n//  {\r\n//      alert($(this).text());\r\n//      IDReader.ReadTest($(this).text());\r\n//  });\r\n\r\n\t//wo#341554\r\n    $('select[objectname=\"o_location_type\"] option[value=\"NONE\"]')\r\n    .css({\r\n        'font-weight': 'bold',\r\n        'font-style': 'italic'\r\n    });\r\n    //wo#341554\r\n    $('select[objectname=\"o_location_type\"]').change(function () {\r\n        var val = $(this).val();\r\n\r\n        var $countryTr = $('select[objectname=\"o_country\"]').closest('table').closest('tr');\r\n        var $streetTr = $('input[objectname=\"o_street1\"]').closest('table').closest('tr');\r\n        var $cityTr = $('input[objectname=\"o_city\"]').closest('table').closest('tr');\r\n        var $countyTr = $('select[objectname=\"o_county\"]').closest('table').closest('tr');\r\n\r\n        if (val === 'NONE') {\r\n            $countryTr.hide();\r\n            $streetTr.hide();\r\n            $cityTr.hide();\r\n            $countyTr.hide();\r\n        } else {\r\n            $countryTr.show();\r\n            $streetTr.show();\r\n            $cityTr.show();\r\n            $countyTr.show();\r\n        }\r\n    });\r\n    //wo#341554\r\n    $('select[objectname=\"o_location_type\"]').trigger('change');\r\n \r\n});</script>\r\n<!--end of webpage-append-->\r\n\t<script type=\"text/javascript\">\r\n\t\t$(function ()\r\n\t\t{\r\n\t\t\tvar pageTitle = 'Add Party';\r\n\t\t\tif (pageTitle)\r\n\t\t\t{\r\n\t\t\t\tif (typeof window.SetDialogTitle === \"function\")\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.SetDialogTitle(pageTitle);\r\n\t\t\t\t}\r\n\r\n\t\t\t\tif (typeof window.parent !== \"undefined\" && typeof window.parent.SetDialogTitle === \"function\")\r\n\t\t\t\t{\r\n\t\t\t\t\twindow.parent.SetDialogTitle(pageTitle);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t})\r\n\t</script>\r\n\t\r\n\t\r\n</body>\r\n</html>", "size":239851, "mimeType":"text/html; charset=utf-8"}, "headers":[{"name":"Cache-Control", "value":"no-cache, no-store"}, {"name":"Pragma", "value":"no-cache"}, {"name":"Content-Type", "value":"text/html; charset=utf-8"}, {"name":"Vary", "value":"Accept-Encoding"}, {"name":"Server", "value":"Microsoft-IIS/10.0"}, {"name":"Set-Cookie", "value":"tst=0; path=/; secure; samesite=strict"}, {"name":"Set-Cookie", "value":".AspNetCore.Mvc.CookieTempD