3iltPxnJZNQ3FJ0JyOsEEGl-IZ4StHptqvogNFf9eeEoUepMfQAq7PmbNLdbTDL86ABALl5W8Zwlo9jI86j2HDyYVXRNldFOsP7uok7z_rp-i1seqAJ29Vf_t05aljSzbv4MmGmjcxocHzgKxTs1M1DPyrA4Z3LcRCwJcnzcIBcXYVEjRq8EyiJ7YbVFLiz43W188_y5JHupSpqksQ1fg_T_ucjINIR-Keq_dwv6qypcRyokiu-yrG0ppXCvhVra77HXmk8YCit2lYiRJZgVmpwCfqLvjCQzSrTprOvBEz7MrlKJV8ZHVMcPt18fA2yeUdBieJ0aIsR06LanyUmwpmHdUZYXtlEDZLTBVuF-vgT4W5MdKCzuwnj5190_oRdWO5bEJbeEb0WygXGBaDPP7XhGWPT4Os3uGm9lvmlZjUkDu3KRuEqlBdj4eDEbyo2hEN40iXmuN7_u8u4_-moIh3a1rvqI_pW3IyeS96ZcvHC7u3hUQWLM0FhjDE6Qrbu8j4nKPlaaoWtN6Xp2A98g"}], "method":"GET", "httpVersion":"HTTP/1.1"}, "timings":{"blocked":-1, "ssl":0, "receive":0, "wait":267, "dns":0, "send":0, "connect":0}, "response":{"headersSize":278, "bodySize":4327, "statusText":"OK", "redirectURL":"", "status":200, "httpVersion":"HTTP/1.1", "cookies":[], "content":{"compression":0, "text":"(function ($)\r\n{\r\n\t$.fn.TextAreaSpellingCheck = function (options)\r\n\t{\r\n\t\tvar saveChecked = false;\r\n\t\tvar $m = $('<div style=\"border: 1px solid gray; width: 600px; height: 150px; display: none;\"></div>');\r\n\t\tvar $n = $('<div style=\"font-family: Calibri; font-size: 12pt;\" contenteditable=\"true\"></div>');\r\n\t\t$n.appendTo($m);\r\n\r\n\t\tvar opts = $.extend({}, $.fn.TextAreaSpellingCheck.defaults, options);\r\n\r\n\t\tif (!opts.enable_spelling)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\treturn this.each(function ()\r\n\t\t{\r\n\t\t\tvar $this = $(this);\r\n\r\n\t\t\tif ($this.attr(\"disable_spelling_check\") == \"1\")\r\n\t\t\t{\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\r\n\t\t\t$this.data(\"spell_checked_flag\", \"0\")\r\n\t\t\t//.css(\"margin-bottom\", \"2px\")\r\n\t\t\t\t.on(\"blur\", function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tif ($(this).data(\"spell_checked_flag\") == \"0\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\tShowSpellingCheckDialog(this, true, opts, $m, $n);\r\n\t\t\t\t\t}\r\n\t\t\t\t}).on(\"change\", function ()\r\n\t\t\t\t{\r\n\t\t\t\t\t$(this).data(\"spell_checked_flag\", \"0\");\r\n\t\t\t\t});\r\n\t\t});\r\n\t};\r\n\r\n\t$.fn.TextAreaSpellingCheck.defaults = {\r\n\t\tenable_spelling: true,\r\n\t\tcheck_url: \"../AspSoft/SpellingCheck.aspx?action=spell_check&rnd=\" + Math.random(),\r\n\t\tsuggest_box_position: \"below\",  //above\r\n\t\tpopup_title: \"Spelling Check\",\r\n\t\tpopup_height: 400,\r\n\t\tpopup_width: 700,\r\n\t\tpopup_resizable: true\r\n\t};\r\n\r\n\t$.fn.TextAreaSpellingCheck.AfterSpellingDialogClose = function (p) { };\r\n\r\n\tfunction ShowSpellingCheckDialog(sender, isAutoCheck, opts, $m, $n)\r\n\t{\r\n\t\tif (sender == undefined)\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\t\tvar $textarea = $(sender);\r\n\t\tif ($.trim($textarea.val()) == \"\")\r\n\t\t{\r\n\t\t\treturn;\r\n\t\t}\r\n\r\n\t\t$m.dialog({\r\n\t\t\tautoOpen: false,\r\n\t\t\ttitle: opts.popup_title,\r\n\t\t\theight: opts.popup_height,\r\n\t\t\twidth: opts.popup_width,\r\n\t\t\tmodal: true,\r\n\t\t\tresizable: opts.popup_resizable,\r\n\t\t\tbuttons: {\r\n\t\t\t\t\"OK\": function ()\r\n\t\t\t\t{\r\n\t\t\t\t\tsaveChecked = true;\r\n\t\t\t\t\tvar v = $n.html();\r\n\t\t\t\t\tv = v.replace(/<BR> /g, '\\r\\n').replace(/<br> /g, '\\r\\n').replace(/<BR>/g, '\\r\\n').replace(/<br>/g, '\\r\\n');\r\n\t\t\t\t\tv = v.replace(/<\\/?SPAN[^>]*>/g, '').replace(/<\\/?span[^>]*>/g, '');   //remove spell check hyperlink\r\n\t\t\t\t\tv = v.replace(/<\\/?P[^>]*>/g, '').replace(/<\\/?p[^>]*>/g, '');   //remove <P>xxx</P>, after press enter in DIV, it will generate P\r\n\t\t\t\t\t//v = v.replace(/<\\/?[^>]+(>|$)/g, \"\");  //remove html tag\r\n\r\n\t\t\t\t\tv = v.replace(/&nbsp;/g, ' ')\r\n\t\t\t\t\t.replace(/&amp;/g, '&')\r\n\t\t\t\t\t.replace(/&quot;/g, '\"')\r\n\t\t\t\t\t.replace(/&#39;/g, '\\'')\r\n\t\t\t\t\t.replace(/&lt;/g, '<')\r\n\t\t\t\t\t.replace(/&gt;/g, '>');\r\n\r\n\t\t\t\t\t$textarea.val(v);\r\n\r\n\t\t\t\t\t$m.dialog(\"close\");\r\n\t\t\t\t\t$n.html(\"\");\r\n\t\t\t\t\t$textarea.data(\"spell_checked_flag\", \"1\");\r\n\t\t\t\t},\r\n\t\t\t\tCancel: function ()\r\n\t\t\t\t{\r\n\t\t\t\t\t$m.dialog(\"close\");\r\n\t\t\t\t\t$n.html(\"\");\r\n\t\t\t\t\t$textarea.data(\"spell_checked_flag\", \"1\");\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\tclose: function (e, ui)\r\n\t\t\t{\r\n\t\t\t\t$m.dialog(\"destroy\");\r\n\t\t\t\tif (saveChecked)\r\n\t\t\t\t{\r\n\t\t\t\t\t$.fn.TextAreaSpellingCheck.AfterSpellingDialogClose(sender);\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\tcreate: function (e, ui)\r\n\t\t\t{\r\n\t\t\t\tsaveChecked = false;\r\n\t\t\t\tvar txt = [];\r\n\t\t\t\tvar lines = $textarea.val().replace(/\\r\\n/g, \"\\n\").split(\"\\n\");\r\n\t\t\t\tfor (var i = 0; i < lines.length; ++i)\r\n\t\t\t\t{\r\n\t\t\t\t\tif (i)\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\ttxt.push(\"<br />\");\r\n\t\t\t\t\t}\r\n\t\t\t\t\ttxt.push(lines[i]);\r\n\t\t\t\t}\r\n\t\t\t\t$n.html(txt.join(\"\"));\r\n\t\t\t\tSpellCheckProcess($textarea, isAutoCheck, opts, $m, $n);\r\n\t\t\t},\r\n\t\t\topen: function (e, ui)\r\n\t\t\t{\r\n\t\t\t\t//\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\tfunction SpellCheckProcess($txtObj, isAutoCheck, opts, $m, $n)\r\n\t{\r\n\t\t$n.spellchecker({\r\n\t\t\turl: opts.check_url, // default spellcheck url\r\n\t\t\tlang: \"en\", // default language\r\n\t\t\tengine: \"pspell\", // pspell or google\r\n\t\t\taddToDictionary: false, //whether show \"Ignore forevet\" add word to dictionary\t\t\t\r\n\t\t\tsuggestBoxPosition: opts.suggest_box_position,  // position of suggest box; above or below the highlighted word\r\n\t\t\tinnerDocument: true  // if you want the badwords highlighted in the html then set to true\r\n\t\t}).spellchecker(\"check\", function (result)\r\n\t\t{\r\n\t\t\t//if result is true then there are no badly spelt words\r\n\t\t\tif (result)\r\n\t\t\t{\r\n\t\t\t\tif (isAutoCheck)\r\n\t\t\t\t{\r\n\t\t\t\t\t$txtObj.data(\"spell_checked_flag\", \"1\");\r\n\t\t\t\t\t//$m.dialog(\"close\"); //it will not trigger close event\r\n\t\t\t\t\t$m.dialog(\"destroy\");\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\talert('There are no incorrectly spelled words.');\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\telse //it has error word\r\n\t\t\t{\r\n\t\t\t\t$m.dialog(\"open\");\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\r\n\r\n})(jQuery);  ", "size":4327, "mimeType":"text/javascript"}, "headers":[{"name":"Content-Type", "value":"text/javascript"}, {"name":"Last-Modified", "value":"Tue, 28 Jul 2026 12:31:15 GMT"}, {"name":"Accept-Ranges", "value":"bytes"}, {"name":"ETag", "value":"\"1dd1e8cfb383b67\""}, {"name":"Vary", "value":"Accept-Encoding"}, {"name":"Server", "value":"Microsoft-IIS/10.0"}, {"name":"X-Powered-By", "value":"ASP.NET"}, {"name":"Date", "value":"Wed, 29 Jul 2026 06:04:17 GMT"}, {"name":"Content-Length", "value":"4327"}]}, "startedDateTime":"2026-07-29T14:04:17.6771709+08:00", "cache":{}}, {"time":269, "connection":"ClientPort:7574;EgressPort:7648", "comment":"[#153]", "request":{"headersSize":2037, "postData":{"text":"", "mimeType":""}, "queryString":[{"name":"v", "value":"Gnw6g5DIS21msaaNeMQgV7VrLZGnrnen8C5edn22ZIk"}], "headers":[{"name":"Host", "value":"parms42test.csitech.com"}, {"name":"Connection", "value":"keep-alive"}, {"name":"sec-ch-ua-platform", "value":"\"Windows\""}, {"name":"User-Agent", "value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36"}, {"name":"sec-ch-ua", "value":"\"Not;A=Brand\";v=\"8\", \"Chromium\";v=\"150\", \"Google Chrome\";v=\"150\""}, {"name":"sec-ch-ua-mobile", "value":"?0"}, {"name":"Accept", "value":"*/*"}, {"name":"Sec-Fetch-Site", "value":"same-origin"}, {"name":"Sec-Fetch-Mode", "value":"no-cors"}, {"name":"Sec-Fetch-Dest", "value":"script"}, {"name":"Referer", "value":"https://parms42test.csitech.com/RMS/Aspsoft/IntakeForm/Intake?nextPID=listPoliceReport&MPID=intakeFormMiddelPage&case_id=1100017412&template_id=1318&report_id=4191&rnd=0.4480235126577403"}, {"name":"Accept-Encoding", "value":"gzip, deflate, br, zstd"}, {"name":"Accept-Language", "value":"en-US,en;q=0.9"}, {"name":"Cookie", "value":"IDReaderCommPort=COM1; .AspNetCore.Antiforgery.im7NZdQjnVA=CfDJ8Lt5bHFAdgVKqAT8Txuezcns