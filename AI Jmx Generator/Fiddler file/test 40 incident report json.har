s\": false,\r\n  \"IsJustGenerate\": false,\r\n  \"IsPop\": false,\r\n  \"IsPopupViewDocWin\": false,\r\n  \"HasChildSection\": false,\r\n  \"AutoSubmit\": false,\r\n  \"IsDebugMode\": false,\r\n  \"TransactionID\": \"\",\r\n  \"MasterIndex\": [],\r\n  \"SeletedMasterID\": null,\r\n  \"Thumbnails\": [],\r\n  \"WordPageNum\": null,\r\n  \"MasterPageFile\": null,\r\n  \"MasterPageType\": null,\r\n  \"TipMessage\": {\r\n    \"intakeform_max_njs\": \"The most allowed to choose {0} Crime/Incident under {1}\",\r\n    \"intakeform_req_njs\": \"Please select Crime/Incident under \u00a0\\\\\\\"{0} \\\\\\\" . \",\r\n    \"intakeform_add_njs\": \"Please click \\\\\\\"{0} \\\\\\\" button to add Crime/Incident.\",\r\n    \"intakeform_max_allcontact\": \"The most allowed to choose {0} Contact under {1}\",\r\n    \"intakeform_req_allcontact\": \"Please select Contact under \u00a0\\\\\\\"{0} \\\\\\\" Section. \",\r\n    \"intakeform_add_allcontact\": \"Please click \\\\\\\"{0} \\\\\\\" button to add Contact.\"\r\n  }\r\n};\r\n\t\textConfig.WorkingMessage = \"<h2>Working...</h2>\";\r\n\t\textConfig.CurrentRequestUrl = \"/Aspsoft/IntakeForm/middlepage?nextPID=intakeFormMiddelPage&template_id=1318&report_id=0&case_id=1100017412&PID=listPoliceReport&FormGUID=066ba348-3b60-4aab-9227-ef3813fa82f8\"\r\n\r\n\t\tlet middleInstance = new Middle(\r\n\t\t\t\"1318\",\r\n\t\t\t\"1100017412\",\r\n\t\t\t\"0\",\r\n\t\t\t\"intakeFormMiddelPage\",\r\n\t\t\t\"listPoliceReport\",\r\n\t\t\t$(\"div[data-obj-name='master_section']\"),\r\n\t\t\textConfig\r\n\t\t);\r\n\r\n\t\tfunction Dialog_BeforeOpenPopup(url)\r\n\t\t{\r\n\t\t\treturn middleInstance.dialogBeforeOpenPopup(url);\r\n\t\t}\r\n\r\n\t\tfunction Dialog_AfterClosePopup(ret)\r\n\t\t{\r\n\t\t\treturn middleInstance.dialogAfterClosePopup(ret);\r\n\t\t}\r\n\r\n\t\t$(function ()\r\n\t\t{\r\n\t\t\t//this page should submit automatically\r\n\t\t\tif (extConfig.IsAutoWorkflow)\r\n\t\t\t{\r\n\t\t\t\t$(\"#btnCreateReport\").trigger(\"click\");\r\n\t\t\t}\r\n\t\t});\r\n\r\n\t\t$(\"#btnRefresh\").click(function ()\r\n\t\t{\r\n\t\t\tdocument.location.reload();\r\n\t\t});\r\n\r\n\t</script>\r\n\r\n\t<!--start of webpage-append--><script type=\"text/javascript\" language=\"javascript\">\r\n$(document).ready(function () {\r\n    $(\"table[objectname='listIntakeFormMaster_FireStaff'] th.titleColumnHeader\").remove();\r\n    $(\"table[objectname='listIntakeFormMaster_FireStaff'] input[type='checkbox']\").attr('islist', '1');\r\n\r\n    var $btnCreate = $(\"input[id='ctl00_ContentPlaceHolder1_btnCreateReport']\");\r\n    var $hiddenReportID = $(\"input[id='ctl00_ContentPlaceHolder1_hdnReportID']\");\r\n    var $hdnAutoWorkFlow = $(\"input[id='ctl00_ContentPlaceHolder1_hdnAutoWorkFlow']\");\r\n\r\n    var reportid = $hiddenReportID.val();\r\n    var IsAutoWF = $hdnAutoWorkFlow.val();\r\n\r\n    if (reportid != \"\" && reportid != \"0\") {\r\n        $btnCreate.val(\"Update Report(s)\");\r\n    } else {\r\n        if (IsAutoWF != \"Y\") {\r\n            $btnCreate.val(\"Generate Report(s)\");\r\n        }\r\n    }\r\n\r\n    var $unit = $(\"table[objectname='listIntakeFormMaster_FireUnit']\");\r\n    if ($unit) {\r\n        var $reportID = $(\"input[id='ctl00_ContentPlaceHolder1_hdnReportID']\");\r\n        if ($reportID.val() == \"0\") {\r\n            var $chks = $unit.find(\":checkbox[objectname='cfs_assignment_id']\")\r\n                $chks.each(function () {\r\n                    $(this).prop('checked', true)\r\n                })\r\n        }\r\n    }\r\n\r\n    var partialrefreshlist = \",\";\r\n    $(\"table[ObjectName^=listIntakeFormMaster_]\").each(function () {\r\n        var objname = $(this).attr(\"objectname\").toLowerCase();\r\n        partialrefreshlist = partialrefreshlist + objname + \",\";\r\n    });\r\n\r\n    //remove non-exist partialrefresh pageid\r\n    var _PopUp = PopUp;\r\n    PopUp = function (url, width, height, orgUrl, callbackFunc) {\r\n        url = correctPartialRefreshParam(url);\r\n        _PopUp(url, width, height, orgUrl, callbackFunc);\r\n    };\r\n\r\n    function correctPartialRefreshParam(url) {\r\n        var add_pageid = url;\r\n        var qsArr = add_pageid.split('&');\r\n        var org_partref,\r\n        partref;\r\n        var new_add_pageid = url;\r\n        for (var i = 0; i < qsArr.length; i++) {\r\n            if (qsArr[i].toLowerCase().indexOf(\"partialrefresh=\") == 0) {\r\n                org_partref = qsArr[i];\r\n                partref = org_partref.substring(15);\r\n\r\n                var pageArr = partref.split(',');\r\n                partref = '';\r\n                for (var j = 0; j < pageArr.length; j++) {\r\n                    if (partialrefreshlist.indexOf(',' + pageArr[j].toLowerCase() + ',') != -1) {\r\n                        partref = partref + ',' + pageArr[j];\r\n                    }\r\n                }\r\n                partref = \"PartialRefresh=\" + partref.substring(1);\r\n                new_add_pageid = add_pageid.replace(org_partref, partref);\r\n                break;\r\n            }\r\n        }\r\n        return new_add_pageid;\r\n    }\r\n\r\n    HideOptional();\r\n    HideReportPersonType();\r\n    DefaultToSelectArrestCharge();\r\n});\r\n\r\nfunction DefaultToSelectArrestCharge() {\r\n    var selectors = [\r\n        \"table[ObjectName='listIntakeFormMaster_Suspect']\",\r\n        \"table[ObjectName='listIntakeFormMaster_Arrestee_NIBRS']\",\r\n        \"table[ObjectName='listIntakeFormMaster_Suspect_JV']\"\r\n    ];\r\n    \r\n    var delegateSelector = selectors.map(function (sel) {\r\n        return sel + \" :checkbox, \" + sel + \" :radio\";\r\n    }).join(\", \");\r\n\r\n    $(document).off(\"click\", delegateSelector).on(\"click\", delegateSelector, function () {\r\n            ReplaceAddChargeUrlBySelectSuspect($(this));\r\n    });\r\n\r\n    selectors.forEach(function (sel) {\r\n        var $table = $(sel);\r\n        //$(document).on(\"click\", \":checkbox, :radio\", function () {\r\n        //    ReplaceAddChargeUrlBySelectSuspect($(this));\r\n        //});\r\n\r\n        $table.find(\":checkbox, :radio\").data(\"has_click_event\", true);\r\n        var $checked = $table.find(\"input:checkbox:checked:first\");\r\n        if ($checked.length > 0) {\r\n            ReplaceAddChargeUrlBySelectSuspect($checked);\r\n        }\r\n    });\r\n}\r\n\r\nfunction ReplaceAddChargeUrlBySelectSuspect($obj) {\r\n    var arresteeID = $obj.is(\":checked\") ? $obj.val() : \"\";\r\n    var arresteeParam = \"&arresteeid=\" + arresteeID;\r\n\r\n   function updateChargeButton(indexType) {\r\n        var $btn = $(\"div[data-master-index-type=\" + indexType + \"]\").find(\"input[type='button'][add_pageid*='addCaseArrest_PA']\");\r\n        if ($btn.length === 1) {\r\n            var url = $btn.attr(\"add_pageid\");\r\n            url = url.indexOf(\"&arresteeid=\") < 0\r\n                ? url + arresteeParam\r\n                : updateURLParameterInMiddlePage(url, \"arresteeid\", arresteeID);\r\n            $btn.attr(\"add_pageid\", url);\r\n            $btn.attr(\"data-add-page-url\", url);\r\n        }\r\n    }\r\n\r\n    updateChargeButton(\"CHARGE\");\r\n    updateChargeButton(\"JV_CHARGE\");\r\n}\r\n\r\nfunction updateURLParameterInMiddlePage(url, param, paramVal) {\r\n    var newAdditionalURL = \"\";\r\n    var tempArray = url.split(\"?\");\r\n    var baseURL = tempArray[0];\r\n    var additionalURL = tempArray[1];\r\n    var temp = \"\";\r\n    if (additionalURL) {\r\n        tempArray = additionalURL.split(\"&\");\r\n        for (var i = 0; i < tempArray.length; i++) {\r\n            if (tempArray[i].split('=')[0] != param) {\r\n                newAdditionalURL += temp + tempArray[i];\r\n                temp = \"&\";\r\n            }\r\n        }\r\n    }\r\n\r\n    var rows_txt = temp + \"\" + param + \"=\" + paramVal;\r\n    return baseURL + \"?\" + newAdditionalURL + rows_txt;\r\n}\r\n\r\nvar Origin_Dialog_AfterClosePopup = Dialog_AfterClosePopup;\r\nDialog_AfterClosePopup = function (ret) {\r\n    Origin_Dialog_AfterClosePopup(ret);\r\n    HideOptional();\r\n}\r\n\r\n\r\n// Hide unused [Optional] column\r\nfunction HideOptional() {\r\n    var optional_MIP_list = \"listIntakeFormMaster_WarrantVehicle,listIntakeFormMaster_ALLCONTACT,listIntakeFormMaster_Vehicle,listIntakeFormMaster_Property,listIntakeFormMaster_Suspect\";\r\n    var MasterObjectPageID = optional_MIP_list.split(\",\");\r\n\r\n    for (var j = 0; j <= MasterObjectPageID.length - 1; j++) {\r\n        var OptionTr = $('table[Objectname=' + MasterObjectPageID[j] + ']').find('tbody').find('tr');\r\n        var OptionTd = $(OptionTr[1]).find('td:eq(1)').html();\r\n\r\n        if (OptionTd == '&nbsp;') {\r\n            OptionTr.find('th:eq(1)').css('display', 'none');\r\n            for (var i = 0; i < OptionTr.length; i++) {\r\n                $(OptionTr[i]).find('td:eq(1)').css('display', 'none');\r\n            }\r\n        }\r\n    }\r\n}\r\nfunction HideReportPersonType() {\r\n    var show_report_person_type = \"No_value\";\r\n    if (show_report_person_type != \"Y\") {\r\n        $(\"select[objectname='report_person_type']\").closest(\"td\").remove();\r\n        $(\"span[column_category='report_person_type']\").closest(\"th\").remove();\r\n    }\r\n}\r\n\r\nfunction Multi_AfterPartial() {\r\n    HideReportPersonType();\r\n    if (typeof(update_AfterPartial) == \"function\") {\r\n        update_AfterPartial();\r\n    }   \r\n}\r\n</script>\r\n<!--end of webpage-append-->\r\n\r\n\t<script>\r\n\t\t$(function ()\r\n\t\t{\r\n\t\t\t//***************** handle day/night ui script *****************\r\n\t\t\t//(1) handle day/night icon\r\n\t\t\t$(\"#themeSwitch\").on(\"change\",function ()\r\n\t\t\t{\r\n\t\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/EngineService/UpdateDayNight\") + '?rn=' + Math.random() + '';\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: url,\r\n\t\t\t\t\tsuccess: () => {\r\n\t\t\t\t\t\t// window.location.reload()\r\n\t\t\t\t\t\tdocument.querySelector(\"html\")\r\n\t\t\t\t\t\t\t.setAttribute(\"data-csi-theme\", this.checked ? \"dark\" : \"light\");\r\n\t\t\t\t\t\tdocument.querySelector(\"body\").classList\r\n\t\t\t\t\t\t\t.remove(\"nightmode_none\",\"nightmode\")\r\n\t\t\t\t\t\tdocument.querySelector(\"body\").classList\r\n\t\t\t\t\t\t\t.add(this.checked ? \"nightmode\" : \"nightmode_none\");\r\n\t\t\t\t\t\t__is_night_mode = this.checked ? \"1\" : \"0\";\r\n\t\t\t\t\t\tif (typeof RefreshAllRichTextBoxThemes === 'function')\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\tRefreshAllRichTextBoxThemes();\r\n\t\t\t\t\t\t}\r\n\r\n\t\t\t\t\t\tconst channel = new BroadcastChannel(\"nightmode\");\r\n\t\t\t\t\t\tchannel.postMessage({\r\n\t\t\t\t\t\t\ttype: \"update-night-mode\",\r\n\t\t\t\t\t\t\tisNightMode: __is_night_mode\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\t\t\t\treturn false;\r\n\t\t\t});\r\n\r\n\t\t\t//(2) special script\r\n\t\t\tvar currentPageID = queryString(document.location.href, \"nextPID\");\r\n\t\t\tif (__is_night_mode == 1)\r\n\t\t\t{\r\n\t\t\t\t//switch day/night icon\r\n\t\t\t\t$(\"#imgDNMode\").attr(\"src\", ResolveClientUrl(\"~/images/icon_nightmode.png\"));\r\n\t\t\t\t//left side inbox/menu icon\r\n\t\t\t\t$(\"#inbox_menu_text\").attr(\"src\", ResolveClientUrl(\"~/images/icon_night_inbox.png\"));\r\n\t\t\t\t$(\"#popup_menu_text\").attr(\"src\", ResolveClientUrl(\"~/images/icon_night_menu.png\"));\r\n\t\t\t\t//list icon\r\n\t\t\t\t$(\"table.gridview_navigation\").find(\"select[name$='ddlPageSize']\").parent().find(\"img\").each(function (idx, oo)\r\n\t\t\t\t{\r\n\t\t\t\t\t$(oo).attr(\"src\", $(oo).attr(\"src\").replace(\".png\", \"_night.png\"));\r\n\t\t\t\t});\r\n\t\t\t\t//home icon\r\n\t\t\t\t$(\"#imgHome\").attr(\"src\", ResolveClientUrl(\"~/images/Icon_home_key_night.png\"));\r\n\r\n\t\t\t\t//dropcheck button\r\n\t\t\t\t$(\"span.dropcheckbox\").prev(\":button[value='>>']\").css({ \"background-color\": \"#383838\", \"color\": \"#a5a7aa\", \"margin-left\": \"2px\" });\r\n\t\t\t}\r\n\r\n\t\t\t//(3) hide nav_table becuase it will use space row (maybe need adjuest the script if has other type element in this area)\r\n\t\t\tif ($(\"table.nav_table\").find(\":input\").length == 0 && $(\"table.nav_table\").find(\"div.search_condition\").length == 0)\r\n\t\t\t{\r\n\t\t\t\t$(\"table.nav_table\").hide();\r\n\t\t\t}\r\n\r\n\t\t\t//(4) gridview table style\r\n\t\t\t$(\"table.gridview_border\").removeAttr(\"style\").css({ \"border-collapse\": \"separate\" }).attr({ \"cellpadding\": \"0\", \"cellspacing\": \"0\" });\r\n\t\t\t$(\"table.gridview_table,table.gridview_table_embed\").attr({ \"cellspacing\": \"0\" });\r\n\t\t\t// ***************** handle day/night ui script end *****************\r\n\r\n\t\t\tif (window.parent.location.href.indexOf(\"Index\") > 0)\r\n\t\t\t{\r\n\t\t\t\t$(\"#lnkToHome\").attr(\"href\", ResolveClientUrl(\"~/Home\"));\r\n\t\t\t\t$(\"#imgAgencyLogo\").css({ \"cursor\": \"pointer\" });\r\n\t\t\t}\r\n\t\t});\r\n\t\tfunction changeDayNightModeCAD(isNight)\r\n\t\t{\r\n\t\t\tif (isNight == \"1\")\r\n\t\t\t{\r\n\t\t\t\t$(\"body\").removeClass(\"nightmode_none\").addClass(\"nightmode\");\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\t$(\"body\").removeClass(\"nightmode\").addClass(\"nightmode_none\");\r\n\t\t\t}\r\n\r\n\t\t\tvar siteNightMode = \"0\";\r\n\t\t\tif (isNight != siteNightMode)\r\n\t\t\t{\r\n\t\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/EngineService/UpdateDayNight\") + '?rn=' + Math.random() + '&force_day_night_type=' + (isNight == \"1\" ? \"night\" : \"day\");\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: url,\r\n\t\t\t\t\tsuccess: () => { }\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}\r\n\t\tfunction RemoteLoginToePro(id)\r\n\t\t{\r\n\t\t\tvar ret = ExecServerMethod(\"POST\", ResolveClientUrl(\"~/AspSoft/EngineService/GetRemoteKey\") + \"?rnd=\" + Math.random());\r\n\t\t\tif (ret == \"true\" || ret == \"false\")\r\n\t\t\t{\r\n\t\t\t\talert(\"Single Sign On function is unavailable, please contact administrators.\");\r\n\t\t\t}\r\n\t\t\telse\r\n\t\t\t{\r\n\t\t\t\tvar guid = ret.substring(0, 32);\r\n\t\t\t\tvar url = ret.substring(33);\r\n\r\n\t\t\t\tvar tempForm = $(\"<form/>\");\r\n\t\t\t\ttempForm.attr(\"id\", \"dynRemoteForm\");\r\n\t\t\t\ttempForm.attr(\"action\", url + \"/Login?action=login_by_remote&guid=\" + guid);\r\n\t\t\t\ttempForm.attr(\"method\", \"post\");\r\n\t\t\t\ttempForm.attr(\"target\", \"_blank\");\r\n\r\n\t\t\t\tvar hldAction = $(\"s<input type=hidden name='action' value='login_by_remote'>\");\r\n\t\t\t\thldAction.appendTo(tempForm);\r\n\r\n\t\t\t\tvar hldGUIDInfo = $(\"<input type='hidden' name='guid' />\");\r\n\t\t\t\thldGUIDInfo.val(guid);\r\n\t\t\t\thldGUIDInfo.appendTo(tempForm);\r\n\r\n\t\t\t\ttempForm.appendTo($(\"body\"));\r\n\r\n\t\t\t\ttempForm.trigger(\"submit\");\r\n\t\t\t\ttempForm.remove();\r\n\r\n\t\t\t\treturn false;\r\n\t\t\t}\r\n\t\t}\r\n\t\tfunction jumpTo(objJumpBase)\r\n\t\t{\r\n\t\t\tvar val = objJumpBase.value;\r\n\t\t\tif (val.replace(/ /g, \"\") == \"\")\r\n\t\t\t{\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tvar menuID = '1';\r\n\t\t\tvar nextPID = 'intakeFormMiddelPage';\r\n\t\t\tif (objJumpBase.value != '')\r\n\t\t\t{\r\n\t\t\t\tif (!validValueForSearch(val))\r\n\t\t\t\t{\r\n\t\t\t\t\tobjJumpBase.focus();\r\n\t\t\t\t\treturn;\r\n\t\t\t\t}\r\n\t\t\t\tvar url = ResolveClientUrl('~/AspSoft/JumpToList' + '?jump_base=' + encodeURIComponent(objJumpBase.value) + '&menu_id=' + menuID + '&nextPID=' + nextPID);\r\n\t\t\t\tPopUp(url + \"&rnd=\" + Math.random(), 800, 800, '', function (ret)\r\n\t\t\t\t{\r\n\t\t\t\t\tif (ret != null && ret != \"\")\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\turl = ResolveClientUrl('~/aspSoft/dispatcher' + '?jump_base=' + encodeURIComponent(objJumpBase.value) + '&' + ret + '');\r\n\t\t\t\t\t\twindow.location = url;\r\n\t\t\t\t\t}\r\n\t\t\t\t});\r\n\r\n\t\t\t}\r\n\t\t}\r\n\r\n\t\tfunction openPageWin()\r\n\t\t{\r\n\t\t\tvar nextPID = 'intakeFormMiddelPage';\r\n\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/Common/CaptionTab?pageID=\" + nextPID);\r\n\t\t\tPopUp(url, 800, 700, 'RELOAD');\r\n\t\t}\r\n\r\n\r\n\t\tif (''==\"1\"&&''==\"1\")\r\n\t\t{\r\n\t\t\t$(function ()\r\n\t\t\t{\r\n\t\t\t\tShowConcurrentLoginsTips();\r\n\t\t\t})\r\n\t\t}\r\n\r\n\t\tfunction ShowConcurrentLoginsTips()\r\n\t\t{\r\n\t\t\t$(\"#customOverlay, #customModal\").remove();\r\n\r\n\t\t\tvar $overlay = $(\"<div>\", {\r\n\t\t\t\tid: \"customOverlay\"\r\n\t\t\t}).css({\r\n\t\t\t\tposition: \"fixed\",\r\n\t\t\t\ttop: 0,\r\n\t\t\t\tleft: 0,\r\n\t\t\t\twidth: \"100%\",\r\n\t\t\t\theight: \"100%\",\r\n\t\t\t\tbackground: \"rgba(0,0,0,0.3)\",\r\n\t\t\t\tzIndex: 9998\r\n\t\t\t});\r\n\r\n\t\t\tvar isNightMode =\"0\";\r\n\r\n\t\t\tvar $modal = $(\"<div>\", {\r\n\t\t\t\tid: \"customModal\",\r\n\t\t\t\thtml: $(\"#divConcurrentLoginsTips\").html()\r\n\t\t\t\t}).css({\r\n\t\t\t\t\tposition: \"fixed\",\r\n\t\t\t\t\twidth: \"500px\",\r\n\t\t\t\t\theight: \"180px\",\r\n\t\t\t\t\tcursor: \"default\",\r\n\t\t\t\t\ttextAlign: \"left\",\r\n\t\t\t\t\tzIndex: 9999,\r\n\t\t\t\t\tpadding: \"15px\",\r\n\t\t\t\t\tboxSizing: \"border-box\",\r\n\t\t\t\t\tborderRadius: \"6px\",\r\n\t\t\t\t\tboxShadow: \"0 2px 10px rgba(0,0,0,0.2)\",\r\n\r\n\t\t\t\t\ttop: \"50%\",\r\n\t\t\t\t\tleft: \"50%\",\r\n\t\t\t\t\ttransform: \"translate(-50%, -50%)\",\r\n\r\n\t\t\t\t\tcolor: isNightMode==\"1\" ? \"#e1e2e3\" : \"#000\",\r\n\t\t\t\t\tbackgroundColor: isNightMode == \"1\" ? \"#232323\" : \"#fff\"\r\n\t\t\t\t});\r\n\r\n\t\t\t\t$(\"body\").append($overlay).append($modal);\r\n\t\t}\r\n\r\n\t\tfunction HideConcurrentLoginsTips()\r\n\t\t{\r\n\t\t\t$(\"#customOverlay, #customModal\").remove();\r\n\t\t}\r\n\r\n\t\tfunction SetConcurrentLoginsAction(actionType)\r\n\t\t{\r\n\t\t\tvar url = ResolveClientUrl(\"~/AspSoft/EngineService/UpdateConcurrentLoginsAction\") + '?rnd=' + Math.random();\r\n\t\t\tExec(url, { action_type: actionType }, function (res)\r\n\t\t\t{\r\n\t\t\t\tHideConcurrentLoginsTips();\r\n\t\t\t});\r\n\t\t}\r\n\t</script>\r\n\t\r\n\t\r\n\r\n\t\r\n\t<script src=\"/RMS/lib/microsoft/signalr/dist/browser/signalr.