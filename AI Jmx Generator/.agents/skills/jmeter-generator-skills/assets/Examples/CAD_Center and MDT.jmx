          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - Get master location" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 1) 去掉首尾的 &quot; 号，并反转义
def raw   = prev.getResponseDataAsString()
def clean = raw.replaceAll(&apos;^&quot;|&quot;$&apos;, &apos;&apos;)   // 去掉最外层双引号
               .replace(&apos;\\&quot;&apos;, &apos;&quot;&apos;)       // 反转义引号
               .replace(&apos;\\\\&apos;, &apos;\\&apos;)     // 反转义反斜杠

// 2) 转成 List
def list = new groovy.json.JsonSlurper().parseText(clean)

// 3) 随机下标
def idx = new Random().nextInt(list.size())

// 4) 把随机那条所有字段写进 JMeter 变量
def rec = list[idx]
vars.put(&quot;Master_location_id&quot;,  rec.master_location_id  ?: &apos;&apos;)
vars.put(&quot;Lat&quot;,    rec.latitude     ?: &apos;&apos;)
vars.put(&quot;Lon&quot;,     rec.longitude ?: &apos;&apos;)
vars.put(&quot;Street1&quot;,  rec.street1  ?: &apos;&apos;)
vars.put(&quot;City&quot;,    rec.city     ?: &apos;&apos;)
vars.put(&quot;County&quot;,     rec.county ?: &apos;&apos;)
vars.put(&quot;Municipality&quot;,  rec.municipality  ?: &apos;&apos;)
vars.put(&quot;State&quot;,    rec.state     ?: &apos;&apos;)
vars.put(&quot;Address&quot;,     rec.address ?: &apos;&apos;)
vars.put(&quot;Zip&quot;,  rec.zip  ?: &apos;&apos;)
vars.put(&quot;AddressType&quot;,  rec.location_type  ?: &apos;&apos;)
vars.put(&quot;PoliceZoneName&quot;,  rec.sector  ?: &apos;&apos;)</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
