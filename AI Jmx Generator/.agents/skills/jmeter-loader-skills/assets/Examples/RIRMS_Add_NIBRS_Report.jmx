                <stringProp name="XPathExtractor.matchNumber">1</stringProp>
                <stringProp name="XPathExtractor.xpathQuery">//span[@objectname=&apos;Victim_number&apos; and text()=&apos;${new_Victim_sequnse_number}&apos;]/parent::td/preceding-sibling::td[2]/a/@href</stringProp>
