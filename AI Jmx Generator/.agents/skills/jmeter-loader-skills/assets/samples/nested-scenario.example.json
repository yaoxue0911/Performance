{
  "test_plan": {
    "name": "Example HTTP Business Flow"
  },
  "thread_groups": [
    {
      "name": "Example Users",
      "threads": "${__P(concurrency,10)}",
      "rampup": "${__P(rampup,10)}",
      "duration": "${__P(duration,60)}",
      "on_sample_error": "continue",
      "children": [
        {
          "type": "http_defaults",
          "host": "${__P(target_host,example.invalid)}",
          "port": "${__P(target_port,443)}",
          "protocol": "${__P(protocol,https)}",
          "encoding": "${__P(content_encoding,UTF-8)}",
          "path": "${__P(base_path,/)}"
        },
        {
          "type": "cookie_manager",
          "clear_each_iteration": false
        },
        {
          "type": "user_defined_variables",
          "name": "Example thread-scoped constants",
          "variables": {
            "division_id": "3"
          }
        },
        {
          "type": "once_only_controller",
          "name": "Example Per-Thread Authentication",
          "children": [
            {
              "type": "transaction_controller",
              "name": "Example Authentication Transaction",
              "children": [
                {
                  "type": "http_sampler",
                  "name": "GET /example-auth-page",
                  "method": "GET",
                  "path": "/example-auth-page"
                },
                {
                  "type": "http_sampler",
                  "name": "POST /example-auth-submit",
                  "method": "POST",
                  "path": "/example-auth-submit"
                }
              ]
            }
          ]
        },
        {
          "type": "loop_controller",
          "name": "Example Business Iteration",
          "loops": "${__P(business_loops,1)}",
          "children": [
            {
              "type": "user_parameters",
              "name": "Example per-iteration data",
              "per_iteration": true,
              "parameters": [
                {
                  "name": "firstName",
                  "values": [
                    "TEST${__Random(1000,9999)}"
                  ]
                }
              ]
            },
            {
              "type": "transaction_controller",
              "name": "Example Business Transaction",
              "children": [
                {
                  "type": "http_sampler",
                  "name": "POST /example-resource",
                  "method": "POST",
                  "path": "/example-resource",
                  "body": "{\"example\":true}",
                  "post_body_raw": true
                }
              ]
            }
          ]
        },
        {
          "type": "view_results_tree",
          "name": "View Results Tree (Debug)",
          "filename": "${__P(debug_result_file,debug.jtl)}"
        },
        {
          "type": "simple_data_writer",
          "name": "Simple Data Writer (Load)",
          "filename": "${__P(load_result_file,load.jtl)}"
        }
      ]
    }
  ]
}
